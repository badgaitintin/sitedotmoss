---
interface Props {
  position?: 'bottom-left' | 'bottom-right';
  theme?: 'auto' | 'spotify' | 'nextwbc' | 'cv' | 'monolithic' | 'blog' | 'default';
}

const { position = 'bottom-right', theme = 'auto' } = Astro.props;

// Auto-detect page art direction if theme is 'auto'
const pathname = Astro.url.pathname;
let activeTheme = theme;
if (activeTheme === 'auto') {
  if (pathname.includes('spotify')) activeTheme = 'spotify';
  else if (pathname.includes('nextwbc')) activeTheme = 'nextwbc';
  else if (pathname.includes('cv')) activeTheme = 'cv';
  else if (pathname.includes('monolithic')) activeTheme = 'monolithic';
  else if (pathname.includes('blog')) activeTheme = 'blog';
  else activeTheme = 'default';
}
---

<!-- Import Tangerine Calligraphy & Serif Fonts from Google Fonts -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Tangerine:wght@400;700&family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&display=swap');
</style>

<!-- Hidden image preloads for instant, zero-flicker sprite switching -->
<div class="gaga-preload" aria-hidden="true">
  <img src="/manifesto/transpbg/manifesto_open-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_close-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_left-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_right-Photoroom.png" alt="" />
</div>

<!-- Full-Screen Temporary Color Invert Flash Overlay (On enter & exit) -->
<div id="gaga-screen-flash" class="gaga-screen-flash-invert" aria-hidden="true"></div>

<!-- Borderless Dark Smoky Watermark Sprite with Subtle Volumetric Rainbow Rays -->
<div
  id="site-watermark"
  class={`watermark-container ${position} theme-${activeTheme}`}
  data-position={position}
  data-theme={activeTheme}
  title="Click to speak"
  role="button"
  tabindex="0"
>
  <div class="gaga-avatar-anchor" id="gagaAvatarAnchor">
    <!-- Deep Dark Velvet Smoky Base (Dominant) -->
    <div class="gaga-smoky-shadow" aria-hidden="true"></div>

    <!-- Soft Volumetric Rainbow Rays (Subtle, Embedded in Darkness) -->
    <div class="gaga-corner-rainbow-rays" aria-hidden="true"></div>

    <div class="gaga-sprite-wrap" id="gagaSpriteWrap">
      <img
        id="gagaSpriteImg"
        class="gaga-sprite-img"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt="Lady Gaga"
        draggable="false"
      />
    </div>
  </div>
</div>

<!-- Floating Dialogue Modal: Avatar Left, Text Right, Borderless, Dark Diffuse Smoke & Soft Rainbow Rays -->
<div id="gaga-manifesto-modal" class={`gaga-dialogue-overlay theme-${activeTheme} is-hidden`} aria-hidden="true">
  <!-- Soft transparent backdrop, keeps website visible -->
  <div class="gaga-transparent-backdrop" id="gagaModalBackdrop"></div>
  
  <!-- Subtle Vintage Film Grain Layer -->
  <div class="gaga-vintage-grain-overlay" aria-hidden="true"></div>

  <div class="gaga-dialogue-stage" id="gagaHeroStage">
    <!-- LEFT: Lady Gaga Head with Deep Dark Smoky Haze & Volumetric Rainbow Rays -->
    <div class="gaga-left-avatar-wrap" id="gagaHeroAvatarWrap">
      <!-- 1. Deep Gothic Dark Velvet Smoke Base (Extremely diffuse, 90% dark) -->
      <div class="gaga-left-dark-smoke" aria-hidden="true"></div>

      <!-- 2. Soft Volumetric Rainbow Light Rays (Stationary, subtle, embedded in dark smoke) -->
      <div class="gaga-left-rainbow-rays" aria-hidden="true"></div>

      <img
        id="gagaHeroImg"
        class="gaga-left-hero-img"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt="Lady Gaga"
        draggable="false"
      />
    </div>

    <!-- RIGHT: Spoken Text with Deep Dark Smoky Haze & Soft Rainbow Rays -->
    <div class="gaga-right-speech-wrap" id="gagaSpeechBox">
      <!-- Deep dark diffuse smoke cloud -->
      <div class="gaga-speech-dark-smoke" aria-hidden="true"></div>

      <!-- Soft diffuse rainbow ray glow behind text -->
      <div class="gaga-speech-rainbow-rays" aria-hidden="true"></div>

      <!-- Current Sentence Only -->
      <div class="gaga-active-sentence-box">
        <p class="gaga-spoken-sentence" id="gagaActiveSentenceText"></p>
        <span class="gaga-typewriter-cursor" id="gagaCursor">|</span>
      </div>

      <!-- Dialogue Stepper & Prompt -->
      <div class="gaga-speech-footer">
        <div class="gaga-sentence-stepper" id="gagaSentenceStepper">
          <span class="step-dot" data-step="0"></span>
          <span class="step-dot" data-step="1"></span>
          <span class="step-dot" data-step="2"></span>
          <span class="step-dot" data-step="3"></span>
          <span class="step-dot" data-step="4"></span>
        </div>
        <span class="gaga-tap-hint">click to advance</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     DEFAULT DYNAMIC CHROMATIC RAINBOW CSS VARIABLES
     ========================================================================== */
  :root {
    --gaga-c1: hsla(330, 95%, 62%, 0.7);
    --gaga-c2: hsla(190, 95%, 58%, 0.6);
    --gaga-c3: hsla(270, 90%, 60%, 0.5);
    --gaga-c4: hsla(45, 95%, 58%, 0.4);
    --gaga-accent: #f43f5e;
    --gaga-glow: rgba(244, 63, 94, 0.35);
    --gaga-ray-angle: 20deg;
  }

  /* ==========================================================================
     HIDDEN PRELOAD CONTAINER
     ========================================================================== */
  .gaga-preload {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* ==========================================================================
     FULLSCREEN COLOR INVERT FLASH STROBE (ON ENTER & EXIT ONLY)
     ========================================================================== */
  .gaga-screen-flash-invert {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1000000;
    background: #ffffff;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
    transform: translateZ(0);
  }

  .gaga-screen-flash-invert.is-flashing {
    visibility: visible;
    animation: gaga-invert-strobe 0.22s steps(2, start) forwards;
  }

  @keyframes gaga-invert-strobe {
    0% { opacity: 0; }
    15% { opacity: 0.95; }
    40% { opacity: 0.1; }
    70% { opacity: 0.85; }
    100% { opacity: 0; }
  }

  /* ==========================================================================
     BORDERLESS CORNER WATERMARK (DEEP DARK SMOKE & SUBTLE VOLUMETRIC RAYS)
     ========================================================================== */
  .watermark-container {
    position: fixed;
    bottom: 20px;
    z-index: 99999;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: auto;
    cursor: pointer;
    background: transparent;
    padding: 0;
    margin: 0;
    outline: none;
    transform: translateZ(0);
    contain: layout style;
  }

  .watermark-container.bottom-right {
    right: 24px;
    left: auto;
  }

  .watermark-container.bottom-left {
    left: 24px;
    right: auto;
  }

  .gaga-avatar-anchor {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.3s ease;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  /* 1. Deep Dark Velvet Smoke Base (Seamless Feathered Decay) */
  .gaga-smoky-shadow {
    position: absolute;
    inset: -28px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.98) 0%, rgba(18, 5, 22, 0.92) 35%, rgba(0, 0, 0, 0.6) 60%, rgba(0, 0, 0, 0.15) 82%, transparent 100%);
    filter: blur(14px);
    pointer-events: none;
    opacity: 0.96;
    transform: translateZ(0);
    will-change: transform, opacity;
    animation: gaga-calm-smoke-pulse 5s ease-in-out infinite alternate;
  }

  /* 2. Soft Volumetric Rainbow Light Rays (Stationary, Subtle) */
  .gaga-corner-rainbow-rays {
    position: absolute;
    inset: -22px;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from var(--gaga-ray-angle, 15deg) at 50% 50%,
      var(--gaga-c1, rgba(255, 0, 128, 0.6)) 0deg 8deg,
      transparent 8deg 24deg,
      var(--gaga-c2, rgba(0, 240, 255, 0.5)) 24deg 32deg,
      transparent 32deg 48deg,
      var(--gaga-c3, rgba(168, 85, 247, 0.45)) 48deg 56deg,
      transparent 56deg 72deg,
      var(--gaga-c4, rgba(234, 179, 8, 0.35)) 72deg 80deg,
      transparent 80deg 96deg
    );
    -webkit-mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.9) 15%, rgba(0, 0, 0, 0.5) 45%, transparent 75%);
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.9) 15%, rgba(0, 0, 0, 0.5) 45%, transparent 75%);
    filter: blur(12px);
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0.45;
    transform: translateZ(0);
    will-change: opacity;
    transition: background 0.8s ease, opacity 0.8s ease;
  }

  .watermark-container:hover .gaga-corner-rainbow-rays {
    opacity: 0.7;
    filter: blur(10px);
  }

  /* Smooth sinking plunge when clicked */
  .gaga-avatar-anchor.is-sinking {
    transform: translateY(80px) scale(0.6) translateZ(0) !important;
    opacity: 0 !important;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.55, 0.085, 0.68, 0.53), opacity 0.25s ease-in !important;
  }

  /* Calm gentle floating up/down */
  .gaga-sprite-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: gaga-gentle-float 5s ease-in-out infinite alternate;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: transparent;
    border: none;
    box-shadow: none;
    transform: translateZ(0);
    will-change: transform;
  }

  .watermark-container:hover .gaga-sprite-wrap {
    transform: scale(1.15) translateY(-3px) translateZ(0);
  }

  .gaga-sprite-img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 10px rgba(0, 0, 0, 0.8));
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    position: relative;
    z-index: 2;
    transform: translateZ(0);
  }

  /* Calm gentle floating */
  @keyframes gaga-gentle-float {
    0% { transform: translateY(0) translateZ(0); }
    50% { transform: translateY(-4px) translateZ(0); }
    100% { transform: translateY(2px) translateZ(0); }
  }

  @keyframes gaga-calm-smoke-pulse {
    0% { transform: scale(0.94) translateZ(0); opacity: 0.88; }
    100% { transform: scale(1.06) translateZ(0); opacity: 1; }
  }

  /* ==========================================================================
     AVATAR LEFT, TEXT RIGHT — BORDERLESS DIFFUSE DIALOGUE
     ========================================================================== */
  .gaga-dialogue-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    opacity: 1;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.28s ease;
    transform: translateZ(0);
  }

  .gaga-dialogue-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Transparent backdrop with soft dimming — page stays visible */
  .gaga-transparent-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(6px) brightness(0.68);
    -webkit-backdrop-filter: blur(6px) brightness(0.68);
    cursor: pointer;
  }

  /* Vintage film grain layer */
  .gaga-vintage-grain-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
    opacity: 0.6;
    z-index: 1;
  }

  /* SIDE-BY-SIDE STAGE */
  .gaga-dialogue-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 36px;
    max-width: 940px;
    width: 92vw;
    box-sizing: border-box;
    pointer-events: auto;
    transform: translateZ(0);
  }

  /* Horror jumpscare tremor */
  .gaga-stage-shaking {
    animation: gaga-horror-tremor 0.35s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes gaga-horror-tremor {
    10%, 90% { transform: translate3d(-3px, -2px, 0) scale(1.01); }
    20%, 80% { transform: translate3d(4px, 3px, 0) scale(0.99); }
    30%, 50%, 70% { transform: translate3d(-4px, 2px, 0) scale(1.02); }
    40%, 60% { transform: translate3d(4px, -3px, 0) scale(0.98); }
  }

  /* ── LEFT: Hero Avatar ── */
  .gaga-dialogue-overlay.is-hidden .gaga-left-avatar-wrap {
    opacity: 0;
    pointer-events: none;
  }

  .gaga-left-avatar-wrap {
    position: relative;
    width: 230px;
    height: 230px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  /* Broad Gothic Deep Dark Smoke (Dominant, Velvet Soft) */
  .gaga-left-dark-smoke {
    position: absolute;
    inset: -80px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 0, 1) 0%, rgba(18, 4, 20, 0.95) 30%, rgba(0, 0, 0, 0.75) 55%, rgba(0, 0, 0, 0.25) 78%, transparent 100%);
    filter: blur(32px);
    transform: translateZ(0);
    will-change: transform, opacity;
    pointer-events: none;
    opacity: 0.98;
    animation: gaga-calm-smoke-pulse 5s ease-in-out infinite alternate;
  }

  /* Stationary Volumetric Rainbow Rays peeking through Darkness */
  .gaga-left-rainbow-rays {
    position: absolute;
    inset: -65px;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from var(--gaga-ray-angle, 25deg) at 50% 50%,
      var(--gaga-c1, rgba(255, 0, 128, 0.7)) 0deg 10deg,
      transparent 10deg 28deg,
      var(--gaga-c2, rgba(0, 240, 255, 0.6)) 28deg 38deg,
      transparent 38deg 56deg,
      var(--gaga-c3, rgba(168, 85, 247, 0.5)) 56deg 66deg,
      transparent 66deg 84deg,
      var(--gaga-c4, rgba(234, 179, 8, 0.4)) 84deg 94deg,
      transparent 94deg 112deg
    );
    -webkit-mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 1) 15%, rgba(0, 0, 0, 0.6) 45%, transparent 80%);
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 1) 15%, rgba(0, 0, 0, 0.6) 45%, transparent 80%);
    filter: blur(20px);
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0.48;
    transform: translateZ(0);
    will-change: opacity;
    transition: background 0.8s ease, opacity 0.8s ease;
  }

  .gaga-left-hero-img {
    width: 215px;
    height: 215px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 25px rgba(0, 0, 0, 0.85));
    animation: gaga-gentle-hero-float 4.5s ease-in-out infinite alternate;
    user-select: none;
    -webkit-user-drag: none;
    transform: translateZ(0);
  }

  /* Gentle calm hero hovering */
  @keyframes gaga-gentle-hero-float {
    0% { transform: translateY(0) translateZ(0); }
    50% { transform: translateY(-6px) translateZ(0); }
    100% { transform: translateY(3px) translateZ(0); }
  }

  /* ── RIGHT: Borderless Diffuse Spoken Text ── */
  .gaga-dialogue-overlay:not(.is-hidden) .gaga-right-speech-wrap {
    animation: gaga-speech-pop 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .gaga-right-speech-wrap {
    position: relative;
    flex: 1;
    max-width: 620px;
    min-height: 160px;
    box-sizing: border-box;
    padding: 26px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    cursor: pointer;
    transform: translateZ(0);
  }

  /* Deep Dark Velvet Smoke Cloud behind right text (Dominant) */
  .gaga-speech-dark-smoke {
    position: absolute;
    inset: -45px;
    border-radius: 50px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 0%, rgba(12, 4, 18, 0.95) 40%, rgba(0, 0, 0, 0.7) 65%, rgba(0, 0, 0, 0.2) 85%, transparent 100%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 1;
    transform: translateZ(0);
    opacity: 0.98;
  }

  /* Soft Diffuse Rainbow Rays behind right text (Stationary) */
  .gaga-speech-rainbow-rays {
    position: absolute;
    inset: -35px;
    border-radius: 50px;
    background: radial-gradient(ellipse at 35% 50%, var(--gaga-c1, rgba(255, 0, 128, 0.4)) 0%, var(--gaga-c2, rgba(0, 240, 255, 0.3)) 30%, var(--gaga-c3, rgba(168, 85, 247, 0.25)) 55%, transparent 85%),
      repeating-conic-gradient(
        from var(--gaga-ray-angle, 40deg) at 40% 50%,
        var(--gaga-c1, rgba(255, 0, 128, 0.4)) 0deg 8deg,
        transparent 8deg 30deg,
        var(--gaga-c2, rgba(0, 240, 255, 0.35)) 30deg 38deg,
        transparent 38deg 60deg,
        var(--gaga-c3, rgba(168, 85, 247, 0.3)) 60deg 68deg,
        transparent 68deg 90deg
      );
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.9) 20%, rgba(0, 0, 0, 0.4) 60%, transparent 85%);
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.9) 20%, rgba(0, 0, 0, 0.4) 60%, transparent 85%);
    filter: blur(22px);
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 1;
    opacity: 0.42;
    transform: translateZ(0);
    will-change: opacity;
    transition: background 0.8s ease, opacity 0.8s ease;
  }

  @keyframes gaga-speech-pop {
    0% {
      opacity: 0;
      transform: translateX(-12px) scale(0.96) translateZ(0);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1) translateZ(0);
    }
  }

  .gaga-active-sentence-box {
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  /* TANGERINE CALLIGRAPHY & POETIC TYPOGRAPHY */
  .gaga-spoken-sentence {
    margin: 0;
    font-family: 'Tangerine', 'Cormorant Garamond', cursive, Georgia, serif;
    font-style: normal;
    font-size: 3.1rem;
    font-weight: 700;
    line-height: 1.22;
    color: #ffffff;
    letter-spacing: 0.5px;
    display: inline;
    text-shadow: 
      0 4px 16px rgba(0, 0, 0, 1),
      0 0 25px rgba(0, 0, 0, 0.95),
      0 0 35px var(--gaga-glow);
    transition: text-shadow 0.6s ease;
  }

  .gaga-spoken-sentence.is-quote {
    color: #ffffff;
    font-size: 3.4rem;
    font-weight: 700;
  }

  .gaga-spoken-sentence.is-author {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--gaga-accent, #f43f5e);
    letter-spacing: 2px;
    display: block;
    margin-top: 4px;
    transition: color 0.6s ease;
  }

  .gaga-typewriter-cursor {
    display: inline-block;
    font-family: monospace;
    font-size: 2.2rem;
    color: var(--gaga-accent, #f43f5e);
    margin-left: 6px;
    vertical-align: middle;
    animation: gaga-cursor-blink 0.7s infinite;
    transition: color 0.6s ease;
  }

  @keyframes gaga-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Footer Stepper */
  .gaga-speech-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 10px;
  }

  .gaga-sentence-stepper {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .step-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.25s ease;
  }

  .step-dot.is-active {
    background: var(--gaga-accent, #f43f5e);
    box-shadow: 0 0 10px var(--gaga-accent, #f43f5e);
    transform: scale(1.4);
  }

  .step-dot.is-done {
    background: rgba(255, 255, 255, 0.7);
  }

  .gaga-tap-hint {
    font-family: 'Tangerine', cursive, serif;
    font-size: 1.45rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.5px;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (Mobile Stacking)
     ========================================================================== */
  @media (max-width: 720px) {
    .gaga-dialogue-stage {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    .gaga-left-avatar-wrap {
      width: 150px;
      height: 150px;
    }

    .gaga-left-hero-img {
      width: 145px;
      height: 145px;
    }

    .gaga-right-speech-wrap {
      text-align: center;
      padding: 16px;
      min-height: 110px;
    }

    .gaga-spoken-sentence {
      font-size: 2.35rem;
    }

    .gaga-spoken-sentence.is-quote {
      font-size: 2.55rem;
    }

    .gaga-spoken-sentence.is-author {
      font-size: 1.65rem;
    }

    .gaga-speech-footer {
      justify-content: center;
      gap: 12px;
    }
  }
</style>

<script>
  /**
   * Fast, High-Performance Lady Gaga Manifesto Controller with Dark Diffuse Volumetric Rainbow Rays
   */
  class GagaManifestoController {
    private spriteImg: HTMLImageElement | null = null;
    private heroImg: HTMLImageElement | null = null;
    private heroAvatarWrap: HTMLElement | null = null;
    private anchor: HTMLElement | null = null;
    private modal: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private speechBox: HTMLElement | null = null;
    private screenFlashEl: HTMLElement | null = null;

    private activeSentenceEl: HTMLElement | null = null;
    private cursorEl: HTMLElement | null = null;
    private stepDots: NodeListOf<HTMLElement> | null = null;

    private isShowcasing = false;
    private blinkTimer: number | null = null;
    private glanceTimer: number | null = null;

    // Sentence-by-sentence dialogue sequence
    private readonly MANIFESTO_SENTENCES = [
      {
        text: 'This is The Manifesto of Mother Monster.',
        isQuote: false,
        isAuthor: false,
        duration: 3000,
      },
      {
        text: '“Computers are only as creative as the humans who program them.”',
        isQuote: true,
        isAuthor: false,
        duration: 3200,
      },
      {
        text: '— John Maeda',
        isQuote: false,
        isAuthor: true,
        duration: 1800,
      },
      {
        text: 'No synthetic illusions — only living algorithms sculpted in mathematical light.',
        isQuote: false,
        isAuthor: false,
        duration: 3500,
      },
      {
        text: 'Every pixel is mathematically rendered, fiercely human-directed.',
        isQuote: false,
        isAuthor: false,
        duration: 3200,
      },
    ];

    private currentSentenceIdx = 0;
    private typingInterval: number | null = null;
    private nextSentenceTimeout: number | null = null;

    private readonly SPRITES = {
      open: '/manifesto/transpbg/manifesto_open-Photoroom.png',
      close: '/manifesto/transpbg/manifesto_close-Photoroom.png',
      left: '/manifesto/transpbg/manifesto_left-Photoroom.png',
      right: '/manifesto/transpbg/manifesto_right-Photoroom.png',
    };

    init(): void {
      this.spriteImg = document.getElementById('gagaSpriteImg') as HTMLImageElement;
      this.heroImg = document.getElementById('gagaHeroImg') as HTMLImageElement;
      this.heroAvatarWrap = document.getElementById('gagaHeroAvatarWrap');
      this.anchor = document.getElementById('gagaAvatarAnchor');
      this.modal = document.getElementById('gaga-manifesto-modal');
      this.backdrop = document.getElementById('gagaModalBackdrop');
      this.speechBox = document.getElementById('gagaSpeechBox');
      this.screenFlashEl = document.getElementById('gaga-screen-flash');

      this.activeSentenceEl = document.getElementById('gagaActiveSentenceText');
      this.cursorEl = document.getElementById('gagaCursor');
      this.stepDots = document.querySelectorAll('.step-dot');

      if (!this.spriteImg || !this.anchor || !this.modal) return;

      this.applyRandomRainbowGradients();
      this.bindEvents();
      this.startRoutines();
    }

    // ── Generate & Apply Harmonious Randomized Rainbow Volumetric Ray Parameters ──

    private generateRainbowColors(): { c1: string; c2: string; c3: string; c4: string; accent: string; glow: string; rayAngle: string } {
      const baseHue = Math.floor(Math.random() * 360);
      const h1 = baseHue;
      const h2 = (baseHue + 55 + Math.floor(Math.random() * 25)) % 360;
      const h3 = (baseHue + 135 + Math.floor(Math.random() * 35)) % 360;
      const h4 = (baseHue + 225 + Math.floor(Math.random() * 45)) % 360;
      const rayAngle = `${Math.floor(Math.random() * 90)}deg`;

      return {
        c1: `hsla(${h1}, 95%, 62%, 0.7)`,
        c2: `hsla(${h2}, 95%, 58%, 0.6)`,
        c3: `hsla(${h3}, 90%, 60%, 0.5)`,
        c4: `hsla(${h4}, 95%, 58%, 0.4)`,
        accent: `hsl(${h1}, 95%, 62%)`,
        glow: `hsla(${h1}, 95%, 62%, 0.35)`,
        rayAngle,
      };
    }

    private applyRandomRainbowGradients(): void {
      const colors = this.generateRainbowColors();
      const root = document.documentElement;
      
      root.style.setProperty('--gaga-c1', colors.c1);
      root.style.setProperty('--gaga-c2', colors.c2);
      root.style.setProperty('--gaga-c3', colors.c3);
      root.style.setProperty('--gaga-c4', colors.c4);
      root.style.setProperty('--gaga-accent', colors.accent);
      root.style.setProperty('--gaga-glow', colors.glow);
      root.style.setProperty('--gaga-ray-angle', colors.rayAngle);

      if (this.anchor) {
        this.anchor.style.setProperty('--gaga-c1', colors.c1);
        this.anchor.style.setProperty('--gaga-c2', colors.c2);
        this.anchor.style.setProperty('--gaga-c3', colors.c3);
        this.anchor.style.setProperty('--gaga-c4', colors.c4);
        this.anchor.style.setProperty('--gaga-ray-angle', colors.rayAngle);
      }
    }

    private bindEvents(): void {
      const watermark = document.getElementById('site-watermark');
      if (watermark) {
        watermark.addEventListener('mouseenter', () => {
          this.applyRandomRainbowGradients();
        });

        watermark.addEventListener('click', (e) => {
          e.stopPropagation();
          this.applyRandomRainbowGradients();
          this.triggerManifestoSequence();
        });
      }

      if (this.backdrop) {
        this.backdrop.addEventListener('click', () => this.dismissShowcase());
      }

      // Click on dialogue area advances to next sentence
      if (this.speechBox) {
        this.speechBox.addEventListener('click', (e) => {
          e.stopPropagation();
          this.advanceSentence();
        });
      }

      // Spacebar, Enter, or Escape key
      window.addEventListener('keydown', (e) => {
        if (this.isShowcasing) {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault();
            this.advanceSentence();
          } else if (e.code === 'Escape') {
            this.dismissShowcase();
          }
        }
      });

      // Restore position preference
      const savedPos = localStorage.getItem('sitedotmoss_watermark_pos');
      if (watermark && (savedPos === 'bottom-left' || savedPos === 'bottom-right')) {
        watermark.classList.remove('bottom-left', 'bottom-right');
        watermark.classList.add(savedPos);
      }
    }

    // ── Full-Screen Color Invert Flash Strobe (On enter & exit) ──

    private triggerScreenFlash(): void {
      if (!this.screenFlashEl) return;
      this.screenFlashEl.classList.remove('is-flashing');
      void this.screenFlashEl.offsetWidth; // Force reflow
      this.screenFlashEl.classList.add('is-flashing');
      setTimeout(() => {
        if (this.screenFlashEl) this.screenFlashEl.classList.remove('is-flashing');
      }, 250);
    }

    // ── Eye Animations (Blinking & Glancing) ──────────────────

    private setSprite(state: 'open' | 'close' | 'left' | 'right'): void {
      const src = this.SPRITES[state];
      if (this.spriteImg && this.spriteImg.src !== src) this.spriteImg.src = src;
      if (this.heroImg && this.heroImg.src !== src) this.heroImg.src = src;
    }

    private startRoutines(): void {
      this.scheduleBlink();
      this.scheduleGlance();
    }

    private scheduleBlink(): void {
      const delay = Math.random() * 3000 + 2500; // 2.5s - 5.5s
      this.blinkTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          this.setSprite('close');
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
              if (Math.random() < 0.2) {
                setTimeout(() => {
                  this.setSprite('close');
                  setTimeout(() => this.setSprite('open'), 110);
                }, 150);
              }
            }
          }, 120);
        }
        this.scheduleBlink();
      }, delay);
    }

    private scheduleGlance(): void {
      const delay = Math.random() * 4000 + 3500; // 3.5s - 7.5s
      this.glanceTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          const dir = Math.random() < 0.5 ? 'left' : 'right';
          this.setSprite(dir);

          const holdTime = Math.random() * 900 + 700; // 0.7s - 1.6s
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
            }
          }, holdTime);
        }
        this.scheduleGlance();
      }, delay);
    }

    // ── Interactive Manifesto Speech Stream ──────────────────

    private triggerManifestoSequence(): void {
      if (this.isShowcasing || !this.anchor || !this.modal) return;
      this.isShowcasing = true;

      // 1. Shift into fresh randomized rainbow ray colors on entry
      this.applyRandomRainbowGradients();

      // 2. Trigger Full-Screen Color Invert Strobe Flash on entry
      this.triggerScreenFlash();

      // 3. Corner sprite plunges down smoothly
      this.anchor.classList.add('is-sinking');
      this.setSprite('open');

      setTimeout(() => {
        if (!this.modal || !this.heroAvatarWrap) return;
        this.modal.classList.remove('is-hidden');

        // Stage jumpscare tremor
        const stage = document.getElementById('gagaHeroStage');
        if (stage) {
          stage.classList.remove('gaga-stage-shaking');
          void stage.offsetWidth;
          stage.classList.add('gaga-stage-shaking');
        }

        // Fluid and impactful cinematic zoom into center
        const rect = this.heroAvatarWrap.getBoundingClientRect();
        const stageCenterX = window.innerWidth / 2;
        const stageCenterY = window.innerHeight / 2;
        const elemCenterX = rect.left + rect.width / 2;
        const elemCenterY = rect.top + rect.height / 2;

        const centerDeltaX = stageCenterX - elemCenterX;
        const centerDeltaY = stageCenterY - elemCenterY;

        this.heroAvatarWrap.animate([
          {
            transform: `translate3d(${centerDeltaX.toFixed(1)}px, ${centerDeltaY.toFixed(1)}px, 0) scale(2.2)`,
            opacity: 0.4,
            filter: 'drop-shadow(0 0 50px var(--gaga-glow, rgba(244, 63, 94, 0.8)))',
          },
          {
            transform: 'translate3d(0, 0, 0) scale(1)',
            opacity: 1,
            filter: 'drop-shadow(0 20px 40px rgba(0, 0, 0, 0.95))',
          }
        ], {
          duration: 750,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards',
        });

        // Begin dialogue stream
        this.currentSentenceIdx = 0;
        setTimeout(() => {
          if (this.isShowcasing) {
            this.speakSentence(0);
          }
        }, 500);
      }, 200);
    }

    private speakSentence(idx: number): void {
      if (idx >= this.MANIFESTO_SENTENCES.length) {
        setTimeout(() => this.dismissShowcase(), 1000);
        return;
      }

      // Smoothly mutate subtle rainbow ray parameters with each sentence spoken
      this.applyRandomRainbowGradients();

      this.currentSentenceIdx = idx;
      const sentenceObj = this.MANIFESTO_SENTENCES[idx];

      // Update progress dots
      this.stepDots?.forEach((dot, dIdx) => {
        dot.classList.remove('is-active', 'is-done');
        if (dIdx < idx) dot.classList.add('is-done');
        else if (dIdx === idx) dot.classList.add('is-active');
      });

      // Clear previous sentence completely (No history)
      if (this.activeSentenceEl) {
        this.activeSentenceEl.innerText = '';
        this.activeSentenceEl.className = 'gaga-spoken-sentence';
        if (sentenceObj.isQuote) this.activeSentenceEl.classList.add('is-quote');
        if (sentenceObj.isAuthor) this.activeSentenceEl.classList.add('is-author');
      }

      // Lady Gaga turns to glance right while speaking
      if (idx === 0) {
        this.setSprite('right');
      }

      // Typewriter letter-by-letter streaming
      const text = sentenceObj.text;
      let charIdx = 0;
      if (this.typingInterval) clearInterval(this.typingInterval);

      const speed = sentenceObj.isAuthor ? 25 : 18;

      this.typingInterval = window.setInterval(() => {
        if (!this.activeSentenceEl) return;
        charIdx++;
        this.activeSentenceEl.innerText = text.slice(0, charIdx);

        // Occasional eye blink while speaking
        if (Math.random() < 0.03) {
          this.setSprite('close');
          setTimeout(() => {
            if (this.isShowcasing) this.setSprite('right');
          }, 100);
        }

        if (charIdx >= text.length) {
          if (this.typingInterval) clearInterval(this.typingInterval);
          this.typingInterval = null;

          // Finished typing sentence: schedule next sentence auto-advance
          this.nextSentenceTimeout = window.setTimeout(() => {
            this.advanceSentence();
          }, sentenceObj.duration);
        }
      }, speed);
    }

    private advanceSentence(): void {
      if (!this.isShowcasing) return;
      if (this.typingInterval) {
        // If still typing, complete instantly
        clearInterval(this.typingInterval);
        this.typingInterval = null;
        const sentenceObj = this.MANIFESTO_SENTENCES[this.currentSentenceIdx];
        if (this.activeSentenceEl) this.activeSentenceEl.innerText = sentenceObj.text;
        return;
      }

      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);

      // Proceed to next sentence
      this.speakSentence(this.currentSentenceIdx + 1);
    }

    private dismissShowcase(): void {
      if (!this.isShowcasing || !this.modal || !this.anchor) return;
      if (this.typingInterval) clearInterval(this.typingInterval);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);

      // Trigger Full-Screen Color Invert Strobe Flash on exit
      this.triggerScreenFlash();

      if (this.heroAvatarWrap) {
        this.heroAvatarWrap.animate([
          {
            transform: 'translate3d(0, 0, 0) scale(1)',
            opacity: 1,
          },
          {
            transform: 'translate3d(0, 40px, 0) scale(0.7)',
            opacity: 0,
          }
        ], {
          duration: 320,
          easing: 'cubic-bezier(0.2, 0.05, 0.2, 1)',
          fill: 'forwards',
        });
      }

      setTimeout(() => {
        if (!this.modal || !this.anchor) return;
        this.modal.classList.add('is-hidden');
        this.anchor.classList.remove('is-sinking');
        this.anchor.style.transform = 'translate3d(0, 0, 0)';
        this.setSprite('open');
        this.isShowcasing = false;
      }, 300);
    }

    destroy(): void {
      if (this.blinkTimer) clearTimeout(this.blinkTimer);
      if (this.glanceTimer) clearTimeout(this.glanceTimer);
      if (this.typingInterval) clearInterval(this.typingInterval);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);
    }
  }

  let controller: GagaManifestoController | null = null;

  function initGagaWatermark() {
    if (controller) controller.destroy();
    controller = new GagaManifestoController();
    controller.init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGagaWatermark);
  } else {
    initGagaWatermark();
  }

  document.addEventListener('astro:after-swap', initGagaWatermark);
</script>
