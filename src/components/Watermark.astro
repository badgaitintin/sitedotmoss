---
interface Props {
  position?: 'bottom-left' | 'bottom-right';
}

const { position = 'bottom-right' } = Astro.props;
---

<div id="site-watermark" class={`watermark-container ${position}`} data-position={position} title="click to toggle position (left / right)">
  <div class="watermark-content">
    <div class="watermark-title">this website contain</div>
    <div class="watermark-line">ai generate code in sdlc process</div>
    <div class="watermark-line">human control every step, cv/about-me are support responsive</div>
    <div class="watermark-line">zero ai use for art, just computer graphics</div>
  </div>
</div>

<style>
  .watermark-container {
    position: fixed;
    bottom: 16px;
    z-index: 99999;
    font-family: Helvetica, Arial, sans-serif;
    text-transform: lowercase;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: auto;
    cursor: pointer;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0;
    margin: 0;
    opacity: 0.38;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s ease, left 0.3s ease, right 0.3s ease;
  }

  .watermark-container:hover {
    opacity: 0.95;
  }

  .watermark-container.bottom-right {
    right: 20px;
    left: auto;
    text-align: right;
  }

  .watermark-container.bottom-left {
    left: 20px;
    right: auto;
    text-align: left;
  }

  .watermark-content {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .watermark-title {
    font-size: 13.5px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.18;
    letter-spacing: -0.1px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8), 0 0 8px rgba(0, 0, 0, 0.5);
  }

  .watermark-line {
    font-size: 11px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.2;
    letter-spacing: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8), 0 0 6px rgba(0, 0, 0, 0.4);
  }

  /* Mobile responsiveness for CV, About, and smaller viewports */
  @media (max-width: 640px) {
    .watermark-container {
      bottom: 8px;
    }

    .watermark-container.bottom-right {
      right: 10px;
    }

    .watermark-container.bottom-left {
      left: 10px;
    }

    .watermark-content {
      max-width: 78vw;
      gap: 0px;
    }

    .watermark-title {
      font-size: 11px;
      line-height: 1.15;
    }

    .watermark-line {
      font-size: 9.5px;
      line-height: 1.15;
    }
  }

  @media (max-width: 400px) {
    .watermark-content {
      max-width: 72vw;
    }
    .watermark-title {
      font-size: 10px;
    }
    .watermark-line {
      font-size: 8.5px;
    }
  }

  @media print {
    .watermark-container {
      display: none !important;
    }
  }
</style>

<script>
  function initWatermark() {
    const watermark = document.getElementById('site-watermark');
    if (!watermark) return;

    const savedPos = localStorage.getItem('sitedotmoss_watermark_pos');
    if (savedPos === 'bottom-left' || savedPos === 'bottom-right') {
      watermark.classList.remove('bottom-left', 'bottom-right');
      watermark.classList.add(savedPos);
    }

    watermark.onclick = () => {
      const isRight = watermark.classList.contains('bottom-right');
      const newPos = isRight ? 'bottom-left' : 'bottom-right';
      watermark.classList.remove('bottom-left', 'bottom-right');
      watermark.classList.add(newPos);
      localStorage.setItem('sitedotmoss_watermark_pos', newPos);
    };
  }

  initWatermark();
  document.addEventListener('astro:after-swap', initWatermark);
</script>
