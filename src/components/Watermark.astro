---
interface Props {
  position?: 'bottom-left' | 'bottom-right';
  theme?: 'auto' | 'spotify' | 'nextwbc' | 'cv' | 'monolithic' | 'blog' | 'default';
}

const { position = 'bottom-right', theme = 'auto' } = Astro.props;

// Auto-detect page art direction if theme is 'auto'
const pathname = Astro.url.pathname;
let activeTheme = theme;
if (activeTheme === 'auto') {
  if (pathname.includes('spotify')) activeTheme = 'spotify';
  else if (pathname.includes('nextwbc')) activeTheme = 'nextwbc';
  else if (pathname.includes('cv')) activeTheme = 'cv';
  else if (pathname.includes('monolithic')) activeTheme = 'monolithic';
  else if (pathname.includes('blog')) activeTheme = 'blog';
  else activeTheme = 'default';
}
---

<!-- Import Haute Gothic Blackletter & High-Fashion Monochromatic Serif Fonts -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@300;400;600;700;800;900&family=Cinzel+Decorative:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600;1,700&display=swap');
</style>

<!-- Hidden image preloads for instant, zero-flicker sprite switching -->
<div class="gaga-preload" aria-hidden="true">
  <img src="/manifesto/transpbg/manifesto_open-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_close-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_left-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_right-Photoroom.png" alt="" />
</div>

<!-- Full-Screen Monochromatic Invert Strobe Flash Overlay (On enter & exit) -->
<div id="gaga-screen-flash" class="gaga-screen-flash-invert" aria-hidden="true"></div>

<!-- ==========================================================================
     SVG TURBULENCE DISPLACEMENT FILTERS (LOCALIZED RANDOM GLITCH & IDLE WARP)
     ========================================================================== -->
<svg class="gaga-svg-filter-def" aria-hidden="true">
  <defs>
    <!-- 1. Ambient Breathing Liquid Warp -->
    <filter id="gaga-idle-filter" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence
        id="gagaIdleTurbulence"
        type="fractalNoise"
        baseFrequency="0.012 0.016"
        numOctaves="2"
        result="noise"
        seed="1"
      />
      <feDisplacementMap
        id="gagaIdleDisp"
        in="SourceGraphic"
        in2="noise"
        scale="10"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>

    <!-- 2. Violent Localized Tear & Glitch Filter -->
    <filter id="gaga-tear-filter" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence
        id="gagaTearTurbulence"
        type="fractalNoise"
        baseFrequency="0.04 0.18"
        numOctaves="3"
        result="tearNoise"
        seed="5"
      />
      <feDisplacementMap
        id="gagaTearDisp"
        in="SourceGraphic"
        in2="tearNoise"
        scale="45"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>

<!-- ==========================================================================
     CORNER WATERMARK: PURE BORDERLESS DIFFUSE BLACK SMOKE & LOCALIZED DISTORTION
     ========================================================================== -->
<div
  id="site-watermark"
  class={`watermark-container ${position} theme-${activeTheme}`}
  data-position={position}
  data-theme={activeTheme}
  title="✠ Mother Monster Manifesto ✠"
  role="button"
  tabindex="0"
>
  <div class="gaga-avatar-anchor" id="gagaAvatarAnchor">
    <!-- Deepest Diffuse Pure Black Smoke Haze (No borders, feathered decay) -->
    <div class="gaga-corner-smoke" aria-hidden="true"></div>

    <div class="gaga-sprite-wrap" id="gagaSpriteWrap">
      <!-- Base Corner Image -->
      <img
        id="gagaSpriteImg"
        class="gaga-sprite-img base-sprite"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt="Mother Monster"
        draggable="false"
      />
      <!-- Localized Glitch Tear Overlay for Corner -->
      <img
        id="gagaCornerTear"
        class="gaga-sprite-img corner-tear-slice"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt=""
        aria-hidden="true"
        draggable="false"
      />
    </div>
  </div>
</div>

<!-- ==========================================================================
     HAUNTING GOTHIC MODAL: PURE BLACK DIFFUSE SMOKE & LOCALIZED RANDOM DISTORTION
     ========================================================================== -->
<div id="gaga-manifesto-modal" class={`gaga-dialogue-overlay theme-${activeTheme} is-hidden`} aria-hidden="true">
  <!-- Pitch Black Void Backdrop -->
  <div class="gaga-dark-backdrop" id="gagaModalBackdrop"></div>

  <!-- Soft Ghostly Cold Volumetric Spotlights (Pure Monochrome) -->
  <div class="gaga-ghost-spotlights" aria-hidden="true">
    <div class="spotlight-beam beam-left"></div>
    <div class="spotlight-beam beam-right"></div>
  </div>

  <!-- Subtle Film Grain / Ethereal Shadow Dust -->
  <div class="gaga-gothic-grain" aria-hidden="true"></div>

  <div class="gaga-dialogue-stage" id="gagaHeroStage">
    <!-- ── LEFT: Mother Monster with Localized Random Spot Distortion ── -->
    <div class="gaga-left-avatar-wrap" id="gagaHeroAvatarWrap">
      <!-- Pure Black Diffuse Smoke Cloud (100% Borderless, Seamless Decay) -->
      <div class="gaga-left-smoke-cloud" aria-hidden="true"></div>

      <!-- Multi-Layered Distortion Stage -->
      <div class="gaga-distort-container" id="gagaDistortContainer">
        <!-- 1. Base Face Layer (Smooth Breathing Liquid Warp) -->
        <img
          id="gagaHeroImg"
          class="gaga-left-hero-img gaga-hero-base"
          src="/manifesto/transpbg/manifesto_open-Photoroom.png"
          alt="Mother Monster"
          draggable="false"
        />

        <!-- 2. Localized Random Glitch Slice (Eyes, Mouth, Slices) -->
        <img
          id="gagaHeroSlice1"
          class="gaga-left-hero-img gaga-hero-slice slice-1"
          src="/manifesto/transpbg/manifesto_open-Photoroom.png"
          alt=""
          aria-hidden="true"
          draggable="false"
        />

        <!-- 3. Secondary Ghost Dislocation Slice -->
        <img
          id="gagaHeroSlice2"
          class="gaga-left-hero-img gaga-hero-slice slice-2"
          src="/manifesto/transpbg/manifesto_open-Photoroom.png"
          alt=""
          aria-hidden="true"
          draggable="false"
        />
      </div>
    </div>

    <!-- ── RIGHT: Borderless Pure Diffuse Spoken Script ── -->
    <div class="gaga-right-speech-wrap" id="gagaSpeechBox">
      <!-- Broad Diffuse Black Smoke Cloud (No box, no borders, no red) -->
      <div class="gaga-speech-smoke-cloud" aria-hidden="true"></div>

      <!-- Sacred Subtitle: Pure Monochrome -->
      <div class="gaga-manifesto-header">
        <span class="gaga-header-rune">✠</span>
        <span class="gaga-header-title">THE MANIFESTO OF MOTHER MONSTER</span>
        <span class="gaga-header-rune">✠</span>
      </div>

      <!-- Current Spoken Sentence (Haute Gothic Blackletter / Operatic Serif) -->
      <div class="gaga-active-sentence-box">
        <p class="gaga-spoken-sentence" id="gagaActiveSentenceText"></p>
        <span class="gaga-typewriter-cursor" id="gagaCursor">|</span>
      </div>

      <!-- Dialogue Stepper & Prompt -->
      <div class="gaga-speech-footer">
        <div class="gaga-sentence-stepper" id="gagaSentenceStepper">
          <span class="step-dot" data-step="0"></span>
          <span class="step-dot" data-step="1"></span>
          <span class="step-dot" data-step="2"></span>
          <span class="step-dot" data-step="3"></span>
          <span class="step-dot" data-step="4"></span>
        </div>
        <span class="gaga-tap-hint">click anywhere to proceed</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     HIDDEN SVG FILTER CONTAINER
     ========================================================================== */
  .gaga-svg-filter-def {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* Hidden Image Preloader */
  .gaga-preload {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* ==========================================================================
     MONOCHROMATIC FULLSCREEN INVERT FLASH (ON ENTER & EXIT)
     ========================================================================== */
  .gaga-screen-flash-invert {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1000000;
    background: #ffffff;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
    transform: translateZ(0);
  }

  .gaga-screen-flash-invert.is-flashing {
    visibility: visible;
    animation: gaga-invert-flash 0.22s steps(2, start) forwards;
  }

  @keyframes gaga-invert-flash {
    0% { opacity: 0; }
    15% { opacity: 0.95; }
    40% { opacity: 0.1; }
    70% { opacity: 0.85; }
    100% { opacity: 0; }
  }

  /* ==========================================================================
     CORNER WATERMARK: PURE BORDERLESS DIFFUSE BLACK SMOKE
     ========================================================================== */
  .watermark-container {
    position: fixed;
    bottom: 24px;
    z-index: 99999;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: auto;
    cursor: pointer;
    background: transparent;
    padding: 0;
    margin: 0;
    border: none;
    outline: none;
    transform: translateZ(0);
    contain: layout style;
  }

  .watermark-container.bottom-right {
    right: 26px;
    left: auto;
  }

  .watermark-container.bottom-left {
    left: 26px;
    right: auto;
  }

  .gaga-avatar-anchor {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.3s ease;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  /* Pure Deep Black Smoke Cloud (Zero red, ultra-feathered decay, 0 borders) */
  .gaga-corner-smoke {
    position: absolute;
    inset: -45px;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.94) 38%, rgba(0, 0, 0, 0.6) 65%, rgba(0, 0, 0, 0.12) 85%, transparent 100%);
    filter: blur(18px);
    pointer-events: none;
    opacity: 0.98;
    transform: translateZ(0);
    animation: gaga-smoke-breathe 5s ease-in-out infinite alternate;
  }

  .watermark-container:hover .gaga-corner-smoke {
    filter: blur(24px);
    transform: scale(1.2) translateZ(0);
  }

  /* Sinking plunge when clicked */
  .gaga-avatar-anchor.is-sinking {
    transform: translateY(90px) scale(0.55) translateZ(0) !important;
    opacity: 0 !important;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.55, 0.085, 0.68, 0.53), opacity 0.25s ease-in !important;
  }

  .gaga-sprite-wrap {
    position: relative;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: gaga-ghost-hover 4.5s ease-in-out infinite alternate;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: transparent;
    border: none;
    transform: translateZ(0);
    will-change: transform;
  }

  .watermark-container:hover .gaga-sprite-wrap {
    transform: scale(1.18) translateY(-4px) translateZ(0);
  }

  .gaga-sprite-img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    position: relative;
    z-index: 2;
    transform: translateZ(0);
  }

  .gaga-sprite-img.base-sprite {
    filter: url(#gaga-idle-filter) drop-shadow(0 10px 25px rgba(0, 0, 0, 1)) drop-shadow(0 0 16px rgba(0, 0, 0, 0.95));
  }

  .gaga-sprite-img.corner-tear-slice {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    filter: url(#gaga-tear-filter) contrast(140%) brightness(120%);
    transition: opacity 0.06s ease;
  }

  @keyframes gaga-ghost-hover {
    0% { transform: translateY(0) translateZ(0); }
    50% { transform: translateY(-7px) translateZ(0); }
    100% { transform: translateY(5px) translateZ(0); }
  }

  @keyframes gaga-smoke-breathe {
    0% { transform: scale(0.93) translateZ(0); opacity: 0.9; }
    100% { transform: scale(1.08) translateZ(0); opacity: 1; }
  }

  /* ==========================================================================
     HAUNTING GOTHIC MODAL: PURE BLACK DIFFUSE SMOKE & LOCALIZED DISTORTION
     ========================================================================== */
  .gaga-dialogue-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    opacity: 1;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
    transform: translateZ(0);
  }

  .gaga-dialogue-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Pitch Black Void Backdrop (No red anywhere) */
  .gaga-dark-backdrop {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: 0.96;
    cursor: pointer;
  }

  /* Cold Monochromatic Volumetric Spotlights Cutting Through the Dark */
  .gaga-ghost-spotlights {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .spotlight-beam {
    position: absolute;
    top: -20%;
    width: 240px;
    height: 130%;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.22;
    filter: blur(36px);
  }

  .spotlight-beam.beam-left {
    left: 12%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(200, 200, 200, 0.05) 40%, transparent 70%);
    transform: rotate(24deg);
    animation: gaga-spot-sway-left 8s ease-in-out infinite alternate;
  }

  .spotlight-beam.beam-right {
    right: 12%;
    background: linear-gradient(225deg, rgba(255, 255, 255, 0.25) 0%, rgba(200, 200, 200, 0.05) 40%, transparent 70%);
    transform: rotate(-24deg);
    animation: gaga-spot-sway-right 8s ease-in-out infinite alternate;
  }

  @keyframes gaga-spot-sway-left {
    0% { transform: rotate(20deg); opacity: 0.16; }
    100% { transform: rotate(28deg); opacity: 0.28; }
  }

  @keyframes gaga-spot-sway-right {
    0% { transform: rotate(-28deg); opacity: 0.16; }
    100% { transform: rotate(-20deg); opacity: 0.28; }
  }

  /* Dark Vignette Film Grain */
  .gaga-gothic-grain {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(0, 0, 0, 0.75) 100%);
    pointer-events: none;
    opacity: 0.7;
    z-index: 2;
  }

  /* ==========================================================================
     PHANTOM CLONES (MULTIPLE MOTHER MONSTERS APPEARING RANDOMLY IN THE DARK)
     ========================================================================== */
  .gaga-phantom-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  /* ── MAIN DIALOGUE STAGE ── */
  .gaga-dialogue-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 32px;
    max-width: 800px;
    width: 92vw;
    box-sizing: border-box;
    pointer-events: auto;
    transform: translateZ(0);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .gaga-dialogue-stage.is-reversed {
    flex-direction: row-reverse;
  }

  /* Supernatural Tremor on Arrival */
  .gaga-stage-tremor {
    animation: gaga-supernatural-tremor 0.38s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes gaga-supernatural-tremor {
    10%, 90% { transform: translate3d(-4px, -2px, 0) scale(1.015); }
    20%, 80% { transform: translate3d(5px, 3px, 0) scale(0.985); }
    30%, 50%, 70% { transform: translate3d(-5px, 2px, 0) scale(1.02); }
    40%, 60% { transform: translate3d(4px, -3px, 0) scale(0.98); }
  }

  /* ── LEFT: Mother Monster Localized Distortion Stage ── */
  .gaga-left-avatar-wrap {
    position: relative;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    will-change: transform, opacity;
    transform: scale(var(--gaga-scale, 0.88)) translateZ(0);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  /* Pure Black Diffuse Smoke Cloud (100% Borderless, Feathered Edge) */
  .gaga-left-smoke-cloud {
    position: absolute;
    inset: -75px;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.95) 35%, rgba(0, 0, 0, 0.68) 58%, rgba(0, 0, 0, 0.18) 80%, transparent 100%);
    filter: blur(34px);
    transform: translateZ(0);
    pointer-events: none;
    opacity: 0.98;
    animation: gaga-smoke-breathe 6s ease-in-out infinite alternate;
  }

  /* Multi-Layered Distortion Container */
  .gaga-distort-container {
    position: relative;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: gaga-supernatural-float 5s ease-in-out infinite alternate;
  }

  .gaga-left-hero-img {
    width: 150px;
    height: 150px;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    transform: translateZ(0);
  }

  /* 1. Base Layer: Idle Liquid Breathing Warp */
  .gaga-left-hero-img.gaga-hero-base {
    position: relative;
    z-index: 2;
    filter: 
      url(#gaga-idle-filter)
      drop-shadow(0 25px 50px rgba(0, 0, 0, 1))
      drop-shadow(0 0 35px rgba(0, 0, 0, 0.95));
    transition: filter 0.15s ease, transform 0.1s ease;
  }

  /* 2. Localized Random Glitch / Tear Slices */
  .gaga-left-hero-img.gaga-hero-slice {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    filter: url(#gaga-tear-filter) brightness(130%) contrast(150%);
    mix-blend-mode: screen;
    transition: opacity 0.05s ease, transform 0.05s ease;
  }

  .gaga-left-hero-img.gaga-hero-slice.slice-2 {
    z-index: 4;
    filter: url(#gaga-tear-filter) invert(85%) contrast(160%);
    mix-blend-mode: difference;
  }

  /* Pure Vertical Floating (Up and Down Only, No Left-Right Movement) */
  @keyframes gaga-supernatural-float {
    0% { transform: translateY(0) translateZ(0); }
    50% { transform: translateY(-12px) translateZ(0); }
    100% { transform: translateY(8px) translateZ(0); }
  }

  /* ── RIGHT: Borderless Diffuse Spoken Text ── */
  .gaga-dialogue-overlay:not(.is-hidden) .gaga-right-speech-wrap {
    animation: gaga-speech-pop 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .gaga-right-speech-wrap {
    position: relative;
    flex: 1;
    max-width: 580px;
    min-height: 155px;
    box-sizing: border-box;
    padding: 22px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    cursor: pointer;
    transform: translateZ(0);
  }

  /* Broad Diffuse Black Smoke Cloud behind text (No box, no borders, no red) */
  .gaga-speech-smoke-cloud {
    position: absolute;
    inset: -60px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.94) 42%, rgba(0, 0, 0, 0.65) 68%, rgba(0, 0, 0, 0.15) 88%, transparent 100%);
    filter: blur(34px);
    pointer-events: none;
    z-index: -1;
    transform: translateZ(0);
    opacity: 0.98;
  }

  @keyframes gaga-speech-pop {
    0% {
      opacity: 0;
      transform: translateY(14px) scale(0.97) translateZ(0);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1) translateZ(0);
    }
  }

  /* Header: Pure Monochromatic Title (Mayhem Ball words completely removed) */
  .gaga-manifesto-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.45);
    font-family: 'Cinzel Decorative', Georgia, serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    user-select: none;
    text-shadow: 0 0 15px rgba(0, 0, 0, 1);
  }

  .gaga-header-rune {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .gaga-active-sentence-box {
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  /* HAUTE GOTHIC BLACKLETTER TYPOGRAPHY (PURE MONOCHROMATIC BONE WHITE & BLACK) */
  .gaga-spoken-sentence {
    margin: 0;
    font-family: 'Grenze Gotisch', Georgia, serif;
    font-size: 2.45rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    letter-spacing: 0.7px;
    display: inline;
    text-shadow: 
      0 0 20px rgba(0, 0, 0, 1),
      0 0 40px rgba(0, 0, 0, 0.95),
      0 4px 18px rgba(0, 0, 0, 1);
  }

  .gaga-spoken-sentence.is-quote {
    font-family: 'Grenze Gotisch', 'Cormorant Garamond', serif;
    font-size: 2.7rem;
    font-weight: 800;
    letter-spacing: 0.9px;
    color: #ffffff;
    text-shadow: 
      0 0 25px rgba(255, 255, 255, 0.25),
      0 0 45px rgba(0, 0, 1),
      0 4px 20px rgba(0, 0, 0, 1);
  }

  .gaga-spoken-sentence.is-author {
    font-family: 'Cinzel Decorative', Georgia, serif;
    font-size: 1.55rem;
    font-weight: 700;
    color: #dfdfdf;
    letter-spacing: 3.2px;
    display: block;
    margin-top: 8px;
    text-shadow: 0 0 16px rgba(0, 0, 0, 1), 0 4px 12px rgba(0, 0, 0, 0.9);
  }

  .gaga-typewriter-cursor {
    display: inline-block;
    font-family: monospace;
    font-size: 1.85rem;
    color: #ffffff;
    margin-left: 5px;
    vertical-align: middle;
    animation: gaga-cursor-blink 0.65s infinite;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
  }

  @keyframes gaga-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Footer Stepper & Hint: Pure Monochrome */
  .gaga-speech-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    padding-top: 12px;
  }

  .gaga-sentence-stepper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .step-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .step-dot.is-active {
    background: #ffffff;
    box-shadow: 0 0 10px #ffffff, 0 0 20px rgba(255, 255, 255, 0.85);
    transform: scale(1.5);
  }

  .step-dot.is-done {
    background: rgba(255, 255, 255, 0.65);
  }

  .gaga-tap-hint {
    font-family: 'Grenze Gotisch', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 1px;
    animation: gaga-hint-pulse 3.5s ease-in-out infinite;
  }

  @keyframes gaga-hint-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.75; text-shadow: 0 0 10px rgba(255, 255, 255, 0.3); }
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (Mobile Stacking)
     ========================================================================== */
  @media (max-width: 768px) {
    .gaga-dialogue-stage {
      flex-direction: column;
      gap: 18px;
      text-align: center;
    }

    .spotlight-beam.beam-left {
      left: 0%;
      width: 150px;
    }

    .spotlight-beam.beam-right {
      right: 0%;
      width: 150px;
    }

    .gaga-left-avatar-wrap {
      width: 125px;
      height: 125px;
    }

    .gaga-distort-container,
    .gaga-left-hero-img {
      width: 118px;
      height: 118px;
    }

    .gaga-right-speech-wrap {
      text-align: center;
      padding: 14px;
      min-height: 120px;
    }

    .gaga-spoken-sentence {
      font-size: 1.85rem;
    }

    .gaga-spoken-sentence.is-quote {
      font-size: 2.05rem;
    }

    .gaga-spoken-sentence.is-author {
      font-size: 1.35rem;
    }

    .gaga-speech-footer {
      justify-content: center;
      flex-direction: column;
      gap: 12px;
    }

    .gaga-manifesto-header {
      justify-content: center;
    }
  }
</style>

<script>
  /**
   * Mother Monster Manifesto Controller with RANDOM LOCALIZED SPOT DISTORTION
   * Pure monochromatic black smoke, zero red, zero sound, eerie psychological horror glitch.
   */
  class GagaManifestoController {
    private spriteImg: HTMLImageElement | null = null;
    private cornerTearEl: HTMLImageElement | null = null;
    private heroImg: HTMLImageElement | null = null;
    private heroSlice1: HTMLImageElement | null = null;
    private heroSlice2: HTMLImageElement | null = null;
    private heroAvatarWrap: HTMLElement | null = null;
    private anchor: HTMLElement | null = null;
    private modal: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private speechBox: HTMLElement | null = null;
    private screenFlashEl: HTMLElement | null = null;

    private idleTurbulence: SVGFETurbulenceElement | null = null;
    private idleDisp: SVGFEDisplacementMapElement | null = null;
    private tearTurbulence: SVGFETurbulenceElement | null = null;
    private tearDisp: SVGFEDisplacementMapElement | null = null;

    private activeSentenceEl: HTMLElement | null = null;
    private cursorEl: HTMLElement | null = null;
    private stepDots: NodeListOf<HTMLElement> | null = null;

    private isShowcasing = false;
    private blinkTimer: number | null = null;
    private glanceTimer: number | null = null;
    private randomTwitchTimer: number | null = null;

    // Random Position Per Sentence State
    private currentShiftX = 0;
    private currentShiftY = 0;
    private isCurrentReversed = false;
    private sentenceTransitionTimeout: number | null = null;

    // Distortion Loop
    private idleAnimId: number | null = null;
    private idlePhase = 0;

    // Localized Clip-Path Zones for Random Spot Distortion
    private readonly SPOT_ZONES = [
      // Zone 0: Eyes only
      { name: 'eyes', clip: 'inset(26% 0% 48% 0%)', maxScale: 55 },
      // Zone 1: Mouth & Jaw melting
      { name: 'mouth', clip: 'inset(54% 0% 12% 0%)', maxScale: 50 },
      // Zone 2: Right half face drag
      { name: 'right-half', clip: 'inset(0% 0% 0% 48%)', maxScale: 45 },
      // Zone 3: Left half face drag
      { name: 'left-half', clip: 'inset(0% 48% 0% 0%)', maxScale: 45 },
      // Zone 4: Thin horizontal slit tear across eyes
      { name: 'slit-eyes', clip: 'inset(34% 0% 56% 0%)', maxScale: 65 },
      // Zone 5: Thin horizontal slit tear across mouth
      { name: 'slit-mouth', clip: 'inset(60% 0% 28% 0%)', maxScale: 60 },
      // Zone 6: Diagonal slash
      { name: 'diagonal', clip: 'polygon(0 15%, 100% 35%, 100% 65%, 0 45%)', maxScale: 50 },
      // Zone 7: Temple & forehead warp
      { name: 'forehead', clip: 'inset(8% 0% 65% 0%)', maxScale: 55 },
    ];

    // Sacred Gothic Manifesto Dialogue Sequence (Atmospheric, deliberate pacing)
    private readonly MANIFESTO_SENTENCES = [
      {
        text: 'This is The Manifesto of Mother Monster.',
        isQuote: false,
        isAuthor: false,
        duration: 4400,
      },
      {
        text: '“Computers are only as creative as the humans who program them.”',
        isQuote: true,
        isAuthor: false,
        duration: 5000,
      },
      {
        text: '— John Maeda',
        isQuote: false,
        isAuthor: true,
        duration: 2800,
      },
      {
        text: 'No synthetic illusions — only living algorithms sculpted in dark mathematical light.',
        isQuote: false,
        isAuthor: false,
        duration: 5400,
      },
      {
        text: 'Every pixel is mathematically rendered, fiercely human-directed. Born in code.',
        isQuote: false,
        isAuthor: false,
        duration: 5200,
      },
    ];

    private currentSentenceIdx = 0;
    private typingTimeout: number | null = null;
    private nextSentenceTimeout: number | null = null;

    private readonly SPRITES = {
      open: '/manifesto/transpbg/manifesto_open-Photoroom.png',
      close: '/manifesto/transpbg/manifesto_close-Photoroom.png',
      left: '/manifesto/transpbg/manifesto_left-Photoroom.png',
      right: '/manifesto/transpbg/manifesto_right-Photoroom.png',
    };

    init(): void {
      this.spriteImg = document.getElementById('gagaSpriteImg') as HTMLImageElement;
      this.cornerTearEl = document.getElementById('gagaCornerTear') as HTMLImageElement;
      this.heroImg = document.getElementById('gagaHeroImg') as HTMLImageElement;
      this.heroSlice1 = document.getElementById('gagaHeroSlice1') as HTMLImageElement;
      this.heroSlice2 = document.getElementById('gagaHeroSlice2') as HTMLImageElement;

      this.heroAvatarWrap = document.getElementById('gagaHeroAvatarWrap');
      this.anchor = document.getElementById('gagaAvatarAnchor');
      this.modal = document.getElementById('gaga-manifesto-modal');
      this.backdrop = document.getElementById('gagaModalBackdrop');
      this.speechBox = document.getElementById('gagaSpeechBox');
      this.screenFlashEl = document.getElementById('gaga-screen-flash');

      this.idleTurbulence = document.getElementById('gagaIdleTurbulence') as unknown as SVGFETurbulenceElement;
      this.idleDisp = document.getElementById('gagaIdleDisp') as unknown as SVGFEDisplacementMapElement;
      this.tearTurbulence = document.getElementById('gagaTearTurbulence') as unknown as SVGFETurbulenceElement;
      this.tearDisp = document.getElementById('gagaTearDisp') as unknown as SVGFEDisplacementMapElement;

      this.activeSentenceEl = document.getElementById('gagaActiveSentenceText');
      this.cursorEl = document.getElementById('gagaCursor');
      this.stepDots = document.querySelectorAll('.step-dot');

      if (!this.spriteImg || !this.anchor || !this.modal) return;

      this.startIdleLoop();
      this.bindEvents();
      this.startRoutines();
      this.startRandomTwitchRoutine();
    }

    // ── Continuous Subtle Breathing Warp Loop ──────────────────

    private startIdleLoop(): void {
      if (this.idleAnimId) return;

      const loop = () => {
        this.idlePhase += 0.02;

        if (this.idleTurbulence && this.idleDisp) {
          const freqX = 0.012 + Math.sin(this.idlePhase * 0.7) * 0.003;
          const freqY = 0.016 + Math.cos(this.idlePhase * 0.9) * 0.004;
          const scale = 10 + Math.sin(this.idlePhase * 1.2) * 3;

          this.idleTurbulence.setAttribute('baseFrequency', `${freqX.toFixed(4)} ${freqY.toFixed(4)}`);
          this.idleDisp.setAttribute('scale', scale.toFixed(1));
        }

        this.idleAnimId = requestAnimationFrame(loop);
      };

      this.idleAnimId = requestAnimationFrame(loop);
    }

    // ── RANDOM LOCALIZED SPOT DISTORTION ENGINE ──────────────────

    /**
     * Triggers a sudden, eerie localized distortion on a specific random part of the face
     */
    private triggerRandomSpotTwitch(forceDouble = false): void {
      // Pick 1 or 2 random zones
      const zoneIdx1 = Math.floor(Math.random() * this.SPOT_ZONES.length);
      const zone1 = this.SPOT_ZONES[zoneIdx1];

      // Random displacement parameters
      const shiftX1 = (Math.random() - 0.5) * 28;
      const shiftY1 = (Math.random() - 0.5) * 14;
      const skewX1 = (Math.random() - 0.5) * 24;
      const scaleY1 = 1 + (Math.random() - 0.5) * 0.45;

      // Update tear filter with random seed
      if (this.tearTurbulence && this.tearDisp) {
        this.tearTurbulence.setAttribute('seed', String(Math.floor(Math.random() * 999)));
        this.tearDisp.setAttribute('scale', String(Math.floor(Math.random() * 30 + 35)));
      }

      // Apply to Slice 1
      if (this.heroSlice1) {
        this.heroSlice1.style.clipPath = zone1.clip;
        this.heroSlice1.style.transform = `translate3d(${shiftX1.toFixed(1)}px, ${shiftY1.toFixed(1)}px, 0) skewX(${skewX1.toFixed(1)}deg) scaleY(${scaleY1.toFixed(2)})`;
        this.heroSlice1.style.opacity = '1';
      }

      // Also trigger on corner tear if not in modal
      if (!this.isShowcasing && this.cornerTearEl) {
        this.cornerTearEl.style.clipPath = zone1.clip;
        this.cornerTearEl.style.transform = `translate3d(${shiftX1.toFixed(1)}px, ${shiftY1.toFixed(1)}px, 0) skewX(${skewX1.toFixed(1)}deg)`;
        this.cornerTearEl.style.opacity = '1';
      }

      // Base layer gets a micro-shudder
      if (this.heroImg) {
        const baseJerkX = (Math.random() - 0.5) * 6;
        this.heroImg.style.transform = `translate3d(${baseJerkX.toFixed(1)}px, 0, 0)`;
      }

      // Optional secondary disjoint tear
      if (forceDouble || Math.random() < 0.35) {
        const zoneIdx2 = (zoneIdx1 + Math.floor(Math.random() * (this.SPOT_ZONES.length - 1)) + 1) % this.SPOT_ZONES.length;
        const zone2 = this.SPOT_ZONES[zoneIdx2];
        const shiftX2 = (Math.random() - 0.5) * 32;
        const skewX2 = (Math.random() - 0.5) * 28;

        if (this.heroSlice2) {
          this.heroSlice2.style.clipPath = zone2.clip;
          this.heroSlice2.style.transform = `translate3d(${shiftX2.toFixed(1)}px, 0, 0) skewX(${skewX2.toFixed(1)}deg)`;
          this.heroSlice2.style.opacity = '0.9';
        }
      }

      // Reset after a brief, shocking duration (80ms - 190ms)
      const duration = Math.random() * 110 + 80;
      setTimeout(() => {
        if (this.heroSlice1) {
          this.heroSlice1.style.opacity = '0';
          this.heroSlice1.style.transform = 'none';
        }
        if (this.heroSlice2) {
          this.heroSlice2.style.opacity = '0';
          this.heroSlice2.style.transform = 'none';
        }
        if (this.cornerTearEl) {
          this.cornerTearEl.style.opacity = '0';
          this.cornerTearEl.style.transform = 'none';
        }
        if (this.heroImg) {
          this.heroImg.style.transform = 'none';
        }
      }, duration);
    }

    private startRandomTwitchRoutine(): void {
      // Unpredictable twitch intervals (every 0.9s - 2.8s)
      const scheduleNext = () => {
        const delay = Math.random() * 1900 + 900;
        this.randomTwitchTimer = window.setTimeout(() => {
          this.triggerRandomSpotTwitch();
          scheduleNext();
        }, delay);
      };

      scheduleNext();
    }

    private bindEvents(): void {
      const watermark = document.getElementById('site-watermark');
      if (watermark) {
        watermark.addEventListener('mouseenter', () => {
          this.triggerRandomSpotTwitch(true);
        });

        watermark.addEventListener('click', (e) => {
          e.stopPropagation();
          this.triggerRandomSpotTwitch(true);
          this.triggerManifestoSequence();
        });
      }

      if (this.backdrop) {
        this.backdrop.addEventListener('click', () => this.dismissShowcase());
      }

      if (this.speechBox) {
        this.speechBox.addEventListener('click', (e) => {
          e.stopPropagation();
          this.advanceSentence();
        });
      }

      window.addEventListener('keydown', (e) => {
        if (this.isShowcasing) {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault();
            this.advanceSentence();
          } else if (e.code === 'Escape') {
            this.dismissShowcase();
          }
        }
      });

      // Restore position preference
      const savedPos = localStorage.getItem('sitedotmoss_watermark_pos');
      if (watermark && (savedPos === 'bottom-left' || savedPos === 'bottom-right')) {
        watermark.classList.remove('bottom-left', 'bottom-right');
        watermark.classList.add(savedPos);
      }
    }

    private triggerScreenFlash(): void {
      if (!this.screenFlashEl) return;
      this.screenFlashEl.classList.remove('is-flashing');
      void this.screenFlashEl.offsetWidth;
      this.screenFlashEl.classList.add('is-flashing');
      setTimeout(() => {
        if (this.screenFlashEl) this.screenFlashEl.classList.remove('is-flashing');
      }, 250);
    }

    private setSprite(state: 'open' | 'close' | 'left' | 'right'): void {
      const src = this.SPRITES[state];
      if (this.spriteImg && this.spriteImg.src !== src) this.spriteImg.src = src;
      if (this.cornerTearEl && this.cornerTearEl.src !== src) this.cornerTearEl.src = src;
      if (this.heroImg && this.heroImg.src !== src) this.heroImg.src = src;
      if (this.heroSlice1 && this.heroSlice1.src !== src) this.heroSlice1.src = src;
      if (this.heroSlice2 && this.heroSlice2.src !== src) this.heroSlice2.src = src;
    }

    private startRoutines(): void {
      this.scheduleBlink();
      this.scheduleGlance();
    }

    private scheduleBlink(): void {
      const delay = Math.random() * 3200 + 2600;
      this.blinkTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          this.setSprite('close');
          this.triggerRandomSpotTwitch();
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
              if (Math.random() < 0.25) {
                setTimeout(() => {
                  this.setSprite('close');
                  setTimeout(() => this.setSprite('open'), 100);
                }, 140);
              }
            }
          }, 120);
        }
        this.scheduleBlink();
      }, delay);
    }

    private scheduleGlance(): void {
      const delay = Math.random() * 4200 + 3800;
      this.glanceTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          const dir = Math.random() < 0.5 ? 'left' : 'right';
          this.setSprite(dir);
          this.triggerRandomSpotTwitch();

          const holdTime = Math.random() * 950 + 750;
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
            }
          }, holdTime);
        }
        this.scheduleGlance();
      }, delay);
    }

    private triggerManifestoSequence(): void {
      if (this.isShowcasing || !this.anchor || !this.modal) return;
      this.isShowcasing = true;

      // 1. Monochromatic Screen Invert Flash
      this.triggerScreenFlash();

      // 2. Corner sprite plunges smoothly into darkness
      this.anchor.classList.add('is-sinking');
      this.setSprite('open');

      setTimeout(() => {
        if (!this.modal || !this.heroAvatarWrap) return;
        this.modal.classList.remove('is-hidden');

        // Stage tremor
        const stage = document.getElementById('gagaHeroStage');
        if (stage) {
          stage.classList.remove('gaga-stage-tremor');
          void stage.offsetWidth;
          stage.classList.add('gaga-stage-tremor');
        }

        // Violent double twitch on arrival
        this.triggerRandomSpotTwitch(true);

        // Variable size scale for initial presence (smaller, eerie)
        this.heroAvatarWrap.style.setProperty('--gaga-scale', '0.86');

        // Slow, menacing vertical rise up from deep in the black void (1600ms)
        this.heroAvatarWrap.animate([
          {
            transform: 'translate3d(0, 50px, 0) scale(0.55)',
            opacity: 0,
            filter: 'blur(10px) drop-shadow(0 0 45px rgba(0, 0, 0, 1))',
          },
          {
            transform: 'translate3d(0, -6px, 0) scale(0.92)',
            opacity: 0.9,
            filter: 'blur(2px) drop-shadow(0 15px 35px rgba(0, 0, 0, 1))',
            offset: 0.75,
          },
          {
            transform: 'translate3d(0, 0, 0) scale(0.86)',
            opacity: 1,
            filter: 'blur(0px) drop-shadow(0 20px 40px rgba(0, 0, 0, 1))',
          }
        ], {
          duration: 1600,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'none',
        });

        // Begin dialogue stream with first sentence
        this.currentSentenceIdx = 0;
        setTimeout(() => {
          if (this.isShowcasing) {
            this.speakSentence(0);
          }
        }, 1200);
      }, 200);
    }

    private speakSentence(idx: number): void {
      if (idx >= this.MANIFESTO_SENTENCES.length) {
        setTimeout(() => this.dismissShowcase(), 1200);
        return;
      }

      this.currentSentenceIdx = idx;
      const sentenceObj = this.MANIFESTO_SENTENCES[idx];
      const stage = document.getElementById('gagaHeroStage');

      // Diverse, unequal sizing per sentence (artistic phantom depth, smaller overall)
      const SENTENCE_SCALES = [0.86, 0.72, 0.64, 0.96, 0.76];
      const randomJitter = (Math.random() * 0.1 - 0.05);
      const chosenScale = Math.max(0.56, Math.min(1.05, SENTENCE_SCALES[idx % SENTENCE_SCALES.length] + randomJitter)).toFixed(2);

      // Update progress dots
      this.stepDots?.forEach((dot, dIdx) => {
        dot.classList.remove('is-active', 'is-done');
        if (dIdx < idx) dot.classList.add('is-done');
        else if (dIdx === idx) dot.classList.add('is-active');
      });

      // Clear previous sentence completely
      if (this.activeSentenceEl) {
        this.activeSentenceEl.innerText = '';
        this.activeSentenceEl.className = 'gaga-spoken-sentence';
        if (sentenceObj.isQuote) this.activeSentenceEl.classList.add('is-quote');
        if (sentenceObj.isAuthor) this.activeSentenceEl.classList.add('is-author');
      }

      const executeSpokenStream = () => {
        // Look towards text based on layout
        this.setSprite(this.isCurrentReversed ? 'left' : 'right');

        // Atmospheric Typewriter streaming with dramatic punctuation pauses
        const text = sentenceObj.text;
        let charIdx = 0;
        if (this.typingTimeout) clearTimeout(this.typingTimeout);

        const baseDelay = sentenceObj.isAuthor ? 36 : 46;

        const typeNextChar = () => {
          if (!this.activeSentenceEl) return;
          charIdx++;
          this.activeSentenceEl.innerText = text.slice(0, charIdx);

          // Occasional supernatural localized twitch while speaking
          if (Math.random() < 0.04) {
            this.setSprite('close');
            this.triggerRandomSpotTwitch();
            setTimeout(() => {
              if (this.isShowcasing) this.setSprite(this.isCurrentReversed ? 'left' : 'right');
            }, 110);
          }

          if (charIdx < text.length) {
            const currentChar = text[charIdx - 1];
            let extraPause = 0;

            // Dramatic pauses on punctuation
            if (currentChar === '—') extraPause = 360;
            else if (currentChar === ',' || currentChar === ';') extraPause = 240;
            else if (currentChar === '.' || currentChar === '”') extraPause = 300;

            this.typingTimeout = window.setTimeout(typeNextChar, baseDelay + extraPause);
          } else {
            this.typingTimeout = null;

            // Finished typing sentence: schedule next sentence auto-advance
            this.nextSentenceTimeout = window.setTimeout(() => {
              this.advanceSentence();
            }, sentenceObj.duration);
          }
        };

        this.typingTimeout = window.setTimeout(typeNextChar, 180);
      };

      if (idx > 0 && stage) {
        // Fade out previous Mother Monster into the black smoke (sink vertically down)
        stage.style.opacity = '0';
        stage.style.transform = `translate3d(${this.currentShiftX}px, ${this.currentShiftY + 30}px, 0)`;

        if (this.sentenceTransitionTimeout) clearTimeout(this.sentenceTransitionTimeout);
        this.sentenceTransitionTimeout = window.setTimeout(() => {
          if (!this.isShowcasing) return;

          // Compute WIDE QUADRANT POSITION across the entire viewport
          const isMobile = window.innerWidth <= 768;
          let nextShiftX = 0;
          let nextShiftY = 0;
          let isReversed = false;

          if (!isMobile) {
            const W = window.innerWidth;
            const H = window.innerHeight;

            // Safe maximum travel bounds: keep stage well within viewport with comfortable margin
            const maxShiftX = Math.max(80, Math.floor((W - 780) / 2 - 40));
            const maxShiftY = Math.max(50, Math.floor((H - 240) / 2 - 40));

            // Organic jitter (±25px)
            const jX = Math.floor((Math.random() - 0.5) * 50);
            const jY = Math.floor((Math.random() - 0.5) * 35);

            // Broadly distributed quadrants across the screen:
            // Sentence 1: Top-Left quadrant (high from the left shadows)
            // Sentence 2: Bottom-Right quadrant (low in the right shadows)
            // Sentence 3: Top-Right quadrant (high from the right shadows)
            // Sentence 4: Bottom-Left quadrant (low in the left shadows)
            switch (idx % 5) {
              case 1:
                nextShiftX = Math.floor(-0.76 * maxShiftX) + jX;
                nextShiftY = Math.floor(-0.72 * maxShiftY) + jY;
                isReversed = false;
                break;
              case 2:
                nextShiftX = Math.floor(0.76 * maxShiftX) + jX;
                nextShiftY = Math.floor(0.70 * maxShiftY) + jY;
                isReversed = true;
                break;
              case 3:
                nextShiftX = Math.floor(0.72 * maxShiftX) + jX;
                nextShiftY = Math.floor(-0.70 * maxShiftY) + jY;
                isReversed = true;
                break;
              case 4:
                nextShiftX = Math.floor(-0.72 * maxShiftX) + jX;
                nextShiftY = Math.floor(0.72 * maxShiftY) + jY;
                isReversed = false;
                break;
              default:
                nextShiftX = 0;
                nextShiftY = -15 + jY * 0.3;
                isReversed = false;
                break;
            }
          } else {
            // Mobile layout: vertical shifts across top, mid, and bottom
            const H = window.innerHeight;
            const maxShiftY = Math.max(30, Math.floor((H - 340) / 2 - 30));
            const jY = Math.floor((Math.random() - 0.5) * 20);

            nextShiftX = 0;
            isReversed = false;
            switch (idx % 5) {
              case 1:
                nextShiftY = Math.floor(-0.75 * maxShiftY) + jY;
                break;
              case 2:
                nextShiftY = Math.floor(0.75 * maxShiftY) + jY;
                break;
              case 3:
                nextShiftY = Math.floor(-0.50 * maxShiftY) + jY;
                break;
              case 4:
                nextShiftY = Math.floor(0.50 * maxShiftY) + jY;
                break;
              default:
                nextShiftY = 0;
                break;
            }
          }

          this.currentShiftX = nextShiftX;
          this.currentShiftY = nextShiftY;
          this.isCurrentReversed = isReversed;

          stage.classList.toggle('is-reversed', this.isCurrentReversed);

          // Update variable scale for this sentence's Mother Monster
          if (this.heroAvatarWrap) {
            this.heroAvatarWrap.style.setProperty('--gaga-scale', chosenScale);
          }

          // Teleport instantaneously while invisible: set position slightly lower for vertical rise
          stage.style.transition = 'none';
          stage.style.transform = `translate3d(${this.currentShiftX}px, ${this.currentShiftY + 35}px, 0)`;
          void stage.offsetWidth; // force reflow

          // Restore smooth vertical rise transition (strictly vertical translateY, no left/right slide)
          stage.style.transition = 'opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
          stage.style.transform = `translate3d(${this.currentShiftX}px, ${this.currentShiftY}px, 0)`;
          stage.style.opacity = '1';

          // Violent localized spot twitch on arrival at new position
          this.triggerRandomSpotTwitch(true);

          executeSpokenStream();
        }, 360);
      } else {
        // Initial sentence 0 (Center Altar)
        this.currentShiftX = 0;
        this.currentShiftY = -15;
        this.isCurrentReversed = false;
        if (stage) {
          stage.classList.remove('is-reversed');
          stage.style.transform = 'translate3d(0, -15px, 0)';
          stage.style.opacity = '1';
        }
        if (this.heroAvatarWrap) {
          this.heroAvatarWrap.style.setProperty('--gaga-scale', chosenScale);
        }
        executeSpokenStream();
      }
    }

    private advanceSentence(): void {
      if (!this.isShowcasing) return;
      if (this.typingTimeout) {
        // If user clicks while still typing, instantly reveal full sentence
        clearTimeout(this.typingTimeout);
        this.typingTimeout = null;
        const sentenceObj = this.MANIFESTO_SENTENCES[this.currentSentenceIdx];
        if (this.activeSentenceEl) this.activeSentenceEl.innerText = sentenceObj.text;
        return;
      }

      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);
      this.speakSentence(this.currentSentenceIdx + 1);
    }

    private dismissShowcase(): void {
      if (!this.isShowcasing || !this.modal || !this.anchor) return;
      if (this.typingTimeout) clearTimeout(this.typingTimeout);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);
      if (this.sentenceTransitionTimeout) clearTimeout(this.sentenceTransitionTimeout);

      this.triggerScreenFlash();
      this.triggerRandomSpotTwitch(true);

      const stage = document.getElementById('gagaHeroStage');
      if (stage) {
        stage.style.opacity = '0';
        stage.style.transform = `translate3d(${this.currentShiftX}px, ${this.currentShiftY + 45}px, 0)`;
      }

      setTimeout(() => {
        if (!this.modal || !this.anchor) return;
        this.modal.classList.add('is-hidden');
        this.anchor.classList.remove('is-sinking');
        this.anchor.style.transform = 'translate3d(0, 0, 0)';
        this.setSprite('open');
        this.isShowcasing = false;
        if (stage) {
          stage.style.transform = 'none';
          stage.classList.remove('is-reversed');
        }
        if (this.heroAvatarWrap) {
          this.heroAvatarWrap.style.removeProperty('--gaga-scale');
        }
      }, 350);
    }

    destroy(): void {
      if (this.blinkTimer) clearTimeout(this.blinkTimer);
      if (this.glanceTimer) clearTimeout(this.glanceTimer);
      if (this.randomTwitchTimer) clearTimeout(this.randomTwitchTimer);
      if (this.typingTimeout) clearTimeout(this.typingTimeout);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);
      if (this.sentenceTransitionTimeout) clearTimeout(this.sentenceTransitionTimeout);
      if (this.idleAnimId) {
        cancelAnimationFrame(this.idleAnimId);
        this.idleAnimId = null;
      }
    }
  }

  let controller: GagaManifestoController | null = null;

  function initGagaWatermark() {
    if (controller) controller.destroy();
    controller = new GagaManifestoController();
    controller.init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGagaWatermark);
  } else {
    initGagaWatermark();
  }

  document.addEventListener('astro:after-swap', initGagaWatermark);
</script>
