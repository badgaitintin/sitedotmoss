---
interface Props {
  position?: 'bottom-left' | 'bottom-right';
  theme?: 'auto' | 'spotify' | 'nextwbc' | 'cv' | 'monolithic' | 'blog' | 'default';
}

const { position = 'bottom-right', theme = 'auto' } = Astro.props;

// Auto-detect page art direction if theme is 'auto'
const pathname = Astro.url.pathname;
let activeTheme = theme;
if (activeTheme === 'auto') {
  if (pathname.includes('spotify')) activeTheme = 'spotify';
  else if (pathname.includes('nextwbc')) activeTheme = 'nextwbc';
  else if (pathname.includes('cv')) activeTheme = 'cv';
  else if (pathname.includes('monolithic')) activeTheme = 'monolithic';
  else if (pathname.includes('blog')) activeTheme = 'blog';
  else activeTheme = 'default';
}
---

<!-- Import Antique Old Style Italic Fonts (Cormorant Garamond + Playfair Display) -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Playfair+Display:ital,wght@1,600;1,700&display=swap');
</style>

<!-- Hidden image preloads for instant, zero-flicker sprite switching -->
<div class="gaga-preload" aria-hidden="true">
  <img src="/manifesto/transpbg/manifesto_open-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_close-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_left-Photoroom.png" alt="" />
  <img src="/manifesto/transpbg/manifesto_right-Photoroom.png" alt="" />
</div>

<!-- SVG Displacement Warp Filters for Real Localized Spot Bulge & Pinch Distortion -->
<svg class="gaga-svg-filters" aria-hidden="true">
  <defs>
    <!-- Corner Sprite Localized Bulge Filter (68x68 space) -->
    <filter id="gaga-corner-bulge-filter" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence
        id="gagaTurbulenceCorner"
        type="fractalNoise"
        baseFrequency="0.055 0.055"
        numOctaves="2"
        seed="3"
        result="rawNoise"
      />
      <feDiffuseLighting in="rawNoise" surfaceScale="2" diffuseConstant="1.2" result="litNoise">
        <fePointLight id="gagaLightCorner" x="34" y="32" z="16" />
      </feDiffuseLighting>
      <feDisplacementMap
        id="gagaDisplaceCorner"
        in="SourceGraphic"
        in2="litNoise"
        scale="0"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>

    <!-- Modal Hero Avatar Localized Bulge Filter (180x180 space) -->
    <filter id="gaga-hero-bulge-filter" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence
        id="gagaTurbulenceHero"
        type="fractalNoise"
        baseFrequency="0.04 0.04"
        numOctaves="2"
        seed="7"
        result="rawHeroNoise"
      />
      <feDiffuseLighting in="rawHeroNoise" surfaceScale="2.5" diffuseConstant="1.2" result="litHeroNoise">
        <fePointLight id="gagaLightHero" x="90" y="80" z="30" />
      </feDiffuseLighting>
      <feDisplacementMap
        id="gagaDisplaceHero"
        in="SourceGraphic"
        in2="litHeroNoise"
        scale="0"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>

<!-- Full-Screen Temporary Color Invert Flash Overlay (On enter & exit) -->
<div id="gaga-screen-flash" class="gaga-screen-flash-invert" aria-hidden="true"></div>

<!-- Borderless Dark Smoky Watermark Sprite in Corner with Calm Float & Slow Creeping Bulge Distortion -->
<div
  id="site-watermark"
  class={`watermark-container ${position} theme-${activeTheme}`}
  data-position={position}
  data-theme={activeTheme}
  title="Click to speak"
  role="button"
  tabindex="0"
>
  <div class="gaga-avatar-anchor" id="gagaAvatarAnchor">
    <!-- Diffuse Smoky Black Shadow (No hard borders) -->
    <div class="gaga-smoky-shadow" aria-hidden="true"></div>

    <div class="gaga-sprite-wrap" id="gagaSpriteWrap">
      <img
        id="gagaSpriteImg"
        class="gaga-sprite-img"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt="Lady Gaga"
        draggable="false"
      />
    </div>
  </div>
</div>

<!-- Floating Dialogue Modal: Avatar Left, Text Right, Borderless, Smoky Background -->
<div id="gaga-manifesto-modal" class={`gaga-dialogue-overlay theme-${activeTheme} is-hidden`} aria-hidden="true">
  <!-- Soft transparent backdrop, keeps website visible -->
  <div class="gaga-transparent-backdrop" id="gagaModalBackdrop"></div>
  
  <!-- Subtle Vintage Film Grain Layer -->
  <div class="gaga-vintage-grain-overlay" aria-hidden="true"></div>

  <div class="gaga-dialogue-stage" id="gagaHeroStage">
    <!-- LEFT: Big Lady Gaga Head with Calm Float & Slow Creeping Bulge Warp -->
    <div class="gaga-left-avatar-wrap" id="gagaHeroAvatarWrap">
      <div class="gaga-left-diffuse-aura" aria-hidden="true"></div>
      <img
        id="gagaHeroImg"
        class="gaga-left-hero-img"
        src="/manifesto/transpbg/manifesto_open-Photoroom.png"
        alt="Lady Gaga"
        draggable="false"
      />
    </div>

    <!-- RIGHT: Spoken Text in Old Style Italic (Only Current Sentence, No History) -->
    <div class="gaga-right-speech-wrap" id="gagaSpeechBox">
      <!-- Diffuse Dark Smoke Cloud (No borders) -->
      <div class="gaga-speech-smoke" aria-hidden="true"></div>

      <!-- Current Sentence Only -->
      <div class="gaga-active-sentence-box">
        <p class="gaga-spoken-sentence" id="gagaActiveSentenceText"></p>
        <span class="gaga-typewriter-cursor" id="gagaCursor">|</span>
      </div>

      <!-- Dialogue Stepper & Prompt -->
      <div class="gaga-speech-footer">
        <div class="gaga-sentence-stepper" id="gagaSentenceStepper">
          <span class="step-dot" data-step="0"></span>
          <span class="step-dot" data-step="1"></span>
          <span class="step-dot" data-step="2"></span>
          <span class="step-dot" data-step="3"></span>
        </div>
        <span class="gaga-tap-hint">click to advance</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     HIDDEN PRELOAD & SVG FILTER CONTAINER
     ========================================================================== */
  .gaga-preload,
  .gaga-svg-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* ==========================================================================
     FULLSCREEN COLOR INVERT FLASH STROBE (ON ENTER & EXIT ONLY)
     ========================================================================== */
  .gaga-screen-flash-invert {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1000000;
    background: #ffffff;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
  }

  .gaga-screen-flash-invert.is-flashing {
    visibility: visible;
    animation: gaga-invert-strobe 0.28s steps(2, start) forwards;
  }

  @keyframes gaga-invert-strobe {
    0% { opacity: 0; }
    10% { opacity: 1; }
    22% { opacity: 0.15; }
    38% { opacity: 0.95; }
    55% { opacity: 0.1; }
    72% { opacity: 1; }
    88% { opacity: 0.3; }
    100% { opacity: 0; }
  }

  /* ==========================================================================
     BORDERLESS CORNER WATERMARK (CALM FLOAT & SLOW CREEPING BULGE)
     ========================================================================== */
  .watermark-container {
    position: fixed;
    bottom: 20px;
    z-index: 99999;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: auto;
    cursor: pointer;
    background: transparent;
    padding: 0;
    margin: 0;
    outline: none;
    transition: opacity 0.3s ease;
  }

  .watermark-container.bottom-right {
    right: 24px;
    left: auto;
  }

  .watermark-container.bottom-left {
    left: 24px;
    right: auto;
  }

  .gaga-avatar-anchor {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.3s ease;
    will-change: transform, opacity;
  }

  /* Diffuse Smoky Dark Bloom behind the sprite */
  .gaga-smoky-shadow {
    position: absolute;
    inset: -18px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.96) 0%, rgba(25, 5, 20, 0.65) 45%, transparent 75%);
    filter: blur(16px);
    pointer-events: none;
    opacity: 0.88;
    animation: gaga-calm-smoke-pulse 5s ease-in-out infinite alternate;
  }

  /* Smooth sinking plunge when clicked */
  .gaga-avatar-anchor.is-sinking {
    transform: translateY(140px) scale(0.7) !important;
    opacity: 0 !important;
    pointer-events: none;
    transition: transform 0.4s cubic-bezier(0.55, 0.085, 0.68, 0.53), opacity 0.3s ease-in !important;
  }

  /* Calm gentle floating up/down */
  .gaga-sprite-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: gaga-gentle-float 6s ease-in-out infinite alternate;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .watermark-container:hover .gaga-sprite-wrap {
    transform: scale(1.18) translateY(-4px);
  }

  .gaga-sprite-img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    /* Applied Localized SVG Bulge filter + drop-shadow */
    filter: url(#gaga-corner-bulge-filter) drop-shadow(0 6px 18px rgba(0, 0, 0, 0.98)) drop-shadow(0 0 16px rgba(0, 0, 0, 0.85));
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    position: relative;
    z-index: 2;
  }

  /* Calm gentle floating (small vertical displacement only) */
  @keyframes gaga-gentle-float {
    0% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
    100% { transform: translateY(2px); }
  }

  @keyframes gaga-calm-smoke-pulse {
    0% { transform: scale(0.9); opacity: 0.75; }
    100% { transform: scale(1.1); opacity: 0.95; }
  }

  /* ==========================================================================
     AVATAR LEFT, TEXT RIGHT — BORDERLESS DIFFUSE DIALOGUE
     ========================================================================== */
  .gaga-dialogue-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    opacity: 1;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
  }

  .gaga-dialogue-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Transparent backdrop with soft dimming — page stays visible */
  .gaga-transparent-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px) brightness(0.65);
    -webkit-backdrop-filter: blur(6px) brightness(0.65);
    cursor: pointer;
  }

  /* Vintage film grain layer */
  .gaga-vintage-grain-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
    opacity: 0.6;
    z-index: 1;
  }

  /* SIDE-BY-SIDE STAGE */
  .gaga-dialogue-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 36px;
    max-width: 880px;
    width: 92vw;
    box-sizing: border-box;
    pointer-events: auto;
  }

  /* ── LEFT: Hero Avatar ── */
  .gaga-dialogue-overlay.is-hidden .gaga-left-avatar-wrap {
    opacity: 0;
    pointer-events: none;
  }

  .gaga-left-avatar-wrap {
    position: relative;
    width: 185px;
    height: 185px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    will-change: transform, opacity, filter;
  }

  /* Dark diffuse smoky aura behind hero head */
  .gaga-left-diffuse-aura {
    position: absolute;
    inset: -38px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 0, 1) 0%, rgba(45, 8, 30, 0.75) 45%, rgba(0, 0, 0, 0.9) 70%, transparent 100%);
    filter: blur(32px);
    animation: gaga-calm-smoke-pulse 4.5s ease-in-out infinite alternate;
  }

  .gaga-left-hero-img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    /* Applied Localized SVG Bulge filter + drop-shadow */
    filter: url(#gaga-hero-bulge-filter) drop-shadow(0 20px 50px rgba(0, 0, 0, 1)) drop-shadow(0 0 30px rgba(0, 0, 0, 0.95));
    animation: gaga-gentle-hero-float 5s ease-in-out infinite alternate;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Gentle calm hero hovering */
  @keyframes gaga-gentle-hero-float {
    0% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
    100% { transform: translateY(3px); }
  }

  /* ── RIGHT: Borderless Diffuse Spoken Text ── */
  .gaga-dialogue-overlay:not(.is-hidden) .gaga-right-speech-wrap {
    animation: gaga-speech-pop 1.5s cubic-bezier(0.16, 1, 0.3, 1) 1.1s both;
  }

  .gaga-right-speech-wrap {
    position: relative;
    flex: 1;
    max-width: 600px;
    min-height: 160px;
    box-sizing: border-box;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    cursor: pointer;
  }

  /* Soft Diffuse Smoky Glow behind right text */
  .gaga-speech-smoke {
    position: absolute;
    inset: -24px;
    border-radius: 40px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.95) 0%, rgba(15, 6, 20, 0.78) 55%, transparent 88%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 1;
  }

  @keyframes gaga-speech-pop {
    0% {
      opacity: 0;
      transform: translateX(-15px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .gaga-active-sentence-box {
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  /* OLD STYLE ITALIC SERIF TYPOGRAPHY */
  .gaga-spoken-sentence {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Playfair Display', Garamond, Georgia, serif;
    font-style: italic;
    font-size: 1.95rem;
    font-weight: 600;
    line-height: 1.38;
    color: #ffffff;
    letter-spacing: 0.4px;
    display: inline;
    text-shadow: 
      0 4px 20px rgba(0, 0, 0, 1),
      0 0 35px rgba(0, 0, 0, 0.98);
  }

  .gaga-spoken-sentence.is-quote {
    color: #ffffff;
    font-size: 2.05rem;
    font-weight: 700;
  }

  .gaga-spoken-sentence.is-author {
    font-size: 1.35rem;
    font-weight: 700;
    color: #f43f5e;
    letter-spacing: 2px;
    display: block;
    margin-top: 8px;
  }

  .gaga-typewriter-cursor {
    display: inline-block;
    font-family: monospace;
    font-size: 1.7rem;
    color: #f43f5e;
    margin-left: 4px;
    vertical-align: middle;
    animation: gaga-cursor-blink 0.7s infinite;
  }

  @keyframes gaga-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Footer Stepper */
  .gaga-speech-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 10px;
  }

  .gaga-sentence-stepper {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .step-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s ease;
  }

  .step-dot.is-active {
    background: #f43f5e;
    box-shadow: 0 0 10px #f43f5e;
    transform: scale(1.4);
  }

  .step-dot.is-done {
    background: rgba(255, 255, 255, 0.7);
  }

  .gaga-tap-hint {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.5px;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (Mobile Stacking)
     ========================================================================== */
  @media (max-width: 720px) {
    .gaga-dialogue-stage {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    .gaga-left-avatar-wrap {
      width: 145px;
      height: 145px;
    }

    .gaga-left-hero-img {
      width: 140px;
      height: 140px;
    }

    .gaga-right-speech-wrap {
      text-align: center;
      padding: 16px;
      min-height: 110px;
    }

    .gaga-spoken-sentence {
      font-size: 1.45rem;
    }

    .gaga-spoken-sentence.is-quote {
      font-size: 1.55rem;
    }

    .gaga-spoken-sentence.is-author {
      font-size: 1.1rem;
    }

    .gaga-speech-footer {
      justify-content: center;
      gap: 12px;
    }
  }
</style>

<script>
  /**
   * Calm Floating Lady Gaga Manifesto Controller with Slow, Creeping Horror Bulge Distortion
   * Implements:
   * 1. Slow, Creeping Localized Spot Bulge/Pinch distortion (โป่งพองหรือยุบตัวช้าๆ แบบขนลุก)
   * 2. Calm, steady vertical floating (no flashing)
   * 3. Full-screen color-invert strobe flash on entry & exit
   * 4. Avatar Left, Text Right, Old Style Italic, only current sentence
   */
  class GagaManifestoController {
    private spriteImg: HTMLImageElement | null = null;
    private heroImg: HTMLImageElement | null = null;
    private heroAvatarWrap: HTMLElement | null = null;
    private anchor: HTMLElement | null = null;
    private modal: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private speechBox: HTMLElement | null = null;
    private screenFlashEl: HTMLElement | null = null;

    // SVG Localized Bulge Displacement Elements
    private displaceCornerEl: SVGElement | null = null;
    private turbCornerEl: SVGElement | null = null;
    private lightCornerEl: SVGElement | null = null;

    private displaceHeroEl: SVGElement | null = null;
    private turbHeroEl: SVGElement | null = null;
    private lightHeroEl: SVGElement | null = null;

    private activeSentenceEl: HTMLElement | null = null;
    private cursorEl: HTMLElement | null = null;
    private stepDots: NodeListOf<HTMLElement> | null = null;

    private isShowcasing = false;
    private blinkTimer: number | null = null;
    private glanceTimer: number | null = null;
    private warpTimer: number | null = null;

    // Candidate Localized Spot Coordinates (เฉพาะจุด เช่น แก้มซ้าย, แก้มขวา, หน้าผาก, คาง/ปาก, ขอบคริสตัล)
    private readonly CORNER_SPOTS = [
      { x: 25, y: 30, z: 14 }, // Left cheek / eye
      { x: 43, y: 30, z: 14 }, // Right cheek / eye
      { x: 34, y: 18, z: 14 }, // Forehead
      { x: 34, y: 46, z: 14 }, // Mouth / Chin
      { x: 18, y: 36, z: 14 }, // Left crystal facet
      { x: 50, y: 36, z: 14 }, // Right crystal facet
    ];

    private readonly HERO_SPOTS = [
      { x: 68, y: 78, z: 28 },  // Left cheek / eye
      { x: 112, y: 78, z: 28 }, // Right cheek / eye
      { x: 90, y: 48, z: 28 },  // Forehead
      { x: 90, y: 122, z: 28 }, // Chin / Mouth
      { x: 45, y: 92, z: 28 },  // Left crystal facet
      { x: 135, y: 92, z: 28 }, // Right crystal facet
    ];

    // Sentence-by-sentence dialogue sequence
    private readonly MANIFESTO_SENTENCES = [
      {
        text: '“Computers are only as creative as the humans who program them.”',
        isQuote: true,
        isAuthor: false,
        duration: 3200,
      },
      {
        text: '— John Maeda',
        isQuote: false,
        isAuthor: true,
        duration: 2000,
      },
      {
        text: 'AI empowers algorithms & computational graphics • zero synthetic art.',
        isQuote: false,
        isAuthor: false,
        duration: 3600,
      },
      {
        text: 'Every pixel is mathematically rendered, human-directed.',
        isQuote: false,
        isAuthor: false,
        duration: 3400,
      },
    ];

    private currentSentenceIdx = 0;
    private typingInterval: number | null = null;
    private nextSentenceTimeout: number | null = null;

    private readonly SPRITES = {
      open: '/manifesto/transpbg/manifesto_open-Photoroom.png',
      close: '/manifesto/transpbg/manifesto_close-Photoroom.png',
      left: '/manifesto/transpbg/manifesto_left-Photoroom.png',
      right: '/manifesto/transpbg/manifesto_right-Photoroom.png',
    };

    init(): void {
      this.spriteImg = document.getElementById('gagaSpriteImg') as HTMLImageElement;
      this.heroImg = document.getElementById('gagaHeroImg') as HTMLImageElement;
      this.heroAvatarWrap = document.getElementById('gagaHeroAvatarWrap');
      this.anchor = document.getElementById('gagaAvatarAnchor');
      this.modal = document.getElementById('gaga-manifesto-modal');
      this.backdrop = document.getElementById('gagaModalBackdrop');
      this.speechBox = document.getElementById('gagaSpeechBox');
      this.screenFlashEl = document.getElementById('gaga-screen-flash');

      this.displaceCornerEl = document.getElementById('gagaDisplaceCorner') as unknown as SVGElement;
      this.turbCornerEl = document.getElementById('gagaTurbulenceCorner') as unknown as SVGElement;
      this.lightCornerEl = document.getElementById('gagaLightCorner') as unknown as SVGElement;

      this.displaceHeroEl = document.getElementById('gagaDisplaceHero') as unknown as SVGElement;
      this.turbHeroEl = document.getElementById('gagaTurbulenceHero') as unknown as SVGElement;
      this.lightHeroEl = document.getElementById('gagaLightHero') as unknown as SVGElement;

      this.activeSentenceEl = document.getElementById('gagaActiveSentenceText');
      this.cursorEl = document.getElementById('gagaCursor');
      this.stepDots = document.querySelectorAll('.step-dot');

      if (!this.spriteImg || !this.anchor || !this.modal) return;

      this.bindEvents();
      this.startRoutines();
    }

    private bindEvents(): void {
      const watermark = document.getElementById('site-watermark');
      if (watermark) {
        watermark.addEventListener('click', (e) => {
          e.stopPropagation();
          this.triggerManifestoSequence();
        });
      }

      if (this.backdrop) {
        this.backdrop.addEventListener('click', () => this.dismissShowcase());
      }

      // Click on dialogue area advances to next sentence
      if (this.speechBox) {
        this.speechBox.addEventListener('click', (e) => {
          e.stopPropagation();
          this.advanceSentence();
        });
      }

      // Spacebar, Enter, or Escape key
      window.addEventListener('keydown', (e) => {
        if (this.isShowcasing) {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault();
            this.advanceSentence();
          } else if (e.code === 'Escape') {
            this.dismissShowcase();
          }
        }
      });

      // Restore position preference
      const savedPos = localStorage.getItem('sitedotmoss_watermark_pos');
      if (watermark && (savedPos === 'bottom-left' || savedPos === 'bottom-right')) {
        watermark.classList.remove('bottom-left', 'bottom-right');
        watermark.classList.add(savedPos);
      }
    }

    // ── Full-Screen Color Invert Flash Strobe (On enter & exit) ──

    private triggerScreenFlash(): void {
      if (!this.screenFlashEl) return;
      this.screenFlashEl.classList.remove('is-flashing');
      void this.screenFlashEl.offsetWidth; // Force reflow
      this.screenFlashEl.classList.add('is-flashing');
      setTimeout(() => {
        if (this.screenFlashEl) this.screenFlashEl.classList.remove('is-flashing');
      }, 300);
    }

    // ── Slow, Creeping Localized Spot Bulge & Pinch Distortion ──

    private triggerLocalizedSpotWarp(isHero: boolean): void {
      const displaceEl = isHero ? this.displaceHeroEl : this.displaceCornerEl;
      const turbEl = isHero ? this.turbHeroEl : this.turbCornerEl;
      const lightEl = isHero ? this.lightHeroEl : this.lightCornerEl;
      if (!displaceEl || !turbEl || !lightEl) return;

      // 1. Pick a single localized candidate spot (เฉพาะจุด)
      const spots = isHero ? this.HERO_SPOTS : this.CORNER_SPOTS;
      const chosenSpot = spots[Math.floor(Math.random() * spots.length)];

      // Apply coordinates only to that localized spotlight
      lightEl.setAttribute('x', String(chosenSpot.x));
      lightEl.setAttribute('y', String(chosenSpot.y));
      lightEl.setAttribute('z', String(chosenSpot.z));

      // Randomize seed
      turbEl.setAttribute('seed', String(Math.floor(Math.random() * 80) + 1));

      // 2. Decide if this spot swells outward (+) or caves inward (-)
      const isBulgeOut = Math.random() < 0.65;
      const maxScale = (Math.random() * 12 + (isHero ? 24 : 16)) * (isBulgeOut ? 1 : -0.88);
      
      // SLOW, CREEPING, UNCANNY SWELLING DURATION (2.2s - 3.4s)
      const duration = Math.random() * 1200 + 2200;
      const startTime = performance.now();

      const animate = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Slow, creeping bell-curve easing (lingers slightly at peak for eerie horror tension)
        const ease = Math.pow(Math.sin(progress * Math.PI), 1.25);
        const currentScale = ease * maxScale;
        displaceEl.setAttribute('scale', currentScale.toFixed(1));

        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          displaceEl.setAttribute('scale', '0');
        }
      };
      requestAnimationFrame(animate);
    }

    // ── Eye Animations (Blinking & Glancing) ──────────────────

    private setSprite(state: 'open' | 'close' | 'left' | 'right'): void {
      const src = this.SPRITES[state];
      if (this.spriteImg) this.spriteImg.src = src;
      if (this.heroImg) this.heroImg.src = src;
    }

    private startRoutines(): void {
      this.scheduleBlink();
      this.scheduleGlance();
      this.scheduleRandomLocalizedBulge();
    }

    private scheduleBlink(): void {
      const delay = Math.random() * 3200 + 2600; // 2.6s - 5.8s
      this.blinkTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          this.setSprite('close');
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
              if (Math.random() < 0.22) {
                setTimeout(() => {
                  this.setSprite('close');
                  setTimeout(() => this.setSprite('open'), 130);
                }, 180);
              }
            }
          }, 140);
        }
        this.scheduleBlink();
      }, delay);
    }

    private scheduleGlance(): void {
      const delay = Math.random() * 4500 + 3800; // 3.8s - 8.3s
      this.glanceTimer = window.setTimeout(() => {
        if (!this.isShowcasing) {
          const dir = Math.random() < 0.5 ? 'left' : 'right';
          this.setSprite(dir);

          const holdTime = Math.random() * 1100 + 800; // 0.8s - 1.9s
          setTimeout(() => {
            if (!this.isShowcasing) {
              this.setSprite('open');
            }
          }, holdTime);
        }
        this.scheduleGlance();
      }, delay);
    }

    // ── Random Localized Spot Bulge Cycle (Slow Horror Rhythm) ──

    private scheduleRandomLocalizedBulge(): void {
      const delay = Math.random() * 3500 + 3500; // 3.5s - 7.0s
      this.warpTimer = window.setTimeout(() => {
        this.triggerLocalizedSpotWarp(this.isShowcasing);
        this.scheduleRandomLocalizedBulge();
      }, delay);
    }

    // ── Interactive Manifesto Speech Stream ──────────────────

    private triggerManifestoSequence(): void {
      if (this.isShowcasing || !this.anchor || !this.modal) return;
      this.isShowcasing = true;

      // 1. Trigger Full-Screen Color Invert Strobe Flash on entry!
      this.triggerScreenFlash();

      // 2. Corner sprite plunges down into dark void
      this.anchor.classList.add('is-sinking');
      this.setSprite('open');

      setTimeout(() => {
        if (!this.modal) return;
        this.modal.classList.remove('is-hidden');

        // 3. Spawn from a completely RANDOM offscreen vector / angle!
        const angle = Math.random() * Math.PI * 2;
        const viewportHypot = Math.hypot(window.innerWidth, window.innerHeight);
        const spawnDist = Math.max(viewportHypot * 0.75, 700);
        const startX = Math.cos(angle) * spawnDist;
        const startY = Math.sin(angle) * spawnDist;
        const startRot = (Math.random() - 0.5) * 44; // -22deg to +22deg
        const startScale = Math.random() * 0.15 + 0.18; // 0.18 - 0.33

        if (this.heroAvatarWrap) {
          this.heroAvatarWrap.animate([
            {
              transform: `translate3d(${startX.toFixed(1)}px, ${startY.toFixed(1)}px, 0) scale(${startScale.toFixed(2)}) rotate(${startRot.toFixed(1)}deg)`,
              opacity: 0,
              filter: 'blur(16px)',
            },
            {
              transform: 'translate3d(0, 0, 0) scale(1) rotate(0deg)',
              opacity: 1,
              filter: 'blur(0px)',
            }
          ], {
            duration: 2600, // VERY SLOW, CREEPING, OMINOUS ARRIVAL (2.6s)
            easing: 'cubic-bezier(0.12, 0.95, 0.22, 1)',
            fill: 'forwards',
          });
        }

        // Initial slow localized bulge warp as she settles into view
        setTimeout(() => this.triggerLocalizedSpotWarp(true), 1500);

        // 4. Begin sentence typing stream once she floats closer into view
        this.currentSentenceIdx = 0;
        setTimeout(() => {
          if (this.isShowcasing) {
            this.speakSentence(0);
          }
        }, 1300);
      }, 350);
    }

    private speakSentence(idx: number): void {
      if (idx >= this.MANIFESTO_SENTENCES.length) {
        setTimeout(() => this.dismissShowcase(), 1200);
        return;
      }

      this.currentSentenceIdx = idx;
      const sentenceObj = this.MANIFESTO_SENTENCES[idx];

      // Update progress dots
      this.stepDots?.forEach((dot, dIdx) => {
        dot.classList.remove('is-active', 'is-done');
        if (dIdx < idx) dot.classList.add('is-done');
        else if (dIdx === idx) dot.classList.add('is-active');
      });

      // Clear previous sentence completely (No history)
      if (this.activeSentenceEl) {
        this.activeSentenceEl.innerText = '';
        this.activeSentenceEl.className = 'gaga-spoken-sentence';
        if (sentenceObj.isQuote) this.activeSentenceEl.classList.add('is-quote');
        if (sentenceObj.isAuthor) this.activeSentenceEl.classList.add('is-author');
      }

      // Lady Gaga turns to glance right while speaking
      if (idx === 0) {
        this.setSprite('right');
      }

      // Typewriter letter-by-letter streaming
      const text = sentenceObj.text;
      let charIdx = 0;
      if (this.typingInterval) clearInterval(this.typingInterval);

      const speed = sentenceObj.isAuthor ? 30 : 22;

      this.typingInterval = window.setInterval(() => {
        if (!this.activeSentenceEl) return;
        charIdx++;
        this.activeSentenceEl.innerText = text.slice(0, charIdx);

        // Occasional uncanny eye blink while speaking
        if (Math.random() < 0.04) {
          this.setSprite('close');
          setTimeout(() => {
            if (this.isShowcasing) this.setSprite('right');
          }, 110);
        }

        if (charIdx >= text.length) {
          if (this.typingInterval) clearInterval(this.typingInterval);
          this.typingInterval = null;

          // Finished typing sentence: schedule next sentence auto-advance
          this.nextSentenceTimeout = window.setTimeout(() => {
            this.advanceSentence();
          }, sentenceObj.duration);
        }
      }, speed);
    }

    private advanceSentence(): void {
      if (!this.isShowcasing) return;
      if (this.typingInterval) {
        // If still typing, complete instantly
        clearInterval(this.typingInterval);
        this.typingInterval = null;
        const sentenceObj = this.MANIFESTO_SENTENCES[this.currentSentenceIdx];
        if (this.activeSentenceEl) this.activeSentenceEl.innerText = sentenceObj.text;
        return;
      }

      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);

      // Trigger slow localized spot warp on sentence advance
      this.triggerLocalizedSpotWarp(true);

      // Proceed to next sentence (replaces current text cleanly, no history)
      this.speakSentence(this.currentSentenceIdx + 1);
    }

    private dismissShowcase(): void {
      if (!this.isShowcasing || !this.modal || !this.anchor) return;
      if (this.typingInterval) clearInterval(this.typingInterval);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);

      // Trigger Full-Screen Color Invert Strobe Flash on exit!
      this.triggerScreenFlash();

      // Slow fading exit float (drift away into darkness)
      if (this.heroAvatarWrap) {
        const exitAngle = Math.random() * Math.PI * 2;
        const exitDist = Math.max(window.innerWidth, window.innerHeight) * 0.7;
        const exitX = Math.cos(exitAngle) * exitDist;
        const exitY = Math.sin(exitAngle) * exitDist;
        this.heroAvatarWrap.animate([
          {
            transform: 'translate3d(0, 0, 0) scale(1) rotate(0deg)',
            opacity: 1,
            filter: 'blur(0px)',
          },
          {
            transform: `translate3d(${exitX.toFixed(1)}px, ${exitY.toFixed(1)}px, 0) scale(0.25) rotate(${((Math.random() - 0.5) * 30).toFixed(1)}deg)`,
            opacity: 0,
            filter: 'blur(16px)',
          }
        ], {
          duration: 750,
          easing: 'cubic-bezier(0.4, 0, 1, 1)',
          fill: 'forwards',
        });
      }

      setTimeout(() => {
        if (!this.modal || !this.anchor) return;
        this.modal.classList.add('is-hidden');
        this.anchor.classList.remove('is-sinking');
        this.anchor.style.transform = 'translate3d(0, 0, 0)';
        this.setSprite('open');
        this.isShowcasing = false;
      }, 350);
    }

    destroy(): void {
      if (this.blinkTimer) clearTimeout(this.blinkTimer);
      if (this.glanceTimer) clearTimeout(this.glanceTimer);
      if (this.warpTimer) clearTimeout(this.warpTimer);
      if (this.typingInterval) clearInterval(this.typingInterval);
      if (this.nextSentenceTimeout) clearTimeout(this.nextSentenceTimeout);
    }
  }

  let controller: GagaManifestoController | null = null;

  function initGagaWatermark() {
    if (controller) controller.destroy();
    controller = new GagaManifestoController();
    controller.init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGagaWatermark);
  } else {
    initGagaWatermark();
  }

  document.addEventListener('astro:after-swap', initGagaWatermark);
</script>
