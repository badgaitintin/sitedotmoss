---
// monolithic-detection.astro -- TinyConvMemLM WASM On-Device Deployment (Claude UI Theme)
import Watermark from '../components/Watermark.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TinyConvMemLM — On-Device LM · site(.)moss</title>
    <meta
      name="description"
      content="A 41M-parameter dilated-CNN + GRU-memory language model distilled from Qwen2.5-0.5B, compiled to WASM. Every token is generated entirely by your browser."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ============================
         CLAUDE THEME TOKENS
      ============================ */
      :root {
        --bg-app: #181816;
        --bg-sidebar: #131312;
        --bg-card: #20201e;
        --bg-input: #262624;
        --bg-hover: #2c2c29;
        --border: #2e2e2b;
        --border-subtle: #242421;
        --text-primary: #ecebe6;
        --text-secondary: #a3a29e;
        --text-muted: #666562;
        --accent-orange: #d97757;
        --accent-orange-soft: rgba(217, 119, 87, 0.15);
        --accent-green: #4ade80;
        --accent-blue: #60a5fa;
        --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-serif: "Newsreader", Georgia, serif;
        --font-mono: "JetBrains Mono", monospace;
        --sidebar-w: 300px;
        --r-lg: 20px;
        --r-md: 12px;
        --r-sm: 8px;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg-app);
        color: var(--text-primary);
        font-family: var(--font-sans);
        height: 100vh;
        overflow: hidden;
        display: flex;
        -webkit-font-smoothing: antialiased;
      }

      .app-shell {
        display: flex;
        width: 100vw;
        height: 100vh;
      }

      /* ============================
         SIDEBAR (LEFT) - PROJECT EXPLANATION
      ============================ */
      .sidebar {
        width: var(--sidebar-w);
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px 14px;
        flex-shrink: 0;
        overflow-y: auto;
      }

      .sidebar-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
      }

      .brand-title {
        font-family: var(--font-serif);
        font-size: 20px;
        font-weight: 500;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .brand-title svg {
        color: var(--accent-orange);
      }

      .project-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--r-md);
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .card-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--accent-orange);
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .project-desc {
        font-size: 12.5px;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      .spec-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
        margin-top: 4px;
      }
      .spec-item {
        background: var(--bg-input);
        border: 1px solid var(--border-subtle);
        border-radius: var(--r-sm);
        padding: 6px 8px;
      }
      .spec-val {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 600;
        color: var(--accent-green);
      }
      .spec-lbl {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 2px;
      }

      /* Sidebar Sliders */
      .slider-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .slider-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .slider-header {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--text-secondary);
      }
      .slider-header span.val {
        color: var(--accent-orange);
      }
      .slider-item input[type="range"] {
        accent-color: var(--accent-orange);
        cursor: pointer;
      }

      .back-link-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: var(--r-sm);
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        font-size: 13px;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
        margin-top: auto;
      }
      .back-link-btn:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
      }

      /* ============================
         MAIN CONTENT AREA
      ============================ */
      .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--bg-app);
        height: 100vh;
        position: relative;
      }

      .top-bar {
        height: 52px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border-subtle);
      }
      .model-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
        background: var(--bg-card);
        padding: 5px 12px;
        border-radius: 16px;
        border: 1px solid var(--border);
      }
      .model-badge strong {
        color: var(--text-primary);
      }

      /* Chat Container */
      .chat-container {
        flex: 1;
        overflow-y: auto;
        padding: 32px 20px 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Hero Greeting */
      .hero-greeting {
        max-width: 680px;
        width: 100%;
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .sparkle-icon {
        color: var(--accent-orange);
        margin-bottom: 16px;
      }
      .hero-title {
        font-family: var(--font-serif);
        font-size: 34px;
        font-weight: 400;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        margin-bottom: 8px;
      }
      .hero-sub {
        font-size: 14px;
        color: var(--text-secondary);
        max-width: 540px;
        line-height: 1.6;
        margin-bottom: 24px;
      }

      /* Signal Stage Pills */
      .signal-pills {
        display: flex;
        gap: 6px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .sig-pill {
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 12px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-muted);
        transition: all 0.2s;
      }
      .sig-pill.active {
        border-color: var(--accent-orange);
        color: var(--accent-orange);
        background: var(--accent-orange-soft);
      }

      /* Messages Stream */
      .messages-list {
        width: 100%;
        max-width: 720px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .msg-row {
        display: flex;
        gap: 14px;
        width: 100%;
      }
      .msg-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        flex-shrink: 0;
      }
      .msg-user .msg-avatar {
        background: #3a3834;
        color: #d8d4cc;
      }
      .msg-assistant .msg-avatar {
        background: var(--accent-orange-soft);
        color: var(--accent-orange);
      }
      .msg-content {
        flex: 1;
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-primary);
      }
      .msg-user .msg-content {
        font-family: var(--font-mono);
        font-size: 13.5px;
        background: var(--bg-card);
        padding: 12px 16px;
        border-radius: var(--r-md);
        border: 1px solid var(--border);
      }
      .msg-assistant .msg-content {
        font-family: var(--font-mono);
        font-size: 13.5px;
        padding-top: 4px;
        white-space: pre-wrap;
        word-break: break-word;
      }

      /* ============================
         CONFIRM & LOADING OVERLAY
      ============================ */
      .init-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        padding: 20px 24px;
        width: 100%;
        max-width: 540px;
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: left;
      }
      .init-header {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .init-desc {
        font-size: 12.5px;
        color: var(--text-secondary);
        line-height: 1.6;
      }
      .load-start-btn {
        background: var(--accent-orange);
        color: #181816;
        border: none;
        border-radius: var(--r-sm);
        padding: 10px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: filter 0.15s, transform 0.1s;
        align-self: flex-start;
      }
      .load-start-btn:hover {
        filter: brightness(1.1);
      }
      .load-start-btn:active {
        transform: scale(0.98);
      }

      .loading-box {
        display: none;
        flex-direction: column;
        gap: 12px;
        margin-top: 4px;
      }
      .loading-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
      }
      .loading-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid var(--border);
        border-top-color: var(--accent-orange);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .loading-track {
        height: 6px;
        background: var(--bg-input);
        border-radius: 3px;
        overflow: hidden;
        position: relative;
      }
      .loading-bar {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--accent-orange), var(--accent-green));
        border-radius: 3px;
        transition: width 0.3s ease;
      }
      .pulse-text {
        font-size: 11.5px;
        color: var(--text-muted);
        animation: pulseText 1.5s ease-in-out infinite;
      }
      @keyframes pulseText {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
      }

      /* Floating Prompt Box */
      .prompt-wrapper {
        position: absolute;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 720px;
        padding: 0 20px;
        z-index: 10;
      }

      .prompt-box {
        background: var(--bg-input);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 14px 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: border-color 0.15s;
      }
      .prompt-box:focus-within {
        border-color: #44433f;
      }

      #status-banner {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      #status-banner.ok { color: var(--accent-green); }
      #status-banner.warn { color: var(--accent-orange); }

      textarea#prompt {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 14.5px;
        resize: none;
        min-height: 48px;
        max-height: 160px;
        line-height: 1.5;
      }
      textarea#prompt::placeholder {
        color: var(--text-muted);
      }

      .prompt-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 4px;
      }

      .right-tools {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .model-tag {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        background: var(--bg-card);
        padding: 4px 10px;
        border-radius: 12px;
        border: 1px solid var(--border-subtle);
      }

      .send-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent-orange);
        color: #181816;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: filter 0.15s, transform 0.1s;
      }
      .send-btn:hover:not(:disabled) {
        filter: brightness(1.1);
      }
      .send-btn:disabled {
        background: var(--border);
        color: var(--text-muted);
        cursor: not-allowed;
      }

      @media (max-width: 768px) {
        .sidebar { display: none; }
      }
    </style>
  </head>

  <body>
    <div class="app-shell">

      <!-- ── SIDEBAR (LEFT) - PROJECT EXPLANATION ── -->
      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="brand-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
            </svg>
            site(.)moss / LM
          </div>

          <!-- Project Description Card -->
          <div class="project-card">
            <div class="card-label">PROJECT OVERVIEW</div>
            <div class="project-desc">
              <strong>TinyConvMemLM</strong> is a 41M-parameter distilled language model derived from <code>Qwen2.5-0.5B</code>. It uses a Dilated-CNN + GRU Memory architecture running 100% locally in your browser via WebAssembly.
            </div>
          </div>

          <!-- Spec Cards -->
          <div class="project-card">
            <div class="card-label">PERFORMANCE METRICS</div>
            <div class="spec-grid">
              <div class="spec-item">
                <div class="spec-val">12.0×</div>
                <div class="spec-lbl">Smaller (41M vs 494M)</div>
              </div>
              <div class="spec-item">
                <div class="spec-val">12.5×</div>
                <div class="spec-lbl">Faster Pass</div>
              </div>
              <div class="spec-item">
                <div class="spec-val">0</div>
                <div class="spec-lbl">API Calls</div>
              </div>
              <div class="spec-item">
                <div class="spec-val" id="side-tps">—</div>
                <div class="spec-lbl">Tokens / Sec</div>
              </div>
            </div>
          </div>

          <!-- Parameters Sliders Card -->
          <div class="project-card">
            <div class="card-label">SAMPLING SETTINGS</div>
            <div class="slider-group">
              <div class="slider-item">
                <div class="slider-header">
                  <span>Temperature</span>
                  <span class="val" id="temp-val">0.7</span>
                </div>
                <input type="range" id="temp" min="0.1" max="1.5" step="0.1" value="0.7" />
              </div>
              <div class="slider-item">
                <div class="slider-header">
                  <span>Top-K Sampling</span>
                  <span class="val" id="topk-val">40</span>
                </div>
                <input type="range" id="topk" min="1" max="100" step="1" value="40" />
              </div>
              <div class="slider-item">
                <div class="slider-header">
                  <span>Repetition Penalty</span>
                  <span class="val" id="reppen-val">1.25</span>
                </div>
                <input type="range" id="reppen" min="1.0" max="2.0" step="0.05" value="1.25" />
              </div>
              <div class="slider-item">
                <div class="slider-header">
                  <span>Max Tokens</span>
                  <span class="val" id="maxlen-val">80</span>
                </div>
                <input type="range" id="maxlen" min="10" max="200" step="10" value="80" />
              </div>
            </div>
          </div>
        </div>

       
      </aside>

      <!-- ── MAIN CONTENT (RIGHT) ── -->
      <main class="main-area">

        <!-- Top Bar -->
        <div class="top-bar">
          <div class="model-badge">
            <span>Model:</span>
            <strong>TinyConvMemLM (41M WASM)</strong>
          </div>
          <div class="top-links">
            <a href="/" style="color: var(--text-secondary); font-size: 13px; text-decoration: none;">← site(.)moss</a>
          </div>
        </div>

        <!-- Chat Container -->
        <div class="chat-container" id="chatContainer">

          <!-- Hero Greeting -->
          <div class="hero-greeting" id="heroGreeting">
            <div class="sparkle-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
              </svg>
            </div>
            <h1 class="hero-title">On-Device LLM Playground</h1>
            <p class="hero-sub">
              Execute a 41M parameter language model locally in your browser. All computations remain private and run on-device.
            </p>

            <!-- Signal Pills -->
            <div class="signal-pills" id="signalPills">
              <span class="sig-pill active" data-stage="input">Stage 1: Input</span>
              <span class="sig-pill" data-stage="cnn">Stage 2: Dilated CNN</span>
              <span class="sig-pill" data-stage="gru">Stage 3: GRU Gate</span>
              <span class="sig-pill" data-stage="output">Stage 4: Output</span>
            </div>

            <!-- Pre-Load Confirmation Card -->
            <div class="init-card" id="initCard">
              <div class="init-header">
                <span>Model Initialization</span>
                <span style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-orange);">~488 MB Total</span>
              </div>
              <div class="init-desc">
                The WASM model weights total ~488 MB (Prefill graph: 320 MB, Decode weights: 165 MB). Once downloaded, weights are cached by your browser for offline use. Are you ready to initialize?
              </div>
              <button class="load-start-btn" id="startLoadBtn">Initialize and Load Model</button>

              <!-- Loading Bar (hidden until button clicked) -->
              <div class="loading-box" id="loadingBox">
                <div class="loading-header">
                  <span id="loadProgressTitle">Preparing WASM model...</span>
                  <span class="loading-spinner" id="loadSpinner"></span>
                </div>
                <div class="loading-track">
                  <div class="loading-bar" id="loadingBar"></div>
                </div>
                <div class="pulse-text" id="loadDetailText">
                  Initializing ONNX Runtime Web engine...
                </div>
              </div>
            </div>
          </div>

          <!-- Messages Stream -->
          <div class="messages-list" id="messagesList"></div>

        </div>

        <!-- Floating Prompt Input Box -->
        <div class="prompt-wrapper">
          <div class="prompt-box">
            <div id="status-banner">
              Click 'Initialize and Load Model' above to start
            </div>

            <textarea
              id="prompt"
              placeholder="Enter a prompt to run inference..."
              rows="1"
              disabled
            ></textarea>

            <div class="prompt-toolbar">
              <div></div>
              <div class="right-tools">
                <span class="model-tag" id="tps-tag">WASM 41M</span>
                <button class="send-btn" id="sendBtn" disabled title="Run Inference">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

      </main>
    </div>

    <!-- ONNX Runtime Web Script -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.19.0/dist/ort.min.js"></script>

    <!-- INFERENCE SCRIPT -->
    <script type="module">
      import { AutoTokenizer, env } from "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.0.0/dist/transformers.min.js";

      env.allowLocalModels = false;

      // Config
      const MODEL_CONFIG_URL  = "/tiny_convmem_lm_onnx_export/model_config.json";
      const PREFILL_MODEL_URL = "/tiny_convmem_lm_onnx_export/tiny_convmem_lm_prefill.onnx";
      const DECODE_MODEL_URL  = "/tiny_convmem_lm_onnx_export/tiny_convmem_lm_decode.onnx";
      const TOKENIZER_REPO    = "Qwen/Qwen2.5-0.5B-Instruct";

      // DOM
      const statusBanner    = document.getElementById("status-banner");
      const promptEl        = document.getElementById("prompt");
      const sendBtn         = document.getElementById("sendBtn");
      const heroGreeting    = document.getElementById("heroGreeting");
      const messagesList    = document.getElementById("messagesList");
      const startLoadBtn    = document.getElementById("startLoadBtn");
      const loadingBox      = document.getElementById("loadingBox");
      const loadTitle       = document.getElementById("loadProgressTitle");
      const loadingBar      = document.getElementById("loadingBar");
      const loadDetail      = document.getElementById("loadDetailText");
      const loadSpinner     = document.getElementById("loadSpinner");
      const tpsTag          = document.getElementById("tps-tag");
      const sideTps         = document.getElementById("side-tps");
      const sigPills        = document.querySelectorAll(".sig-pill");

      const tempSlider   = document.getElementById("temp");
      const topkSlider   = document.getElementById("topk");
      const reppenSlider = document.getElementById("reppen");
      const maxlenSlider = document.getElementById("maxlen");

      [["temp", tempSlider], ["topk", topkSlider], ["reppen", reppenSlider], ["maxlen", maxlenSlider]].forEach(function (pair) {
        var valEl = document.getElementById(pair[0] + "-val");
        pair[1].addEventListener("input", function () { valEl.textContent = pair[1].value; });
      });

      var prefillSession, decodeSession, tokenizer, modelConfig, ort;

      function setStatus(text, cls) {
        statusBanner.innerHTML = text;
        statusBanner.className = cls || "";
      }

      function updateProgress(title, detail, pct) {
        if (loadTitle) loadTitle.textContent = title;
        if (loadDetail) loadDetail.textContent = detail;
        if (loadingBar) loadingBar.style.width = pct + "%";
        setStatus(title);
      }

      function setActiveStage(name) {
        sigPills.forEach(function (p) {
          p.classList.toggle("active", p.dataset.stage === name);
        });
      }

      function getOrtInstance() {
        if (window.ort) return Promise.resolve(window.ort);
        return new Promise(function (resolve) {
          var check = setInterval(function () {
            if (window.ort) {
              clearInterval(check);
              resolve(window.ort);
            }
          }, 50);
        });
      }

      // Sampling with Repetition Penalty & Temperature & Top-K
      function sampleWithRepetitionPenalty(logits, vocabSize, temperature, topK, repPenalty, seenTokenSet) {
        var logitsCopy = new Float32Array(logits);

        if (repPenalty !== 1.0 && seenTokenSet.size > 0) {
          seenTokenSet.forEach(function (id) {
            if (id < vocabSize) {
              if (logitsCopy[id] < 0) {
                logitsCopy[id] *= repPenalty;
              } else {
                logitsCopy[id] /= repPenalty;
              }
            }
          });
        }

        var scaled = logitsCopy.map(function (v) { return v / temperature; });

        var indices = Array.from({ length: vocabSize }, function (_, i) { return i; });
        indices.sort(function (a, b) { return scaled[b] - scaled[a]; });
        var top = indices.slice(0, topK);

        var maxVal = scaled[top[0]];
        var exps = top.map(function (i) { return Math.exp(scaled[i] - maxVal); });
        var sum = exps.reduce(function (a, b) { return a + b; }, 0);
        var probs = exps.map(function (v) { return v / sum; });

        var r = Math.random(), cum = 0;
        for (var i = 0; i < top.length; i++) {
          cum += probs[i];
          if (r <= cum) return top[i];
        }
        return top[0];
      }

      async function startLoadingModel() {
        startLoadBtn.style.display = "none";
        loadingBox.style.display = "flex";

        try {
          updateProgress("Initializing ONNX Runtime Web engine...", "Loading WASM runtime...", 10);
          ort = await getOrtInstance();

          if (ort && ort.env && ort.env.wasm) {
            ort.env.wasm.wasmPaths = "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.19.0/dist/";
            if (typeof SharedArrayBuffer === "undefined") {
              ort.env.wasm.numThreads = 1;
            } else {
              ort.env.wasm.numThreads = Math.min(navigator.hardwareConcurrency || 4, 4);
            }
          }

          updateProgress("Fetching model configuration...", "Reading model_config.json...", 25);
          var configRes = await fetch(MODEL_CONFIG_URL);
          if (!configRes.ok) throw new Error("Could not fetch model_config.json");
          modelConfig = await configRes.json();

          updateProgress("Loading tokenizer (Qwen2.5)...", "Preparing vocabulary table (151.6K tokens)...", 40);
          tokenizer = await AutoTokenizer.from_pretrained(TOKENIZER_REPO);

          updateProgress("Downloading prefill model (320 MB)...", "Loading prompt encoding graph...", 60);
          var prefillRes = await fetch(PREFILL_MODEL_URL);
          if (!prefillRes.ok) throw new Error("Could not fetch tiny_convmem_lm_prefill.onnx");
          var prefillBuf = new Uint8Array(await prefillRes.arrayBuffer());

          updateProgress("Compiling prefill WASM session...", "Building neural network graph for context analysis...", 75);
          prefillSession = await ort.InferenceSession.create(prefillBuf, { executionProviders: ["wasm"] });

          updateProgress("Downloading decode weights (165 MB)...", "Loading generation weights...", 90);
          var decodeRes = await fetch(DECODE_MODEL_URL);
          if (!decodeRes.ok) throw new Error("Could not fetch tiny_convmem_lm_decode.onnx");
          var decodeBuf = new Uint8Array(await decodeRes.arrayBuffer());

          var decodeDataRes = await fetch("/tiny_convmem_lm_onnx_export/tiny_convmem_lm_decode.onnx.data");
          if (!decodeDataRes.ok) throw new Error("Could not fetch tiny_convmem_lm_decode.onnx.data");
          var decodeDataBuf = new Uint8Array(await decodeDataRes.arrayBuffer());

          updateProgress("Compiling decode WASM session...", "Finalizing session compilation...", 100);
          decodeSession = await ort.InferenceSession.create(decodeBuf, {
            executionProviders: ["wasm"],
            externalData: [
              {
                data: decodeDataBuf,
                path: "tiny_convmem_lm_decode.onnx.data"
              }
            ]
          });

          setTimeout(function() {
            if (loadingBox) loadingBox.style.display = "none";
          }, 800);

          setStatus("Model loaded and ready.", "ok");
          promptEl.disabled = false;
          sendBtn.disabled = false;
          promptEl.focus();
        } catch (err) {
          console.error(err);
          var msg = (err && err.message) ? err.message : String(err);
          updateProgress("Initialization Error", msg, 0);
          if (loadSpinner) loadSpinner.style.display = "none";
          setStatus("Failed to load model: " + msg, "warn");
        }
      }

      async function generate() {
        var promptText = promptEl.value.trim();
        if (!promptText) return;

        heroGreeting.style.display = "none";
        promptEl.value = "";
        promptEl.disabled = true;
        sendBtn.disabled = true;

        // User message bubble
        var userRow = document.createElement("div");
        userRow.className = "msg-row msg-user";
        userRow.innerHTML = '<div class="msg-avatar">M</div><div class="msg-content"></div>';
        userRow.querySelector(".msg-content").textContent = promptText;
        messagesList.appendChild(userRow);

        // Assistant message bubble
        var assistantRow = document.createElement("div");
        assistantRow.className = "msg-row msg-assistant";
        assistantRow.innerHTML = '<div class="msg-avatar">LM</div><div class="msg-content" id="active-target"></div>';
        messagesList.appendChild(assistantRow);
        var targetEl = assistantRow.querySelector("#active-target");
        targetEl.removeAttribute("id");

        var temperature  = parseFloat(tempSlider.value);
        var topK         = parseInt(topkSlider.value, 10);
        var repPenalty   = parseFloat(reppenSlider.value);
        var maxNewTokens = parseInt(maxlenSlider.value, 10);

        setActiveStage("input");
        setStatus("Encoding prompt (Prefill)...");

        try {
          var encoded  = await tokenizer(promptText, { return_tensor: false });
          var inputIds = encoded.input_ids;
          var vocabSize = modelConfig.vocab_size;
          var t0 = performance.now();

          var seenTokens = new Set(inputIds);

          // Prefill
          setActiveStage("cnn");
          var bigIds = new BigInt64Array(inputIds.length);
          for (var i = 0; i < inputIds.length; i++) bigIds[i] = BigInt(inputIds[i]);
          var prefillInput = new ort.Tensor("int64", bigIds, [1, inputIds.length]);
          var prefillResult = await prefillSession.run({ input_ids: prefillInput });
          var hidden = prefillResult.hidden_out;

          setActiveStage("gru");
          var start = (inputIds.length - 1) * vocabSize;
          var lastLogits = Array.from(prefillResult.logits.data.slice(start, start + vocabSize));

          var nextId = sampleWithRepetitionPenalty(lastLogits, vocabSize, temperature, topK, repPenalty, seenTokens);
          var generatedIds = [nextId];
          seenTokens.add(nextId);
          targetEl.textContent += await tokenizer.decode([nextId]);

          // Decode loop
          setActiveStage("output");
          setStatus("Generating response tokens...");
          
          var consecutiveSameCount = 0;
          var lastSeenId = nextId;

          for (var step = 1; step < maxNewTokens; step++) {
            var tokenBig = new BigInt64Array([BigInt(nextId)]);
            var tokenTensor = new ort.Tensor("int64", tokenBig, [1, 1]);
            var decResult = await decodeSession.run({ input_ids: tokenTensor, hidden_in: hidden });
            hidden = decResult.hidden_out;

            var stepLogits = Array.from(decResult.logits.data.slice(0, vocabSize));
            nextId = sampleWithRepetitionPenalty(stepLogits, vocabSize, temperature, topK, repPenalty, seenTokens);

            // EOS token check
            if (tokenizer.eos_token_id != null && nextId === tokenizer.eos_token_id) break;

            // Loop detector: stop if same token repeats 3 times consecutively
            if (nextId === lastSeenId) {
              consecutiveSameCount++;
              if (consecutiveSameCount >= 3) break;
            } else {
              consecutiveSameCount = 0;
              lastSeenId = nextId;
            }

            generatedIds.push(nextId);
            seenTokens.add(nextId);
            targetEl.textContent += await tokenizer.decode([nextId]);

            var currentElapsed = performance.now() - t0;
            var currentTps = (generatedIds.length / (currentElapsed / 1000)).toFixed(1);
            tpsTag.textContent = currentTps + " tok/s";
            if (sideTps) sideTps.textContent = currentTps;

            if (step % 3 === 0) await new Promise(function (r) { setTimeout(r, 0); });
          }

          var elapsed = performance.now() - t0;
          var tps = (generatedIds.length / (elapsed / 1000)).toFixed(1);
          tpsTag.textContent = tps + " tok/s";
          if (sideTps) sideTps.textContent = tps;
          setStatus("Generation complete (" + generatedIds.length + " tokens, " + tps + " tok/s)", "ok");
          setActiveStage("input");
        } catch (err) {
          console.error(err);
          var msg = (err && err.message) ? err.message : String(err);
          setStatus("Generation error: " + msg, "warn");
        } finally {
          promptEl.disabled = false;
          sendBtn.disabled = false;
          promptEl.focus();
        }
      }

      startLoadBtn.addEventListener("click", startLoadingModel);
      sendBtn.addEventListener("click", generate);
      promptEl.addEventListener("keydown", function (e) {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          generate();
        }
      });
    </script>
    <Watermark />
  </body>
</html>
