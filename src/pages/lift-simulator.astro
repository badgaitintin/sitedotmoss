---
// lift-simulator.astro — 2-DOF UPDN Lift Simulation (Architectural CAD Workbench)
// Layout: Rigid 3-Column CAD Workstation (Controls Left | 3D Center | Readout Right)
// Zero Border Radius, Monochromatic Architectural Drafting Art Direction
import "@fontsource/google-sans-flex";
import Watermark from "../components/Watermark.astro";
---

<html lang="th">
<head>
	<meta charset="utf-8" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content="2-DOF UPDN Lift Simulation — Architectural CAD Workbench & Kinematics Blueprint" />
	<title>2-DOF UPDN Lift Simulation — site(.)moss</title>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>
	<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js" is:inline></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" is:inline defer></script>

	<style is:global>
		/* ========================================================
		   STRICT ARCHITECTURAL CAD WORKBENCH (NO ROUNDED CORNERS)
		======================================================== */
		:root {
			--cad-bg: #09090c;
			--cad-panel: #101015;
			--cad-surface: #15151c;
			--cad-border: #272732;
			--cad-border-light: #424252;
			--cad-text: #f4f4f6;
			--cad-sub: #a1a1aa;
			--cad-dim: #71717a;
			--cad-grid: rgba(255, 255, 255, 0.04);
			--font: 'DM Sans', 'Google Sans Flex', system-ui, sans-serif;
			--mono: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
		}

		*, *::before, *::after {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
			border-radius: 0px !important; /* STRICTLY NO ROUNDED CORNERS */
			-webkit-tap-highlight-color: transparent;
		}

		html, body {
			width: 100vw;
			height: 100vh;
			overflow: hidden;
			background: var(--cad-bg);
			color: var(--cad-text);
			font-family: var(--font);
			font-size: 13px;
			-webkit-font-smoothing: antialiased;
		}

		/* ================================
		   RIGID WORKSTATION GRID LAYOUT
		================================ */
		.cad-workstation {
			display: grid;
			grid-template-rows: 44px 1fr 34px;
			grid-template-columns: 320px 1fr 340px;
			grid-template-areas: 
				"topbar topbar topbar"
				"leftdock center3d rightdock"
				"bottombar bottombar bottombar";
			width: 100vw;
			height: 100vh;
			overflow: hidden;
			background: var(--cad-bg);
		}

		/* ================================
		   TOP BAR
		================================ */
		.cad-topbar {
			grid-area: topbar;
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: var(--cad-panel);
			border-bottom: 1px solid var(--cad-border);
			padding: 0 16px;
			user-select: none;
			z-index: 20;
		}

		.topbar-left {
			display: flex;
			align-items: center;
			gap: 16px;
		}

		.cad-nav-link {
			color: var(--cad-sub);
			text-decoration: none;
			font-size: 0.76rem;
			font-family: var(--mono);
			display: flex;
			align-items: center;
			gap: 6px;
			transition: color 0.15s;
		}
		.cad-nav-link:hover { color: #ffffff; }

		.cad-main-title {
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			font-family: var(--mono);
			border-left: 1px solid var(--cad-border);
			padding-left: 14px;
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.cad-tag {
			background: #1c1c24;
			border: 1px solid var(--cad-border);
			color: #ffffff;
			font-size: 0.65rem;
			padding: 2px 6px;
			font-family: var(--mono);
			font-weight: 600;
		}

		.topbar-right {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.cad-btn-spec {
			background: var(--cad-surface);
			border: 1px solid var(--cad-border);
			color: var(--cad-text);
			padding: 4px 10px;
			font-size: 0.72rem;
			font-family: var(--mono);
			cursor: pointer;
			display: flex;
			align-items: center;
			gap: 6px;
			transition: all 0.15s;
		}
		.cad-btn-spec:hover {
			background: #242430;
			border-color: var(--cad-border-light);
		}

		/* ================================
		   LEFT CONTROL DOCK
		================================ */
		.cad-leftdock {
			grid-area: leftdock;
			background: var(--cad-panel);
			border-right: 1px solid var(--cad-border);
			display: flex;
			flex-direction: column;
			gap: 14px;
			padding: 16px;
			overflow-y: auto;
			user-select: none;
			scrollbar-width: thin;
			scrollbar-color: var(--cad-border) transparent;
		}

		.dock-header {
			font-size: 0.68rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			font-family: var(--mono);
			font-weight: 700;
			color: var(--cad-dim);
			border-bottom: 1px solid var(--cad-border);
			padding-bottom: 5px;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.control-group {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}

		.control-row {
			display: grid;
			grid-template-columns: 110px 1fr 58px;
			align-items: center;
			gap: 8px;
		}

		.control-label {
			font-size: 0.74rem;
			font-weight: 600;
			color: var(--cad-text);
		}
		.control-label span {
			display: block;
			font-size: 0.62rem;
			color: var(--cad-dim);
			font-weight: 400;
			font-family: var(--mono);
		}

		input[type="range"] {
			width: 100%;
			height: 3px;
			background: #252530;
			cursor: pointer;
			-webkit-appearance: none;
			appearance: none;
			outline: none;
		}
		input[type="range"]::-webkit-slider-thumb {
			-webkit-appearance: none;
			width: 10px;
			height: 16px;
			background: #ffffff;
			border: 1px solid #000000;
			cursor: pointer;
		}
		input[type="range"] { accent-color: #ffffff; }

		.cad-num-box {
			background: #09090d;
			border: 1px solid var(--cad-border);
			color: #ffffff;
			padding: 4px 6px;
			font-size: 0.78rem;
			text-align: right;
			font-family: var(--mono);
			width: 100%;
			outline: none;
		}
		.cad-num-box:focus { border-color: var(--cad-border-light); }

		.preset-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 6px;
		}

		.cad-btn-preset {
			background: var(--cad-surface);
			border: 1px solid var(--cad-border);
			color: var(--cad-text);
			padding: 7px 8px;
			font-size: 0.68rem;
			font-family: var(--mono);
			cursor: pointer;
			transition: all 0.15s;
			text-align: left;
			display: flex;
			align-items: center;
			gap: 6px;
		}
		.cad-btn-preset:hover {
			background: #22222c;
			border-color: var(--cad-border-light);
			color: #ffffff;
		}

		.view-toggles {
			display: flex;
			gap: 4px;
		}

		.cad-toggle-btn {
			flex: 1;
			background: var(--cad-surface);
			border: 1px solid var(--cad-border);
			color: var(--cad-dim);
			padding: 6px;
			font-size: 0.68rem;
			font-family: var(--mono);
			cursor: pointer;
			text-align: center;
			transition: all 0.15s;
		}
		.cad-toggle-btn.active {
			background: #282834;
			border-color: #ffffff;
			color: #ffffff;
		}

		/* Stage Inspiration Card */
		.inspiration-card {
			background: var(--cad-surface);
			border: 1px solid var(--cad-border);
			display: flex;
			flex-direction: column;
			overflow: hidden;
		}

		.inspiration-img {
			width: 100%;
			height: 105px;
			object-fit: cover;
			display: block;
			border-bottom: 1px solid var(--cad-border);
			filter: grayscale(0.85) contrast(1.15);
			transition: filter 0.2s ease;
		}
		.inspiration-card:hover .inspiration-img {
			filter: grayscale(0.1) contrast(1.1);
		}

		.inspiration-body {
			padding: 9px 10px;
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.inspiration-title {
			font-size: 0.68rem;
			font-family: var(--mono);
			font-weight: 700;
			text-transform: uppercase;
			color: #ffffff;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.inspiration-desc {
			font-size: 0.62rem;
			color: var(--cad-dim);
			font-family: var(--mono);
			line-height: 1.45;
		}

		/* ================================
		   CENTER 3D WORKSPACE
		================================ */
		.cad-center3d {
			grid-area: center3d;
			position: relative;
			width: 100%;
			height: 100%;
			background: var(--cad-bg);
			overflow: hidden;
			background-image: 
				linear-gradient(to right, var(--cad-grid) 1px, transparent 1px),
				linear-gradient(to bottom, var(--cad-grid) 1px, transparent 1px);
			background-size: 40px 40px;
		}

		#webgl-canvas {
			width: 100%;
			height: 100%;
			display: block;
		}

		.viewport-overlay-corner {
			position: absolute;
			font-family: var(--mono);
			font-size: 0.65rem;
			color: var(--cad-dim);
			background: rgba(16, 16, 21, 0.85);
			border: 1px solid var(--cad-border);
			padding: 4px 8px;
			pointer-events: none;
			z-index: 10;
		}
		.viewport-top-left { top: 12px; left: 12px; }
		.viewport-bottom-right { bottom: 12px; right: 12px; }

		/* ================================
		   RIGHT KINEMATICS DOCK
		================================ */
		.cad-rightdock {
			grid-area: rightdock;
			background: var(--cad-panel);
			border-left: 1px solid var(--cad-border);
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 16px;
			overflow-y: auto;
			user-select: none;
			scrollbar-width: thin;
			scrollbar-color: var(--cad-border) transparent;
		}

		.hud-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 6px;
		}

		.hud-stat-box {
			background: var(--cad-surface);
			border: 1px solid var(--cad-border);
			padding: 6px 8px;
			text-align: center;
		}

		.stat-title {
			font-size: 0.6rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--cad-dim);
			font-family: var(--mono);
		}

		.stat-value {
			font-size: 0.88rem;
			font-weight: 700;
			font-family: var(--mono);
			color: #ffffff;
			margin-top: 2px;
		}

		.cad-table {
			width: 100%;
			border-collapse: collapse;
			font-family: var(--mono);
			font-size: 0.68rem;
			border: 1px solid var(--cad-border);
		}

		.cad-table th {
			background: #16161e;
			color: var(--cad-sub);
			padding: 5px 6px;
			text-align: center;
			font-weight: 600;
			border: 1px solid var(--cad-border);
		}

		.cad-table td {
			background: #0b0b0f;
			padding: 5px 6px;
			text-align: center;
			color: var(--cad-dim);
			border: 1px solid var(--cad-border);
		}
		.cad-table .val-active { color: #ffffff; font-weight: 700; }

		.matrix-block {
			background: #08080b;
			border: 1px solid var(--cad-border);
			padding: 8px;
			font-family: var(--mono);
			font-size: 0.64rem;
			color: #d4d4d8;
			line-height: 1.45;
			white-space: pre;
			overflow-x: auto;
		}

		.label-mono {
			font-size: 0.62rem;
			color: var(--cad-dim);
			font-family: var(--mono);
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		/* ================================
		   BOTTOM SPEC BAR
		================================ */
		.cad-bottombar {
			grid-area: bottombar;
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: var(--cad-panel);
			border-top: 1px solid var(--cad-border);
			padding: 0 16px;
			font-family: var(--mono);
			font-size: 0.68rem;
			color: var(--cad-dim);
			user-select: none;
			z-index: 20;
		}
		.spec-item { display: flex; gap: 6px; }
		.spec-val { color: var(--cad-text); }

		:global(.watermark-container) {
			bottom: 38px !important;
			z-index: 100 !important;
		}

		/* ================================
		   SPECS & THEORY MODAL
		================================ */
		.cad-modal {
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.85);
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
			z-index: 50;
			display: none;
			align-items: center;
			justify-content: center;
			padding: 24px;
		}
		.cad-modal.active { display: flex; }

		.cad-modal-box {
			background: #0e0e12;
			border: 1px solid var(--cad-border-light);
			width: 680px;
			max-width: 95vw;
			max-height: 85vh;
			display: flex;
			flex-direction: column;
			box-shadow: 0 20px 60px rgba(0,0,0,0.9);
		}

		.cad-modal-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 12px 18px;
			background: #14141a;
			border-bottom: 1px solid var(--cad-border);
			font-family: var(--mono);
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
		}

		.cad-modal-close {
			background: transparent;
			border: 1px solid var(--cad-border);
			color: var(--cad-sub);
			width: 24px;
			height: 24px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.cad-modal-close:hover { background: #22222a; color: #ffffff; }

		.cad-modal-content {
			padding: 18px;
			overflow-y: auto;
			display: flex;
			flex-direction: column;
			gap: 14px;
		}

		.modal-section {
			background: #121217;
			border: 1px solid var(--cad-border);
			padding: 14px;
		}
		.modal-section h3 {
			font-size: 0.78rem;
			font-family: var(--mono);
			text-transform: uppercase;
			color: #ffffff;
			margin-bottom: 6px;
			border-bottom: 1px solid var(--cad-border);
			padding-bottom: 4px;
		}
		.modal-section p, .modal-section li {
			color: var(--cad-sub);
			font-size: 0.78rem;
			line-height: 1.6;
		}
		.modal-section ul { padding-left: 16px; margin-top: 4px; }

		.math-card {
			background: #08080a;
			border: 1px solid var(--cad-border);
			padding: 8px 12px;
			margin: 8px 0;
			text-align: center;
		}

		/* Responsive fallback */
		@media (max-width: 960px) {
			.cad-workstation {
				grid-template-rows: 44px 1fr auto auto 34px;
				grid-template-columns: 1fr;
				grid-template-areas: 
					"topbar"
					"center3d"
					"leftdock"
					"rightdock"
					"bottombar";
				height: auto;
				overflow-y: auto;
			}
			.cad-center3d { min-height: 50vh; }
		}
	</style>
</head>

<body>
	<div class="cad-workstation">
		<!-- TOP BAR -->
		<header class="cad-topbar">
			<div class="topbar-left">
				<a href="/" class="cad-nav-link">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
					site(.)moss
				</a>
				<div class="cad-main-title">
					2-DOF UPDN Lift Simulation
					<span class="cad-tag">STAGE LEVEL BASE [0 &rarr; +400st]</span>
				</div>
			</div>
			<div class="topbar-right">
				<button class="cad-btn-spec" id="btnOpenModal">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
					Kinematics Specs
				</button>
			</div>
		</header>

		<!-- LEFT CONTROL DOCK -->
		<aside class="cad-leftdock">
			<div class="dock-header">
				<span>Actuator Drive (Upward Only)</span>
				<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
			</div>

			<div class="control-group">
				<div class="control-row">
					<div class="control-label">
						LEFTUP2
						<span>0 &rarr; 400st (0.4st/clk)</span>
					</div>
					<input type="range" id="slLeft" min="0" max="400" step="4" value="0">
					<input type="number" id="numLeft" class="cad-num-box" min="0" max="400" value="0">
				</div>

				<div class="control-row">
					<div class="control-label">
						RIGHTUP2
						<span>0 &rarr; 400st (0.4st/clk)</span>
					</div>
					<input type="range" id="slRight" min="0" max="400" step="4" value="0">
					<input type="number" id="numRight" class="cad-num-box" min="0" max="400" value="0">
				</div>

				<div class="control-row">
					<div class="control-label">
						Tilt Angle (&theta;)
						<span>asin((yR-yL)/440)</span>
					</div>
					<input type="range" id="slTh" min="-30" max="30" step="0.5" value="0">
					<input type="number" id="numTh" class="cad-num-box" value="0">
				</div>
			</div>

			<div class="dock-header">
				<span>Operating Presets</span>
			</div>
			<div class="preset-grid">
				<button class="cad-btn-preset" id="pre1">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="2"/></svg>
					1) STAGE (0st)
				</button>
				<button class="cad-btn-preset" id="pre2">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
					2) MID (+160st)
				</button>
				<button class="cad-btn-preset" id="pre3">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V3M4 11l8-8 8 8"/></svg>
					3) HIGH (+360st)
				</button>
				<button class="cad-btn-preset" id="pre4">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 21 18-12M3 21h18"/></svg>
					4) RAMP (0/+240)
				</button>
			</div>

			<div class="dock-header">
				<span>CAD Viewport Modes</span>
			</div>
			<div class="view-toggles">
				<button class="cad-toggle-btn active" id="togWire">Wireframe</button>
				<button class="cad-toggle-btn active" id="togGrid">Draft Grid</button>
				<button class="cad-toggle-btn active" id="togAxes">Center Axes</button>
			</div>

			<div class="dock-header">
				<span>Stage Inspiration</span>
				<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
			</div>
			<div class="inspiration-card">
				<img src="/Joanne-Lift-1.jpg" alt="Joanne World Tour Stage Lift" class="inspiration-img" />
				<div class="inspiration-body">
					<div class="inspiration-title">
						<span>Joanne World Tour (2017)</span>
					</div>
					<p class="inspiration-desc">
						Kinematics and dual hydraulic column risers inspired by Lady Gaga's dynamic concert stage by Tait Towers. Features articulated LED screen pods capable of independent elevation & dramatic pitch ramps.
					</p>
				</div>
			</div>
		</aside>

		<!-- CENTER 3D WORKSPACE -->
		<main class="cad-center3d">
			<div class="viewport-overlay-corner viewport-top-left">
				ELEVATION VIEW // SCALE 1:12.5 [STUDS &rarr; 3D]
			</div>
			<div class="viewport-overlay-corner viewport-bottom-right">
				ORBIT: LEFT-DRAG | PAN: RIGHT-DRAG | ZOOM: SCROLL
			</div>
			<canvas id="webgl-canvas"></canvas>
		</main>

