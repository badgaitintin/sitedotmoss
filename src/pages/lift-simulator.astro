---
import "@fontsource/google-sans-flex";
import Watermark from "../components/Watermark.astro";
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Maize Tassel Counting — site(.)moss</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" />
	<link rel="preload" as="image" href="/optimized/anim_bg_1.webp" />
	<script src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.js" is:inline></script>

	<style is:inline>
		/* ==========================================================================
		   HOMEPAGE DESIGN SYSTEM (MATCHING index.astro)
		   ========================================================================== */
		:root {
			--bg:               #F0EBE4;
			--fg:               #1A1410;
			--tile-bg:          #FFFFFF;
			--tile-border:      rgba(0, 0, 0, 0.08);
			--tile-hover:       #F7F4F0;
			--tile-shadow:      0 2px 8px rgba(0,0,0,0.06);
			--tile-shadow-hover:0 8px 24px rgba(0,0,0,0.12);
			--tile-text:        #1A1410;
			--tile-label-color: rgba(26, 20, 16, 0.55);

			--accent-primary:   #949B7B;
			--accent-blue:      #0071e3;
			--accent-green:     #10b981;

			--font: 'DM Sans', 'Google Sans Flex', system-ui, sans-serif;
			--unit: clamp(56px, 7.4vh, 66px);
			--gap: 6px;
		}

		*, *::before, *::after {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
			-webkit-tap-highlight-color: transparent;
		}

		html, body {
			width: 100%;
			min-height: 100vh;
			background: transparent;
			color: var(--fg);
			font-family: var(--font);
			font-size: 15px;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			overflow-x: hidden;
			scrollbar-width: none;
			position: relative;
		}

		/* Wallpaper Background (Crisp blue sky & fields matching homepage) */
		body::before {
			content: "";
			position: fixed;
			inset: -20px;
			z-index: -1;
			background-image: url('/optimized/anim_bg_1.webp');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			filter: blur(6px);
			-webkit-filter: blur(6px);
			background-color: rgba(255, 255, 255, 0.1);
			background-blend-mode: overlay;
		}

		/* Page Root */
		.page-root {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			padding: 24px 0;
			gap: 16px;
			width: 100%;
		}

		/* Site Header */
		.site-header {
			width: 100%;
			max-width: 100vw;
			padding: 0 32px;
			text-align: center;
			animation: fadeDown 0.8s cubic-bezier(0.1, 0.9, 0.2, 1) both;
		}

		.header-inner {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
		}

		.header-back-link {
			display: inline-flex;
			align-items: center;
			gap: 4px;
			color: var(--tile-label-color);
			font-size: clamp(1.1rem, 2.4vw, 1.8rem);
			font-weight: 300;
			letter-spacing: -0.02em;
			text-decoration: none;
			transition: color 0.2s ease, transform 0.2s ease;
		}
		.header-back-link:hover {
			color: var(--fg);
			transform: translateX(-2px);
		}

		.header-sep {
			color: rgba(0, 0, 0, 0.2);
			font-size: clamp(1.2rem, 2.5vw, 1.8rem);
			font-weight: 200;
		}

		.site-logo {
			font-size: clamp(1.6rem, 3.6vw, 2.6rem);
			font-weight: 300;
			letter-spacing: -0.02em;
			color: var(--fg);
			line-height: 1;
		}

		/* Dashboard Container (Fits Screen, Centered, No Overflow!) */
		.dashboard-scroll {
			width: 100%;
			max-width: 100vw;
			padding: 0 24px;
			overflow-x: auto;
			overflow-y: hidden;
			-ms-overflow-style: none;
			scrollbar-width: none;
			display: flex;
			justify-content: center;
			box-sizing: border-box;
		}
		.dashboard-scroll::-webkit-scrollbar { display: none; }

		@media (max-width: 940px) {
			.dashboard-scroll {
				justify-content: flex-start;
			}
		}

		.dashboard-grid {
			display: flex;
			flex-wrap: nowrap;
			gap: clamp(14px, 2vw, 24px);
			align-items: flex-start;
			width: max-content;
			padding: 4px 0;
		}

		/* Tile Group */
		.tile-group {
			display: flex;
			flex-direction: column;
			gap: 8px;
			flex-shrink: 0;
			animation: fadeUp 0.75s cubic-bezier(0.1, 0.9, 0.2, 1) both;
		}
		.tile-group:nth-child(1) { animation-delay: 0.05s; }
		.tile-group:nth-child(2) { animation-delay: 0.1s; }
		.tile-group:nth-child(3) { animation-delay: 0.15s; }

		.group-label {
			font-size: 9px;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--tile-label-color);
			padding-left: 2px;
		}

		/* 5-Row Tile Grid */
		.tile-grid {
			display: grid;
			grid-template-rows: repeat(5, var(--unit));
			grid-auto-flow: column dense;
			grid-auto-columns: var(--unit);
			gap: var(--gap);
		}

		/* Base Tile */
		.tile {
			background: var(--tile-bg);
			border: 1px solid var(--tile-border);
			box-shadow: var(--tile-shadow);
			position: relative;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: 8px 10px;
			cursor: pointer;
			text-decoration: none;
			color: var(--tile-text);
			transition: transform 0.25s cubic-bezier(0.1, 0.9, 0.2, 1),
						box-shadow 0.25s ease,
						border-color 0.25s ease,
						background 0.2s ease;
			transform: translateZ(0);
			backface-visibility: hidden;
		}
		.tile:hover {
			will-change: transform;
			transform: translateY(-2px) scale(1.012);
			box-shadow: var(--tile-shadow-hover);
			border-color: rgba(0,0,0,0.12);
			background: var(--tile-hover);
		}
		.tile:active {
			transform: scale(0.97);
			transition-duration: 0.06s;
		}

		/* Glow overlay on hover */
		.tile::after {
			content: '';
			position: absolute;
			inset: 0;
			background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.3) 0%, transparent 65%);
			opacity: 0;
			transition: opacity 0.3s ease;
			pointer-events: none;
			z-index: 5;
		}
		.tile:hover::after { opacity: 1; }

		/* Dimensions */
		.t-2x2 { grid-column: span 2; grid-row: span 2; }
		.t-3x1 { grid-column: span 3; grid-row: span 1; }
		.t-3x2 { grid-column: span 3; grid-row: span 2; }
		.t-4x3 { grid-column: span 4; grid-row: span 3; }
		.t-5x5 { grid-column: span 5; grid-row: span 5; }

		/* Labels */
		.tile-label {
			font-size: 7.5px;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--tile-label-color);
			position: relative;
			z-index: 2;
			line-height: 1;
			margin-top: auto;
		}

		/* ==========================================================================
		   NESTED TILES GALLERY (ไทล์ซ้อนไทล์)
		   ========================================================================== */
		.tile-gallery-parent {
			cursor: default;
			padding: 8px 10px;
		}
		.tile-gallery-parent:hover {
			transform: none;
			box-shadow: var(--tile-shadow);
			background: var(--tile-bg);
		}
		.gallery-inner {
			display: flex;
			flex-direction: column;
			height: 100%;
			gap: 5px;
			z-index: 2;
			margin-bottom: 3px;
		}
		.gallery-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0 1px;
		}
		.gallery-title {
			font-size: 9.5px;
			font-weight: 700;
			letter-spacing: 0.05em;
			color: var(--fg);
		}
		.gallery-hint {
			font-size: 8px;
			color: var(--tile-label-color);
			font-weight: 600;
		}
		.nested-tiles-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			grid-template-rows: repeat(2, 1fr);
			gap: 5px;
			flex: 1;
		}
		.nested-sample-tile {
			position: relative;
			border-radius: 2px;
			overflow: hidden;
			border: 1px solid rgba(0, 0, 0, 0.1);
			background: #1e293b;
			cursor: pointer;
			transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: 4px;
		}
		.nested-sample-tile:hover {
			transform: translateY(-2px) scale(1.02);
			border-color: #0071e3;
			box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
		}
		.nested-sample-tile.active-sample {
			border-color: #0071e3;
			box-shadow: 0 0 0 1.5px #0071e3, 0 4px 12px rgba(0, 113, 227, 0.3);
		}
		.nested-img {
			position: absolute;
			inset: 0;
			background-size: cover;
			background-position: center;
			transition: transform 0.4s ease;
		}
		.nested-sample-tile:hover .nested-img {
			transform: scale(1.08);
		}
		.nested-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);
		}
		.nested-gt {
			position: relative;
			z-index: 2;
			align-self: flex-end;
			background: rgba(0, 0, 0, 0.65);
			backdrop-filter: blur(3px);
			-webkit-backdrop-filter: blur(3px);
			color: #34d399;
			font-size: 7.5px;
			font-weight: 700;
			padding: 1px 4px;
			border-radius: 2px;
			line-height: 1.1;
		}
		.nested-name {
			position: relative;
			z-index: 2;
			color: rgba(255, 255, 255, 0.95);
			font-size: 8px;
			font-weight: 700;
			letter-spacing: 0.04em;
			line-height: 1;
			text-shadow: 0 1px 2px rgba(0,0,0,0.7);
		}

		/* ==========================================================================
		   UPLOAD & CONTROLS TILES (2×2 BALANCED)
		   ========================================================================== */
		.tile-action-card {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: 10px;
		}
		.action-card-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 6px;
			flex: 1;
			text-align: center;
			z-index: 2;
		}
		.action-icon-circle {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: rgba(0, 113, 227, 0.08);
			display: flex;
			align-items: center;
			justify-content: center;
			color: #0071e3;
			transition: transform 0.2s ease, background 0.2s ease;
		}
		.tile-action-card:hover .action-icon-circle {
			transform: scale(1.08);
			background: rgba(0, 113, 227, 0.15);
		}
		.action-card-text {
			display: flex;
			flex-direction: column;
			gap: 1px;
		}
		.action-card-title {
			font-size: 10.5px;
			font-weight: 700;
			color: var(--fg);
			line-height: 1.2;
		}
		.action-card-sub {
			font-size: 8px;
			color: var(--tile-label-color);
			line-height: 1.2;
		}

		/* Controls Inside 2x2 */
		.ctrl-box {
			display: flex;
			flex-direction: column;
			gap: 8px;
			flex: 1;
			justify-content: center;
			z-index: 2;
		}
		.ctrl-section {
			display: flex;
			flex-direction: column;
			gap: 3px;
		}
		.ctrl-section-label {
			font-size: 7.5px;
			font-weight: 700;
			color: var(--tile-label-color);
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		/* Segmented 4-button Control (1x1, 2x1, 1x2, 2x2) */
		.segmented-ctrl {
			display: flex;
			background: rgba(0, 0, 0, 0.05);
			border: 1px solid rgba(0, 0, 0, 0.08);
			padding: 2px;
			gap: 2px;
			width: 100%;
			border-radius: 4px;
		}
		.seg-btn {
			flex: 1;
			border: none;
			background: transparent;
			padding: 4px 0;
			font-size: 9px;
			font-family: inherit;
			font-weight: 600;
			color: var(--tile-label-color);
			cursor: pointer;
			border-radius: 3px;
			transition: all .15s ease;
			text-align: center;
		}
		.seg-btn:hover { color: var(--fg); }
		.seg-btn.on {
			background: #ffffff;
			color: var(--fg);
			font-weight: 700;
			box-shadow: 0 1px 2px rgba(0,0,0,0.1);
		}

		.toggle-line {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			padding: 1px 0;
		}
		.toggle-name {
			font-size: 9px;
			font-weight: 700;
			color: var(--fg);
		}
		.clean-toggle {
			width: 26px;
			height: 15px;
			background: rgba(0, 0, 0, 0.15);
			border-radius: 8px;
			position: relative;
			cursor: pointer;
			transition: background-color .2s ease;
		}
		.clean-toggle.on { background: #10b981; }
		.clean-toggle-knob {
			width: 11px;
			height: 11px;
			background: #ffffff;
			border-radius: 50%;
			position: absolute;
			top: 2px;
			left: 2px;
			box-shadow: 0 1px 2px rgba(0,0,0,0.2);
			transition: transform .2s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.clean-toggle.on .clean-toggle-knob {
			transform: translateX(11px);
		}

		/* ==========================================================================
		   VIEWPORT TILE (5×5)
		   ========================================================================== */
		.tile-viewport {
			padding: 0;
			background: #0f141c;
			overflow: hidden;
			position: relative;
			cursor: default;
			border-color: rgba(0, 0, 0, 0.15);
		}
		.tile-viewport:hover {
			transform: none;
			box-shadow: var(--tile-shadow);
		}

		.viewport-drop-facade {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 8px;
			color: #64748b;
			text-align: center;
			padding: 24px;
			cursor: pointer;
			background: #ffffff;
			transition: background 0.2s ease;
			z-index: 2;
		}
		.viewport-drop-facade:hover {
			background: #fafaf9;
		}
		.viewport-drop-facade input {
			position: absolute;
			inset: 0;
			opacity: 0;
			cursor: pointer;
		}
		.vp-facade-title { font-weight: 700; font-size: 13px; color: var(--fg); }
		.vp-facade-sub { font-size: 10px; color: #64748b; }
		.vp-facade-hint { font-size: 9.5px; color: #94a3b8; margin-top: 4px; }

		.viewport-preview {
			position: absolute;
			inset: 0;
			display: none;
			align-items: center;
			justify-content: center;
			background: #0a0d14;
			overflow: hidden;
		}
		.viewport-preview.on { display: flex; }

		.viewport-preview img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
			display: block;
			user-select: none;
			pointer-events: none;
		}

		.viewport-preview canvas {
			position: absolute;
			pointer-events: none;
			display: none;
			z-index: 3;
		}
		.viewport-preview canvas.on { display: block; }

		.viewport-top-bar {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			background: linear-gradient(to bottom, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.25) 70%, transparent 100%);
			padding: 8px 12px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-size: 10px;
			color: #ffffff;
			z-index: 4;
		}
		.vp-btn-reset {
			background: rgba(255, 255, 255, 0.2);
			border: 1px solid rgba(255, 255, 255, 0.35);
			color: #ffffff;
			padding: 2px 7px;
			font-size: 9px;
			font-weight: 700;
			border-radius: 3px;
			cursor: pointer;
			transition: background 0.15s ease;
		}
		.vp-btn-reset:hover {
			background: rgba(255, 255, 255, 0.35);
		}

		.viewport-bottom-bar {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 70%, transparent 100%);
			padding: 8px 12px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-size: 7.5px;
			color: rgba(255, 255, 255, 0.85);
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			z-index: 4;
			pointer-events: none;
		}

		.vp-loading-overlay {
			position: absolute;
			inset: 0;
			background: rgba(15, 20, 28, 0.85);
			backdrop-filter: blur(4px);
			-webkit-backdrop-filter: blur(4px);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 10px;
			color: #ffffff;
			font-size: 11px;
			font-weight: 600;
			z-index: 10;
		}
		.spin-loader {
			width: 24px;
			height: 24px;
			border: 2.5px solid rgba(255, 255, 255, 0.2);
			border-top-color: #38bdf8;
			border-radius: 50%;
			animation: spin 0.75s linear infinite;
		}
		@keyframes spin { to { transform: rotate(360deg); } }

		/* ==========================================================================
		   ESTIMATION RESULT TILE (3×2)
		   ========================================================================== */
		.result-box {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			height: 100%;
			gap: 3px;
			padding: 4px 0;
			z-index: 2;
		}
		.res-number {
			font-size: 36px;
			font-weight: 800;
			color: var(--fg);
			line-height: 1;
			letter-spacing: -0.02em;
		}
		.res-caption {
			font-size: 8.5px;
			font-weight: 700;
			color: var(--tile-label-color);
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}
		.res-meta-row {
			display: flex;
			align-items: center;
			gap: 6px;
			margin-top: 4px;
		}
		.res-gt-tag {
			font-size: 9px;
			color: var(--tile-label-color);
			font-weight: 600;
		}
		.gt-chip-in {
			background: rgba(16, 185, 129, 0.15);
			border: 1px solid rgba(16, 185, 129, 0.35);
			color: #047857;
			padding: 1px 5px;
			border-radius: 2px;
			font-size: 8.5px;
			font-weight: 700;
		}
		.gt-chip-out {
			background: rgba(245, 158, 11, 0.15);
			border: 1px solid rgba(245, 158, 11, 0.35);
			color: #b45309;
			padding: 1px 5px;
			border-radius: 2px;
			font-size: 8.5px;
			font-weight: 700;
		}

		/* Purpose Tile (3×2) */
		.purpose-box {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 6px;
			height: 100%;
			z-index: 2;
			padding: 2px 0;
		}
		.purpose-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.purpose-title {
			font-size: 11px;
			font-weight: 700;
			color: var(--fg);
			letter-spacing: 0.01em;
		}
		.purpose-badge {
			font-size: 7.5px;
			font-weight: 800;
			padding: 2px 5px;
			border-radius: 3px;
			background: rgba(0, 113, 227, 0.08);
			color: #0071e3;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}
		.purpose-text {
			font-size: 9px;
