	<!-- ================================
		 THREE.JS MONOCHROME SIMULATOR SCRIPT
	================================ -->
	<script is:inline>
	(function() {
		'use strict';

		const VERTICAL_PER_CLICK = 0.4;
		const SPAN_STUDS = 440;
		const SCALE_3D = 0.08;

		var state = {
			yL: 0.0,
			yR: 0.0,
			angleDeg: 0.0,
			anchorCenterY: 0.0
		};

		// --- 3D SCENE SETUP ---
		var canvas = document.getElementById('webgl-canvas');
		var container = canvas.parentElement;
		var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
		renderer.setSize(container.clientWidth, container.clientHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFSoftShadowMap;

		var scene = new THREE.Scene();
		scene.background = new THREE.Color(0x09090c);
		scene.fog = new THREE.FogExp2(0x09090c, 0.012);

		var camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.5, 500);
		camera.position.set(0, 20, 68);

		var controls = new THREE.OrbitControls(camera, canvas);
		controls.enableDamping = true;
		controls.dampingFactor = 0.06;
		controls.maxPolarAngle = Math.PI / 2 + 0.01;
		controls.target.set(0, 8, 0);

		// Monochrome Sketch Lighting
		scene.add(new THREE.AmbientLight(0xffffff, 0.85));

		var dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
		dirLight.position.set(30, 60, 40);
		dirLight.castShadow = true;
		scene.add(dirLight);

		var fillLight = new THREE.DirectionalLight(0xffffff, 0.35);
		fillLight.position.set(-30, 20, -20);
		scene.add(fillLight);

		// ==============================
		// MATERIALS & REALISTIC SHADERS
		// ==============================
		var stageDeckMat = new THREE.MeshStandardMaterial({
			color: 0x111116,
			roughness: 0.85,
			metalness: 0.15
		});

		var metalTrimMat = new THREE.MeshStandardMaterial({
			color: 0xd4d4d8,
			roughness: 0.25,
			metalness: 0.85
		});

		var steelTrussMat = new THREE.MeshStandardMaterial({
			color: 0x1c1c24,
			roughness: 0.6,
			metalness: 0.4
		});

		var chromePistonMat = new THREE.MeshStandardMaterial({
			color: 0xe4e4e7,
			roughness: 0.12,
			metalness: 0.96
		});

		var outerSleeveMat = new THREE.MeshStandardMaterial({
			color: 0x0f0f14,
			roughness: 0.7,
			metalness: 0.3
		});

		var ledGlowStripMat = new THREE.MeshBasicMaterial({
			color: 0x60a5fa
		});

		var wireLineMat = new THREE.LineBasicMaterial({ color: 0x555562, transparent: true, opacity: 0.65 });
		var wireLineBrightMat = new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.95 });

		function createWireframeEdges(mesh, mat) {
			var geo = new THREE.EdgesGeometry(mesh.geometry);
			var line = new THREE.LineSegments(geo, mat || wireLineMat);
			mesh.add(line);
			return line;
		}

		// ==============================
		// STAGE FLOOR & PIT (SURROUNDINGS)
		// ==============================
		var colSpan3D = SPAN_STUDS * SCALE_3D; // ~35.2 units
		var floorY = 0;
		var pitDepth = 14;
		var pitWidth = colSpan3D + 12;
		var pitLength = 16;

		var stageGroup = new THREE.Group();

		// Main arena stage deck surrounding the pit
		var stageOuterL = new THREE.Mesh(new THREE.BoxGeometry((140 - pitWidth)/2, 2, 80), stageDeckMat);
		stageOuterL.position.set(-(pitWidth + (140 - pitWidth)/2)/2, -1, 0);
		stageOuterL.receiveShadow = true;
		createWireframeEdges(stageOuterL);
		stageGroup.add(stageOuterL);

		var stageOuterR = new THREE.Mesh(new THREE.BoxGeometry((140 - pitWidth)/2, 2, 80), stageDeckMat);
		stageOuterR.position.set((pitWidth + (140 - pitWidth)/2)/2, -1, 0);
		stageOuterR.receiveShadow = true;
		createWireframeEdges(stageOuterR);
		stageGroup.add(stageOuterR);

		var stageOuterF = new THREE.Mesh(new THREE.BoxGeometry(pitWidth, 2, (80 - pitLength)/2), stageDeckMat);
		stageOuterF.position.set(0, -1, (pitLength + (80 - pitLength)/2)/2);
		stageOuterF.receiveShadow = true;
		createWireframeEdges(stageOuterF);
		stageGroup.add(stageOuterF);

		var stageOuterB = new THREE.Mesh(new THREE.BoxGeometry(pitWidth, 2, (80 - pitLength)/2), stageDeckMat);
		stageOuterB.position.set(0, -1, -(pitLength + (80 - pitLength)/2)/2);
		stageOuterB.receiveShadow = true;
		createWireframeEdges(stageOuterB);
		stageGroup.add(stageOuterB);

		// Sub-stage pit floor
		var pitFloor = new THREE.Mesh(new THREE.BoxGeometry(pitWidth, 1, pitLength), outerSleeveMat);
		pitFloor.position.set(0, -pitDepth, 0);
		pitFloor.receiveShadow = true;
		stageGroup.add(pitFloor);

		// Pit walls
		var pitWallBack = new THREE.Mesh(new THREE.BoxGeometry(pitWidth, pitDepth, 0.4), outerSleeveMat);
		pitWallBack.position.set(0, -pitDepth/2, -pitLength/2);
		stageGroup.add(pitWallBack);

		scene.add(stageGroup);

		// Arena Lighting Truss Overhead
		var arenaTruss = new THREE.Group();
		for (var r = 0; r < 6; r++) {
			for (var c = -7; c <= 7; c++) {
				var panel = new THREE.Mesh(new THREE.BoxGeometry(6, 4, 0.25), outerSleeveMat);
				panel.position.set(c * 6.8, 8 + r * 4.6, -32);
				createWireframeEdges(panel, new THREE.LineBasicMaterial({ color: 0x272734, transparent: true, opacity: 0.4 }));
				arenaTruss.add(panel);
			}
		}
		scene.add(arenaTruss);

		// Drafting Grid
		var draftGrid = new THREE.GridHelper(90, 45, 0x444455, 0x181822);
		draftGrid.position.y = 0.02;
		scene.add(draftGrid);

		// ==============================
		// DYNAMIC CONCERT LED SCREEN TEXTURE
		// ==============================
		var ledCanvas = document.createElement('canvas');
		ledCanvas.width = 1024;
		ledCanvas.height = 256;
		var ledCtx = ledCanvas.getContext('2d');
		var ledTexture = new THREE.CanvasTexture(ledCanvas);

		function updateLedScreen(time) {
			var t = (typeof time === 'number') ? time : 0;
			ledCtx.fillStyle = '#0a0a0f';
			ledCtx.fillRect(0, 0, ledCanvas.width, ledCanvas.height);

			// LED pixel panel modular borders
			ledCtx.strokeStyle = '#181824';
			ledCtx.lineWidth = 1;
			var panelW = 64, panelH = 64;
			for (var px = 0; px < ledCanvas.width; px += panelW) {
				ledCtx.beginPath(); ledCtx.moveTo(px, 0); ledCtx.lineTo(px, ledCanvas.height); ledCtx.stroke();
			}
			for (var py = 0; py < ledCanvas.height; py += panelH) {
				ledCtx.beginPath(); ledCtx.moveTo(0, py); ledCtx.lineTo(ledCanvas.width, py); ledCtx.stroke();
			}

			// Dynamic concert video waves (Lady Gaga Joanne aesthetic)
			var grad = ledCtx.createLinearGradient(0, 0, ledCanvas.width, 0);
			grad.addColorStop(0, '#111827');
			grad.addColorStop(0.3, '#1e293b');
			grad.addColorStop(0.5, '#38bdf8');
			grad.addColorStop(0.7, '#f8fafc');
			grad.addColorStop(0.85, '#38bdf8');
			grad.addColorStop(1, '#0f172a');

			ledCtx.fillStyle = grad;
			ledCtx.beginPath();
			var waveY = 128 + Math.sin(t * 0.002) * 30;
			ledCtx.moveTo(0, ledCanvas.height);
			ledCtx.lineTo(0, waveY);
			for (var x = 0; x <= ledCanvas.width; x += 32) {
				var y = waveY + Math.sin(x * 0.01 + t * 0.003) * 45 + Math.cos(x * 0.02 - t * 0.002) * 20;
				ledCtx.lineTo(x, y);
			}
			ledCtx.lineTo(ledCanvas.width, ledCanvas.height);
			ledCtx.closePath();
			ledCtx.fill();

			// Digital stage graphic scanlines
			ledCtx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
			ledCtx.lineWidth = 2;
			var scanLineY = (t * 0.08) % ledCanvas.height;
			ledCtx.beginPath(); ledCtx.moveTo(0, scanLineY); ledCtx.lineTo(ledCanvas.width, scanLineY); ledCtx.stroke();

			// High-tech Concert Typography
			ledCtx.font = 'bold 16px monospace';
			ledCtx.fillStyle = '#ffffff';
			ledCtx.fillText('JOANNE WORLD TOUR // 2-DOF UPDN LIFT SYSTEM', 24, 38);
			ledCtx.font = '12px monospace';
			ledCtx.fillStyle = '#94a3b8';
			ledCtx.fillText('TAIT STAGE AUTOMATION • DUAL HYDRAULIC RISERS • 440 STUDS SPAN', 24, 60);

			ledTexture.needsUpdate = true;
		}

		// ==============================
		// REALISTIC LIFT PLATFORM ASSEMBLY
		// ==============================
		var screenWidth  = colSpan3D + 6; // Platform length
		var deckDepth    = 6.5;          // Walkable stage depth
		var screenHeight = 8.5;          // Front video fascia height
		var deckThick    = 0.45;

		var screenPivot = new THREE.Group();

		// 1. Walkway Deck Plate (Top surface where performers walk)
		var deckMesh = new THREE.Mesh(new THREE.BoxGeometry(screenWidth, deckThick, deckDepth), stageDeckMat);
		deckMesh.position.set(0, 0, 0);
		deckMesh.castShadow = true;
		deckMesh.receiveShadow = true;
		createWireframeEdges(deckMesh, wireLineBrightMat);
		screenPivot.add(deckMesh);

		// Aluminum edge trim nosings
		var trimF = new THREE.Mesh(new THREE.BoxGeometry(screenWidth + 0.1, 0.5, 0.15), metalTrimMat);
		trimF.position.set(0, 0, deckDepth/2 + 0.05);
		screenPivot.add(trimF);

		var trimB = new THREE.Mesh(new THREE.BoxGeometry(screenWidth + 0.1, 0.5, 0.15), metalTrimMat);
		trimB.position.set(0, 0, -deckDepth/2 - 0.05);
		screenPivot.add(trimB);

		// Glowing LED edge strip on front deck edge
		var ledStrip = new THREE.Mesh(new THREE.BoxGeometry(screenWidth, 0.08, 0.08), ledGlowStripMat);
		ledStrip.position.set(0, deckThick/2 + 0.04, deckDepth/2);
		screenPivot.add(ledStrip);

		// 2. Front Fascia LED Video Screen (Hang below front edge)
		var screenMat = new THREE.MeshStandardMaterial({
			map: ledTexture,
			roughness: 0.35,
			metalness: 0.1,
			emissive: 0x222233,
			emissiveMap: ledTexture,
			emissiveIntensity: 0.6
		});

		var fasciaMesh = new THREE.Mesh(new THREE.BoxGeometry(screenWidth, screenHeight, 0.3), [
			metalTrimMat, metalTrimMat, metalTrimMat, metalTrimMat, screenMat, outerSleeveMat
		]);
		fasciaMesh.position.set(0, -screenHeight/2, deckDepth/2);
		fasciaMesh.castShadow = true;
		createWireframeEdges(fasciaMesh, wireLineBrightMat);
		screenPivot.add(fasciaMesh);

		// 3. Under-Deck Scissor & Space Truss Framework (Tait Towers engineering)
		var trussFramework = new THREE.Group();
		var numBays = 8;
		var bayWidth = screenWidth / numBays;

		// Bottom chord beam
		var bottomChord = new THREE.Mesh(new THREE.BoxGeometry(screenWidth, 0.3, 0.3), steelTrussMat);
		bottomChord.position.set(0, -screenHeight + 0.15, -deckDepth/2 + 0.5);
		trussFramework.add(bottomChord);

		var bottomChordF = new THREE.Mesh(new THREE.BoxGeometry(screenWidth, 0.3, 0.3), steelTrussMat);
		bottomChordF.position.set(0, -screenHeight + 0.15, deckDepth/2 - 0.2);
		trussFramework.add(bottomChordF);

		// Vertical Posts & Cross-Truss Webbing
		for (var b = 0; b <= numBays; b++) {
			var postX = -screenWidth/2 + b * bayWidth;

			// Front-to-back bottom cross beam
			var crossBeam = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.25, deckDepth - 0.7), steelTrussMat);
			crossBeam.position.set(postX, -screenHeight + 0.15, 0);
			trussFramework.add(crossBeam);

			// Vertical structural post
			var vertPost = new THREE.Mesh(new THREE.BoxGeometry(0.25, screenHeight, 0.25), steelTrussMat);
			vertPost.position.set(postX, -screenHeight/2, -deckDepth/2 + 0.5);
			trussFramework.add(vertPost);

			// Diagonal X-bracing between bays
			if (b < numBays) {
				var diagLen = Math.sqrt(bayWidth * bayWidth + screenHeight * screenHeight);
				var diagAngle = Math.atan2(screenHeight, bayWidth);

				var diag1 = new THREE.Mesh(new THREE.BoxGeometry(diagLen, 0.18, 0.18), steelTrussMat);
				diag1.position.set(postX + bayWidth/2, -screenHeight/2, -deckDepth/2 + 0.5);
				diag1.rotation.z = -diagAngle;
				trussFramework.add(diag1);

				var diag2 = new THREE.Mesh(new THREE.BoxGeometry(diagLen, 0.18, 0.18), steelTrussMat);
				diag2.position.set(postX + bayWidth/2, -screenHeight/2, -deckDepth/2 + 0.5);
				diag2.rotation.z = diagAngle;
				trussFramework.add(diag2);
			}
		}

		screenPivot.add(trussFramework);

		// 4. Center Coordinates & Axes Marker
		var axesHelper = new THREE.AxesHelper(6);
		axesHelper.position.set(0, 0, 0);
		screenPivot.add(axesHelper);

		scene.add(screenPivot);

		// ==============================
		// TELESCOPIC HYDRAULIC ACTUATOR COLUMNS
		// ==============================
		// LEFTUP2 Hydraulic Column Assembly
		var leftColGroup = new THREE.Group();
		leftColGroup.position.set(-colSpan3D/2, 0, 0);

		// Heavy Base Footing Flange (mounted to sub-stage pit floor)
		var leftBaseFlange = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.6, 3.6), steelTrussMat);
		leftBaseFlange.position.set(0, -pitDepth + 0.3, 0);
		createWireframeEdges(leftBaseFlange, wireLineBrightMat);
		leftColGroup.add(leftBaseFlange);

		// Outer Hydraulic Barrel Sleeve (Stationary)
		var leftSleeveH = pitDepth;
		var leftOuterSleeve = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 1.3, leftSleeveH, 16), outerSleeveMat);
		leftOuterSleeve.position.set(0, -pitDepth/2, 0);
		createWireframeEdges(leftOuterSleeve);
		leftColGroup.add(leftOuterSleeve);

		// Inner Telescoping Chrome Piston (Extends upward)
		var leftPiston = new THREE.Mesh(new THREE.CylinderGeometry(0.85, 0.85, 1, 16), chromePistonMat);
		createWireframeEdges(leftPiston, wireLineBrightMat);
		leftColGroup.add(leftPiston);

		// Top Mounting Clevis Yoke (Pivots with platform angle)
		var leftYoke = new THREE.Mesh(new THREE.BoxGeometry(1.8, 1.2, 1.8), steelTrussMat);
		leftColGroup.add(leftYoke);

		scene.add(leftColGroup);

		// RIGHTUP2 Hydraulic Column Assembly
		var rightColGroup = new THREE.Group();
		rightColGroup.position.set(colSpan3D/2, 0, 0);

		var rightBaseFlange = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.6, 3.6), steelTrussMat);
		rightBaseFlange.position.set(0, -pitDepth + 0.3, 0);
		createWireframeEdges(rightBaseFlange, wireLineBrightMat);
		rightColGroup.add(rightBaseFlange);

		var rightOuterSleeve = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 1.3, leftSleeveH, 16), outerSleeveMat);
		rightOuterSleeve.position.set(0, -pitDepth/2, 0);
		createWireframeEdges(rightOuterSleeve);
		rightColGroup.add(rightOuterSleeve);

		var rightPiston = new THREE.Mesh(new THREE.CylinderGeometry(0.85, 0.85, 1, 16), chromePistonMat);
		createWireframeEdges(rightPiston, wireLineBrightMat);
		rightColGroup.add(rightPiston);

		var rightYoke = new THREE.Mesh(new THREE.BoxGeometry(1.8, 1.2, 1.8), steelTrussMat);
		rightColGroup.add(rightYoke);

		scene.add(rightColGroup);

		// --- UI UPDATES ---
		var slLeft   = document.getElementById('slLeft');
		var numLeft  = document.getElementById('numLeft');
		var slRight  = document.getElementById('slRight');
		var numRight = document.getElementById('numRight');
		var slTh     = document.getElementById('slTh');
		var numTh    = document.getElementById('numTh');

		var hudLeftY  = document.getElementById('hudLeftY');
		var hudRightY = document.getElementById('hudRightY');
		var hudTilt   = document.getElementById('hudTilt');
		var hudClicks = document.getElementById('hudClicks');
		var dhValL    = document.getElementById('dh-valL');
		var dhHtL     = document.getElementById('dh-htL');
		var dhValR    = document.getElementById('dh-valR');
		var dhHtR     = document.getElementById('dh-htR');
		var dhD1      = document.getElementById('dh-d1');
		var dhD2      = document.getElementById('dh-d2');
		var dhTh3     = document.getElementById('dh-th3');
		var matrixOutput = document.getElementById('matrixOutput');
		var posReadout   = document.getElementById('posReadout');

		function clampUpward(v) { return Math.max(0, Math.min(400, v)); }

		function computeFromColumns() {
			state.yL = clampUpward(state.yL);
			state.yR = clampUpward(state.yR);
			state.anchorCenterY = (state.yL + state.yR) / 2;
			var deltaY = state.yR - state.yL;
			var ratio = Math.max(-1, Math.min(1, deltaY / SPAN_STUDS));
			state.angleDeg = Math.asin(ratio) * (180 / Math.PI);
			syncUI(false);
		}

		function computeFromAngle() {
			var rad = state.angleDeg * (Math.PI / 180);
			var delta = SPAN_STUDS * Math.sin(rad);
			var center = (typeof state.anchorCenterY === 'number') ? state.anchorCenterY : (state.yL + state.yR) / 2;

			if (center <= 1.0) {
				// Stage Level Base: one column stays at 0st, other raises to create tilt ramp
				if (delta >= 0) {
					state.yL = 0;
					state.yR = clampUpward(delta);
				} else {
					state.yR = 0;
					state.yL = clampUpward(-delta);
				}
			} else {
				// Raised Elevation: pivot symmetrically around center height
				var half = delta / 2;
				var newL = center - half;
				var newR = center + half;
				if (newL < 0) { newL = 0; }
				if (newR < 0) { newR = 0; }
				state.yL = clampUpward(newL);
				state.yR = clampUpward(newR);
			}
			syncUI(true);
		}

		function syncUI(skipAngleInput) {
			slLeft.value = state.yL.toFixed(1);
			numLeft.value = state.yL.toFixed(1);
			slRight.value = state.yR.toFixed(1);
			numRight.value = state.yR.toFixed(1);

			if (!skipAngleInput) {
				slTh.value = state.angleDeg.toFixed(1);
				numTh.value = state.angleDeg.toFixed(1);
			} else {
				numTh.value = state.angleDeg.toFixed(1);
			}

			var clkL = Math.round(state.yL / VERTICAL_PER_CLICK);
			var clkR = Math.round(state.yR / VERTICAL_PER_CLICK);
			var midY = (state.yL + state.yR) / 2;

			hudLeftY.textContent  = state.yL.toFixed(1) + ' st';
			hudRightY.textContent = state.yR.toFixed(1) + ' st';
			hudTilt.textContent   = state.angleDeg.toFixed(1) + '°';
			hudClicks.textContent = clkL + ' / ' + clkR;

			// Actuator Table
			if (dhValL) dhValL.textContent = clkL;
			if (dhHtL)  dhHtL.textContent  = state.yL.toFixed(1) + ' st';
			if (dhValR) dhValR.textContent = clkR;
			if (dhHtR)  dhHtR.textContent  = state.yR.toFixed(1) + ' st';

			// DH Parameter Table
			if (dhD1)  dhD1.textContent  = state.yL.toFixed(1);
			if (dhD2)  dhD2.textContent  = state.yR.toFixed(1);
			if (dhTh3) dhTh3.textContent = state.angleDeg.toFixed(1) + '°';

			var rad = state.angleDeg * Math.PI / 180;
			var cosStr = Math.cos(rad).toFixed(4);
			var sinStr = Math.sin(rad).toFixed(4);
			var negSinStr = (-Math.sin(rad)).toFixed(4);

			matrixOutput.textContent = 
'[ ' + cosStr.padStart(8) + ' ' + negSinStr.padStart(8) + '   0.0000       0.000 ]\n' +
'[ ' + sinStr.padStart(8) + ' ' + cosStr.padStart(8) + '   0.0000  ' + midY.toFixed(2).padStart(10) + ' ]\n' +
'[   0.0000   0.0000   1.0000     410.000 ]\n' +
'[   0.0000   0.0000   0.0000       1.000 ]';

			posReadout.textContent =
'Center Elevation (yC) : ' + midY.toFixed(2) + ' studs (>= 0)\n' +
'Delta Travel (yR - yL): ' + (state.yR - state.yL).toFixed(2) + ' studs\n' +
'Span (L)             : ' + SPAN_STUDS + ' studs (fixed base)\n' +
'Pitch Angle (θ)      : ' + state.angleDeg.toFixed(2) + ' deg';

			var yL_3D = state.yL * SCALE_3D;
			var yR_3D = state.yR * SCALE_3D;
			var midY_3D = (yL_3D + yR_3D) / 2;
			var rotZ = Math.atan2(yR_3D - yL_3D, colSpan3D);

			screenPivot.position.set(0, floorY + midY_3D, 0);
			screenPivot.rotation.z = rotZ;

			// LEFTUP2 Hydraulic Chrome Telescopic Piston
			var totalLeftLen = Math.max(0.1, pitDepth + yL_3D);
			leftPiston.scale.set(1, totalLeftLen, 1);
			leftPiston.position.set(0, -pitDepth + totalLeftLen / 2, 0);
			leftYoke.position.set(0, floorY + yL_3D, 0);
			leftYoke.rotation.z = rotZ;

			// RIGHTUP2 Hydraulic Chrome Telescopic Piston
			var totalRightLen = Math.max(0.1, pitDepth + yR_3D);
			rightPiston.scale.set(1, totalRightLen, 1);
			rightPiston.position.set(0, -pitDepth + totalRightLen / 2, 0);
			rightYoke.position.set(0, floorY + yR_3D, 0);
			rightYoke.rotation.z = rotZ;
		}

		slLeft.addEventListener('input', function() { state.yL = parseFloat(slLeft.value); computeFromColumns(); });
		numLeft.addEventListener('change', function() { state.yL = parseFloat(numLeft.value) || 0; computeFromColumns(); });
		slRight.addEventListener('input', function() { state.yR = parseFloat(slRight.value); computeFromColumns(); });
		numRight.addEventListener('change', function() { state.yR = parseFloat(numRight.value) || 0; computeFromColumns(); });

		slTh.addEventListener('pointerdown', function() {
			state.anchorCenterY = (state.yL + state.yR) / 2;
		});
		slTh.addEventListener('input', function() { state.angleDeg = parseFloat(slTh.value); computeFromAngle(); });
		numTh.addEventListener('change', function() {
			state.anchorCenterY = (state.yL + state.yR) / 2;
			state.angleDeg = parseFloat(numTh.value) || 0;
			computeFromAngle();
		});

		function applyPreset(yL, yR) {
			state.yL = clampUpward(yL);
			state.yR = clampUpward(yR);
			computeFromColumns();
		}

		document.getElementById('pre1').addEventListener('click', function() { applyPreset(0, 0); });
		document.getElementById('pre2').addEventListener('click', function() { applyPreset(160, 160); });
		document.getElementById('pre3').addEventListener('click', function() { applyPreset(360, 360); });
		document.getElementById('pre4').addEventListener('click', function() { applyPreset(0, 240); });

		var togWire = document.getElementById('togWire');
		var togGrid = document.getElementById('togGrid');
		var togAxes = document.getElementById('togAxes');

		togWire.addEventListener('click', function() {
			togWire.classList.toggle('active');
			var v = togWire.classList.contains('active');
			scene.traverse(function(obj) { if (obj instanceof THREE.LineSegments) obj.visible = v; });
		});

		togGrid.addEventListener('click', function() {
			togGrid.classList.toggle('active');
			draftGrid.visible = togGrid.classList.contains('active');
		});

		togAxes.addEventListener('click', function() {
			togAxes.classList.toggle('active');
			axesHelper.visible = togAxes.classList.contains('active');
		});

		// Modal & KaTeX formula renderer
		function renderModalMath() {
			if (typeof katex === 'undefined') return;
			var items = [
				{ id: 'math-theta', tex: '\\theta = \\arcsin\\left(\\frac{y_R - y_L}{440}\\right)' },
				{ id: 'math-yc', tex: 'y_C = \\frac{y_L + y_R}{2}' },
				{ id: 'math-twe', tex: 'T_{WE} = \\begin{bmatrix} \\cos\\theta & -\\sin\\theta & 0 & 0 \\\\ \\sin\\theta & \\cos\\theta & 0 & y_C \\\\ 0 & 0 & 1 & 410 \\\\ 0 & 0 & 0 & 1 \\end{bmatrix}' },
				{ id: 'math-cframe', tex: '\\text{CFrame}_{E} = \\text{CFrame.new}(0, y_C, 410) \\cdot \\text{CFrame.Angles}(0, 0, \\theta)' }
			];
			items.forEach(function(item) {
				var el = document.getElementById(item.id);
				if (el) {
					try {
						katex.render(item.tex, el, { displayMode: true, throwOnError: false });
					} catch(e) {
						el.textContent = item.tex;
					}
				}
			});
		}

		var theoryModal = document.getElementById('theoryModal');
		var btnOpenModal = document.getElementById('btnOpenModal');
		var btnCloseModal = document.getElementById('btnCloseModal');

		btnOpenModal.addEventListener('click', function() {
			theoryModal.classList.add('active');
			renderModalMath();
		});

		btnCloseModal.addEventListener('click', function() { theoryModal.classList.remove('active'); });
		theoryModal.addEventListener('click', function(e) { if (e.target === theoryModal) theoryModal.classList.remove('active'); });

		function handleResize() {
			var w = container.clientWidth;
			var h = container.clientHeight;
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			renderer.setSize(w, h);
		}

		window.addEventListener('resize', handleResize);

		function animate() {
			requestAnimationFrame(animate);
			controls.update();
			updateLedScreen(performance.now());
			renderer.render(scene, camera);
		}

		computeFromColumns();
		handleResize();
		animate();

	})();
	</script>
</body>
</html>
