	<script is:inline>
	(function(){
		var W=256, H=384;
		var MEAN=[.485,.456,.406], STD=[.229,.224,.225];

		// Samples metadata: Lightweight thumbnails on tiles, full 4.8MB loaded ONLY on test click!
		var SAMPLES = {
			'DJI_0238': { id: 'DJI_0238', name: 'DJI_0238.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0238_thumb.jpg', full: '/maize_tassel/sample/DJI_0238.JPG', gtMin: 295, gtMax: 330, gtText: '295 – 330' },
			'DJI_0247': { id: 'DJI_0247', name: 'DJI_0247.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0247_thumb.jpg', full: '/maize_tassel/sample/DJI_0247.JPG', gtMin: 270, gtMax: 305, gtText: '270 – 305' },
			'DJI_0263': { id: 'DJI_0263', name: 'DJI_0263.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0263_thumb.jpg', full: '/maize_tassel/sample/DJI_0263.JPG', gtMin: 250, gtMax: 285, gtText: '250 – 285' },
			'DJI_0808': { id: 'DJI_0808', name: 'DJI_0808.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0808_thumb.jpg', full: '/maize_tassel/sample/DJI_0808.JPG', gtMin: 310, gtMax: 345, gtText: '310 – 345' },
			'DJI_0815': { id: 'DJI_0815', name: 'DJI_0815.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0815_thumb.jpg', full: '/maize_tassel/sample/DJI_0815.JPG', gtMin: 320, gtMax: 360, gtText: '320 – 360' },
			'DJI_0900': { id: 'DJI_0900', name: 'DJI_0900.jpg', thumb: '/maize_tassel/sample/thumbs/DJI_0900_thumb.jpg', full: '/maize_tassel/sample/DJI_0900.JPG', gtMin: 210, gtMax: 245, gtText: '210 – 245' }
		};

		var session=null, showGrid=false, cells=null;
		var currentSrc=null, currentImg=null, currentSample=null;
		var tileCols=1, tileRows=1;
		var currentGridCols=8, currentGridRows=8;

		var viewportTile=document.getElementById('tile-viewport');
		var dropZone=document.getElementById('dropZone');
		var fileInput=document.getElementById('fileInput');
		var previewWrap=document.getElementById('previewWrap');
		var previewImg=document.getElementById('previewImg');
		var previewBarName=document.getElementById('previewBarName');
		var previewBarRes=document.getElementById('previewBarRes');
		var vpGridStatus=document.getElementById('vpGridStatus');
		var gridCanvas=document.getElementById('gridCanvas');
		var ppCanvas=document.getElementById('ppCanvas');
		var resCount=document.getElementById('resCount');
		var resMeta=document.getElementById('resMeta');
		var resGtTag=document.getElementById('resGtTag');
		var resBadge=document.getElementById('resBadge');
		var btnReset=document.getElementById('btnReset');
		var togGrid=document.getElementById('togGrid');
		var tileBtns=document.querySelectorAll('.seg-btn');
		var gridLabel=document.getElementById('gridLabel');
		var nestedTiles=document.querySelectorAll('.nested-sample-tile');

		// Nested sample tile click handlers
		nestedTiles.forEach(function(tile){
			tile.addEventListener('click', function(){
				var sid = tile.getAttribute('data-id');
				var sample = SAMPLES[sid];
				if (sample) selectSample(sample);
			});
		});

		function updateSampleUI(){
			var activeId = currentSample ? currentSample.id : null;
			nestedTiles.forEach(function(el){
				el.classList.toggle('active-sample', el.getAttribute('data-id') === activeId);
			});
		}

		// When sample is selected, load the full high-res 4.8MB image and run inference
		function selectSample(sample){
			currentSample = sample;
			updateSampleUI();

			showViewportLoading('Loading ' + sample.name + '...');

			var img = new Image();
			img.onload = function(){
				if (previewBarName) previewBarName.textContent = sample.name;
				updatePreviewRes(img);
				go(sample.full, img);
			};
			img.onerror = function(){
				hideViewportLoading();
				alert('Could not load high-res drone image. Please try again.');
			};
			img.src = sample.full;
		}

		function updatePreviewRes(img){
			if (!previewBarRes || !img) return;
			var sliceTag = (tileCols > 1 || tileRows > 1) ? ' · ' + tileCols + '×' + tileRows + ' Slices' : '';
			previewBarRes.textContent = (img.naturalWidth || img.width) + '×' + (img.naturalHeight || img.height) + ' px' + sliceTag;
		}

		function showViewportLoading(msg){
			var ov = document.getElementById('vpLoadingOverlay');
			if (!ov) {
				ov = document.createElement('div');
				ov.className = 'vp-loading-overlay';
				ov.id = 'vpLoadingOverlay';
				viewportTile.appendChild(ov);
			}
			ov.innerHTML = '<div class="spin-loader"></div><div>' + (msg || 'Processing...') + '</div>';
		}

		function hideViewportLoading(){
			var ov = document.getElementById('vpLoadingOverlay');
			if (ov) ov.remove();
		}

		// Init ONNX Model
		(async function(){
			try {
				ort.env.wasm.numThreads = 1;
				ort.env.wasm.wasmPaths = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/';

				var MODEL_URL = '/maize_tassel/tassel_v4_5_top1_seed2024.onnx';
				var DATA_URL = '/maize_tassel/tassel_v4_5_top1_seed2024.onnx.data';
				var DATA_NAME = 'tassel_v4_5_top1_seed2024.onnx.data';

				async function fetchWithProgress(url, label) {
					var cache = null;
					try {
						if ('caches' in window) {
							cache = await caches.open('maize-tassel-v1');
							var cached = await cache.match(url);
							if (cached) return await cached.arrayBuffer();
						}
					} catch(ce) {}

					var res = await fetch(url);
					if (!res.ok) throw new Error('HTTP ' + res.status + ' on ' + url);

					var total = parseInt(res.headers.get('content-length') || '0', 10);
					if (!total || !res.body) {
						var b = await res.arrayBuffer();
						if (cache) try { cache.put(url, new Response(b.slice(0))); } catch(e){}
						return b;
					}

					var reader = res.body.getReader();
					var chunks = [];
					var loaded = 0;
					while (true) {
						var part = await reader.read();
						if (part.done) break;
						chunks.push(part.value);
						loaded += part.value.length;
					}

					var all = new Uint8Array(loaded);
					var off = 0;
					for (var i = 0; i < chunks.length; i++) {
						all.set(chunks[i], off);
						off += chunks[i].length;
					}

					if (cache) {
						try { cache.put(url, new Response(all.slice(0))); } catch(e){}
					}
					return all.buffer;
				}

				var modelBuf = await fetchWithProgress(MODEL_URL, 'Graph');
				var dataBuf = await fetchWithProgress(DATA_URL, 'Weights');

				session = await ort.InferenceSession.create(modelBuf, {
					executionProviders: ['wasm'],
					externalData: [
						{
							path: DATA_NAME,
							data: dataBuf
						}
					]
				});

				// Auto-load first sample for an instant live demonstration
				if (!currentSample && SAMPLES['DJI_0238']) {
					selectSample(SAMPLES['DJI_0238']);
				}
			} catch(e) {
				console.error(e);
			}
		})();

		// Slicing buttons (1x1, 2x1, 1x2, 2x2)
		tileBtns.forEach(function(btn){
			btn.addEventListener('click', function(e){
				e.stopPropagation();
				var cols = parseInt(btn.getAttribute('data-cols'), 10) || 1;
				var rows = parseInt(btn.getAttribute('data-rows'), 10) || 1;
				if (cols === tileCols && rows === tileRows) return;
				tileCols = cols;
				tileRows = rows;
				tileBtns.forEach(function(b){ b.classList.toggle('on', b === btn); });

				var totalGridCols = 8 * tileCols;
				var totalGridRows = 8 * tileRows;
				if (gridLabel) {
					gridLabel.textContent = totalGridCols + '×' + totalGridRows + ' Heatmap';
				}
				if (vpGridStatus) {
					vpGridStatus.textContent = 'Grid: ' + totalGridCols + '×' + totalGridRows;
				}
				if (currentImg) {
					updatePreviewRes(currentImg);
				}
				if (currentSrc && currentImg && session) {
					go(currentSrc, currentImg);
				}
			});
		});

		// Drop zone & file input
		fileInput.addEventListener('change', function(e){ if(e.target.files[0]) handle(e.target.files[0]); });
		viewportTile.addEventListener('dragover', function(e){ e.preventDefault(); dropZone.style.background='#f1f5f9'; });
		viewportTile.addEventListener('dragleave', function(e){ e.preventDefault(); dropZone.style.background=''; });
		viewportTile.addEventListener('drop', function(e){ 
			e.preventDefault(); 
			dropZone.style.background=''; 
			var f=e.dataTransfer.files[0]; 
			if(f && f.type.startsWith('image/')) handle(f); 
		});

		// Overlay Toggle
		togGrid.addEventListener('click', function(e){
			e.stopPropagation();
			showGrid = !showGrid;
			togGrid.querySelector('.clean-toggle').classList.toggle('on', showGrid);
			gridCanvas.classList.toggle('on', showGrid);
			if (showGrid) {
				requestAnimationFrame(function(){ drawGrid(cells); });
			}
		});

		btnReset.addEventListener('click', function(e){
			e.stopPropagation();
			reset();
		});

		window.addEventListener('resize', function(){
			if (showGrid) requestAnimationFrame(function(){ drawGrid(cells); });
		});

		previewImg.addEventListener('load', function(){
			if (showGrid) requestAnimationFrame(function(){ drawGrid(cells); });
		});

		function handle(file){
			currentSample = null;
			updateSampleUI();
			showViewportLoading('Reading image...');
			var r = new FileReader();
			r.onload = function(ev){
				var img = new Image();
				img.onload = function(){
					if (previewBarName) previewBarName.textContent = file.name;
					updatePreviewRes(img);
					go(ev.target.result, img);
				};
				img.src = ev.target.result;
			};
			r.readAsDataURL(file);
		}

		async function go(src, img){
			currentSrc = src;
			currentImg = img;
			dropZone.style.display = 'none';
			previewWrap.classList.add('on');
			previewImg.src = src;

			showViewportLoading('Running Inference...');
			await new Promise(function(r){ setTimeout(r, 40); });

			try {
				if(!session) throw new Error('Neural model is preparing. Please wait a moment.');

				var cols = tileCols;
				var rows = tileRows;
				var totalTiles = cols * rows;
				var totalGridCols = 8 * cols;
				var totalGridRows = 8 * rows;
				var combinedCells = new Float32Array(totalGridRows * totalGridCols);
				var totalQ50 = 0;

				var iw = img.naturalWidth || img.width || 256;
				var ih = img.naturalHeight || img.height || 384;
				var tw = iw / cols;
				var th = ih / rows;

				var tileIdx = 0;
				for (var tr = 0; tr < rows; tr++) {
					for (var tc = 0; tc < cols; tc++) {
						tileIdx++;
						if (totalTiles > 1) {
							showViewportLoading('Processing tile ' + tileIdx + ' of ' + totalTiles + '...');
							await new Promise(function(r){ setTimeout(r, 10); });
						}

						var sx = Math.round(tc * tw);
						var sy = Math.round(tr * th);
						var sw = Math.round((tc + 1) * tw) - sx;
						var sh = Math.round((tr + 1) * th) - sy;

						var tensor = preprocessTile(img, sx, sy, sw, sh);
						var feeds = {}; feeds[session.inputNames[0]] = tensor;
						var out = await session.run(feeds);
						var data = out[session.outputNames[0]].data;

						var c = 64;
						for (var lr = 0; lr < 8; lr++) {
							for (var lc = 0; lc < 8; lc++) {
								var lIdx = lr * 8 + lc;
								var q50Val = Math.max(0, data[c + lIdx]);
								totalQ50 += q50Val;

								var gr = tr * 8 + lr;
								var gc = tc * 8 + lc;
								combinedCells[gr * totalGridCols + gc] = q50Val;
							}
						}
					}
				}

				cells = combinedCells;
				currentGridCols = totalGridCols;
				currentGridRows = totalGridRows;

				render({ count: Math.round(totalQ50) });

				if (showGrid) {
					gridCanvas.classList.add('on');
				}
				requestAnimationFrame(function(){ drawGrid(cells); });
			} catch(e) {
				console.error(e);
				resCount.textContent = 'Err';
			}

			hideViewportLoading();
		}

		function preprocessTile(img, sx, sy, sw, sh){
			var ctx = ppCanvas.getContext('2d');
			ppCanvas.width = W;
			ppCanvas.height = H;
			ctx.drawImage(img, sx, sy, sw, sh, 0, 0, W, H);
			var d = ctx.getImageData(0, 0, W, H).data;
			var n = W * H, f = new Float32Array(3 * n);
			for(var i = 0; i < n; i++){
				f[i] = (d[i*4] / 255 - MEAN[0]) / STD[0];
				f[n + i] = (d[i*4 + 1] / 255 - MEAN[1]) / STD[1];
				f[2*n + i] = (d[i*4 + 2] / 255 - MEAN[2]) / STD[2];
			}
			return new ort.Tensor('float32', f, [1, 3, H, W]);
		}

		function render(r){
			var modeText = (tileCols > 1 || tileRows > 1) ? '<span style="font-size:12px;font-weight:600;color:var(--tile-label-color);margin-left:4px;">(' + tileCols + '×' + tileRows + ')</span>' : '';
			resCount.innerHTML = r.count + modeText;

			if (currentSample) {
				resMeta.style.display = 'flex';
				resGtTag.textContent = 'GT: ' + currentSample.gtText;

				var inRange = r.count >= currentSample.gtMin && r.count <= currentSample.gtMax;
				if (inRange) {
					resBadge.className = 'gt-chip-in';
					resBadge.textContent = '✓ Within Range';
				} else {
					var diff = r.count > currentSample.gtMax ? '+' + (r.count - currentSample.gtMax) : (r.count - currentSample.gtMin);
					resBadge.className = 'gt-chip-out';
					resBadge.textContent = 'Δ ' + diff;
				}
			} else {
				resMeta.style.display = 'none';
			}
		}

		function drawGrid(cs){
			if (!previewImg || !previewImg.complete || previewImg.naturalWidth === 0) return;

			var rect = previewImg.getBoundingClientRect();
			var pr = previewWrap.getBoundingClientRect();
			var ox = rect.left - pr.left;
			var oy = rect.top - pr.top;
			var w = Math.round(rect.width);
			var h = Math.round(rect.height);

			if (w <= 0 || h <= 0) return;

			gridCanvas.style.left = ox + 'px';
			gridCanvas.style.top = oy + 'px';
			gridCanvas.width = w;
			gridCanvas.height = h;
			gridCanvas.style.width = w + 'px';
			gridCanvas.style.height = h + 'px';

			var ctx = gridCanvas.getContext('2d');
			ctx.clearRect(0, 0, w, h);

			var GD_C = currentGridCols || 8;
			var GD_R = currentGridRows || 8;
			var cw = w / GD_C;
			var ch = h / GD_R;
			var mx = 0;
			if (cs && cs.length) {
				for (var i = 0; i < cs.length; i++) {
					if (cs[i] > mx) mx = cs[i];
				}
			}

			for (var r = 0; r < GD_R; r++) {
				for (var c = 0; c < GD_C; c++) {
					var x = c * cw;
					var y = r * ch;
					var idx = r * GD_C + c;
					var v = (cs && cs[idx] != null) ? cs[idx] : 0;

					if (mx > 0 && v > 0) {
						var a = Math.min(0.48, (v / mx) * 0.42 + 0.06);
						ctx.fillStyle = 'rgba(234, 179, 8, ' + a.toFixed(3) + ')';
						ctx.fillRect(x, y, cw, ch);
					}

					ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
					ctx.lineWidth = 1.5;
					ctx.strokeRect(x, y, cw, ch);

					ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
					ctx.lineWidth = 1;
					ctx.strokeRect(x, y, cw, ch);

					if (v >= 0.5 && cw >= 16) {
						var txt = (v >= 10 ? Math.round(v) : v.toFixed(1)).toString();
						var fsize = Math.max(7, Math.min(cw * 0.32, 12));
						ctx.font = '700 ' + fsize + 'px system-ui, sans-serif';
						ctx.textAlign = 'center';
						ctx.textBaseline = 'middle';

						var tw = ctx.measureText(txt).width;
						var bw = Math.max(tw + 6, fsize + 4);
						var bh = fsize + 4;
						var bx = x + cw / 2 - bw / 2;
						var by = y + ch / 2 - bh / 2;

						ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
						if (ctx.roundRect) {
							ctx.beginPath();
							ctx.roundRect(bx, by, bw, bh, 2);
							ctx.fill();
						} else {
							ctx.fillRect(bx, by, bw, bh);
						}

						ctx.fillStyle = '#ffffff';
						ctx.fillText(txt, x + cw / 2, y + ch / 2);
					}
				}
			}

			// Slice dividers
			if (tileCols > 1 || tileRows > 1) {
				var sliceW = w / tileCols;
				var sliceH = h / tileRows;
				ctx.strokeStyle = '#ffffff';
				ctx.lineWidth = 2.5;
				for (var tr = 0; tr < tileRows; tr++) {
					for (var tc = 0; tc < tileCols; tc++) {
						ctx.strokeRect(tc * sliceW, tr * sliceH, sliceW, sliceH);
					}
				}
			}
		}

		function reset(){
			dropZone.style.display = '';
			previewWrap.classList.remove('on');
			gridCanvas.classList.remove('on');
			previewImg.src = '';
			cells = null;
			fileInput.value = '';
			currentSrc = null;
			currentImg = null;
			currentSample = null;
			resCount.textContent = '--';
			resMeta.style.display = 'none';
			updateSampleUI();
		}

		// Mouse glow effect on tiles
		document.querySelectorAll('.tile').forEach(function(tile){
			var ticking = false;
			tile.addEventListener('mousemove', function(e){
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(function(){
					var r = tile.getBoundingClientRect();
					var x = ((e.clientX - r.left) / r.width * 100).toFixed(1);
					var y = ((e.clientY - r.top) / r.height * 100).toFixed(1);
					tile.style.setProperty('--mx', x + '%');
					tile.style.setProperty('--my', y + '%');
					ticking = false;
				});
			});
		});
	})();
	</script>
</body>
</html>
