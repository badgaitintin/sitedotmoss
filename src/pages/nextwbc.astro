								</div>
							</button>
						</div>

						<!-- Error Message Pane -->
						<div id="wbcError" class="wbc-error-msg hidden"></div>
					</aside>

					<!-- RIGHT WORKSPACE CONTENT -->
					<main class="wbc-workspace">
						<!-- Upload Prompt Area (Acting as Empty State) -->
						<div id="wbcUploadPrompt">
							<div class="wbc-upload-zone" id="wbcDropzone">
								<input
									type="file"
									id="wbcFileInput"
									accept="image/*"
									class="hidden"
								/>
								<div class="wbc-upload-icon-wrapper">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="24"
										height="24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path
											d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"
										></path>
									</svg>
								</div>
								<p class="wbc-upload-text">
