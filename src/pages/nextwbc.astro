			/* SATELLITE CELL CROPS ORBITING POSITIONS */
			.wbc-crops-cluster-field {
				position: absolute;
				inset: 0;
				pointer-events: none;
				z-index: 15;
			}

			.wbc-crop-card,
			.wbc-crop-bubble {
				width: 84px;
				height: 84px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				position: absolute;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 6px;
				box-sizing: border-box;
				cursor: pointer;
				transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
				pointer-events: auto;
				animation: wbc-crop-float 4.5s ease-in-out infinite alternate;
			}

			@keyframes wbc-crop-float {
				0% { transform: scale(1) translateY(0px) rotate(0deg); }
				50% { transform: scale(1.06) translateY(-6px) rotate(3deg); }
				100% { transform: scale(0.97) translateY(4px) rotate(-2deg); }
			}

			.wbc-crop-bubble:hover,
			.wbc-crop-card:hover {
				transform: scale(1.25) translateY(-6px) !important;
				z-index: 30;
			}

			/* Cropped cell bubbles popping animation */
			.wbc-crop-bubble.is-popping {
				animation: wbc-bubble-pop 0.45s cubic-bezier(0.1, 0.9, 0.2, 1.2) forwards !important;
			}
			@keyframes wbc-bubble-pop {
				0% {
					transform: scale(1);
					opacity: 1;
					filter: blur(0px);
				}
				35% {
					transform: scale(1.4);
					opacity: 0.95;
					filter: blur(2px) brightness(1.4);
				}
				100% {
					transform: scale(1.85);
					opacity: 0;
					filter: blur(14px) brightness(2.5);
				}
			}

			/* Central magic mirror dissolve animation */
			.wbc-results-container.is-dissolving {
				animation: wbc-magic-dissolve 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
			}
			@keyframes wbc-magic-dissolve {
				0% {
					opacity: 1;
					filter: blur(0px) brightness(1);
					transform: scale(1);
				}
				50% {
					opacity: 0.6;
					filter: blur(16px) brightness(1.7) contrast(1.2);
					transform: scale(1.04);
				}
				100% {
					opacity: 0;
					filter: blur(28px) brightness(2.2) contrast(0.7);
					transform: scale(0.95);
				}
			}

