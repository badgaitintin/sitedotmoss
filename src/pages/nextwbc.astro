---
import "@fontsource/google-sans-flex";
import Watermark from "../components/Watermark.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="NextWBC white blood cell classification dashboard."
		/>
		<title>NextWBC</title>

		<style is:global>
			/* ===========================
			   BLACKHOLE TOKEN SYSTEM
			=========================== */
			:root {
				--bh-void: #ffffff;
				--bh-deep: rgba(224, 242, 254, 0.5);
				--bh-surface: rgba(255, 255, 255, 0.65);
				--bh-card: rgba(255, 255, 255, 0.65);
				--bh-border: rgba(255, 255, 255, 0.5);
				--bh-border-hi: rgba(255, 255, 255, 0.85);
				--bh-text: #0f172a;
				--bh-muted: #334155;
				--bh-accent: #0284c7; /* Aero Sky Blue */
				--bh-accent2: #38bdf8; /* Aero Aqua */
				--bh-accent3: #10b981; /* Emerald Green */
				--bh-danger: #ef4444;
				--bh-glow: rgba(14, 165, 233, 0.3);
				--bh-glow-sm: rgba(56, 189, 248, 0.2);
			}

			/* ===========================
			   BASE
			=========================== */
			html,
			body {
				width: 100%;
				height: 100vh;
				overflow: hidden;
				background: transparent;
				font-family:
					"Google Sans Flex", "Google Sans", "Helvetica Neue",
					sans-serif;
				color: var(--bh-text);
				line-height: 1.5;
				margin: 0;
				padding: 0;
				position: relative;
			}

		body::before {
			content: "";
			position: fixed;
			inset: -20px;
			z-index: -2;
			background-image: url("/optimized/anim_bg_3.webp");
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			filter: blur(5px) brightness(0.95) saturate(1.25);
			-webkit-filter: blur(5px) brightness(0.95) saturate(1.25);
			background-color: rgba(255, 255, 255, 0.05);
			background-blend-mode: overlay;
		}

			a {
				color: var(--bh-accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}

			.page-wrap {
				animation: bh-enter 0.5s cubic-bezier(0.1, 0.9, 0.2, 1) both;
			}
			@keyframes bh-enter {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			body.is-exiting .page-wrap {
				animation: bh-exit 0.28s cubic-bezier(0.4, 0, 1, 1) both;
				pointer-events: none;
			}
			@keyframes bh-exit {
				from {
					opacity: 1;
					transform: translateY(0);
				}
				to {
					opacity: 0;
					transform: translateY(20px);
				}
			}

			/* ===========================
			   LAYOUT CONTAINER
			=========================== */
			.bh-page {
				position: relative;
				z-index: 1;
				max-width: 1200px;
				margin: 0 auto;
				height: 100vh;
				padding: 16px 20px;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
			}

			.bh-main-card {
				position: relative;
				background: transparent;
				border: none;
				box-shadow: none;
				backdrop-filter: none;
				-webkit-backdrop-filter: none;
				display: flex;
				height: calc(100vh - 32px);
				width: 100%;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
				overflow: visible;
				padding: 0;
			}

			/* ===========================
			   100% PERFECT CIRCULAR BUBBLE (THINK DIFFERENT)
			=========================== */
			.aero-component-bubble {
				position: relative;
				border-radius: 50% !important;
				background:
					/* Primary specular light spot - Top Left */
					radial-gradient(
						circle at 32% 22%,
						rgba(255, 255, 255, 0.98) 0%,
						rgba(255, 255, 255, 0.72) 16%,
						rgba(224, 242, 254, 0.42) 34%,
						rgba(56, 189, 248, 0.22) 58%,
						rgba(14, 165, 233, 0.1) 80%,
						rgba(255, 255, 255, 0.45) 94%,
						transparent 100%
					),
					/* Iridescent thin-film rainbow reflection - Bottom Right */
					radial-gradient(
						circle at 75% 78%,
						rgba(192, 132, 252, 0.28) 0%,
						rgba(56, 189, 248, 0.24) 48%,
						rgba(255, 255, 255, 0.16) 75%,
						transparent 100%
					),
					/* Glassy base background */
					linear-gradient(
						135deg,
						rgba(255, 255, 255, 0.6) 0%,
						rgba(255, 255, 255, 0.22) 40%,
						rgba(255, 255, 255, 0.14) 60%,
						rgba(255, 255, 255, 0.42) 100%
					);
				backdrop-filter: blur(28px) saturate(175%);
				-webkit-backdrop-filter: blur(28px) saturate(175%);
				border: 2px solid rgba(255, 255, 255, 0.95);
				box-shadow:
					inset -8px -10px 28px rgba(2, 132, 199, 0.4),
					inset 8px 10px 22px rgba(255, 255, 255, 0.98),
					inset 0 0 20px rgba(255, 255, 255, 0.88),
					0 18px 50px rgba(14, 165, 233, 0.32),
					0 4px 16px rgba(0, 0, 0, 0.08);
				overflow: hidden;
				transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				box-sizing: border-box;
				flex-shrink: 0;
			}

			.aero-component-bubble::before {
				content: "";
				position: absolute;
				top: 5%;
				left: 10%;
				width: 38%;
				height: 22%;
				border-radius: 50%;
				background: linear-gradient(
					180deg,
					rgba(255, 255, 255, 0.96) 0%,
					rgba(255, 255, 255, 0.2) 100%
				);
				transform: rotate(-25deg);
				pointer-events: none;
				z-index: 2;
			}

			.aero-component-bubble::after {
				content: "";
				position: absolute;
				bottom: 6%;
				right: 12%;
				width: 30%;
				height: 20%;
				border-radius: 50%;
				background: radial-gradient(
					circle,
					rgba(186, 230, 253, 0.85) 0%,
					rgba(125, 211, 252, 0.3) 70%,
					transparent 100%
				);
				filter: blur(3.5px);
				pointer-events: none;
				z-index: 2;
			}

			/* Staggered Floating Animations for Bubble Cluster */
			.aero-float-1 { animation: bh-component-float-1 6.5s ease-in-out 0s infinite alternate; }
			.aero-float-2 { animation: bh-component-float-2 7.2s ease-in-out 0.9s infinite alternate; }
			.aero-float-3 { animation: bh-component-float-3 6.8s ease-in-out 1.8s infinite alternate; }
			.aero-float-4 { animation: bh-component-float-4 7.6s ease-in-out 2.5s infinite alternate; }

			@keyframes bh-component-float-1 {
				0% { transform: translateY(0) scale(1); }
				50% { transform: translateY(-7px) scale(1.01); }
				100% { transform: translateY(0) scale(1); }
			}
			@keyframes bh-component-float-2 {
				0% { transform: translateY(0) scale(1); }
				50% { transform: translateY(-8px) scale(1.01); }
				100% { transform: translateY(0) scale(1); }
			}
			@keyframes bh-component-float-3 {
				0% { transform: translateY(0) scale(1); }
				50% { transform: translateY(-6px) scale(1.01); }
				100% { transform: translateY(0) scale(1); }
			}
			@keyframes bh-component-float-4 {
				0% { transform: translateY(0) scale(1); }
				50% { transform: translateY(-9px) scale(1.01); }
				100% { transform: translateY(0) scale(1); }
			}

			.hidden {
				display: none !important;
			}

			/* ===========================
			   PRECISION BUBBLE CONSTELLATION (0% COLLISION)
			=========================== */
			.wbc-bubble-stage {
				position: relative;
				width: 100%;
				max-width: 1100px;
				height: 560px;
				margin: -85px auto 0 auto;
			}

			/* CENTER MICROSCOPE ORB — 380px */
			.wbc-center-orb {
				position: absolute;
				left: calc(50% - 190px);
				top: calc(50% - 190px);
				width: 380px;
				height: 380px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				z-index: 5;
				overflow: hidden;
				isolation: isolate;
			}

			.wbc-center-content {
				width: 100%;
				height: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				position: absolute;
				inset: 0;
				border-radius: 50%;
				overflow: hidden;
			}

			.wbc-empty-state {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				flex: 1;
				text-align: center;
				padding: 48px 24px;
				color: var(--bh-muted);
			}
			.wbc-empty-icon {
				width: 80px;
				height: 80px;
				border-radius: 50%;
				background: rgba(0, 0, 0, 0.02);
				border: 1px solid var(--bh-border);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--bh-accent);
				margin-bottom: 24px;
				animation: wbc-pulse 3s infinite ease-in-out;
			}
			@keyframes wbc-pulse {
				0%,
				100% {
					transform: scale(1);
					opacity: 0.7;
				}
				50% {
					transform: scale(1.05);
					opacity: 1;
				}
			}
			.wbc-empty-title {
				font-size: 1.4rem;
				font-weight: 300;
				color: var(--bh-text);
				margin: 0 0 12px 0;
			}
			.wbc-empty-subtitle {
				font-size: 0.9rem;
				max-width: 420px;
				margin: 0;
				line-height: 1.6;
			}

			@media (max-width: 900px) {
				.bh-page {
					height: auto;
					padding: 16px;
				}
				.bh-main-card {
					flex-direction: column;
					padding: 24px;
					gap: 24px;
					height: auto;
					overflow: visible;
					backdrop-filter: blur(16px) saturate(130%);
					-webkit-backdrop-filter: blur(16px) saturate(130%);
				}
				.wbc-sidebar {
					width: 100% !important;
					border-right: none !important;
					padding-right: 0 !important;
					padding-bottom: 24px;
					border-bottom: 1px solid var(--bh-border);
					overflow: visible;
				}
				.wbc-workspace {
					overflow: visible;
					height: auto;
					padding-right: 0;
				}
				/* Reduce GPU-heavy backdrop-filter on mobile */
				.wbc-upload-zone,
				.wbc-preview-container,
				.wbc-image-panel,
				.wbc-count-card,
				.wbc-chart-card,
				.wbc-crop-card,
				.wbc-guide-note {
					backdrop-filter: none;
					-webkit-backdrop-filter: none;
					background: rgba(255, 255, 255, 0.35);
				}
			}

			/* ===========================
			   TOP NAV BAR (legacy / fallback)
			=========================== */
			.bh-topbar {
				display: none;
			}

			.wbc-back-btn {
				width: 40px;
				height: 40px;
				background: linear-gradient(
					180deg,
					rgba(186, 230, 253, 0.9) 0%,
					rgba(125, 211, 252, 0.7) 48%,
					rgba(56, 189, 248, 0.8) 50%,
					rgba(14, 165, 233, 0.9) 100%
				);
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid rgba(3, 105, 161, 0.5);
				border-top: 1.5px solid rgba(186, 230, 253, 0.9);
				border-radius: 50%;
				box-shadow:
					inset 0 2px 0 rgba(255, 255, 255, 0.7),
					inset 0 -1px 0 rgba(0, 0, 0, 0.1),
					0 4px 16px rgba(14, 165, 233, 0.25);
				cursor: pointer;
				transition: all 0.25s cubic-bezier(0.1, 0.8, 0.2, 1);
				flex-shrink: 0;
			}
			.wbc-back-btn:hover {
				background: linear-gradient(
					180deg,
					rgba(224, 242, 254, 0.95) 0%,
					rgba(186, 230, 253, 0.8) 48%,
					rgba(125, 211, 252, 0.85) 50%,
					rgba(56, 189, 248, 0.95) 100%
				);
				box-shadow:
					inset 0 2px 0 rgba(255, 255, 255, 0.9),
					0 6px 20px rgba(14, 165, 233, 0.35);
				transform: translateY(-1px) scale(1.04);
			}

			.bh-content-scroll {
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
			}

			/* ===========================
			   HEADER & TITLE
			=========================== */
			.bh-header {
				position: absolute;
				left: 11%;
				top: 15%;
				width: 165px;
				height: 165px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 16px;
				box-sizing: border-box;
				z-index: 6;
			}

			.bh-title {
				font-size: 1.6rem;
				font-weight: 900;
				line-height: 1.1;
				letter-spacing: -0.5px;
				margin: 0;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				gap: 8px;
			}

			.title-nextwbc {
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
				color: var(--bh-text);
			}
			.title-classifier {
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
				color: var(--bh-accent);
			}

			.bh-subtitle {
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
				font-size: 0.65rem;
				color: var(--bh-muted);
				font-weight: 400;
				margin: 0;
				line-height: 1.2;
				max-width: 140px;
				text-align: center;
			}

			/* ===========================
			   WBC DEMO COMPONENTS
			=========================== */
			#wbcUploadPrompt {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				position: absolute;
				inset: 0;
			}
			.wbc-upload-zone {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border-radius: 50% !important;
				border: none;
				cursor: pointer;
				padding: 0;
				margin: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
			}

			/* ── User Guide Styling ── */
			.wbc-guide {
				position: absolute;
				left: 5%;
				top: 48%;
				width: 195px;
				height: 195px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 18px 16px;
				box-sizing: border-box;
				z-index: 6;
			}
			.wbc-guide-title {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: var(--bh-text);
				margin: 0;
				border-bottom: none;
				padding-bottom: 0;
			}
			.wbc-guide-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 4px;
				align-items: center;
			}
			.wbc-guide-list li {
				display: flex;
				gap: 6px;
				align-items: center;
				text-align: left;
				max-width: 170px;
			}
			.wbc-step-num {
				width: 16px;
				height: 16px;
				border-radius: 50%;
				background: var(--bh-accent);
				color: #ffffff;
				font-size: 0.6rem;
				font-weight: bold;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}
			.wbc-step-text {
				font-size: 0.62rem;
				color: var(--bh-muted);
				line-height: 1.2;
			}
			.wbc-guide-note {
				font-size: 0.6rem;
				background: rgba(255, 255, 255, 0.45);
				border: 1px solid rgba(255, 255, 255, 0.7);
				border-radius: 99px;
				padding: 3px 8px;
				color: var(--bh-muted);
				line-height: 1.2;
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
			}
			.wbc-upload-icon-wrapper {
				width: 88px;
				height: 88px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.65);
				border: 2px solid rgba(255, 255, 255, 0.95);
				box-shadow:
					0 8px 28px rgba(14, 165, 233, 0.3),
					inset 0 2px 5px rgba(255, 255, 255, 1);
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 0;
				color: var(--bh-accent);
				transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}
			.wbc-upload-icon-wrapper svg {
				display: block;
				margin: auto;
			}
			.wbc-upload-zone:hover .wbc-upload-icon-wrapper {
				transform: scale(1.15);
				color: #0284c7;
				box-shadow:
					0 12px 36px rgba(14, 165, 233, 0.45),
					inset 0 2px 6px rgba(255, 255, 255, 1);
			}
			.wbc-upload-text {
				font-size: 0.82rem;
				font-weight: 500;
				color: rgba(0, 0, 0, 0.75);
				margin: 0 0 4px 0;
			}
			.wbc-upload-subtext {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: rgba(0, 0, 0, 0.45);
				margin: 0;
			}

			.wbc-preview-container {
				width: 380px;
				height: 380px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 28px;
				box-sizing: border-box;
			}
			.wbc-preview-img {
				width: 180px;
				height: 180px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid rgba(255, 255, 255, 0.8);
			}

			.wbc-progress-bar-wrapper {
				width: 100%;
				max-width: 300px;
				height: 6px;
				background: rgba(0, 0, 0, 0.08);
				border-radius: 99px;
				overflow: hidden;
				margin-top: 8px;
			}
			.wbc-progress-bar-fill {
				height: 100%;
				width: 0%;
				background: var(--bh-accent);
				border-radius: 99px;
				transition: width 0.4s ease-out;
			}
			.wbc-status-text {
				font-size: 0.75rem;
				color: var(--bh-accent);
				display: flex;
				align-items: center;
				gap: 8px;
				justify-content: center;
				margin-top: 8px;
			}

			.wbc-error-msg {
				padding: 12px;
				border-radius: 12px;
				background: rgba(239, 68, 68, 0.08);
				border: 1px solid rgba(239, 68, 68, 0.15);
				color: var(--bh-danger);
				font-size: 0.8rem;
				margin-top: 12px;
				text-align: center;
			}

			/* Results structure */
			.wbc-results-container {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 100%;
			}
			.wbc-results-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				border-bottom: 1px solid var(--bh-border);
				padding-bottom: 12px;
			}
			.wbc-results-heading {
				font-size: 1.1rem;
				font-weight: 300;
				margin: 0;
			}
			.wbc-results-top {
				display: flex;
				flex-direction: row;
				gap: 24px;
				flex: 1;
				align-items: stretch;
				min-height: 0;
			}
			@media (max-width: 560px) {
				.wbc-results-top {
					flex-direction: column;
				}
				.wbc-image-panel {
					height: 280px;
					flex: none;
				}
			}
			.wbc-image-panel {
				width: 380px;
				height: 380px;
				aspect-ratio: 1 / 1;
				border-radius: 50% !important;
				overflow: hidden;
				position: relative;
				flex-shrink: 0;
			}
			.wbc-image-wrapper {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				border-radius: 50%;
			}
			.wbc-image-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				cursor: pointer;
				border-radius: 50%;
			}
			.wbc-panel-badge {
