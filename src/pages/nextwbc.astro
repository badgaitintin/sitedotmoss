			/* ===========================
			   TOP-RIGHT RGB BUBBLE TOGGLE BUTTON
			=========================== */
			.rgb-bubble-toggle-btn {
				position: absolute;
				top: 24px;
				right: 28px;
				width: 46px;
				height: 46px;
				border-radius: 50%;
				border: none;
				background: transparent;
				cursor: pointer;
				z-index: 50;
				padding: 0;
				outline: none;
				transition: transform 0.25s cubic-bezier(0.1, 0.9, 0.2, 1);
			}

			.rgb-bubble-toggle-btn:hover {
				transform: scale(1.14);
			}

			.rgb-bubble-toggle-btn:active {
				transform: scale(0.92);
			}

			/* Vibrant RGB Glass Bubble (ON State) */
			.rgb-bubble-inner {
				position: absolute;
				inset: 0;
				border-radius: 50%;
				background:
					radial-gradient(
						circle at 35% 26%,
						rgba(255, 255, 255, 1) 0%,
						rgba(255, 255, 255, 0.75) 15%,
						rgba(192, 132, 252, 0.45) 40%,
						rgba(56, 189, 248, 0.4) 65%,
						rgba(34, 197, 94, 0.35) 85%,
						transparent 100%
					),
					linear-gradient(
						135deg,
						#38bdf8 0%,
						#a855f7 50%,
						#22c55e 100%
					);
				background-blend-mode: overlay;
				border: 1.8px solid rgba(255, 255, 255, 0.95);
				box-shadow:
					inset -4px -5px 12px rgba(168, 85, 247, 0.5),
					inset 4px 5px 10px rgba(255, 255, 255, 0.98),
					0 0 16px rgba(168, 85, 247, 0.5),
					0 0 28px rgba(56, 189, 248, 0.4);
				animation: rgb-hue-rotate 5s infinite linear;
				transition:
					transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.25),
					opacity 0.25s ease;
			}

			/* Top Crescent Specular Glare */
			.rgb-bubble-inner::before {
				content: "";
				position: absolute;
				top: 10%;
				left: 18%;
				width: 38%;
				height: 26%;
				border-radius: 50%;
				background: linear-gradient(
					180deg,
					#ffffff 0%,
					rgba(255, 255, 255, 0.25) 100%
				);
				transform: rotate(-30deg);
			}

			@keyframes rgb-hue-rotate {
				0% {
					filter: hue-rotate(0deg);
				}
				100% {
					filter: hue-rotate(360deg);
				}
			}

			/* Ghost Outline (OFF State - Faint & Blurry) */
			.ghost-bubble-outline {
				position: absolute;
				inset: 0;
				border-radius: 50%;
				border: 1.5px dashed rgba(255, 255, 255, 0.55);
				background: rgba(255, 255, 255, 0.12);
				backdrop-filter: blur(4px);
				-webkit-backdrop-filter: blur(4px);
				box-shadow: inset 0 1px 3px rgba(255, 255, 255, 0.5);
				opacity: 0;
				transform: scale(0.85);
				transition:
					opacity 0.3s ease,
					transform 0.3s ease,
					border-color 0.2s ease;
				pointer-events: none;
			}

			/* OFF State Behavior */
			.rgb-bubble-toggle-btn.is-off .rgb-bubble-inner {
				opacity: 0;
				transform: scale(0);
				pointer-events: none;
			}

			.rgb-bubble-toggle-btn.is-off .ghost-bubble-outline {
				opacity: 0.35;
				transform: scale(1);
			}

			.rgb-bubble-toggle-btn.is-off:hover .ghost-bubble-outline {
				opacity: 0.75;
				border-color: rgba(255, 255, 255, 0.95);
				background: rgba(255, 255, 255, 0.25);
			}

			/* ===========================
			   ULTRA-REALISTIC AERO GLASS BUBBLE
			=========================== */
			.aero-bubble-stage {
				position: fixed;
				inset: 0;
				pointer-events: none;
				overflow: hidden;
				transition: opacity 0.4s ease;
			}
			.aero-stage-back {
				z-index: -1; /* 80% bubbles float behind main UI */
			}
			.aero-stage-front {
				z-index: 5; /* 20% bubbles float in front of main UI */
			}

			.aero-glass-bubble {
				position: absolute;
				top: 0;
				left: 0;
				border-radius: 50%;
				background:
					/* Primary specular light spot */
					radial-gradient(
						circle at 35% 26%,
						rgba(255, 255, 255, 1) 0%,
						rgba(255, 255, 255, 0.7) 14%,
						rgba(224, 242, 254, 0.45) 30%,
						rgba(56, 189, 248, 0.25) 55%,
						rgba(14, 165, 233, 0.12) 78%,
						rgba(255, 255, 255, 0.5) 94%,
						transparent 100%
					),
					/* Iridescent thin-film rainbow reflection */
					radial-gradient(
							circle at 75% 75%,
							rgba(192, 132, 252, 0.2) 0%,
							rgba(56, 189, 248, 0.18) 50%,
							transparent 80%
						);
				box-shadow:
					inset -5px -7px 16px rgba(2, 132, 199, 0.5),
					inset 5px 6px 14px rgba(255, 255, 255, 0.98),
					inset 0 0 10px rgba(255, 255, 255, 0.85),
					0 12px 32px rgba(14, 165, 233, 0.35),
					0 2px 6px rgba(0, 0, 0, 0.08);
				border: 1.5px solid rgba(255, 255, 255, 0.9);
				backdrop-filter: blur(2px) saturate(160%);
				-webkit-backdrop-filter: blur(2px) saturate(160%);
				will-change: transform, opacity;
			}

			.aero-glass-bubble.is-popping {
				transform: scale(1.4) !important;
				opacity: 0 !important;
				transition:
					transform 0.18s ease-out,
					opacity 0.18s ease-out !important;
			}

			.aero-pop-particle {
				position: absolute;
				top: 0;
				left: 0;
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: radial-gradient(
					circle,
					rgba(255, 255, 255, 1) 0%,
					rgba(56, 189, 248, 0.9) 70%
				);
				box-shadow:
					0 0 8px rgba(56, 189, 248, 0.9),
					0 0 2px #ffffff;
				pointer-events: none;
				will-change: transform, opacity;
			}

			/* Curved Top Specular Reflection Glare Crescent */
			.aero-glass-bubble::before {
				content: "";
				position: absolute;
				top: 8%;
				left: 16%;
				width: 40%;
				height: 26%;
				border-radius: 50%;
				background: linear-gradient(
					180deg,
					rgba(255, 255, 255, 0.98) 0%,
					rgba(255, 255, 255, 0.3) 100%
				);
				transform: rotate(-30deg);
			}

			/* Bottom Secondary Ground Reflection Highlight */
			.aero-glass-bubble::after {
				content: "";
				position: absolute;
				bottom: 10%;
				right: 18%;
				width: 32%;
				height: 24%;
				border-radius: 50%;
				background: radial-gradient(
					circle,
					rgba(186, 230, 253, 0.85) 0%,
					rgba(125, 211, 252, 0.4) 70%,
					transparent 100%
				);
				filter: blur(1.5px);
			}

			/* ===========================
			   CORAL REEF BOTTOM LAYER (FULL WIDTH 100VW)
			=========================== */
			.coralreef-bottom-layer {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				width: 100vw;
				height: 140px;
				pointer-events: none;
				z-index: 100; /* Topmost layer */
				overflow: hidden;
				display: flex;
				align-items: flex-end;
				transition: opacity 0.4s ease;
			}

			.coralreef-img {
				width: 100vw;
				height: 140px;
				object-fit: cover;
				object-position: bottom center;
				display: block;
				filter: drop-shadow(0 -8px 22px rgba(14, 165, 233, 0.45))
					saturate(1.25);
				opacity: 0.95;
			}

			/* ── Decorative Micro Glass Bubbles ── */
			.wbc-deco-bubble {
				position: absolute;
				border-radius: 50% !important;
				pointer-events: none;
				z-index: 3;
				background: radial-gradient(
					circle at 35% 25%,
					rgba(255, 255, 255, 0.95) 0%,
					rgba(255, 255, 255, 0.4) 30%,
					rgba(56, 189, 248, 0.18) 60%,
					rgba(2, 132, 199, 0.3) 100%
				);
				border: 1.5px solid rgba(255, 255, 255, 0.9);
				box-shadow:
					0 6px 18px rgba(14, 165, 233, 0.3),
					inset -3px -4px 8px rgba(2, 132, 199, 0.4),
					inset 3px 4px 6px rgba(255, 255, 255, 0.98);
				backdrop-filter: blur(4px);
				-webkit-backdrop-filter: blur(4px);
			}

			.wbc-deco-1 {
				width: 22px;
				height: 22px;
				left: calc(50% - 260px);
				top: calc(50% - 235px);
				animation: bh-component-float-1 6s ease-in-out infinite;
			}
			.wbc-deco-2 {
				width: 14px;
				height: 14px;
				left: calc(50% - 410px);
				top: calc(50% - 15px);
				animation: bh-component-float-2 4.8s ease-in-out infinite;
			}
			.wbc-deco-3 {
				width: 18px;
				height: 18px;
				left: calc(50% - 275px);
				top: calc(50% + 215px);
				animation: bh-component-float-3 5.5s ease-in-out infinite;
			}
			.wbc-deco-4 {
				width: 26px;
				height: 26px;
				left: calc(50% - 15px);
				top: calc(50% + 210px);
				animation: bh-component-float-4 7s ease-in-out infinite;
			}
			.wbc-deco-5 {
				width: 16px;
				height: 16px;
				left: calc(50% + 215px);
				top: calc(50% + 205px);
				animation: bh-component-float-1 5.2s ease-in-out infinite;
			}
			.wbc-deco-6 {
				width: 20px;
				height: 20px;
				left: calc(50% + 365px);
				top: calc(50% - 20px);
				animation: bh-component-float-2 6.4s ease-in-out infinite;
			}

			/* ── Swimming Tropical Fish Aquarium ── */
			.wbc-fish-aquarium-stage {
				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				pointer-events: none;
				overflow: hidden;
				z-index: 2;
			}

			.wbc-swimming-fish {
				position: absolute;
				pointer-events: auto;
				cursor: pointer;
				will-change: transform, left;
				transition: filter 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}

			.fish-layer-back {
				opacity: 0.85;
				filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18)) brightness(0.95);
				z-index: 2;
			}

			.fish-layer-mid {
				opacity: 0.98;
				filter: drop-shadow(0 8px 20px rgba(2, 132, 199, 0.35)) brightness(1.05);
				z-index: 6;
			}

			.wbc-fish-img {
				width: 100%;
				height: auto;
				display: block;
				animation: fish-undulate 2.6s ease-in-out infinite alternate;
			}

			@keyframes fish-undulate {
				0% {
					transform: translateY(0px) rotate(0deg);
				}
				50% {
					transform: translateY(-8px) rotate(2.5deg);
				}
				100% {
					transform: translateY(6px) rotate(-2deg);
				}
			}

			@keyframes swim-ltr {
				0% {
					left: -180px;
				}
				100% {
					left: calc(100vw + 180px);
				}
			}

			@keyframes swim-rtl {
				0% {
					left: calc(100vw + 180px);
				}
				100% {
					left: -180px;
				}
			}

			.swim-left-to-right {
				animation-name: swim-ltr;
				animation-timing-function: linear;
				animation-iteration-count: 1;
				animation-fill-mode: forwards;
			}

			.swim-right-to-left {
				animation-name: swim-rtl;
				animation-timing-function: linear;
				animation-iteration-count: 1;
				animation-fill-mode: forwards;
			}

			.hidden {
				display: none !important;
			}

			.animate-spin {
				animation: spin 1s linear infinite;
			}
			@keyframes spin {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(360deg);
				}
			}
		</style>
	</head>

	<body>
		<!-- Coral Reef Bottom Layer (Centered Medium Scale) -->
		<div class="coralreef-bottom-layer" id="coralReefLayer">
			<img src="/coralreef.png" alt="Coral Reef" class="coralreef-img" />
		</div>

		<!-- Tropical Swimming Fish Aquarium Stage (Random Spawn fish1-fish4) -->
		<div class="wbc-fish-aquarium-stage" id="fishAquariumStage" aria-hidden="true"></div>

		<!-- Aero Floating Glass Bubbles Stage (80% Back, 20% Front) -->
		<div class="aero-bubble-stage aero-stage-back" id="bubbleStageBack">
		</div>
		<div class="aero-bubble-stage aero-stage-front" id="bubbleStageFront">
		</div>

		<div class="page-wrap">
			<div class="bh-page">
				<!-- MAIN CONTENT CARD (Split Columns) -->
				<div class="bh-main-card">
					<!-- Top-Right RGB Bubble Toggle Button -->
					<button
						id="rgbBubbleToggleBtn"
						class="rgb-bubble-toggle-btn"
						title="Toggle Glass Bubbles"
					>
						<div class="rgb-bubble-inner"></div>
						<div class="ghost-bubble-outline"></div>
					</button>

					<div class="wbc-bubble-stage">
						<!-- Standalone Back Button Mini Glass Bubble (42px) -->
						<a
							href="/"
							class="wbc-back-bubble aero-component-bubble aero-float-4"
							id="backBtn"
							title="Back to Home"
						>
							<svg
								width="14"
								height="14"
								viewBox="0 0 14 14"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M9 12L4 7l5-5"></path>
							</svg>
						</a>

						<!-- Header Title Orb (165px) -->
						<header class="bh-header aero-component-bubble aero-float-1">
							<h1 class="bh-title">
								<span class="title-nextwbc">NextWBC</span>
							</h1>
							<p class="bh-subtitle">
								Avian white blood cell classification using YOLO12.
							</p>
						</header>

						<!-- User Guide Orb (195px) -->
						<div class="wbc-guide aero-component-bubble aero-float-2">
							<h3 class="wbc-guide-title">How to Use</h3>
							<ul class="wbc-guide-list">
								<li>
									<span class="wbc-step-num">1</span>
									<span class="wbc-step-text"
										>Drag & drop or click image.</span
									>
								</li>
								<li>
									<span class="wbc-step-num">2</span>
									<span class="wbc-step-text"
										>YOLO12 AI detection pipeline.</span
									>
								</li>
								<li>
									<span class="wbc-step-num">3</span>
									<span class="wbc-step-text"
										>Review counts & cell crops.</span
									>
								</li>
							</ul>
							<div class="wbc-guide-note">
								JPG/PNG up to 20MB
							</div>
						</div>

						<!-- Quick Try Sample Orb (140px - Full Glass Photo Bubble) -->
						<div class="wbc-sample-section aero-component-bubble aero-float-3">
							<button
								id="wbcSampleBtn"
								class="wbc-sample-btn"
								title="Click to test sample image"
							>
								<img
									src="/raptor_wbc_00001.jpeg"
									alt="Sample Blood Smear"
									class="wbc-sample-bg-img"
								/>
								<div class="wbc-sample-overlay">
									<span class="wbc-sample-tag">QUICK TRY</span>
									<span class="wbc-sample-name">raptor_wbc.jpeg</span>
									<span class="wbc-sample-desc">Click to test</span>
								</div>
							</button>
						</div>

						<!-- GIANT CENTER MICROSCOPE ORB (380px) -->
						<main class="wbc-center-orb aero-component-bubble aero-float-1">
							<!-- Idle State: Upload Prompt -->
							<div id="wbcUploadPrompt" class="wbc-center-content">
								<div class="wbc-upload-zone" id="wbcDropzone" title="Click or drop blood smear image to upload">
									<input
										type="file"
										id="wbcFileInput"
										accept="image/*"
										class="hidden"
									/>
									<div class="wbc-upload-icon-wrapper">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="44"
											height="44"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path
												d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"
											></path>
										</svg>
									</div>
								</div>
							</div>

							<!-- Processing State: Progress Spinner -->
							<div
								id="wbcPreview"
								class="wbc-preview-container wbc-center-content hidden"
							>
								<img
									id="wbcPreviewImg"
									class="wbc-preview-img"
									src=""
									alt="Smear Preview"
								/>
								<div class="wbc-progress-bar-wrapper">
									<div
										class="wbc-progress-bar-fill"
										id="wbcProgressFill"
									>
									</div>
								</div>
								<div class="wbc-status-text" id="wbcStatusText">
									Connecting to model...
								</div>
							</div>

							<!-- Showing Result State: Annotated Detection Image Lens -->
							<div
								id="wbcResult"
								class="wbc-results-container wbc-center-content hidden"
							>
								<span
									class="wbc-panel-badge"
									id="panelBadge">Detection</span
								>
								<div class="wbc-image-wrapper">
									<img
										id="wbcAnnotatedImg"
										src=""
										alt="Annotated Detections"
										title="Click to toggle boxes"
									/>
								</div>
							</div>
						</main>

						<!-- Distribution Breakdown Orb (195px) -->
						<div class="wbc-chart-card aero-component-bubble aero-float-4">
							<h4 class="wbc-chart-title">
								Distribution
							</h4>
							<div id="wbcDistributionContainer">
								<!-- Dynamic Distribution Bars Injected Here -->
							</div>
						</div>

						<!-- Tiny Reset Button Orb (78px - Icon Only) -->
						<div class="wbc-reset-orb aero-component-bubble aero-float-3">
							<button
								id="wbcResetBtn"
								class="wbc-reset-btn"
								title="Upload New Image"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path
										d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"
									></path>
								</svg>
							</button>
						</div>

						<!-- DECORATIVE MICRO GLASS BUBBLES (Subtle Aesthetic Accent) -->
						<div class="wbc-deco-bubble wbc-deco-1" aria-hidden="true"></div>
						<div class="wbc-deco-bubble wbc-deco-2" aria-hidden="true"></div>
						<div class="wbc-deco-bubble wbc-deco-3" aria-hidden="true"></div>
						<div class="wbc-deco-bubble wbc-deco-4" aria-hidden="true"></div>
						<div class="wbc-deco-bubble wbc-deco-5" aria-hidden="true"></div>
						<div class="wbc-deco-bubble wbc-deco-6" aria-hidden="true"></div>

						<!-- TIGHTLY CLUSTERED SATELLITE MOVING CELL CROP BUBBLES FIELD -->
						<div class="wbc-crops-cluster-field" id="wbcCropsGrid">
							<!-- Dynamic satellite crop glass bubbles float around center orb -->
						</div>

						<!-- Error Message Pane -->
						<div id="wbcError" class="wbc-error-msg hidden"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- ── Page exit transition (stays inline — pure DOM, tiny) ── -->
		<script>
			const backBtn = document.getElementById("backBtn");
			if (backBtn) {
				backBtn.addEventListener("click", (e) => {
					e.preventDefault();
					document.body.classList.add("is-exiting");
					setTimeout(() => {
						window.location.href = backBtn.getAttribute("href");
					}, 280);
				});
			}
		</script>

		<!-- ── NextWBC Application (OOP Modules) ── -->
		<script>
			import { GradioSpaceClient } from "../lib/nextwbc/gradio-client";
			import { NextWbcUI } from "../lib/nextwbc/nextwbc-ui";
			import { AeroBubbleEngine } from "../lib/nextwbc/bubble-engine";
			import { FishSpawner } from "../lib/nextwbc/fish-spawner";

			// ── Initialize the Gradio API client & UI controller ──
			const client = new GradioSpaceClient();
			const ui = new NextWbcUI(client);
			ui.init();

			// ── Initialize the Aero Bubble Physics Engine & Fish Spawner ──
			function initUnderwaterWorld() {
				// 1. Aero Bubbles
				const stageBack = document.getElementById("bubbleStageBack");
				const stageFront = document.getElementById("bubbleStageFront");
				if (stageBack && stageFront) {
					const engine = new AeroBubbleEngine(stageBack, stageFront, {
						coralReefLayer: document.getElementById("coralReefLayer"),
						toggleBtn: document.getElementById("rgbBubbleToggleBtn"),
						config: {
							totalBubbles: 10,
							minSize: 18,
							maxSize: 46,
							backRatio: 0.75,
							mouseRepulsionDist: 140,
							mouseRepulsionForce: 2.2,
						},
					});
					engine.start();
				}

				// 2. Random Fish Spawner (fish1 - fish4)
				const fishContainer = document.getElementById("fishAquariumStage");
				if (fishContainer) {
					const spawner = new FishSpawner(fishContainer, { maxFish: 4 });
					spawner.start();
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initUnderwaterWorld);
			} else {
				initUnderwaterWorld();
			}
		</script>
		<Watermark />
	</body>
</html>
