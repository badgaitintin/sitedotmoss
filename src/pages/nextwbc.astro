											title="Click to toggle boxes"
										/>
									</div>
								</div>

								<!-- Side statistics counts -->
								<div class="wbc-stats-panel">
									<div class="wbc-count-card">
										<span
											class="wbc-count-number"
											id="wbcCellCountNum">0</span
										>
										<span class="wbc-count-label"
											>Cells Detected</span
										>
									</div>

									<div class="wbc-chart-card">
										<h4 class="wbc-chart-title">
											Distribution
										</h4>
										<div id="wbcDistributionContainer">
											<!-- Dynamic Distribution Bars Injected Here -->
										</div>
									</div>
								</div>
							</div>

							<!-- Individual Cell Crops Panel -->
							<div class="wbc-crops-panel">
								<h4 class="wbc-crops-title">
									Detected Cell Crops
								</h4>
								<div class="wbc-crops-grid" id="wbcCropsGrid">
									<!-- Dynamic crops Injected Here -->
								</div>
							</div>
						</div>
					</main>
				</div>
			</div>
		</div>

		<!-- ── Page exit transition (stays inline — pure DOM, tiny) ── -->
		<script>
			const backBtn = document.getElementById("backBtn");
			if (backBtn) {
				backBtn.addEventListener("click", (e) => {
					e.preventDefault();
					document.body.classList.add("is-exiting");
					setTimeout(() => {
						window.location.href = backBtn.getAttribute("href");
					}, 280);
				});
			}
		</script>

		<!-- ── NextWBC Application (OOP Modules) ── -->
		<script type="module">
			import { GradioSpaceClient } from "../lib/nextwbc/gradio-client";
			import { NextWbcUI } from "../lib/nextwbc/nextwbc-ui";
			import { AeroBubbleEngine } from "../lib/nextwbc/bubble-engine";

			// ── Initialize the Gradio API client & UI controller ──
			const client = new GradioSpaceClient();
			const ui = new NextWbcUI(client);
			ui.init();

			// ── Initialize the Aero Bubble Physics Engine ──
			document.addEventListener("DOMContentLoaded", () => {
				const stageBack = document.getElementById("bubbleStageBack");
				const stageFront = document.getElementById("bubbleStageFront");
				if (!stageBack || !stageFront) return;

				const engine = new AeroBubbleEngine(stageBack, stageFront, {
					coralReefLayer: document.getElementById("coralReefLayer"),
					toggleBtn: document.getElementById("rgbBubbleToggleBtn"),
				});
				engine.start();
			});
		</script>
	</body>
</html>
