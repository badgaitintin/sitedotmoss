---
// deep-learning-fundamental.astro — Deep Learning Fundamental (Minimalist Editorial Layout)
import '@fontsource/google-sans-flex';
import Watermark from '../components/Watermark.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Deep Learning Fundamental — site(.)moss</title>
    <meta name="description" content="A foundational overview of Deep Learning: History, Artificial Neural Networks, Deep Architectures, and Specialized Paradigms." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="layout-root">
      
      <!-- =========================================================
           LEFT SIDEBAR: MINIMAL NAVIGATION
      ========================================================= -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-top">
          <a href="/" class="back-link">
            <svg class="icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Dashboard</span>
          </a>
          <span class="sub-tag">AI LAB</span>
        </div>

        <div class="doc-meta">
          <h2 class="doc-title">Deep Learning Fundamental</h2>
          <p class="doc-subtitle">A first-principles guide to artificial neural systems, architectural evolution, and paradigms.</p>
        </div>

        <div class="nav-divider"></div>

        <nav class="nav-menu">
          <div class="nav-label">TABLE OF CONTENTS</div>
          <ul class="nav-list">
            <li>
              <a href="#history" class="nav-item active">
                <span class="nav-num">01</span>
                <span class="nav-text">History &amp; Origins</span>
              </a>
            </li>
            <li>
              <a href="#ann" class="nav-item">
                <span class="nav-num">02</span>
                <span class="nav-text">Artificial Neural Network (ANN)</span>
              </a>
            </li>
            <li>
              <a href="#dnn" class="nav-item">
                <span class="nav-num">03</span>
                <span class="nav-text">Deep Neural Network (DNN)</span>
              </a>
            </li>
            <li>
              <a href="#other-types" class="nav-item">
                <span class="nav-num">04</span>
                <span class="nav-text">Other Types of Neural Networks</span>
              </a>
            </li>
            <li>
              <a href="#summary" class="nav-item">
                <span class="nav-num">05</span>
                <span class="nav-text">Summary &amp; Takeaways</span>
              </a>
            </li>
          </ul>
        </nav>

        <div class="sidebar-bottom">
          <div class="reading-meta">
            <svg class="icon" viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Reading Time: ~15 mins</span>
          </div>
        </div>
      </aside>

      <!-- =========================================================
           RIGHT / MAIN: EDITORIAL CONTENT AREA
      ========================================================= -->
      <main class="main-content">
        
        <!-- Header Bar for Mobile -->
        <header class="mobile-header">
          <button class="mobile-menu-btn" id="mobile-toggle" aria-label="Toggle Menu">
            <svg class="icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <span class="mobile-title">Deep Learning Fundamental</span>
        </header>

        <!-- Reading Canvas -->
        <div class="reading-canvas">
          
          <header class="article-header">
            <div class="article-breadcrumb">
              <span>site(.)moss</span>
              <span class="sep">/</span>
              <span>AI Lab</span>
              <span class="sep">/</span>
              <span class="current">Fundamentals</span>
            </div>
            <h1 class="article-title">Deep Learning Fundamental</h1>
            <p class="article-lead">
              An exploration of artificial neural networks, from early biological analogs to modern multi-layered representation learning architectures.
            </p>
          </header>

          <hr class="section-divider" />

          <!-- =========================================================
               SECTION 1: HISTORY
          ========================================================= -->
          <section id="history" class="content-section">
            <div class="section-header">
              <span class="section-badge">01</span>
              <h2>History &amp; Origins</h2>
            </div>

            <p>
              The quest to model human cognition mathematically dates back to the mid-twentieth century. Rather than emerging suddenly, modern Deep Learning is the culmination of decades of mathematical theory, computational breakthroughs, and empirical trial and error.
            </p>

            <div class="timeline-box">
              <div class="timeline-item">
                <div class="timeline-year">1943</div>
                <div class="timeline-content">
                  <h3>The McCulloch-Pitts Neuron</h3>
                  <p>Warren McCulloch and Walter Pitts proposed the first computational model of a biological neuron. It operated on binary inputs and produced a binary output via a fixed threshold step function, laying the foundation for theoretical neural networks.</p>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-year">1958</div>
                <div class="timeline-content">
                  <h3>Rosenblatt's Perceptron</h3>
                  <p>Frank Rosenblatt introduced the <em>Perceptron</em>, adding learnable weights to the input signals. This marked the transition from hard-coded computational logic to machines capable of learning linear decision boundaries from empirical data.</p>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-year">1969</div>
                <div class="timeline-content">
                  <h3>The Minsky-Papert Limitation &amp; The AI Winter</h3>
                  <p>Marvin Minsky and Seymour Papert published a mathematical proof showing that single-layer perceptrons could not solve non-linearly separable problems, such as the exclusive-or (XOR) logic gate. Funding and academic interest dropped significantly, initiating the first "AI Winter".</p>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-year">1986</div>
                <div class="timeline-content">
                  <h3>Backpropagation Resurgence</h3>
                  <p>David Rumelhart, Geoffrey Hinton, and Ronald Williams popularized the <em>Backpropagation algorithm</em> using the chain rule of calculus. This allowed multi-layer neural networks to adjust internal weights efficiently, breaking the single-layer limitation.</p>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-year">2012</div>
                <div class="timeline-content">
                  <h3>The AlexNet Turning Point</h3>
                  <p>Alex Krizhevsky, Ilya Sutskever, and Geoffrey Hinton entered <em>AlexNet</em> into the ImageNet competition, outperforming traditional handcrafted computer vision techniques by a substantial margin using GPU-accelerated convolutional architectures. This launched the modern Deep Learning era.</p>
                </div>
              </div>
            </div>
          </section>

          <hr class="section-divider" />

          <!-- =========================================================
               SECTION 2: ARTIFICIAL NEURAL NETWORK
          ========================================================= -->
          <section id="ann" class="content-section">
            <div class="section-header">
              <span class="section-badge">02</span>
              <h2>Artificial Neural Network (ANN)</h2>
            </div>

            <p>
              An <strong>Artificial Neural Network (ANN)</strong> is a computational system composed of interconnected processing units called <em>artificial neurons</em>. Inspired loosely by biological synaptic connections in the brain, each neuron receives signals, processes them through an affine transformation, and determines an output.
            </p>

            <div class="callout-card">
              <div class="callout-header">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                <span>The Single Neuron Formulation</span>
              </div>
              <p>A single artificial neuron takes a vector of inputs, multiplies each by a corresponding parameter (weight), adds a bias term, and passes the aggregate sum through a non-linear activation function:</p>
              <div class="math-block">
                z = ∑ (wᵢ · xᵢ) + b = wᵀx + b
              </div>
              <div class="math-block">
                a = σ(z) = 1 / (1 + e⁻ᶻ)
              </div>
            </div>

            <h3>Key Components of an ANN</h3>
            
            <div class="text-grid">
              <div class="grid-card">
                <h4>Input Layer</h4>
                <p>Receives the raw feature values from external datasets (e.g. numerical table measurements, sound frequencies, pixel intensities).</p>
              </div>

              <div class="grid-card">
                <h4>Weights &amp; Biases</h4>
                <p>The learnable parameters of the model. Weights quantify the relative importance of specific input signals, while biases adjust the overall firing threshold.</p>
              </div>

              <div class="grid-card">
                <h4>Activation Functions</h4>
                <p>Non-linear mapping functions (such as ReLU, Sigmoid, and Tanh) applied to the weighted sum, allowing the network to approximate non-linear mathematical relations.</p>
              </div>

              <div class="grid-card">
                <h4>Output Layer</h4>
                <p>Produces the final predictions, formatted as class probabilities via Softmax for classification or real values for regression tasks.</p>
              </div>
            </div>

            <h3>Why Non-Linearity is Essential</h3>
            <p>
              If a multi-layer network consists solely of linear transformations, any sequence of matrix multiplications can be reduced to a single equivalent linear operation:
            </p>
            <div class="math-block">
              W₂ (W₁x + b₁) + b₂ = (W₂ W₁) x + (W₂ b₁ + b₂) = W'x + b'
            </div>
            <p>
              Without non-linear activations, stacking multiple layers provides no increase in expressive power over a simple linear regression model.
            </p>
          </section>

          <hr class="section-divider" />

          <!-- =========================================================
               SECTION 3: DEEP NEURAL NETWORK
          ========================================================= -->
          <section id="dnn" class="content-section">
            <div class="section-header">
              <span class="section-badge">03</span>
              <h2>Deep Neural Network (DNN)</h2>
            </div>

            <p>
              A <strong>Deep Neural Network (DNN)</strong> refers to an artificial neural network containing multiple hidden layers between the input and output stages. The term <em>"Deep"</em> reflects the depth of sequential transformation layers the signal passes through.
            </p>

            <h3>Hierarchical Representation Learning</h3>
            <p>
              The primary theoretical advantage of depth is <em>representation learning</em>. Instead of relying on human engineers to manually craft feature representations, deep networks learn a hierarchy of abstract representations directly from data:
            </p>

            <ul class="clean-list">
              <li><strong>Early Layers:</strong> Capture low-level, primitive features such as edge orientations, color transitions, and texture gradients.</li>
              <li><strong>Middle Layers:</strong> Combine primitive features into mid-level parts and geometric contours (e.g. circles, corners, motifs).</li>
              <li><strong>Deep Layers:</strong> Synthesize high-level semantic abstractions (e.g. object classes, linguistic concepts, global scene composition).</li>
            </ul>

            <div class="callout-card">
              <div class="callout-header">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>The Vanishing &amp; Exploding Gradient Problem</span>
              </div>
              <p>
                As networks grow deeper, gradients propagated backwards through many layers using the chain rule can diminish exponentially toward zero (vanishing) or expand uncontrollably (exploding). This historically prevented networks from exceeding a few layers.
              </p>
              <p>
                Modern deep architectures overcome this challenge using techniques such as:
              </p>
              <ul class="clean-list" style="margin-top: 8px;">
                <li><strong>ReLU Activations:</strong> Preventing saturation in the positive domain.</li>
                <li><strong>Residual / Skip Connections (ResNet):</strong> Providing direct gradient highways across layers.</li>
                <li><strong>Normalization Layers (LayerNorm / BatchNorm):</strong> Stabilizing internal activation distributions.</li>
              </ul>
            </div>
          </section>

          <hr class="section-divider" />

          <!-- =========================================================
               SECTION 4: OTHER TYPES OF NEURAL NETWORKS
          ========================================================= -->
          <section id="other-types" class="content-section">
            <div class="section-header">
              <span class="section-badge">04</span>
              <h2>Other Types of Neural Networks</h2>
            </div>

            <p>
              While standard fully connected networks (Dense MLPs) are effective for structured tabular data, specialized architectures have been developed to exploit inductive biases in distinct modalities such as images, sequences, and graph structures.
            </p>

            <div class="arch-container">
              
              <!-- 1. CNN -->
              <div class="arch-card">
                <div class="arch-top">
                  <div class="arch-tag">VISION &amp; SPATIAL</div>
                  <h3 class="arch-name">Convolutional Neural Networks (CNN)</h3>
                </div>
                <p class="arch-desc">
                  Utilizes parameterized sliding kernels (filters) to perform discrete convolution across spatial grids.
                </p>
                <div class="arch-specs">
                  <div class="spec-row">
                    <span class="spec-k">Key Bias:</span>
                    <span class="spec-v">Translational invariance &amp; local spatial locality</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Core Operations:</span>
                    <span class="spec-v">2D Convolution, Pooling (Max/Avg), Stride, Padding</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Primary Uses:</span>
                    <span class="spec-v">Computer Vision, Image Classification, Object Detection, Medical Imaging</span>
                  </div>
                </div>
              </div>

              <!-- 2. RNN / LSTM -->
              <div class="arch-card">
                <div class="arch-top">
                  <div class="arch-tag">TEMPORAL &amp; SEQUENTIAL</div>
                  <h3 class="arch-name">Recurrent Neural Networks (RNN &amp; LSTM / GRU)</h3>
                </div>
                <p class="arch-desc">
                  Processes sequential inputs iteratively while maintaining an internal hidden state vector as a persistent memory of prior steps.
                </p>
                <div class="arch-specs">
                  <div class="spec-row">
                    <span class="spec-k">Key Bias:</span>
                    <span class="spec-v">Temporal causality &amp; sequential continuity</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Core Operations:</span>
                    <span class="spec-v">Recurrent Hidden Loops, Gating Units (Forget, Input, Output Gates)</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Primary Uses:</span>
                    <span class="spec-v">Time Series Forecasting, Speech Recognition, Biosignal Analysis</span>
                  </div>
                </div>
              </div>

              <!-- 3. Transformer -->
              <div class="arch-card">
                <div class="arch-top">
                  <div class="arch-tag">ATTENTION &amp; FOUNDATION</div>
                  <h3 class="arch-name">Transformer Architectures</h3>
                </div>
                <p class="arch-desc">
                  Replaces recurrence entirely with Multi-Head Self-Attention mechanisms, computing pairwise correlation scores across all tokens simultaneously.
                </p>
                <div class="arch-specs">
                  <div class="spec-row">
                    <span class="spec-k">Key Bias:</span>
                    <span class="spec-v">Permutation-equivariant relational modeling with positional encodings</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Core Operations:</span>
                    <span class="spec-v">Scaled Dot-Product Attention: softmax(Q · Kᵀ / √dₖ) · V</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Primary Uses:</span>
                    <span class="spec-v">Large Language Models (LLMs), Vision Transformers (ViT), Multimodal AI</span>
                  </div>
                </div>
              </div>

              <!-- 4. Generative / Latent -->
              <div class="arch-card">
                <div class="arch-top">
                  <div class="arch-tag">SYNTHESIS &amp; DENSITY</div>
                  <h3 class="arch-name">Generative Architectures (Autoencoders, GANs, Diffusion)</h3>
                </div>
                <p class="arch-desc">
                  Learns underlying probability density distributions to sample and synthesize novel high-dimensional data points from latent noise representations.
                </p>
                <div class="arch-specs">
                  <div class="spec-row">
                    <span class="spec-k">Key Bias:</span>
                    <span class="spec-v">Low-dimensional manifold hypothesis &amp; score matching</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Core Operations:</span>
                    <span class="spec-v">Adversarial Minimax Loss, KL-Divergence, Denoising Score Matching</span>
                  </div>
                  <div class="spec-row">
                    <span class="spec-k">Primary Uses:</span>
                    <span class="spec-v">Image &amp; Audio Generation, Representation Disentanglement, Anomaly Detection</span>
                  </div>
                </div>
              </div>

            </div>
          </section>

          <hr class="section-divider" />

          <!-- =========================================================
               SECTION 5: SUMMARY
          ========================================================= -->
          <section id="summary" class="content-section">
            <div class="section-header">
              <span class="section-badge">05</span>
              <h2>Summary &amp; Comparative Taxonomy</h2>
            </div>

            <p>
              Neural networks have evolved from simple threshold logic gates into expressive parametric function approximators. The choice of architecture is determined by the underlying geometry and structure of the input data:
            </p>

            <div class="table-wrap">
              <table class="clean-table">
                <thead>
                  <tr>
                    <th>Architecture</th>
                    <th>Data Modality</th>
                    <th>Core Inductive Bias</th>
                    <th>Primary Strength</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>ANN / MLP</strong></td>
                    <td>Tabular / Flat Vectors</td>
                    <td>Dense Global Relationships</td>
                    <td>General Non-linear Function Fitting</td>
                  </tr>
                  <tr>
                    <td><strong>CNN</strong></td>
                    <td>Grids (Images, Spectrograms)</td>
                    <td>Local Spatial Invariance</td>
                    <td>Translation Invariant Visual Perception</td>
                  </tr>
                  <tr>
                    <td><strong>RNN / LSTM</strong></td>
                    <td>Temporal Sequences</td>
                    <td>Sequential Memory</td>
                    <td>Variable-Length Historical Tracking</td>
                  </tr>
                  <tr>
                    <td><strong>Transformer</strong></td>
                    <td>Sets, Tokens &amp; Multimodal</td>
                    <td>Pairwise Dynamic Attention</td>
                    <td>Parallel Training &amp; Global Context</td>
                  </tr>
                  <tr>
                    <td><strong>Diffusion / GAN</strong></td>
                    <td>Continuous Distributions</td>
                    <td>Latent Density Manifolds</td>
                    <td>High-Fidelity Sample Generation</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="footer-nav-box">
              <a href="/" class="footer-btn">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Return to Dashboard</span>
              </a>
              <a href="#history" class="footer-btn secondary">
                <span>Back to Top</span>
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="19" x2="12" y2="5"></line>
                  <polyline points="5 12 12 5 19 12"></polyline>
                </svg>
              </a>
            </div>
          </section>

        </div>
      </main>

    </div>

    <Watermark />
  </body>
</html>

<style>
  /* =========================================================
     DESIGN SYSTEM: MONOCHROMATIC EDITORIAL (NO NOISE / CLEAN)
  ========================================================= */
  :root {
    --bg-page: #0a0c0f;
    --bg-sidebar: #08090b;
    --bg-card: rgba(255, 255, 255, 0.025);
    --bg-card-hover: rgba(255, 255, 255, 0.045);
    
    --border-subtle: rgba(255, 255, 255, 0.07);
    --border-card: rgba(255, 255, 255, 0.1);
    
    --text-primary: #ededed;
    --text-secondary: #9aa0a6;
    --text-muted: #606770;
    
    --accent-mono: #d4d4d8;
    
    --font-sans: 'Google Sans Flex', 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    
    --sidebar-w: 280px;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    width: 100%;
    min-height: 100vh;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* Layout Container */
  .layout-root {
    display: flex;
    min-height: 100vh;
    width: 100%;
  }

  /* =========================================================
     LEFT SIDEBAR
  ========================================================= */
  .sidebar {
    width: var(--sidebar-w);
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border-subtle);
    height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding: 24px 20px;
    z-index: 40;
    overflow-y: auto;
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: #ffffff;
  }

  .sub-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .doc-meta {
    margin-bottom: 20px;
  }
  .doc-title {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .doc-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .nav-divider {
    height: 1px;
    background: var(--border-subtle);
    margin-bottom: 20px;
  }

  .nav-menu {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 13px;
    transition: all 0.15s ease;
  }
  .nav-item:hover {
    color: #ffffff;
    background: var(--bg-card-hover);
  }
  .nav-item.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
    font-weight: 500;
