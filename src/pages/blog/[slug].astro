---
import { db } from "../../db/client";
import { posts, comments } from "../../db/schema";
import { eq, desc } from "drizzle-orm";
import { InstagramPostModal } from "../../components/blog/InstagramPostModal";
import '@fontsource/google-sans-flex';
import "../../styles/blog.css";
import Watermark from "../../components/Watermark.astro";

export const prerender = false;

const { slug } = Astro.params;

let post: any = null;
if (slug) {
  const dbPosts = await db.select().from(posts).where(eq(posts.slug, slug)).limit(1);
  if (dbPosts.length > 0) {
    const rawPost = dbPosts[0];
    const postComments = await db
      .select({
        id: comments.id,
        postSlug: comments.postSlug,
        authorName: comments.authorName,
        authorAvatar: comments.authorAvatar,
        content: comments.content,
        parentId: comments.parentId,
        createdAt: comments.createdAt,
      })
      .from(comments)
      .where(eq(comments.postSlug, slug))
      .orderBy(desc(comments.createdAt));

    post = {
      ...rawPost,
      images: rawPost.images ? JSON.parse(rawPost.images) : [rawPost.coverImage],
      tags: rawPost.tags ? JSON.parse(rawPost.tags) : [],
      comments: postComments.map((c: any) => ({
        id: c.id,
        authorName: c.authorName,
        authorAvatar: c.authorAvatar || undefined,
        content: c.content,
        parentId: c.parentId || null,
        likesCount: c.likesCount || 0,
        createdAt: c.createdAt,
      })),
    };
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post ? `${post.title} | sitedotmoss` : "Post Not Found"}</title>
    <meta name="description" content={post ? post.caption.substring(0, 150) : "Blog Post"} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="ig-root" style="margin: 0; min-height: 100vh;">
    {post ? (
      <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; padding: 16px; z-index: 1000;">
        <InstagramPostModal post={post} onClose={() => { window.location.href = "/blog"; }} client:load />
      </div>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; gap: 16px; width: 100%;">
        <h1 style="font-size: 22px; font-weight: 500; color: #111827;">Post Not Found</h1>
        <a href="/blog" style="padding: 10px 24px; border-radius: 10px; background: #0f172a; color: #fff; text-decoration: none; font-size: 14px; font-weight: 600;">
          Back to Journal
        </a>
      </div>
    )}
    <Watermark />
  </body>
</html>
