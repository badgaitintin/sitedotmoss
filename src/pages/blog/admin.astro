---
import { BlogCrud } from "../../components/blog/BlogCrud";
import '@fontsource/google-sans-flex';
import "../../styles/blog.css";
import Watermark from "../../components/Watermark.astro";

export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Admin | sitedotmoss</title>
    <meta name="description" content="Admin CRUD panel for sitedotmoss blog posts" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="admin-body">
    <!-- Top Header Navigation -->
    <header id="admin-header">
      <div class="header-container">
        <a href="/blog" class="back-link">
          <div class="back-icon-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
          </div>
          <span>Back to Journal</span>
        </a>
        <h1 class="header-title">Blog Admin</h1>
        <div style="width: 140px;"></div>
      </div>
    </header>

    <main className="admin-content">
      <BlogCrud client:load />
    </main>
    <Watermark />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .admin-body {
    min-height: 100vh;
    background: transparent;
    color: #111827;
    font-family: "Google Sans Flex", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    position: relative;
    margin: 0;
  }

  .admin-body::before {
    content: "";
    position: fixed;
    inset: -40px;
    z-index: -1;
    background-image: url('/frutigif_1.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(8px);
    background-color: rgba(255, 255, 255, 0.05);
    background-blend-mode: overlay;
  }

  #admin-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    width: 100%;
  }

  .header-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #111827;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .back-link:hover { opacity: 0.75; }

  .back-icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111827;
  }

  .header-title {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .admin-content {
    width: 100%;
  }
</style>
