---
import { BlogCrud } from "../../components/blog/BlogCrud";

export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Admin | sitedotmoss</title>
    <meta name="description" content="Admin CRUD panel for sitedotmoss blog posts" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Top Header Navigation -->
    <header id="admin-header">
      <div class="header-container">
        <a href="/blog" class="back-link">
          <div class="back-icon-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
          </div>
          <span>← Journal</span>
        </a>
        <h1 class="header-title">Blog Admin</h1>
        <div style="width: 100px;"></div>
      </div>
    </header>

    <BlogCrud client:load />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg-color: #f8f7f5;
    --fg-color: #1a1410;
  }

  html, body {
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-color);
    color: var(--fg-color);
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  #admin-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 247, 245, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .header-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-color);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .back-link:hover { opacity: 0.65; }

  .back-icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-color);
  }

  .header-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--fg-color);
  }
</style>
