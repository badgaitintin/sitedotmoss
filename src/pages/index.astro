---
// index.astro — Minimalist 3-Circle Venn Diagram (Google Sans Flex)
import '@fontsource/google-sans-flex';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>sitedotmoss.vercel.app</title>
    <meta name="description" content="Tinnaphop Sonsang (Moss) — sitedotmoss.vercel.app" />
  </head>
  <body>

    <!-- TOP-LEFT: SITE NAME -->
    <header class="corner top-left">
      <a href="/" class="brand-link">sitedotmoss.vercel.app</a>
    </header>

    <!-- TOP-RIGHT: NAVIGATION MENU -->
    <nav class="corner top-right">
      <ul class="nav-list">
        <li><a href="/legacy">legacy</a></li>
        <li><button type="button" class="nav-btn" id="navExperienceBtn" data-target="experience">experience</button></li>
        <li><button type="button" class="nav-btn" id="navProjectBtn" data-target="project">project</button></li>
        <li><a href="/cv">cv</a></li>
      </ul>
    </nav>

    <!-- MAIN VENN DIAGRAM STAGE -->
    <main class="venn-stage">
      <!-- 3-CIRCLE VENN (LANDING VIEW) -->
      <!-- LANDSCAPE / DESKTOP (3 Circles: OOO) -->
      <svg class="venn-svg landscape-venn" id="vennLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <!-- 1. Arc 1: Circle 2 left boundary (runs convex towards left) -->
          <path id="arcCircle2Left" d="M 482,132 A 450,450 0 0,0 482,768" fill="none" />
          
          <!-- 2. Arc 2: Center vesica left boundary (Circle 3 left boundary inside middle circle) -->
          <path id="arcVesicaLeft" d="M 800,167 A 450,450 0 0,0 800,733" fill="none" />

          <!-- 3. Arc 3: Center vesica right boundary (Circle 1 right boundary inside middle circle) -->
          <path id="arcVesicaRight" d="M 800,167 A 450,450 0 0,1 800,733" fill="none" />

          <!-- 4. Arc 4: Circle 2 right boundary (runs convex towards right) -->
          <path id="arcCircle2Right" d="M 1118,132 A 450,450 0 0,1 1118,768" fill="none" />
        </defs>

        <circle cx="450" cy="450" r="450" class="venn-circle" />
        <circle cx="800" cy="450" r="450" class="venn-circle" />
        <circle cx="1150" cy="450" r="450" class="venn-circle" />

        <!-- 1. Tinnaphop Sonsang (Top-left arc, green circle) -->
        <text class="venn-text text-curved">
          <textPath href="#arcCircle2Left" startOffset="26%" text-anchor="middle">
            Tinnaphop Sonsang
          </textPath>
        </text>

        <!-- 2. Moss (Moved into left inner vesica arc - first yellow region) -->
        <text class="venn-text text-curved">
          <textPath href="#arcVesicaLeft" startOffset="50%" text-anchor="middle">
            Moss
          </textPath>
        </text>

        <!-- CENTER EYE IMAGE -->
        <image
          id="eyeImgLandscape"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="730" y="380"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          transform="rotate(90, 800, 450)"
          class="eye-img"
        />

        <!-- 3. Live age (Moved into right inner vesica arc - second yellow region) -->
        <text class="venn-text text-curved">
          <textPath href="#arcVesicaRight" startOffset="50%" text-anchor="middle">
            <tspan id="ageDisplay">22y 314d 1052m</tspan> · 60kg 180cm
          </textPath>
        </text>

        <!-- 4. linkedin & email (On right arc, moved down along curve towards bottom arrow) -->
        <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
          <text class="venn-text text-curved hover-link">
            <textPath href="#arcCircle2Right" startOffset="66%" text-anchor="middle">
              linkedin
            </textPath>
          </text>
        </a>

        <a href="mailto:tinnaphop.moss@gmail.com">
          <text class="venn-text text-curved hover-link">
            <textPath href="#arcCircle2Right" startOffset="79%" text-anchor="middle">
              email
            </textPath>
          </text>
        </a>
      </svg>

      <!-- PORTRAIT / MOBILE (3 Circles in a column) -->
      <svg class="venn-svg portrait-venn" id="vennPortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice">
        <circle cx="450" cy="450" r="450" class="venn-circle" />
        <circle cx="450" cy="800" r="450" class="venn-circle" />
        <circle cx="450" cy="1150" r="450" class="venn-circle" />

        <!-- TOP LENS (Exclusive 1 ∩ 2): Center y=525 -->
        <g id="lensTopPortrait" class="venn-lens-group">
          <text x="450" y="490" text-anchor="middle" class="venn-text text-side-portrait">
            Tinnaphop Sonsang
          </text>
          <text x="450" y="560" text-anchor="middle" class="venn-text text-side-portrait">
            Moss
          </text>
        </g>

        <!-- CENTER LENS (Triple overlap): y=800 -->
        <image
          id="eyeImgPortrait"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="380" y="730"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          class="eye-img"
        />

        <!-- BOTTOM LENS (Exclusive 2 ∩ 3): Center y=1075 -->
        <g id="lensBottomPortrait" class="venn-lens-group">
          <text x="450" y="1020" text-anchor="middle" class="venn-text text-side-portrait">
            <tspan x="450" dy="0" id="ageDisplayMobile">22y 314d 1052m</tspan>
            <tspan x="450" dy="1.15em" class="venn-text-sub-portrait">60kg · 180cm</tspan>
          </text>
          <!-- linkedin and email kept right next to each other -->
          <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
            <text x="450" y="1115" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              linkedin
            </text>
          </a>
          <a href="mailto:tinnaphop.moss@gmail.com">
            <text x="450" y="1170" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              email
            </text>
          </a>
        </g>
      </svg>

      <!-- 2-CIRCLE VENN (FLIP PAGE FOR EXPERIENCE & PROJECT) -->
      <!-- Landscape 2 circles (Left circle cx=560, Right circle cx=1040, r=450) -->
      <svg class="venn-svg landscape-venn" id="vennTwoCircleLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <circle cx="560" cy="450" r="450" class="venn-circle" />
        <circle cx="1040" cy="450" r="450" class="venn-circle" />

        <!-- Left Circle Exclusive: x=360 -->
        <g id="twoLeftLandscape" class="venn-lens-group"></g>

        <!-- Center Intersection (Lens): x=800 -->
        <g id="twoCenterLandscape" class="venn-lens-group">
          <text id="twoCenterTitleLandscape" x="800" y="450" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title">
          </text>
        </g>

        <!-- Right Circle Exclusive: x=1240 -->
        <g id="twoRightLandscape" class="venn-lens-group"></g>
      </svg>

      <!-- Portrait 2 circles (Top circle cy=560, Bottom circle cy=1040, r=450) -->
      <svg class="venn-svg portrait-venn" id="vennTwoCirclePortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <circle cx="450" cy="560" r="450" class="venn-circle" />
        <circle cx="450" cy="1040" r="450" class="venn-circle" />

        <!-- Top Circle Exclusive: y=360 -->
        <g id="twoTopPortrait" class="venn-lens-group"></g>

        <!-- Center Intersection: y=800 -->
        <g id="twoCenterPortrait" class="venn-lens-group">
          <text id="twoCenterTitlePortrait" x="450" y="800" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title-portrait">
          </text>
        </g>

        <!-- Bottom Circle Exclusive: y=1240 -->
        <g id="twoBottomPortrait" class="venn-lens-group"></g>
      </svg>
    </main>

    <!-- BOTTOM-LEFT: 3-CIRCLE MINI ICON + INSPIRED BY CREDIT -->
    <aside class="corner bottom-left">
      <div class="credit-row">
        <svg width="44" height="20" viewBox="0 0 54 22" fill="none" stroke="currentColor" stroke-width="1.8" class="mini-diagram">
          <circle cx="11" cy="11" r="10" />
          <circle cx="27" cy="11" r="10" />
          <circle cx="43" cy="11" r="10" />
        </svg>
        <span class="inspired-text">inspired by robyn - <a href="https://sexistential.xyz" target="_blank" rel="noopener noreferrer">sexistential.xyz</a> website</span>
      </div>
    </aside>

    <!-- BOTTOM-RIGHT: UTILITY ACTIONS -->
    <aside class="corner bottom-right">
      <button class="action-btn" id="shareBtn">share</button>
    </aside>

    <!-- BOTTOM 5-COLOR ACCENT STRIPE (ขาว, ดำ, ชมพูซากุระ, น้ำเงิน, เหลืองมัสตาร์ด) -->
    <div class="bottom-stripe">
      <span class="stripe-block stripe-white" title="White"></span>
      <span class="stripe-block stripe-black" title="Black"></span>
      <span class="stripe-block stripe-sakura" title="Sakura Pink"></span>
      <span class="stripe-block stripe-blue" title="Blue"></span>
      <span class="stripe-block stripe-mustard" title="Mustard Yellow"></span>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">link copied!</div>

    <script is:inline>
      // ── BIRTHDAY LIVE CALCULATION: 13 Jan 2004 ──
      const BIRTH_DATE = new Date('2004-01-13T00:00:00+07:00');

      function updateAge() {
        const now = new Date();
        let years = now.getFullYear() - BIRTH_DATE.getFullYear();
        let birthThisYear = new Date(now.getFullYear(), BIRTH_DATE.getMonth(), BIRTH_DATE.getDate());
        if (now < birthThisYear) {
          years--;
          birthThisYear = new Date(now.getFullYear() - 1, BIRTH_DATE.getMonth(), BIRTH_DATE.getDate());
        }
        const daysSinceLastBirthday = Math.floor((now - birthThisYear) / (1000 * 60 * 60 * 24));
        const minutesInDay = (now.getHours() * 60) + now.getMinutes();
        const ageStr = `${years}y ${daysSinceLastBirthday}d ${minutesInDay}m`;

        const el1 = document.getElementById('ageDisplay');
        const el2 = document.getElementById('ageDisplayMobile');
        if (el1) el1.textContent = ageStr;
        if (el2) el2.textContent = ageStr;
      }

      updateAge();
      setInterval(updateAge, 30000);

      // ── FLIP DATA FOR 2-CIRCLE EXPERIENCE & PROJECT ──
      const twoCircleData = {
        experience: {
          title: "experience",
          left: [
            { title: "Lief Capital Asset Management", sub: "Data Scientist · AI & Research (2026)" },
            { title: "Azure ML & Polars Ingestion", sub: "Vectorized workflows, >50% backtest runtime cut" }
          ],
          right: [
            { title: "Thaidotrun Co., Ltd. (ASICS)", sub: "AI & Computer Vision Intern (2025–2026)" },
            { title: "RT-DETR & BoTSORT Tracking", sub: "Marathon runner highlight generation pipeline" }
          ]
        },
        project: {
          title: "project",
          left: [
            { title: "MTC-UAV Maize Counting", sub: "Spatial density estimation in dense aerial UAV imagery" },
            { title: "Raptor Blood Cell Classification", sub: "YOLO-26l, RT-DETR & Grad-CAM XAI diagnostics" }
          ],
          right: [
            { title: "Runner Highlight Extraction", sub: "Spatial weighting algorithm & OCR bib recognition" },
            { title: "Shoe Detection & ML Pipeline", sub: "DINO Vision Transformer & HDBSCAN video curation" }
          ]
        }
      };

      let activeSection = null;

      const navExpBtn = document.getElementById('navExperienceBtn');
      const navProjBtn = document.getElementById('navProjectBtn');

      const venn3Landscape = document.getElementById('vennLandscape');
      const venn3Portrait = document.getElementById('vennPortrait');
      const venn2Landscape = document.getElementById('vennTwoCircleLandscape');
      const venn2Portrait = document.getElementById('vennTwoCirclePortrait');

      const twoCenterTitleL = document.getElementById('twoCenterTitleLandscape');
      const twoCenterTitleP = document.getElementById('twoCenterTitlePortrait');
      const twoLeftL = document.getElementById('twoLeftLandscape');
      const twoRightL = document.getElementById('twoRightLandscape');
      const twoTopP = document.getElementById('twoTopPortrait');
      const twoBottomP = document.getElementById('twoBottomPortrait');

      function renderSideItems(items, x, isPortrait, yBase) {
        if (!items) return '';
        const yOffsets = items.length === 1 ? [0] : [-55, 55];
        return items.map((it, idx) => {
          const cy = (yBase || 450) + (yOffsets[idx] || 0);
          return `
            <text x="${x}" y="${cy}" text-anchor="middle" class="venn-text ${isPortrait ? 'text-side-portrait' : 'text-side'}">
              <tspan x="${x}" dy="-0.2em">${it.title}</tspan>
              <tspan x="${x}" dy="1.2em" class="${isPortrait ? 'venn-text-sub-portrait' : 'venn-text-sub'}">${it.sub}</tspan>
            </text>
          `;
        }).join('');
      }

      function switchView(section) {
        const stage = document.querySelector('.venn-stage');
        if (stage) stage.classList.add('flipping');
        setTimeout(() => {
          if (stage) stage.classList.remove('flipping');
        }, 300);

        if (activeSection === section) {
          // Flip back to 3-circle landing
          activeSection = null;
          if (navExpBtn) navExpBtn.textContent = 'experience';
          if (navProjBtn) navProjBtn.textContent = 'project';

          // Show 3-circle, hide 2-circle
          venn3Landscape.style.setProperty('display', '', '');
          venn3Portrait.style.setProperty('display', '', '');
          venn2Landscape.style.setProperty('display', 'none', 'important');
          venn2Portrait.style.setProperty('display', 'none', 'important');
        } else {
          // Flip to 2-circle section
          activeSection = section;
          if (navExpBtn) navExpBtn.textContent = section === 'experience' ? '✕' : 'experience';
          if (navProjBtn) navProjBtn.textContent = section === 'project' ? '✕' : 'project';

          const data = twoCircleData[section];
          if (twoCenterTitleL) twoCenterTitleL.textContent = data.title;
          if (twoCenterTitleP) twoCenterTitleP.textContent = data.title;

          if (twoLeftL) twoLeftL.innerHTML = renderSideItems(data.left, 360, false, 450);
          if (twoRightL) twoRightL.innerHTML = renderSideItems(data.right, 1240, false, 450);
          if (twoTopP) twoTopP.innerHTML = renderSideItems(data.left, 450, true, 360);
          if (twoBottomP) twoBottomP.innerHTML = renderSideItems(data.right, 450, true, 1240);

          // Hide 3-circle, show 2-circle
          venn3Landscape.style.setProperty('display', 'none', 'important');
          venn3Portrait.style.setProperty('display', 'none', 'important');
          venn2Landscape.style.setProperty('display', '', '');
          venn2Portrait.style.setProperty('display', '', '');
        }
      }

      if (navExpBtn) navExpBtn.addEventListener('click', () => switchView('experience'));
      if (navProjBtn) navProjBtn.addEventListener('click', () => switchView('project'));

      // ── SHARE BUTTON ──
      const shareBtn = document.getElementById('shareBtn');
      const toast = document.getElementById('toast');

      shareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'sitedotmoss.vercel.app',
              text: 'Tinnaphop Sonsang (Moss)',
              url: url
            });
            return;
          } catch (e) {}
        }
        navigator.clipboard.writeText(url).then(() => {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 1800);
        });
      });
    </script>
  </body>
</html>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background-color: #ffffff;
    color: #000000;
    font-family: 'Google Sans Flex', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ── CORNER CONTAINERS ── */
  .corner {
    position: fixed;
    z-index: 50;
    user-select: none;
  }

  /* ── UNIFIED FONT SIZE ACROSS MAIN CORNER ELEMENTS ── */
  :root {
    --site-font-size: clamp(1.85rem, 3.2vw, 2.75rem);
  }

  /* ── TOP-LEFT BRAND ── */
  .top-left {
    top: 20px;
    left: 24px;
  }

  .brand-link {
    font-size: var(--site-font-size);
    font-family: inherit;
    font-weight: 400;
    letter-spacing: -0.04em;
    color: #000000;
    text-decoration: none;
    line-height: 1;
    display: inline-block;
    transition: opacity 0.15s ease;
  }

  .brand-link:hover {
    opacity: 0.5;
  }

  /* ── TOP-RIGHT NAVIGATION ── */
  .top-right {
    top: 18px;
    right: 24px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0px;
    margin: 0;
    padding: 0;
  }

  .nav-list a, .nav-btn {
    font-size: var(--site-font-size);
    font-family: inherit;
    font-weight: 400;
    letter-spacing: -0.04em;
    color: #000000;
    text-decoration: none;
    line-height: 1.08;
    display: block;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: right;
    transition: opacity 0.15s ease;
  }

  .nav-list a:hover, .nav-btn:hover {
    opacity: 0.4;
  }

  /* ── VENN OVERLAY HTML STYLES ── */
  .venn-overlay-fo {
    overflow: visible;
    pointer-events: auto;
  }

  .venn-overlay-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
    padding: 10px 4px;
    font-family: 'Google Sans Flex', -apple-system, sans-serif;
  }

  .venn-cv-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 100%;
  }

  .venn-cv-tag {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #71717a;
    text-transform: uppercase;
  }

  .venn-cv-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .venn-cv-title {
    font-size: 15px;
    font-weight: 500;
    color: #000000;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .venn-cv-sub {
    font-size: 11px;
    color: #71717a;
    line-height: 1.2;
  }

  .venn-cv-body {
    font-size: 12px;
    color: #27272a;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* ── MAIN VENN STAGE ── */
  .venn-stage {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    z-index: 10;
  }

  .venn-svg {
    width: 100%;
    height: 100%;
  }

  /* 3 SVG Circles */
  .venn-circle {
    fill: none;
    stroke: #000000;
    stroke-width: 3.2px;
  }

  /* SVG Typography */
  .venn-text {
    font-family: 'Google Sans Flex', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 400;
    fill: #000000;
    letter-spacing: -0.04em;
    user-select: none;
  }

  /* Curved text along circumference */
  .text-curved {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.03em;
    fill: #000000;
  }

  /* Side Text Sizes (Tinnaphop Sonsang & Moss) - Fits inside intersection lens without cutting lines */
  .text-side {
    font-size: 38px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .text-side-portrait {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .text-flip-title {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.05em;
    fill: #000000;
  }

  .text-flip-title-portrait {
    font-size: 52px;
    font-weight: 500;
    letter-spacing: -0.05em;
    fill: #000000;
  }

  .venn-text-sub {
    font-size: 20px;
    font-weight: 400;
    fill: #52525b;
    letter-spacing: -0.02em;
  }

  .venn-text-sub-portrait {
    font-size: 16px;
    font-weight: 400;
    fill: #52525b;
    letter-spacing: -0.02em;
  }

  /* Flip page transition effect */
  .venn-stage {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .venn-stage.flipping {
    opacity: 0;
    transform: scale(0.97);
  }

  .hover-link {
    cursor: pointer;
    transition: fill 0.15s ease, opacity 0.15s ease;
  }

  .hover-link:hover {
    fill: #0038a8 !important;
    opacity: 0.65;
  }

  /* ── STRICT ORIENTATION SWITCH ── */
  .landscape-venn {
    display: block !important;
  }
  .portrait-venn {
    display: none !important;
  }

  @media (max-aspect-ratio: 1/1) {
    .landscape-venn {
      display: none !important;
    }
    .portrait-venn {
      display: block !important;
    }
  }

  /* ── BOTTOM-LEFT MINI DIAGRAM + INSPIRED CREDIT ── */
  .bottom-left {
    bottom: 22px;
    left: 24px;
  }

  .credit-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .mini-diagram {
    color: #000000;
    flex-shrink: 0;
  }

  .inspired-text {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #71717a;
    line-height: 1.2;
  }

  .inspired-text a {
    color: #27272a;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .inspired-text a:hover {
    color: #000000;
  }

  /* ── BOTTOM-RIGHT ACTION BUTTONS ── */
  .bottom-right {
    bottom: 20px;
    right: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--site-font-size);
    font-weight: 400;
    letter-spacing: -0.04em;
    color: #000000;
    line-height: 1.08;
    padding: 0;
    margin: 0;
    text-align: right;
