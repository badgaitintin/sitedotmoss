---
// index.astro — Minimalist 3-Circle Venn Diagram (Google Sans Flex)
import '@fontsource/google-sans-flex';
import { computeAgeString } from '../lib/home/venn-helpers';

const initialAge = computeAgeString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>sitedotmoss.vercel.app</title>
    <meta name="description" content="Tinnaphop Sonsang (Moss) — sitedotmoss.vercel.app" />
  </head>
  <body>

    <!-- TOP-LEFT: SITE NAME -->
    <header class="corner top-left">
      <a href="/" class="brand-link">sitedotmoss.vercel.app</a>
    </header>

    <!-- TOP-RIGHT: NAVIGATION MENU -->
    <nav class="corner top-right">
      <ul class="nav-list">
        <li><a href="/legacy">legacy</a></li>
        <li><button type="button" class="nav-btn" id="navExperienceBtn" data-target="experience">experience</button></li>
        <li><button type="button" class="nav-btn" id="navProjectBtn" data-target="project">project</button></li>
        <li><button type="button" class="nav-btn" id="navCvBtn" data-target="cv">cv</button></li>
      </ul>
    </nav>

    <!-- MAIN VENN DIAGRAM STAGE -->
    <main class="venn-stage">
      <!-- 3-CIRCLE VENN (LANDING VIEW) -->
      <!-- LANDSCAPE / DESKTOP (3 Circles: OOO) -->
      <svg class="venn-svg landscape-venn" id="vennLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <!-- 1. Arc 2: Circle 2 left boundary (reversed: bottom to top so text tops point outward to left) -->
          <path id="arcCircle2LeftFlipped" d="M 482,768 A 450,450 0 0,1 482,132" fill="none" />

          <!-- 2. Arc 3: Center vesica left boundary (Circle 3 left curve inside middle circle, reversed: bottom to top) -->
          <path id="arcVesicaLeftFlipped" d="M 800,733 A 450,450 0 0,1 800,167" fill="none" />

          <!-- 3. Arc 4: Center vesica right boundary (Circle 1 right curve inside middle circle) -->
          <path id="arcVesicaRight" d="M 800,167 A 450,450 0 0,1 800,733" fill="none" />

          <!-- 4. Arc 5: Circle 2 right boundary (right inner lens curve) -->
          <path id="arcCircle2Right" d="M 1118,132 A 450,450 0 0,1 1118,768" fill="none" />
        </defs>

        <!-- Side shapes (placed before circle-mid so they render BEHIND the center circle in CV mode) -->
        <circle cx="450" cy="450" r="450" class="venn-circle circle-left" />
        <rect x="70" y="70" width="760" height="760" class="venn-circle venn-shape shape-square" />

        <circle cx="1150" cy="450" r="450" class="venn-circle circle-right" />
        <polygon points="1150,60 1550,790 750,790" class="venn-circle venn-shape shape-triangle" />

        <!-- Center circle painted last so square & triangle stay behind it -->
        <circle cx="800" cy="450" r="450" class="venn-circle circle-mid" />

        <!-- 1. Tinnaphop Sonsang (Back on inner vesica arc, top pointing outward) -->
        <text class="venn-text text-curved" dy="-14">
          <textPath href="#arcVesicaLeftFlipped" startOffset="60%" text-anchor="middle">
            Tinnaphop Sonsang
          </textPath>
        </text>

        <!-- 2. Moss (On left arcCircle2Left, top pointing outward; click to push up & reveal IG + gaming TikTok) -->
        <g id="mossGroupLandscape" class="moss-arc-group">
          <text class="venn-text text-curved hover-link" id="mossTriggerBtn" dy="-14" style="cursor: pointer;">
            <textPath id="tpMossL" href="#arcCircle2LeftFlipped" startOffset="50%" text-anchor="middle">
              Moss
            </textPath>
          </text>

          <a href="https://instagram.com/badgaitintin" target="_blank" rel="noopener noreferrer" id="igLinkL" class="arc-reveal-link" style="opacity: 0; pointer-events: none;">
            <text class="venn-text text-curved moss-social-text hover-link" dy="-14">
              <textPath id="tpIgL" href="#arcCircle2LeftFlipped" startOffset="-10%" text-anchor="middle">
                ig @badgaitintin
              </textPath>
            </text>
          </a>

          <a href="https://www.tiktok.com/@badgaitintin_roblox" target="_blank" rel="noopener noreferrer" id="tiktokLinkL" class="arc-reveal-link" style="opacity: 0; pointer-events: none;">
            <text class="venn-text text-curved moss-social-text hover-link" dy="-14">
              <textPath id="tpTiktokL" href="#arcCircle2LeftFlipped" startOffset="-25%" text-anchor="middle">
                tiktok @badgaitintin_roblox
              </textPath>
            </text>
          </a>
        </g>

        <!-- CENTER EYE IMAGE -->
        <image
          id="eyeImgLandscape"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="730" y="380"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          transform="rotate(90, 800, 450)"
          class="eye-img"
        />

        <!-- 3. Live age (Restored to original right inner vesica boundary) -->
        <text class="venn-text text-curved" dy="-14">
          <textPath href="#arcVesicaRight" startOffset="50%" text-anchor="middle">
            <tspan id="ageDisplay">{initialAge}</tspan> · 60kg 180cm
          </textPath>
        </text>

        <!-- 4. PUSH INTERACTION: linkedin and email along right curve arcCircle2Right -->
        <g id="contactGroupLandscape" class="contact-arc-group">
          <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
            <text class="venn-text text-curved hover-link contact-item-linkedin" dy="-14">
              <textPath id="tpLinkedinL" href="#arcCircle2Right" startOffset="66%" text-anchor="middle">
                linkedin
              </textPath>
            </text>
          </a>

          <!-- Email button (Click to push contacts up and reveal address) -->
          <text class="venn-text text-curved hover-link contact-item-email" id="emailTriggerBtn" dy="-14" style="cursor: pointer;">
            <textPath id="tpEmailL" href="#arcCircle2Right" startOffset="79%" text-anchor="middle">
              email
            </textPath>
          </text>

          <!-- Revealed actual email address (slides in along the arc) -->
          <a href="mailto:tinnaphop.moss@gmail.com" id="actualEmailLink" class="actual-email-link" style="opacity: 0; pointer-events: none;">
            <text class="venn-text text-curved hover-link actual-email-text" dy="-14">
              <textPath id="tpActualEmailL" href="#arcCircle2Right" startOffset="102%" text-anchor="middle">
                tinnaphop.moss@gmail.com
              </textPath>
            </text>
          </a>
        </g>
      </svg>

      <!-- PORTRAIT / MOBILE (3 Circles in a column) -->
      <svg class="venn-svg portrait-venn" id="vennPortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice">
        <circle cx="450" cy="450" r="450" class="venn-circle circle-top" />
        <rect x="70" y="70" width="760" height="760" class="venn-circle venn-shape shape-square" />

        <circle cx="450" cy="1150" r="450" class="venn-circle circle-bottom" />
        <polygon points="450,760 850,1490 50,1490" class="venn-circle venn-shape shape-triangle" />

        <circle cx="450" cy="800" r="450" class="venn-circle circle-mid" />

        <!-- TOP LENS (Exclusive 1 ∩ 2): Center y=525 -->
        <g id="lensTopPortrait" class="venn-lens-group">
          <text x="450" y="490" text-anchor="middle" class="venn-text text-side-portrait">
            Tinnaphop Sonsang
          </text>
          <text x="450" y="560" text-anchor="middle" class="venn-text text-side-portrait">
            Moss
          </text>
        </g>

        <!-- CENTER LENS (Triple overlap): y=800 -->
        <image
          id="eyeImgPortrait"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="380" y="730"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          class="eye-img"
        />

        <!-- BOTTOM LENS (Exclusive 2 ∩ 3): Center y=1075 -->
        <g id="lensBottomPortrait" class="venn-lens-group">
          <text x="450" y="1020" text-anchor="middle" class="venn-text text-side-portrait">
            <tspan x="450" dy="0" id="ageDisplayMobile">{initialAge}</tspan>
            <tspan x="450" dy="1.15em" class="venn-text-sub-portrait">60kg · 180cm</tspan>
          </text>
          <!-- linkedin and email kept right next to each other -->
          <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
            <text x="450" y="1115" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              linkedin
            </text>
          </a>
          <a href="mailto:tinnaphop.moss@gmail.com">
            <text x="450" y="1170" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              email
            </text>
          </a>
        </g>
      </svg>

      <!-- 2-CIRCLE VENN (FLIP PAGE FOR EXPERIENCE & PROJECT) -->
      <!-- Landscape 2 circles (Left circle cx=560, Right circle cx=1040, r=450) -->
      <svg class="venn-svg landscape-venn" id="vennTwoCircleLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <defs>
          <mask id="maskTwoLeftL">
            <circle cx="560" cy="450" r="450" fill="white" />
            <circle cx="1040" cy="450" r="450" fill="black" />
          </mask>
          <mask id="maskTwoRightL">
            <circle cx="1040" cy="450" r="450" fill="white" />
            <circle cx="560" cy="450" r="450" fill="black" />
          </mask>
          <!-- Outer right arc for curved "demo nextwbc" link in Project mode -->
          <path id="arcTwoOuterRightL" d="M 1430,225 A 450,450 0 0,1 1430,675" fill="none" />
        </defs>

        <!-- Masked background images for project section -->
        <image id="twoBgLeftL" href="/shrimp.jpg" x="110" y="0" width="900" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#maskTwoLeftL)" class="two-bg-img" style="display:none;" />
        <image id="twoBgRightL" href="/wbc.png" x="590" y="0" width="900" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#maskTwoRightL)" class="two-bg-img" style="display:none;" />

        <circle cx="560" cy="450" r="450" class="venn-circle" />
        <circle cx="1040" cy="450" r="450" class="venn-circle" />

        <!-- Left Circle Exclusive: center x=350 (60px margin from 110..590) -->
        <foreignObject id="twoLeftFO" x="170" y="210" width="360" height="480" class="two-circle-fo">
          <div id="twoLeftLandscape" class="two-circle-content"></div>
        </foreignObject>

        <!-- Center Intersection (Lens): x=800 -->
        <g id="twoCenterLandscape" class="venn-lens-group">
          <text id="twoCenterTitleLandscape" x="800" y="450" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title">
          </text>
        </g>

        <!-- Right Circle Exclusive: center x=1250 (60px margin from 1010..1490) -->
        <foreignObject id="twoRightFO" x="1070" y="210" width="360" height="480" class="two-circle-fo">
          <div id="twoRightLandscape" class="two-circle-content"></div>
        </foreignObject>

        <!-- Curved link along outer right edge (shown in Project mode) -->
        <a href="/nextwbc-new" id="nextwbcDemoLinkL" style="display:none;">
          <text class="venn-text text-curved hover-link" dy="-14">
            <textPath href="#arcTwoOuterRightL" startOffset="50%" text-anchor="middle">
              demo nextwbc ↗
            </textPath>
          </text>
        </a>
      </svg>

      <!-- Portrait 2 circles (Top circle cy=560, Bottom circle cy=1040, r=450) -->
      <svg class="venn-svg portrait-venn" id="vennTwoCirclePortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <defs>
          <mask id="maskTwoTopP">
            <circle cx="450" cy="560" r="450" fill="white" />
            <circle cx="450" cy="1040" r="450" fill="black" />
          </mask>
          <mask id="maskTwoBottomP">
            <circle cx="450" cy="1040" r="450" fill="white" />
            <circle cx="450" cy="560" r="450" fill="black" />
          </mask>
          <path id="arcTwoOuterBottomP" d="M 885,1156 A 450,450 0 0,1 566,1475" fill="none" />
        </defs>

        <image id="twoBgTopP" href="/shrimp.jpg" x="0" y="110" width="900" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#maskTwoTopP)" class="two-bg-img" style="display:none;" />
        <image id="twoBgBottomP" href="/wbc.png" x="0" y="590" width="900" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#maskTwoBottomP)" class="two-bg-img" style="display:none;" />

        <circle cx="450" cy="560" r="450" class="venn-circle" />
        <circle cx="450" cy="1040" r="450" class="venn-circle" />

        <!-- Top Circle Exclusive: center (450, 385) inside circle curves -->
        <foreignObject id="twoTopFO" x="170" y="215" width="560" height="340" class="two-circle-fo">
          <div id="twoTopPortrait" class="two-circle-content"></div>
        </foreignObject>

        <!-- Center Intersection: y=800 -->
        <g id="twoCenterPortrait" class="venn-lens-group">
          <text id="twoCenterTitlePortrait" x="450" y="800" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title-portrait">
          </text>
        </g>

        <!-- Bottom Circle Exclusive: center (450, 1215) inside circle curves -->
        <foreignObject id="twoBottomFO" x="170" y="1045" width="560" height="340" class="two-circle-fo">
          <div id="twoBottomPortrait" class="two-circle-content"></div>
        </foreignObject>

        <!-- Curved link along outer bottom-right edge (shown in Project mode) -->
        <a href="/nextwbc-new" id="nextwbcDemoLinkP" style="display:none;">
          <text class="venn-text text-curved hover-link" dy="-14">
            <textPath href="#arcTwoOuterBottomP" startOffset="50%" text-anchor="middle">
              demo nextwbc ↗
            </textPath>
          </text>
        </a>
      </svg>
    </main>

    <!-- CV PDF VIEWER OVERLAY (Fills entire center circle with overlay buttons) -->
    <section class="cv-overlay-view" id="cvOverlayView" style="display: none;">
      <div class="cv-viewer-card">
        <div class="cv-frame-box">
          <iframe
            src="/assets/Resume_TinnaphopSonsang.pdf#toolbar=0&navpanes=0&scrollbar=1&view=FitH"
            class="cv-pdf-iframe"
            title="Tinnaphop Sonsang CV PDF"
          >
          </iframe>
        </div>
        <div class="cv-bottom-actions">
          <a href="/assets/Resume_TinnaphopSonsang.pdf" download="Resume_TinnaphopSonsang.pdf" class="cv-pill-btn cv-download-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            download cv
          </a>
          <a href="/assets/Resume_TinnaphopSonsang.pdf" target="_blank" rel="noopener noreferrer" class="cv-pill-btn">
            open tab
          </a>
        </div>
      </div>
    </section>

    <!-- BOTTOM-LEFT: 3-CIRCLE MINI ICON + INSPIRED BY CREDIT -->
    <aside class="corner bottom-left">
      <div class="credit-row">
        <svg width="44" height="20" viewBox="0 0 54 22" fill="none" stroke="currentColor" stroke-width="1.8" class="mini-diagram">
          <circle cx="11" cy="11" r="10" />
          <circle cx="27" cy="11" r="10" />
          <circle cx="43" cy="11" r="10" />
        </svg>
        <span class="inspired-text">inspired by robyn - <a href="https://sexistential.xyz" target="_blank" rel="noopener noreferrer">sexistential.xyz</a> website</span>
      </div>
    </aside>

    <!-- BOTTOM-RIGHT: UTILITY ACTIONS -->
    <aside class="corner bottom-right">
      <button class="action-btn" id="shareBtn">share</button>
    </aside>

    <!-- BOTTOM 5-COLOR ACCENT STRIPE (ขาว, ดำ, ชมพูซากุระ, น้ำเงิน, เหลืองมัสตาร์ด) -->
    <div class="bottom-stripe">
      <span class="stripe-block stripe-white" title="White"></span>
      <span class="stripe-block stripe-black" title="Black"></span>
      <span class="stripe-block stripe-sakura" title="Sakura Pink"></span>
      <span class="stripe-block stripe-blue" title="Blue"></span>
      <span class="stripe-block stripe-mustard" title="Mustard Yellow"></span>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">link copied!</div>

    <script>
      import {
        TWO_CIRCLE_SECTIONS,
        computeAgeString,
        easeOutBack,
        interpolatePercent,
        renderSideCardHtml,
        type TwoCircleSectionKey,
      } from '../lib/home/venn-helpers';

      type ActiveSection = TwoCircleSectionKey | 'cv' | null;

      // ── LIVE AGE UPDATER (13/01/2004) ──
      function updateAge(): void {
        const ageStr = computeAgeString();
        const elDesktop = document.getElementById('ageDisplay');
        const elMobile = document.getElementById('ageDisplayMobile');
        if (elDesktop) elDesktop.textContent = ageStr;
        if (elMobile) elMobile.textContent = ageStr;
      }

      updateAge();
      setInterval(updateAge, 30000);

      // ── VIEW STATE & DOM REFS ──
      let activeSection: ActiveSection = null;
      let viewTimer1: ReturnType<typeof setTimeout> | null = null;
      let viewTimer2: ReturnType<typeof setTimeout> | null = null;

      const navExpBtn = document.getElementById('navExperienceBtn');
      const navProjBtn = document.getElementById('navProjectBtn');
      const navCvBtn = document.getElementById('navCvBtn');
      const cvOverlay = document.getElementById('cvOverlayView') as HTMLElement | null;
      const mainStage = document.querySelector('.venn-stage') as HTMLElement | null;

      const venn3Landscape = document.getElementById('vennLandscape') as HTMLElement | null;
      const venn3Portrait = document.getElementById('vennPortrait') as HTMLElement | null;
      const venn2Landscape = document.getElementById('vennTwoCircleLandscape') as HTMLElement | null;
      const venn2Portrait = document.getElementById('vennTwoCirclePortrait') as HTMLElement | null;

      const twoCenterTitleL = document.getElementById('twoCenterTitleLandscape');
      const twoCenterTitleP = document.getElementById('twoCenterTitlePortrait');
      const twoLeftL = document.getElementById('twoLeftLandscape');
      const twoRightL = document.getElementById('twoRightLandscape');
      const twoTopP = document.getElementById('twoTopPortrait');
      const twoBottomP = document.getElementById('twoBottomPortrait');

      function clearViewTimers(): void {
        if (viewTimer1) { clearTimeout(viewTimer1); viewTimer1 = null; }
        if (viewTimer2) { clearTimeout(viewTimer2); viewTimer2 = null; }
      }

      function resetNavButtons(): void {
        if (navExpBtn) navExpBtn.textContent = 'experience';
        if (navProjBtn) navProjBtn.textContent = 'project';
        if (navCvBtn) navCvBtn.textContent = 'cv';
      }

      function setVennMode(mode: 'three' | 'two'): void {
        const show3 = mode === 'three';
        if (venn3Landscape) venn3Landscape.style.setProperty('display', show3 ? '' : 'none', show3 ? '' : 'important');
        if (venn3Portrait) venn3Portrait.style.setProperty('display', show3 ? '' : 'none', show3 ? '' : 'important');
        if (venn2Landscape) venn2Landscape.style.setProperty('display', show3 ? 'none' : '', show3 ? 'important' : '');
        if (venn2Portrait) venn2Portrait.style.setProperty('display', show3 ? 'none' : '', show3 ? 'important' : '');
      }

      const twoBgLeftL = document.getElementById('twoBgLeftL');
      const twoBgRightL = document.getElementById('twoBgRightL');
      const twoBgTopP = document.getElementById('twoBgTopP');
      const twoBgBottomP = document.getElementById('twoBgBottomP');
      const nextwbcDemoLinkL = document.getElementById('nextwbcDemoLinkL');
      const nextwbcDemoLinkP = document.getElementById('nextwbcDemoLinkP');

      function setBgImage(el: Element | null, src?: string): void {
        if (!el) return;
        const svgEl = el as SVGImageElement;
        if (src) {
          svgEl.setAttribute('href', src);
          svgEl.style.display = 'block';
        } else {
          svgEl.style.display = 'none';
        }
      }

      function populateTwoCircle(section: TwoCircleSectionKey): void {
        const data = TWO_CIRCLE_SECTIONS[section];
        if (twoCenterTitleL) twoCenterTitleL.textContent = data.title;
        if (twoCenterTitleP) twoCenterTitleP.textContent = data.title;
        if (twoLeftL) twoLeftL.innerHTML = renderSideCardHtml(data.left);
        if (twoRightL) twoRightL.innerHTML = renderSideCardHtml(data.right);
        if (twoTopP) twoTopP.innerHTML = renderSideCardHtml(data.left);
        if (twoBottomP) twoBottomP.innerHTML = renderSideCardHtml(data.right);
        setBgImage(twoBgLeftL, data.left.bgImage);
        setBgImage(twoBgRightL, data.right.bgImage);
        setBgImage(twoBgTopP, data.left.bgImage);
        setBgImage(twoBgBottomP, data.right.bgImage);

        const showDemoLink = section === 'project';
        if (nextwbcDemoLinkL) (nextwbcDemoLinkL as unknown as SVGElement).style.display = showDemoLink ? 'block' : 'none';
        if (nextwbcDemoLinkP) (nextwbcDemoLinkP as unknown as SVGElement).style.display = showDemoLink ? 'block' : 'none';
      }

      function showCvOverlay(): void {
        document.body.classList.add('cv-dark-mode');
        mainStage?.classList.add('anim-cv-active');
        if (!cvOverlay) return;
        cvOverlay.style.display = 'flex';
        cvOverlay.classList.remove('cv-closing');
        void cvOverlay.offsetWidth;
        cvOverlay.classList.add('cv-active');
      }

      function hideCvOverlay(onHidden: () => void): void {
        document.body.classList.remove('cv-dark-mode');
        cvOverlay?.classList.remove('cv-active');
        cvOverlay?.classList.add('cv-closing');
        viewTimer1 = setTimeout(() => {
          if (cvOverlay) {
            cvOverlay.style.display = 'none';
            cvOverlay.classList.remove('cv-closing');
          }
          onHidden();
        }, 260);
      }

      function settleTwoCircle(delayMs: number): void {
        viewTimer2 = setTimeout(() => {
          setVennMode('two');
          if (!mainStage) return;
          mainStage.classList.remove('text-out', 'anim-two-active');
          mainStage.classList.add('two-content-in');
          setTimeout(() => mainStage.classList.remove('two-content-in'), 450);
        }, delayMs);
      }

      function switchView(section: Exclude<ActiveSection, null>): void {
        clearViewTimers();

        // Closing active section back to 3-circle landing
        if (activeSection === section) {
          const closingSection = activeSection;
          activeSection = null;
          resetNavButtons();

          if (closingSection === 'cv') {
            hideCvOverlay(() => {
              if (mainStage) {
                void mainStage.offsetWidth;
                mainStage.classList.remove('anim-cv-active');
              }
              viewTimer2 = setTimeout(() => mainStage?.classList.remove('text-out'), 680);
            });
            return;
          }

          mainStage?.classList.add('two-content-out');
          viewTimer1 = setTimeout(() => {
            setVennMode('three');
            if (mainStage) {
              mainStage.classList.remove('two-content-out');
              mainStage.classList.add('text-out', 'anim-two-active');
              void mainStage.offsetWidth;
              mainStage.classList.remove('anim-two-active');
            }
            viewTimer2 = setTimeout(() => mainStage?.classList.remove('text-out'), 680);
          }, 260);
          return;
        }

        // Opening or cross-switching sections
        const prevSection = activeSection;
        activeSection = section;
        resetNavButtons();

        if (section === 'experience' && navExpBtn) navExpBtn.textContent = '✕';
        if (section === 'project' && navProjBtn) navProjBtn.textContent = '✕';
        if (section === 'cv' && navCvBtn) navCvBtn.textContent = '✕';

        // Cross-switch: CV -> Experience / Project
        if (prevSection === 'cv' && section !== 'cv') {
          populateTwoCircle(section);
          hideCvOverlay(() => {
            mainStage?.classList.remove('anim-cv-active');
            mainStage?.classList.add('anim-two-active');
            settleTwoCircle(900);
          });
          return;
        }

        // Cross-switch: Experience / Project -> CV
        if ((prevSection === 'experience' || prevSection === 'project') && section === 'cv') {
          mainStage?.classList.add('two-content-out');
          viewTimer1 = setTimeout(() => {
            setVennMode('three');
            if (mainStage) {
              mainStage.classList.remove('two-content-out');
              mainStage.classList.add('text-out', 'anim-two-active');
              void mainStage.offsetWidth;
              mainStage.classList.remove('anim-two-active');
            }
            viewTimer2 = setTimeout(showCvOverlay, 240);
          }, 260);
          return;
        }

        // Cross-switch: Experience <-> Project
        if (prevSection && section !== 'cv') {
          mainStage?.classList.add('two-content-out');
          viewTimer1 = setTimeout(() => {
            populateTwoCircle(section);
            if (!mainStage) return;
            mainStage.classList.remove('two-content-out');
            mainStage.classList.add('two-content-in');
            setTimeout(() => mainStage.classList.remove('two-content-in'), 450);
          }, 260);
          return;
        }

        // Normal open from 3-circle landing
        mainStage?.classList.add('text-out');
        viewTimer1 = setTimeout(() => {
          if (section === 'cv') {
            showCvOverlay();
          } else {
            populateTwoCircle(section);
            mainStage?.classList.add('anim-two-active');
            settleTwoCircle(900);
          }
        }, 260);
      }

      navExpBtn?.addEventListener('click', () => switchView('experience'));
      navProjBtn?.addEventListener('click', () => switchView('project'));
      navCvBtn?.addEventListener('click', () => switchView('cv'));

      // ── ARC PUSH INTERACTIONS (Email & Moss via shared rAF helper) ──
      interface ArcTrack {
        el: Element | null;
        closed: number;
        open: number;
      }

      const arcAnimFrames: Record<string, number | null> = {};

      function getOffset(el: Element | null, fallback: number): number {
        if (!el) return fallback;
        const val = parseFloat(el.getAttribute('startOffset') ?? '');
        return Number.isNaN(val) ? fallback : val;
      }

      function animateArcGroup(
        key: string,
        tracks: ArcTrack[],
        revealLinks: (HTMLElement | SVGElement | null)[],
        opening: boolean
      ): void {
        if (arcAnimFrames[key]) cancelAnimationFrame(arcAnimFrames[key]!);

        const resolvedTracks = tracks.map(tr => ({
          el: tr.el,
          from: getOffset(tr.el, opening ? tr.closed : tr.open),
          to: opening ? tr.open : tr.closed,
        }));

        const resolvedOpacities = revealLinks.map(link => {
          if (link) link.style.pointerEvents = opening ? 'auto' : 'none';
          return {
            link,
            from: link ? parseFloat(link.style.opacity || (opening ? '0' : '1')) : (opening ? 0 : 1),
            to: opening ? 1 : 0,
          };
        });

        const duration = 620;
        const startTime = performance.now();

        function tick(now: number): void {
          const rawT = Math.min(1, (now - startTime) / duration);
          const eased = easeOutBack(rawT);
          const alphaT = Math.min(1, rawT * 1.4);

          resolvedTracks.forEach(tr => {
            tr.el?.setAttribute('startOffset', interpolatePercent(tr.from, tr.to, eased));
          });

          resolvedOpacities.forEach(op => {
            if (op.link) {
              op.link.style.opacity = (op.from + (op.to - op.from) * alphaT).toFixed(3);
            }
          });

          if (rawT < 1) {
            arcAnimFrames[key] = requestAnimationFrame(tick);
          } else {
            arcAnimFrames[key] = null;
          }
        }

        arcAnimFrames[key] = requestAnimationFrame(tick);
      }

      let emailPushed = false;
      const emailBtn = document.getElementById('emailTriggerBtn');
      const tpLinkedin = document.getElementById('tpLinkedinL');
      const tpEmail = document.getElementById('tpEmailL');
      const tpActualEmail = document.getElementById('tpActualEmailL');
      const actualEmail = document.getElementById('actualEmailLink') as SVGElement | null;

      emailBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        emailPushed = !emailPushed;
        animateArcGroup(
          'email',
          [
            { el: tpLinkedin, closed: 66, open: 24 },
            { el: tpEmail, closed: 79, open: 42 },
            { el: tpActualEmail, closed: 102, open: 78 },
          ],
          [actualEmail],
          emailPushed
        );
      });

      let mossPushed = false;
      const mossBtn = document.getElementById('mossTriggerBtn');
      const tpMoss = document.getElementById('tpMossL');
      const tpIg = document.getElementById('tpIgL');
      const tpTiktok = document.getElementById('tpTiktokL');
      const igLink = document.getElementById('igLinkL') as SVGElement | null;
      const tiktokLink = document.getElementById('tiktokLinkL') as SVGElement | null;

      mossBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        mossPushed = !mossPushed;
        animateArcGroup(
          'moss',
          [
            { el: tpMoss, closed: 50, open: 85 },
            { el: tpIg, closed: -10, open: 61 },
            { el: tpTiktok, closed: -25, open: 24 },
          ],
          [igLink, tiktokLink],
          mossPushed
        );
      });

      // ── SHARE BUTTON ──
      const shareBtn = document.getElementById('shareBtn');
      const toast = document.getElementById('toast');

      shareBtn?.addEventListener('click', async () => {
        const url = window.location.href;
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'sitedotmoss.vercel.app',
              text: 'Tinnaphop Sonsang (Moss)',
              url,
            });
            return;
          } catch {
            // Fall through to clipboard copy
          }
        }
        navigator.clipboard.writeText(url).then(() => {
          toast?.classList.add('show');
          setTimeout(() => toast?.classList.remove('show'), 1800);
        });
      });
    </script>
  </body>
</html>

