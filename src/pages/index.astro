---
// index.astro — Minimalist 3-Circle Venn Diagram (Google Sans Flex)
import '@fontsource/google-sans-flex';

function computeInitialAge() {
  const now = new Date();
  const birthYear = 2004;
  const birthMonth = 0; // Jan (0-indexed)
  const birthDay = 13;
  let years = now.getFullYear() - birthYear;
  let birthThisYear = new Date(now.getFullYear(), birthMonth, birthDay);
  if (now < birthThisYear) {
    years--;
    birthThisYear = new Date(now.getFullYear() - 1, birthMonth, birthDay);
  }
  const days = Math.floor((now.getTime() - birthThisYear.getTime()) / (1000 * 60 * 60 * 24));
  const mins = now.getHours() * 60 + now.getMinutes();
  return `${years}y ${days}d ${mins}m`;
}
const initialAge = computeInitialAge();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>sitedotmoss.vercel.app</title>
    <meta name="description" content="Tinnaphop Sonsang (Moss) — sitedotmoss.vercel.app" />
  </head>
  <body>

    <!-- TOP-LEFT: SITE NAME -->
    <header class="corner top-left">
      <a href="/" class="brand-link">sitedotmoss.vercel.app</a>
    </header>

    <!-- TOP-RIGHT: NAVIGATION MENU -->
    <nav class="corner top-right">
      <ul class="nav-list">
        <li><a href="/legacy">legacy</a></li>
        <li><button type="button" class="nav-btn" id="navExperienceBtn" data-target="experience">experience</button></li>
        <li><button type="button" class="nav-btn" id="navProjectBtn" data-target="project">project</button></li>
        <li><button type="button" class="nav-btn" id="navCvBtn" data-target="cv">cv</button></li>
      </ul>
    </nav>

    <!-- MAIN VENN DIAGRAM STAGE -->
    <main class="venn-stage">
      <!-- 3-CIRCLE VENN (LANDING VIEW) -->
      <!-- LANDSCAPE / DESKTOP (3 Circles: OOO) -->
      <svg class="venn-svg landscape-venn" id="vennLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <!-- 1. Arc 1: Circle 1 left outer arc -->
          <path id="arcCircle1OuterLeft" d="M 450,0 A 450,450 0 0,0 450,900" fill="none" />

          <!-- 2. Arc 2: Circle 2 left boundary (reversed: bottom to top so text tops point outward to left) -->
          <path id="arcCircle2LeftFlipped" d="M 482,768 A 450,450 0 0,1 482,132" fill="none" />
          
          <!-- 3. Arc 3: Center vesica left boundary (Circle 3 left curve inside middle circle, reversed: bottom to top) -->
          <path id="arcVesicaLeftFlipped" d="M 800,733 A 450,450 0 0,1 800,167" fill="none" />

          <!-- 4. Arc 4: Center vesica right boundary (Circle 1 right curve inside middle circle) -->
          <path id="arcVesicaRight" d="M 800,167 A 450,450 0 0,1 800,733" fill="none" />

          <!-- 5. Arc 5: Circle 2 right boundary (right inner lens curve) -->
          <path id="arcCircle2Right" d="M 1118,132 A 450,450 0 0,1 1118,768" fill="none" />
        </defs>

        <!-- Circles with individual classes for transition animations -->
        <circle cx="450" cy="450" r="450" class="venn-circle circle-left" />
        <circle cx="800" cy="450" r="450" class="venn-circle circle-mid" />
        <circle cx="1150" cy="450" r="450" class="venn-circle circle-right" />

        <!-- 1. Tinnaphop Sonsang (Back on inner vesica arc, top pointing outward) -->
        <text class="venn-text text-curved">
          <textPath href="#arcVesicaLeftFlipped" startOffset="60%" text-anchor="middle">
            Tinnaphop Sonsang
          </textPath>
        </text>

        <!-- 2. Moss (On left arcCircle2Left, top pointing outward) -->
        <text class="venn-text text-curved">
          <textPath href="#arcCircle2LeftFlipped" startOffset="50%" text-anchor="middle">
            Moss
          </textPath>
        </text>

        <!-- CENTER EYE IMAGE -->
        <image
          id="eyeImgLandscape"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="730" y="380"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          transform="rotate(90, 800, 450)"
          class="eye-img"
        />

        <!-- 3. Live age (Restored to original right inner vesica boundary) -->
        <text class="venn-text text-curved">
          <textPath href="#arcVesicaRight" startOffset="50%" text-anchor="middle">
            <tspan id="ageDisplay">{initialAge}</tspan> · 60kg 180cm
          </textPath>
        </text>

        <!-- 4. PUSH INTERACTION: linkedin and email along right curve arcCircle2Right -->
        <g id="contactGroupLandscape" class="contact-arc-group">
          <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
            <text class="venn-text text-curved hover-link contact-item-linkedin">
              <textPath id="tpLinkedinL" href="#arcCircle2Right" startOffset="66%" text-anchor="middle">
                linkedin
              </textPath>
            </text>
          </a>

          <!-- Email button (Click to push contacts up and reveal address) -->
          <text class="venn-text text-curved hover-link contact-item-email" id="emailTriggerBtn" style="cursor: pointer;">
            <textPath id="tpEmailL" href="#arcCircle2Right" startOffset="79%" text-anchor="middle">
              email
            </textPath>
          </text>

          <!-- Revealed actual email address (appears where email was, with dedicated comfortable gap) -->
          <a href="mailto:tinnaphop.moss@gmail.com" id="actualEmailLink" style="display: none;">
            <text class="venn-text text-curved hover-link actual-email-text">
              <textPath id="tpActualEmailL" href="#arcCircle2Right" startOffset="82%" text-anchor="middle">
                tinnaphop.moss@gmail.com
              </textPath>
            </text>
          </a>
        </g>
      </svg>

      <!-- PORTRAIT / MOBILE (3 Circles in a column) -->
      <svg class="venn-svg portrait-venn" id="vennPortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice">
        <circle cx="450" cy="450" r="450" class="venn-circle circle-top" />
        <circle cx="450" cy="800" r="450" class="venn-circle circle-mid" />
        <circle cx="450" cy="1150" r="450" class="venn-circle circle-bottom" />

        <!-- TOP LENS (Exclusive 1 ∩ 2): Center y=525 -->
        <g id="lensTopPortrait" class="venn-lens-group">
          <text x="450" y="490" text-anchor="middle" class="venn-text text-side-portrait">
            Tinnaphop Sonsang
          </text>
          <text x="450" y="560" text-anchor="middle" class="venn-text text-side-portrait">
            Moss
          </text>
        </g>

        <!-- CENTER LENS (Triple overlap): y=800 -->
        <image
          id="eyeImgPortrait"
          href="/pngtree-pop-art-eye-collage-with-halftone-effect-and-vintage-cutout-shape-png-image_12950307.png"
          x="380" y="730"
          width="140" height="140"
          preserveAspectRatio="xMidYMid meet"
          class="eye-img"
        />

        <!-- BOTTOM LENS (Exclusive 2 ∩ 3): Center y=1075 -->
        <g id="lensBottomPortrait" class="venn-lens-group">
          <text x="450" y="1020" text-anchor="middle" class="venn-text text-side-portrait">
            <tspan x="450" dy="0" id="ageDisplayMobile">{initialAge}</tspan>
            <tspan x="450" dy="1.15em" class="venn-text-sub-portrait">60kg · 180cm</tspan>
          </text>
          <!-- linkedin and email kept right next to each other -->
          <a href="https://linkedin.com/in/tinnaphop-sonsang" target="_blank" rel="noopener noreferrer">
            <text x="450" y="1115" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              linkedin
            </text>
          </a>
          <a href="mailto:tinnaphop.moss@gmail.com">
            <text x="450" y="1170" text-anchor="middle" class="venn-text text-side-portrait hover-link">
              email
            </text>
          </a>
        </g>
      </svg>

      <!-- 2-CIRCLE VENN (FLIP PAGE FOR EXPERIENCE & PROJECT) -->
      <!-- Landscape 2 circles (Left circle cx=560, Right circle cx=1040, r=450) -->
      <svg class="venn-svg landscape-venn" id="vennTwoCircleLandscape" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <circle cx="560" cy="450" r="450" class="venn-circle" />
        <circle cx="1040" cy="450" r="450" class="venn-circle" />

        <!-- Left Circle Exclusive: x=340 -->
        <foreignObject id="twoLeftFO" x="120" y="240" width="440" height="420" class="two-circle-fo">
          <div xmlns="http://www.w3.org/1999/xhtml" id="twoLeftLandscape" class="two-circle-content"></div>
        </foreignObject>

        <!-- Center Intersection (Lens): x=800 -->
        <g id="twoCenterLandscape" class="venn-lens-group">
          <text id="twoCenterTitleLandscape" x="800" y="450" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title">
          </text>
        </g>

        <!-- Right Circle Exclusive: x=1260 -->
        <foreignObject id="twoRightFO" x="1040" y="240" width="440" height="420" class="two-circle-fo">
          <div xmlns="http://www.w3.org/1999/xhtml" id="twoRightLandscape" class="two-circle-content"></div>
        </foreignObject>
      </svg>

      <!-- Portrait 2 circles (Top circle cy=560, Bottom circle cy=1040, r=450) -->
      <svg class="venn-svg portrait-venn" id="vennTwoCirclePortrait" viewBox="0 0 900 1600" preserveAspectRatio="xMidYMid slice" style="display:none !important;">
        <circle cx="450" cy="560" r="450" class="venn-circle" />
        <circle cx="450" cy="1040" r="450" class="venn-circle" />

        <!-- Top Circle Exclusive: y=320 -->
        <foreignObject id="twoTopFO" x="100" y="180" width="700" height="340" class="two-circle-fo">
          <div xmlns="http://www.w3.org/1999/xhtml" id="twoTopPortrait" class="two-circle-content"></div>
        </foreignObject>

        <!-- Center Intersection: y=800 -->
        <g id="twoCenterPortrait" class="venn-lens-group">
          <text id="twoCenterTitlePortrait" x="450" y="800" text-anchor="middle" dominant-baseline="central" class="venn-text text-flip-title-portrait">
          </text>
        </g>

        <!-- Bottom Circle Exclusive: y=1280 -->
        <foreignObject id="twoBottomFO" x="100" y="1080" width="700" height="340" class="two-circle-fo">
          <div xmlns="http://www.w3.org/1999/xhtml" id="twoBottomPortrait" class="two-circle-content"></div>
        </foreignObject>
      </svg>
    </main>

    <!-- CV PDF VIEWER OVERLAY (Shown when cv button is active) -->
    <section class="cv-overlay-view" id="cvOverlayView" style="display: none;">
      <div class="cv-viewer-card">
        <div class="cv-viewer-header">
          <div class="cv-title-group">
            <span class="cv-subtag">Curriculum Vitae</span>
            <span class="cv-name-tag">Tinnaphop Sonsang</span>
          </div>
          <div class="cv-btn-group">
            <a href="/assets/CV_Tinnaphop_Sonsang.pdf" target="_blank" rel="noopener noreferrer" class="cv-pill-btn">
              open tab
            </a>
            <a href="/assets/CV_Tinnaphop_Sonsang.pdf" download="CV_Tinnaphop_Sonsang.pdf" class="cv-pill-btn cv-download-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              download
            </a>
          </div>
        </div>
        <div class="cv-frame-box">
          <iframe
            src="/assets/CV_Tinnaphop_Sonsang.pdf#toolbar=0&navpanes=0&scrollbar=1"
            class="cv-pdf-iframe"
            title="Tinnaphop Sonsang CV PDF"
          >
          </iframe>
        </div>
      </div>
    </section>

    <!-- BOTTOM-LEFT: 3-CIRCLE MINI ICON + INSPIRED BY CREDIT -->
    <aside class="corner bottom-left">
      <div class="credit-row">
        <svg width="44" height="20" viewBox="0 0 54 22" fill="none" stroke="currentColor" stroke-width="1.8" class="mini-diagram">
          <circle cx="11" cy="11" r="10" />
          <circle cx="27" cy="11" r="10" />
          <circle cx="43" cy="11" r="10" />
        </svg>
        <span class="inspired-text">inspired by robyn - <a href="https://sexistential.xyz" target="_blank" rel="noopener noreferrer">sexistential.xyz</a> website</span>
      </div>
    </aside>

    <!-- BOTTOM-RIGHT: UTILITY ACTIONS -->
    <aside class="corner bottom-right">
      <button class="action-btn" id="shareBtn">share</button>
    </aside>

    <!-- BOTTOM 5-COLOR ACCENT STRIPE (ขาว, ดำ, ชมพูซากุระ, น้ำเงิน, เหลืองมัสตาร์ด) -->
    <div class="bottom-stripe">
      <span class="stripe-block stripe-white" title="White"></span>
      <span class="stripe-block stripe-black" title="Black"></span>
      <span class="stripe-block stripe-sakura" title="Sakura Pink"></span>
      <span class="stripe-block stripe-blue" title="Blue"></span>
      <span class="stripe-block stripe-mustard" title="Mustard Yellow"></span>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">link copied!</div>

    <script is:inline>
      // ── BIRTHDAY LIVE CALCULATION: 13/01/2004 ──
      const BIRTH_YEAR = 2004;
      const BIRTH_MONTH = 0; // Jan (0-indexed)
      const BIRTH_DAY = 13;

      function updateAge() {
        const now = new Date();
        let years = now.getFullYear() - BIRTH_YEAR;
        let birthThisYear = new Date(now.getFullYear(), BIRTH_MONTH, BIRTH_DAY);
        if (now < birthThisYear) {
          years--;
          birthThisYear = new Date(now.getFullYear() - 1, BIRTH_MONTH, BIRTH_DAY);
        }
        const daysSinceLastBirthday = Math.floor((now.getTime() - birthThisYear.getTime()) / (1000 * 60 * 60 * 24));
        const minutesInDay = (now.getHours() * 60) + now.getMinutes();
        const ageStr = `${years}y ${daysSinceLastBirthday}d ${minutesInDay}m`;

        const el1 = document.getElementById('ageDisplay');
        const el2 = document.getElementById('ageDisplayMobile');
        if (el1) el1.textContent = ageStr;
        if (el2) el2.textContent = ageStr;
      }

      updateAge();
      setInterval(updateAge, 30000);

      // ── FLIP DATA FOR 2-CIRCLE EXPERIENCE & PROJECT ──
      const twoCircleData = {
        experience: {
          title: "experience",
          left: {
            title: "Lief Capital Asset Management",
            desc: "Worked with AI and data processing workflows on Azure Machine Learning, covering data preprocessing, feature engineering, model training, and evaluation. Optimized large-scale financial data processing using parallel processing, vectorized computation, and Polars, reducing runtime from over 1 hour to under 30 minutes. Also contributed to a machine learning-based financial ranking pipeline with Walk-Forward Validation."
          },
          right: {
            title: "Thaidotrun Co., Ltd. (Merged into ASICS)",
            desc: "Worked on computer vision and machine learning solutions for race events. Developed an automated runner highlight extraction system using object detection, tracking, and OCR to generate 10–20 second clips, achieving approximately 60% success rate. Also built a shoe detection and brand classification pipeline using DINO feature extraction, unsupervised learning, and pseudo-labeling, reducing dataset preparation time from 7–10 days to 1–2 days and improving model performance from 0.74 to 0.85 ± 0.05."
          }
        },
        project: {
          title: "project",
          left: {
            title: "MTC-UAV Maize Tassel Counting",
            desc: "Investigated spatial density estimation as a robust computer vision solution for automated maize tassel enumeration in ultra-dense aerial drone imagery, addressing severe occlusions where individual bounding box detectors fail."
          },
          right: {
            title: "Raptor Blood Cell Classification System",
            desc: "Collaborative graduation research creating a clinical deep learning object detection diagnostic system for identifying six avian blood-cell classes from raptor blood smears with YOLO-26l, RT-DETR, and Grad-CAM for Explainable AI (XAI)."
          }
        }
      };

      let activeSection = null;

      const navExpBtn = document.getElementById('navExperienceBtn');
      const navProjBtn = document.getElementById('navProjectBtn');
      const navCvBtn = document.getElementById('navCvBtn');
      const cvOverlay = document.getElementById('cvOverlayView');
      const mainStage = document.querySelector('.venn-stage');

      const venn3Landscape = document.getElementById('vennLandscape');
      const venn3Portrait = document.getElementById('vennPortrait');
      const venn2Landscape = document.getElementById('vennTwoCircleLandscape');
      const venn2Portrait = document.getElementById('vennTwoCirclePortrait');

      const twoCenterTitleL = document.getElementById('twoCenterTitleLandscape');
      const twoCenterTitleP = document.getElementById('twoCenterTitlePortrait');
      const twoLeftL = document.getElementById('twoLeftLandscape');
      const twoRightL = document.getElementById('twoRightLandscape');
      const twoTopP = document.getElementById('twoTopPortrait');
      const twoBottomP = document.getElementById('twoBottomPortrait');

      function renderSideCard(item) {
        if (!item) return '';
        return `
          <div class="two-circle-card">
            <h3 class="two-circle-card-title">${item.title}</h3>
            <p class="two-circle-card-desc">${item.desc}</p>
          </div>
        `;
      }

      function resetNavButtons() {
        if (navExpBtn) navExpBtn.textContent = 'experience';
        if (navProjBtn) navProjBtn.textContent = 'project';
        if (navCvBtn) navCvBtn.textContent = 'cv';
      }

      function switchView(section) {
        if (activeSection === section) {
          // ── CLOSING (ANIMATING BACK TO 3-CIRCLE LANDING) ──
          const closingSection = activeSection;
          activeSection = null;
          resetNavButtons();

          if (closingSection === 'cv') {
            // CV Close: Fade out CV viewer
            if (cvOverlay) {
              cvOverlay.classList.remove('cv-active');
              cvOverlay.classList.add('cv-closing');
            }
            if (mainStage) {
              mainStage.style.display = '';
              mainStage.classList.remove('anim-cv-exit');
              mainStage.classList.add('anim-cv-enter');
            }
            setTimeout(() => {
              if (cvOverlay) {
                cvOverlay.style.display = 'none';
                cvOverlay.classList.remove('cv-closing');
              }
              if (mainStage) {
                mainStage.classList.remove('anim-cv-enter', 'text-out');
              }
            }, 550);
          } else {
            // Experience / Project Close:
            if (mainStage) {
              mainStage.classList.add('text-out');
              mainStage.classList.remove('anim-two-active');
              mainStage.classList.add('anim-two-closing');
            }
            setTimeout(() => {
              venn3Landscape.style.setProperty('display', '', '');
              venn3Portrait.style.setProperty('display', '', '');
              venn2Landscape.style.setProperty('display', 'none', 'important');
              venn2Portrait.style.setProperty('display', 'none', 'important');
              if (mainStage) {
                mainStage.classList.remove('anim-two-closing', 'text-out');
              }
            }, 500);
          }
        } else {
          // ── OPENING NEW SECTION OR SWITCHING BETWEEN SECTIONS ──
          const prevSection = activeSection;
          activeSection = section;
          resetNavButtons();

          // 1. CROSS-SWITCHING DIRECTLY FROM CV TO EXPERIENCE/PROJECT
          if (prevSection === 'cv' && (section === 'experience' || section === 'project')) {
            if (section === 'experience' && navExpBtn) navExpBtn.textContent = '✕';
            if (section === 'project' && navProjBtn) navProjBtn.textContent = '✕';

            if (cvOverlay) {
              cvOverlay.classList.remove('cv-active');
              cvOverlay.classList.add('cv-closing');
            }

            const data = twoCircleData[section];
            if (twoCenterTitleL) twoCenterTitleL.textContent = data.title;
            if (twoCenterTitleP) twoCenterTitleP.textContent = data.title;

            if (twoLeftL) twoLeftL.innerHTML = renderSideCard(data.left);
            if (twoRightL) twoRightL.innerHTML = renderSideCard(data.right);
            if (twoTopP) twoTopP.innerHTML = renderSideCard(data.left);
            if (twoBottomP) twoBottomP.innerHTML = renderSideCard(data.right);

            setTimeout(() => {
              if (cvOverlay) {
                cvOverlay.style.display = 'none';
                cvOverlay.classList.remove('cv-closing');
              }
              if (mainStage) {
                mainStage.style.display = '';
                mainStage.classList.remove('anim-cv-exit', 'anim-cv-enter');
                mainStage.classList.add('anim-two-active');
              }
              venn3Landscape.style.setProperty('display', 'none', 'important');
              venn3Portrait.style.setProperty('display', 'none', 'important');
              venn2Landscape.style.setProperty('display', '', '');
              venn2Portrait.style.setProperty('display', '', '');
            }, 300);
            return;
          }

          // 2. CROSS-SWITCHING FROM EXPERIENCE/PROJECT TO CV
          if ((prevSection === 'experience' || prevSection === 'project') && section === 'cv') {
            if (navCvBtn) navCvBtn.textContent = '✕';
            if (mainStage) {
              mainStage.classList.add('text-out');
            }
            setTimeout(() => {
              venn3Landscape.style.setProperty('display', '', '');
              venn3Portrait.style.setProperty('display', '', '');
              venn2Landscape.style.setProperty('display', 'none', 'important');
              venn2Portrait.style.setProperty('display', 'none', 'important');

              if (mainStage) {
                mainStage.classList.remove('anim-two-active', 'anim-two-closing');
                mainStage.classList.add('anim-cv-exit');
              }
              setTimeout(() => {
                if (mainStage) mainStage.style.display = 'none';
                if (cvOverlay) {
                  cvOverlay.style.display = 'flex';
                  cvOverlay.classList.remove('cv-closing');
                  cvOverlay.classList.add('cv-active');
                }
              }, 450);
            }, 200);
            return;
          }

          // 3. SWITCHING DIRECTLY BETWEEN EXPERIENCE AND PROJECT
          if ((prevSection === 'experience' && section === 'project') || (prevSection === 'project' && section === 'experience')) {
            if (section === 'experience' && navExpBtn) navExpBtn.textContent = '✕';
            if (section === 'project' && navProjBtn) navProjBtn.textContent = '✕';

            if (mainStage) mainStage.classList.add('text-out');
            setTimeout(() => {
              const data = twoCircleData[section];
              if (twoCenterTitleL) twoCenterTitleL.textContent = data.title;
              if (twoCenterTitleP) twoCenterTitleP.textContent = data.title;

              if (twoLeftL) twoLeftL.innerHTML = renderSideCard(data.left);
              if (twoRightL) twoRightL.innerHTML = renderSideCard(data.right);
              if (twoTopP) twoTopP.innerHTML = renderSideCard(data.left);
              if (twoBottomP) twoBottomP.innerHTML = renderSideCard(data.right);
              if (mainStage) mainStage.classList.remove('text-out');
            }, 250);
            return;
          }

          // 4. OPENING FROM LANDING (NORMAL INITIAL OPEN)
          // Step 1: Text & eye fade out cleanly first
          if (mainStage) mainStage.classList.add('text-out');

          setTimeout(() => {
            if (section === 'cv') {
              if (navCvBtn) navCvBtn.textContent = '✕';
              if (mainStage) {
                mainStage.classList.remove('anim-two-active', 'anim-two-closing');
                mainStage.classList.add('anim-cv-exit');
              }
              setTimeout(() => {
                if (mainStage) mainStage.style.display = 'none';
                if (cvOverlay) {
                  cvOverlay.style.display = 'flex';
                  cvOverlay.classList.remove('cv-closing');
                  cvOverlay.classList.add('cv-active');
                }
              }, 450);
            } else {
              // Opening experience or project
              if (section === 'experience' && navExpBtn) navExpBtn.textContent = '✕';
              if (section === 'project' && navProjBtn) navProjBtn.textContent = '✕';

              const data = twoCircleData[section];
              if (twoCenterTitleL) twoCenterTitleL.textContent = data.title;
              if (twoCenterTitleP) twoCenterTitleP.textContent = data.title;

              if (twoLeftL) twoLeftL.innerHTML = renderSideCard(data.left);
              if (twoRightL) twoRightL.innerHTML = renderSideCard(data.right);
              if (twoTopP) twoTopP.innerHTML = renderSideCard(data.left);
              if (twoBottomP) twoBottomP.innerHTML = renderSideCard(data.right);

              if (mainStage) mainStage.classList.add('anim-two-active');
              setTimeout(() => {
                venn3Landscape.style.setProperty('display', 'none', 'important');
                venn3Portrait.style.setProperty('display', 'none', 'important');
                venn2Landscape.style.setProperty('display', '', '');
                venn2Portrait.style.setProperty('display', '', '');
                if (mainStage) mainStage.classList.remove('text-out');
              }, 350);
            }
          }, 200);
        }
      }

      if (navExpBtn) navExpBtn.addEventListener('click', () => switchView('experience'));
      if (navProjBtn) navProjBtn.addEventListener('click', () => switchView('project'));
      if (navCvBtn) navCvBtn.addEventListener('click', () => switchView('cv'));

      // ── EMAIL PUSH INTERACTION ──
      let emailPushed = false;
      const emailBtn = document.getElementById('emailTriggerBtn');
      const tpLinkedin = document.getElementById('tpLinkedinL');
      const tpEmail = document.getElementById('tpEmailL');
      const actualEmail = document.getElementById('actualEmailLink');

      if (emailBtn) {
        emailBtn.addEventListener('click', (e) => {
          e.preventDefault();
          emailPushed = !emailPushed;
          if (emailPushed) {
            // Push linkedin and email smoothly up along the arc with a generous gap
            if (tpLinkedin) tpLinkedin.setAttribute('startOffset', '24%');
            if (tpEmail) tpEmail.setAttribute('startOffset', '42%');
            // Reveal actual email address with a clear separation below
            setTimeout(() => {
              if (actualEmail) actualEmail.style.display = 'block';
            }, 250);
          } else {
            // Push back down to normal
            if (actualEmail) actualEmail.style.display = 'none';
            if (tpLinkedin) tpLinkedin.setAttribute('startOffset', '66%');
            if (tpEmail) tpEmail.setAttribute('startOffset', '79%');
          }
        });
      }
      const shareBtn = document.getElementById('shareBtn');
      const toast = document.getElementById('toast');

      shareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'sitedotmoss.vercel.app',
              text: 'Tinnaphop Sonsang (Moss)',
              url: url
            });
            return;
          } catch (e) {}
        }
        navigator.clipboard.writeText(url).then(() => {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 1800);
        });
      });
    </script>
  </body>
</html>

