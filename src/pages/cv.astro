				if (tileModal.style.display === 'flex') window.closeTileModal();
			}
		});

		// Mouse radial glow on tiles
		document.querySelectorAll('.tile').forEach(function(tile) {
			var ticking = false;
			tile.addEventListener('mousemove', function(e) {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(function() {
					var rect = tile.getBoundingClientRect();
					tile.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
					tile.style.setProperty('--my', (e.clientY - rect.top) + 'px');
					ticking = false;
				});
			});
		});

		// ==========================================================================
		// HORIZONTAL MOUSE WHEEL & DRAG-TO-SCROLL (WINDOWS 8 HORIZONTAL PANNING)
		// ==========================================================================
		var scroll = document.getElementById('dashScroll');

		// 1. Mouse wheel horizontal scrolling anywhere on the window!
		window.addEventListener('wheel', function(e) {
			// If either modal is open, let user scroll inside modal normally
			if (pdfModal && pdfModal.style.display === 'flex') return;
			if (tileModal && tileModal.style.display === 'flex') return;
			if (!scroll) return;

			// Translate vertical mouse wheel scrolling into horizontal dashboard scroll
			if (Math.abs(e.deltaY) > 0) {
				e.preventDefault();
				scroll.scrollLeft += e.deltaY * 1.25;
			} else if (Math.abs(e.deltaX) > 0) {
				scroll.scrollLeft += e.deltaX;
			}
		}, { passive: false });

		// 2. Mouse drag-to-scroll (swipe left/right with mouse)
		if (scroll) {
			var isDragging = false, startX = 0, scrollStartLeft = 0;
			scroll.addEventListener('mousedown', function(e) {
				if (e.target.closest('a, button, iframe, input, select')) return;
				isDragging = true;
				startX = e.pageX - scroll.offsetLeft;
				scrollStartLeft = scroll.scrollLeft;
				scroll.classList.add('is-dragging');
			});
			document.addEventListener('mousemove', function(e) {
				if (!isDragging) return;
				e.preventDefault();
				var x = e.pageX - scroll.offsetLeft;
				scroll.scrollLeft = scrollStartLeft - (x - startX);
			});
			document.addEventListener('mouseup', function() {
				if (isDragging) {
					isDragging = false;
					scroll.classList.remove('is-dragging');
				}
			});
		}
