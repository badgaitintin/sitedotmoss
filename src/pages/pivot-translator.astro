---
import Watermark from '../components/Watermark.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=1280, initial-scale=1.0" />
    <title>Translate · site(.)moss</title>
    <meta
      name="description"
      content="A compact multilingual Transformer built from scratch using a Pre-LN encoder–decoder architecture, shared subword representations, and an English-centric pivot translation strategy."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900;1,9..40,700;1,9..40,900&family=Kanit:wght@800;900&family=Space+Grotesk:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ==========================================================================
         CLEAN TRANSLUCENT & SOFT CURVATURE DESIGN TOKENS
         ========================================================================== */
      :root {
        --bg-screen: #edf2f7;
        --text-wall-idle: #cbd5e1;
        --text-wall-hover: #0f172a;
        
        --card-bg: rgba(255, 255, 255, 0.72);
        --card-border: rgba(255, 255, 255, 0.85);
        --card-shadow: 0 24px 64px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03);
        
        --text-main: #000000;
        --text-sub: #64748b;
        --text-placeholder: #94a3b8;
        
        --cyan-primary: #00a8cc;
        --cyan-hover: #0284c7;
        --cyan-bg: rgba(230, 247, 250, 0.9);
        --cyan-subtle: #7dd3fc;
        
        --font-heavy: "Space Grotesk", "Kanit", "Leelawadee UI", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --r-card: 24px;
        --r-control: 12px;
        --r-btn: 10px;
        --r-circle: 50%;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        margin: 0;
        padding: 0;
        background: var(--bg-screen);
        color: var(--text-main);
        font-family: var(--font-heavy);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        -webkit-font-smoothing: antialiased;
      }

      /* ==========================================================================
         DENSE FULL-VIEWPORT KINETIC WALL (FIT TOP TO BOTTOM, EVERYDAY PHRASES, NO EMOJIS)
         ========================================================================== */
      .billboard-wall {
        position: fixed;
        inset: 0;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0;
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
        pointer-events: auto;
      }

      .wall-row {
        display: flex;
        width: 100%;
        flex: 1 1 0;
        min-height: 0;
        overflow: visible;
        white-space: nowrap;
        align-items: center;
        margin: 0;
        padding: 0;
      }

      .wall-track {
        display: flex;
        gap: 36px;
        flex-shrink: 0;
        will-change: transform;
        align-items: center;
      }

      /* Marquee infinite speeds */
      .scroll-l-1 { animation: marquee-left 48s linear infinite; }
      .scroll-r-1 { animation: marquee-right 52s linear infinite; }
      .scroll-l-2 { animation: marquee-left 42s linear infinite; }
      .scroll-r-2 { animation: marquee-right 46s linear infinite; }
      .scroll-l-3 { animation: marquee-left 56s linear infinite; }
      .scroll-r-3 { animation: marquee-right 44s linear infinite; }
      .scroll-l-4 { animation: marquee-left 50s linear infinite; }
      .scroll-r-4 { animation: marquee-right 40s linear infinite; }
      .scroll-l-5 { animation: marquee-left 54s linear infinite; }
      .scroll-r-5 { animation: marquee-right 48s linear infinite; }
      .scroll-l-6 { animation: marquee-left 45s linear infinite; }
      .scroll-r-6 { animation: marquee-right 50s linear infinite; }

      .wall-row:hover .wall-track {
        animation-play-state: paused;
      }

      @keyframes marquee-left {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      @keyframes marquee-right {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0); }
      }

      /* Clean Raw Typography Item */
      .wall-sentence {
        background: transparent;
        border: none;
        outline: none;
        padding: 0 4px;
        font-family: var(--font-heavy);
        font-size: clamp(34px, 6.2vh, 68px);
        font-weight: 900;
        letter-spacing: -1.2px;
        line-height: 0.88;
        text-transform: uppercase;
        color: var(--text-wall-idle);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .wall-sentence:hover {
        color: var(--text-wall-hover);
        transform: scale(1.02);
      }
      .wall-sentence.accent-hover:hover {
        color: var(--cyan-primary);
      }

      .wall-dot {
        display: none !important;
      }

      /* ==========================================================================
         RANDOMIZED KINETIC TYPOGRAPHY EFFECTS (TRANSPARENT & OLD TV / CRT)
         ========================================================================== */
      /* 1. Hollow / Transparent Outline */
      .wall-sentence.fx-hollow {
        color: transparent !important;
        -webkit-text-stroke: 1.5px var(--text-wall-idle);
      }
      .wall-sentence.fx-hollow:hover {
        -webkit-text-stroke: 1.8px var(--text-wall-hover);
      }
      .wall-sentence.fx-hollow.accent-hover:hover {
        -webkit-text-stroke: 1.8px var(--cyan-primary);
      }

      /* 2. Ghost / Translucent */
      .wall-sentence.fx-ghost {
        opacity: 0.35;
      }
      .wall-sentence.fx-ghost:hover {
        opacity: 1;
      }

      /* 3. Old TV Horizontal Scanlines (CRT Raster) */
      .wall-sentence.fx-tv-scanline {
        background: repeating-linear-gradient(
          0deg,
          var(--text-wall-idle) 0px,
          var(--text-wall-idle) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }
      .wall-sentence.fx-tv-scanline:hover {
        background: repeating-linear-gradient(
          0deg,
          var(--text-wall-hover) 0px,
          var(--text-wall-hover) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .wall-sentence.fx-tv-scanline.accent-hover:hover {
        background: repeating-linear-gradient(
          0deg,
          var(--cyan-primary) 0px,
          var(--cyan-primary) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* 4. Old TV Vertical LED Slits / CRT Phosphor Grille */
      .wall-sentence.fx-tv-vertical {
        background: repeating-linear-gradient(
          90deg,
          var(--text-wall-idle) 0px,
          var(--text-wall-idle) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }
      .wall-sentence.fx-tv-vertical:hover {
        background: repeating-linear-gradient(
          90deg,
          var(--text-wall-hover) 0px,
          var(--text-wall-hover) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .wall-sentence.fx-tv-vertical.accent-hover:hover {
        background: repeating-linear-gradient(
          90deg,
          var(--cyan-primary) 0px,
          var(--cyan-primary) 2.5px,
          transparent 2.5px,
          transparent 5.5px
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* 5. Old TV CRT Chromatic Aberration / RGB Split */
      .wall-sentence.fx-tv-rgb {
        color: var(--text-wall-idle);
        text-shadow: 
          2px 0 0 rgba(239, 68, 68, 0.4),
          -2px 0 0 rgba(6, 182, 212, 0.4);
      }
      .wall-sentence.fx-tv-rgb:hover {
        color: var(--text-wall-hover);
        text-shadow: 
          3px 0 0 rgba(239, 68, 68, 0.7),
          -3px 0 0 rgba(6, 182, 212, 0.7);
      }
      .wall-sentence.fx-tv-rgb.accent-hover:hover {
        color: var(--cyan-primary);
        text-shadow: 
          3px 0 0 rgba(239, 68, 68, 0.65),
          -3px 0 0 rgba(6, 182, 212, 0.75);
      }

      /* 6. Old TV Glitch & Static Jitter */
      .wall-sentence.fx-tv-glitch {
        animation: tv-jitter 6s infinite;
        text-shadow: 
          2px 0 0 rgba(239, 68, 68, 0.35),
          -2px 0 0 rgba(6, 182, 212, 0.35);
      }
      @keyframes tv-jitter {
        0%, 93%, 100% { transform: translate(0, 0); }
        94% { transform: translate(-2px, 1px); }
        95% { transform: translate(2px, -1px); }
        96% { transform: translate(0, 0); }
        98% { transform: translate(-1.5px, 0); }
        99% { transform: translate(0, 0); }
      }

      /* Screen Vignette with subtle CRT scanline grid */
      .wall-vignette {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: 
          linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.015) 50%),
          radial-gradient(circle at center, rgba(237, 242, 247, 0.25) 0%, rgba(237, 242, 247, 0.82) 100%);
        background-size: 100% 4px, 100% 100%;
      }

      /* ==========================================================================
         CENTERED TRANSLUCENT CONSOLE CARD (NO SCROLL, CENTER OF SCREEN)
         ========================================================================== */
      .center-stage-wrap {
        position: relative;
        z-index: 10;
        width: 820px;
        max-width: 92vw;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: auto;
      }

      /* Top Bar with Title and Info Icon */
      .stage-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 4px;
      }

      .stage-title {
        font-size: 34px;
        font-weight: 900;
        letter-spacing: -1px;
        color: var(--text-main);
      }

      .info-circle-btn {
        width: 36px;
        height: 36px;
        border-radius: var(--r-circle);
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        color: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .info-circle-btn:hover {
        background: #ffffff;
        color: var(--cyan-primary);
        border-color: rgba(0, 168, 204, 0.35);
        transform: scale(1.08);
      }
      .info-circle-btn:active {
        transform: scale(0.92);
      }

      /* Master Card */
      .master-translate-card {
        background: var(--card-bg);
        backdrop-filter: blur(32px) saturate(180%);
        -webkit-backdrop-filter: blur(32px) saturate(180%);
        border-radius: var(--r-card);
        box-shadow: var(--card-shadow);
        border: 1px solid var(--card-border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* ─── TOP LANGUAGE DROPDOWN & SWAP BAR ─── */
      .card-header-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 14px 20px;
        background: rgba(255, 255, 255, 0.5);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }

      .lang-select-box {
        display: flex;
        align-items: center;
      }
      .lang-select-box.left {
        justify-content: flex-start;
      }
      .lang-select-box.right {
        justify-content: flex-end;
      }

      .select-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
      }

      .custom-lang-select {
        appearance: none;
        -webkit-appearance: none;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: var(--r-control);
        padding: 8px 34px 8px 14px;
        font-family: var(--font-heavy);
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        cursor: pointer;
        outline: none;
        transition: all 0.15s ease;
      }
      .custom-lang-select:hover {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.15);
      }
      .custom-lang-select:focus {
        border-color: var(--cyan-primary);
        box-shadow: 0 0 0 3px rgba(0, 168, 204, 0.15);
      }

      .select-arrow {
        position: absolute;
        right: 12px;
        pointer-events: none;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Top Center Swap Button */
      .top-swap-btn {
        width: 36px;
        height: 36px;
        border-radius: var(--r-circle);
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: var(--cyan-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }
      .top-swap-btn:hover {
        background: var(--cyan-bg);
        transform: scale(1.08) rotate(180deg);
      }
      .top-swap-btn:active {
        transform: scale(0.92) rotate(180deg);
      }
      .top-swap-btn.pulsing {
        animation: pulse-swap 1.2s infinite;
      }

      @keyframes pulse-swap {
        0% { box-shadow: 0 0 0 0 rgba(0, 168, 204, 0.5); }
        70% { box-shadow: 0 0 0 10px rgba(0, 168, 204, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 168, 204, 0); }
      }

      /* ─── MAIN BODY (SIDE-BY-SIDE) ─── */
      .card-body-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 290px;
      }

      /* Left Side: Source Input */
      .pane-source {
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        border-right: 1px solid rgba(0, 0, 0, 0.05);
      }

      .source-textarea {
        width: 100%;
        flex: 1;
        min-height: 160px;
        border: none;
        outline: none;
        background: transparent;
        font-family: var(--font-heavy);
        font-size: 21px;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.35;
        letter-spacing: -0.3px;
        resize: none;
      }
      .source-textarea::placeholder {
        color: var(--text-placeholder);
        font-weight: 600;
      }

      .pane-bottom-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 6px;
      }

      .char-tag {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-sub);
      }

      .icon-cluster {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .icon-btn-subtle {
        background: transparent;
        border: 1px solid transparent;
        color: #64748b;
        cursor: pointer;
        padding: 6px;
        border-radius: var(--r-btn);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
      }
      .icon-btn-subtle:hover {
        background: rgba(255, 255, 255, 0.8);
        color: var(--text-main);
        border-color: rgba(0, 0, 0, 0.06);
      }
      .icon-btn-subtle:active {
        transform: scale(0.92);
      }

      /* Sleek Rounded Translate Button */
      .translate-action-btn {
        background: #000000;
        color: #ffffff;
        border: none;
        border-radius: var(--r-control);
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 800;
        font-family: var(--font-heavy);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition: all 0.18s ease;
      }
      .translate-action-btn:hover {
        background: #1e293b;
        transform: translateY(-1px);
      }
      .translate-action-btn:active {
        transform: scale(0.96);
      }
      .translate-action-btn.is-loading {
        background: var(--cyan-primary);
        pointer-events: none;
      }

      .speaker-btn-subtle {
        width: 34px;
        height: 34px;
        border-radius: var(--r-control);
        background: rgba(241, 245, 249, 0.85);
        color: #0f172a;
        border: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s;
      }
      .speaker-btn-subtle:hover {
        background: #ffffff;
        transform: scale(1.05);
      }
      .speaker-btn-subtle:active {
        transform: scale(0.92);
      }

      /* Right Side: Target Translation & Bridge */
      .pane-target {
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        background: rgba(241, 245, 249, 0.35);
      }

      .target-output-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 14px;
        position: relative;
        padding-top: 1px;
      }

      .target-output-text {
        font-size: 21px;
        font-weight: 800;
        color: var(--cyan-primary);
        line-height: 1.35;
        letter-spacing: -0.3px;
        word-break: break-word;
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .target-output-text.anim-pop {
        animation: pop-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes pop-in {
        0% { opacity: 0; transform: translateY(4px) scale(0.98); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
      }

      /* Shimmer Animation */
      .loading-shimmer-wrap {
        display: none;
        flex-direction: column;
        gap: 8px;
        padding: 4px 0;
      }
      .loading-shimmer-wrap.active {
        display: flex;
      }

      .shimmer-bar {
        height: 20px;
        border-radius: 8px;
        background: linear-gradient(90deg, rgba(226, 232, 240, 0.6) 25%, rgba(203, 213, 225, 0.8) 50%, rgba(226, 232, 240, 0.6) 75%);
        background-size: 200% 100%;
        animation: shimmer-flow 1.4s infinite;
      }

      .shimmer-text-stage {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--cyan-primary);
        display: flex;
        align-items: center;
        gap: 6px;
        animation: fade-pulse 0.9s ease-in-out infinite alternate;
      }

      @keyframes shimmer-flow {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      @keyframes fade-pulse {
        0% { opacity: 0.65; }
        100% { opacity: 1; }
      }

      /* Pivot Bridge Strip */
      .pivot-bridge-strip {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(0, 168, 204, 0.25);
        border-radius: var(--r-control);
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
      }
      .bridge-strip-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.4px;
        color: var(--cyan-primary);
      }
      .bridge-strip-content {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        line-height: 1.35;
      }

      .speaker-btn-cyan {
        width: 34px;
        height: 34px;
        border-radius: var(--r-control);
        background: var(--cyan-primary);
        color: #ffffff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s;
        box-shadow: 0 2px 8px rgba(0, 168, 204, 0.25);
      }
      .speaker-btn-cyan:hover {
        background: var(--cyan-hover);
        transform: scale(1.05);
      }
      .speaker-btn-cyan:active {
        transform: scale(0.92);
      }

      /* ==========================================================================
         TECHNICAL MODEL ARCHITECTURE MODAL (8 DETAILED CARDS & PAPERS, NO EMOJIS)
         ========================================================================== */
      .modal-scrim {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        opacity: 0;
        visibility: hidden;
        transition: all 0.22s ease;
      }
      .modal-scrim.is-open {
        opacity: 1;
        visibility: visible;
      }

      .info-dialog-box {
        background: #ffffff;
        width: 820px;
        max-width: 94vw;
        max-height: 88vh;
        border-radius: 20px;
        padding: 26px 28px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        gap: 16px;
        border: 1px solid rgba(0, 0, 0, 0.08);
      }

      .info-dialog-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 14px;
      }

      .info-title-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .info-dialog-title {
        font-size: 21px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.4px;
      }

      .info-dialog-subtitle {
        font-size: 13px;
        font-weight: 500;
        color: #64748b;
        line-height: 1.45;
      }

      .info-content-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow-y: auto;
        padding-right: 6px;
      }

      /* Custom sleek scrollbar */
      .info-content-body::-webkit-scrollbar {
        width: 5px;
      }
      .info-content-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }

      /* 8-Card Architecture Grid */
      .arch-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .arch-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: all 0.15s ease;
      }
      .arch-card:hover {
        border-color: var(--cyan-primary);
        background: #ffffff;
        box-shadow: 0 4px 16px rgba(0, 168, 204, 0.06);
      }

      .arch-card-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
      }

      .arch-card-title {
        font-size: 14.5px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.2px;
      }

      .arch-card-sub {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--cyan-primary);
        letter-spacing: 0.3px;
      }

      .arch-card-p {
        font-size: 12.5px;
        font-weight: 500;
        color: #475569;
        line-height: 1.45;
      }

      .arch-card-ref {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        font-style: italic;
        margin-top: auto;
        padding-top: 4px;
      }

      /* Pivot Hub Diagram inside Card */
      .hub-diagram {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 6px 10px;
        margin: 4px 0;
      }

      .hub-node {
        font-size: 11px;
        font-weight: 700;
        color: #334155;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        padding: 3px 6px;
        border-radius: 4px;
      }
      .hub-node.active {
        background: var(--cyan-bg);
        color: var(--cyan-primary);
        border-color: rgba(0, 168, 204, 0.35);
      }

      /* Evolution & References Sections */
      .info-narrative-section {
        background: #f1f5f9;
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .narrative-title {
        font-size: 13px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: 0.2px;
        text-transform: uppercase;
      }

      .narrative-p {
        font-size: 12.5px;
        font-weight: 500;
        color: #475569;
        line-height: 1.5;
      }

      .references-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding-left: 0;
        list-style: none;
      }

      .reference-item {
        font-size: 12px;
        font-weight: 500;
        color: #334155;
        line-height: 1.4;
      }
      .reference-item strong {
        color: #0f172a;
        font-weight: 700;
      }

      /* Toast Notification */
      .toast {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(-50px);
        background: rgba(15, 23, 42, 0.92);
        backdrop-filter: blur(12px);
        color: #ffffff;
        padding: 8px 18px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        opacity: 0;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 99999;
      }
      .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
      }

      .spin-icon {
        animation: spin-loop 0.8s linear infinite;
      }
      @keyframes spin-loop {
        100% { transform: rotate(360deg); }
      }
    </style>
