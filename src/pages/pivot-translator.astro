        },
        "ไม่ต้องเป็นห่วงนะ ทุกอย่างเรียบร้อยดี": {
          en: { tgt: "Don't worry, everything is fine.", en: "Don't worry, everything is fine." },
          zh: { tgt: "别担心，一切顺利。", en: "Don't worry, everything is fine." }
        },
        "เดินทางกลับบ้านปลอดภัยนะ": {
          en: { tgt: "Have a safe trip home!", en: "Have a safe trip home!" },
          zh: { tgt: "回家路上注意安全。", en: "Have a safe trip home!" }
        },
        "คืนนี้ฝันดีนะ พรุ่งนี้เจอกัน": {
          en: { tgt: "Good night and see you tomorrow!", en: "Good night and see you tomorrow!" },
          zh: { tgt: "晚安，明天见！", en: "Good night and see you tomorrow!" }
        },
        "ฉันรักการอ่าน": {
          en: { tgt: "I love reading.", en: "I love reading." },
          zh: { tgt: "我热爱阅读。", en: "I love reading." }
        }
      };

      // ─── DOM REFS ──────────────────────────────────────────────────────────
      const selectSrcLang = document.getElementById("selectSrcLang") as HTMLSelectElement;
      const selectTgtLang = document.getElementById("selectTgtLang") as HTMLSelectElement;
      const btnSwapLang = document.getElementById("btnSwapLang")!;
      const mainSourceInput = document.getElementById("mainSourceInput") as HTMLTextAreaElement;
      const mainTargetDisplay = document.getElementById("mainTargetDisplay")!;
      const loadingShimmer = document.getElementById("loadingShimmer")!;
      const shimmerStageText = document.getElementById("shimmerStageText")!;
      const bridgeStrip = document.getElementById("bridgeStrip")!;
      const bridgeStripContent = document.getElementById("bridgeStripContent")!;
      const charTag = document.getElementById("charTag")!;
      const btnRunTranslate = document.getElementById("btnRunTranslate")!;
      const translateBtnLabel = document.getElementById("translateBtnLabel")!;

      const infoModal = document.getElementById("infoModal")!;
      const btnOpenInfoModal = document.getElementById("btnOpenInfoModal")!;
      const btnCloseInfoModal = document.getElementById("btnCloseInfoModal")!;

      // ─── HELPERS ───────────────────────────────────────────────────────────
      function showToast(text: string) {
        const t = document.getElementById("toastBox");
        if (t) {
          t.textContent = text;
          t.classList.add("show");
          setTimeout(() => t.classList.remove("show"), 2000);
        }
      }

      function updateConsoleUI() {
        selectSrcLang.value = sourceLang;
        selectTgtLang.value = targetLang;
        mainSourceInput.placeholder = PLACEHOLDERS[sourceLang] || "Type text...";
        charTag.textContent = `${mainSourceInput.value.length} characters`;

        const isPivotNeeded = sourceLang !== "en" && targetLang !== "en" && sourceLang !== targetLang;
        bridgeStrip.style.display = isPivotNeeded ? "flex" : "none";
      }

      // ─── TRANSLATION ENGINE & ANIMATION ────────────────────────────────────
      let animInterval: any = null;

      function startLoadingVisuals() {
        isTranslating = true;
        btnSwapLang.classList.add("pulsing");
        btnRunTranslate.classList.add("is-loading");
        translateBtnLabel.textContent = "Translating...";
        
        mainTargetDisplay.style.display = "none";
        loadingShimmer.classList.add("active");

        const stages = [
          "Tokenizing input...",
          "English pivot bridge mapping...",
          "Generating translation...",
        ];
        let idx = 0;
        shimmerStageText.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="spin-icon">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
          </svg>
          <span>${stages[0]}</span>
        `;
        animInterval = setInterval(() => {
          idx = (idx + 1) % stages.length;
          shimmerStageText.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="spin-icon">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
            <span>${stages[idx]}</span>
          `;
        }, 280);
      }

      function stopLoadingVisuals() {
        isTranslating = false;
        clearInterval(animInterval);
        btnSwapLang.classList.remove("pulsing");
        btnRunTranslate.classList.remove("is-loading");
        translateBtnLabel.textContent = "Translate";
        
        loadingShimmer.classList.remove("active");
        mainTargetDisplay.style.display = "block";
        mainTargetDisplay.classList.remove("anim-pop");
        void mainTargetDisplay.offsetWidth;
        mainTargetDisplay.classList.add("anim-pop");
      }

      async function runTranslation() {
        const text = mainSourceInput.value.trim();
        if (!text) {
          mainTargetDisplay.textContent = "Have you eaten yet?";
          bridgeStripContent.textContent = '"Have you eaten yet?"';
          return;
        }

        startLoadingVisuals();

        try {
          const resp = await fetch("/api/pivot/translate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              text,
              srcLang: sourceLang,
              tgtLang: targetLang,
              spaceUrl: spaceRepo,
            }),
          });
          const data = await resp.json();
          stopLoadingVisuals();
          if (data.success && data.target) {
            applyTranslationData(data.target, data.pivot || data.target);
            return;
          }
        } catch (err) {
          console.warn("Translation request error:", err);
        }

        stopLoadingVisuals();
        // Fallback dictionary match
        const match = EVERYDAY_DICT[text]?.[targetLang];
        if (match) {
          applyTranslationData(match.tgt, match.en);
        } else {
          if (targetLang === "en") {
            applyTranslationData("Have you eaten yet?", "Have you eaten yet?");
          } else if (targetLang === "zh") {
            applyTranslationData("你吃了吗？", "Have you eaten yet?");
          } else {
            applyTranslationData("กินข้าวหรือยัง", "Have you eaten yet?");
          }
        }
      }

      function applyTranslationData(targetText: string, pivotText: string) {
        mainTargetDisplay.textContent = targetText;
        bridgeStripContent.textContent = `"${pivotText}"`;
      }

      function speakTextAudio(text: string, lang: string) {
        if (!("speechSynthesis" in window)) return;
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        const codeMap: Record<string, string> = { th: "th-TH", en: "en-US", zh: "zh-CN" };
        u.lang = codeMap[lang] || "en-US";
        u.rate = 0.95;
        window.speechSynthesis.speak(u);
      }

      function applyRandomKineticEffects() {
        const sentences = document.querySelectorAll(".billboard-wall .wall-sentence");
        const effectPool = [
          "fx-hollow",       // Hollow transparent outline
          "fx-hollow",       // Hollow transparent outline
          "fx-ghost",        // Translucent 35% opacity
          "fx-tv-scanline",  // Old CRT TV horizontal scanlines
          "fx-tv-vertical",  // Old TV / LED vertical phosphor slits
          "fx-tv-rgb",       // Old CRT TV chromatic aberration (RGB split)
          "fx-tv-glitch",    // Old TV signal static glitch
          "",                // Solid normal
          "",                // Solid normal
        ];

        sentences.forEach((el) => {
          const chosen = effectPool[Math.floor(Math.random() * effectPool.length)];
          if (chosen) el.classList.add(chosen);
        });
      }

      // ─── EVENT HANDLERS ────────────────────────────────────────────────────
      document.addEventListener("DOMContentLoaded", () => {
        applyRandomKineticEffects();
        updateConsoleUI();

        // Realtime typing debounce (Wait 3.5s after user stops typing before auto-translating, or instant on Translate button / Ctrl+Enter)
        let typeDebounce: any = null;
        mainSourceInput.addEventListener("input", () => {
          charTag.textContent = `${mainSourceInput.value.length} characters`;
          clearTimeout(typeDebounce);
          typeDebounce = setTimeout(runTranslation, 3500);
        });

        mainSourceInput.addEventListener("keydown", (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
            e.preventDefault();
            clearTimeout(typeDebounce);
            runTranslation();
          }
        });

        // Top Dropdowns
        selectSrcLang.addEventListener("change", () => {
          sourceLang = selectSrcLang.value;
          if (sourceLang === targetLang) {
            targetLang = sourceLang === "en" ? "zh" : "en";
            selectTgtLang.value = targetLang;
          }
          updateConsoleUI();
          runTranslation();
        });

        selectTgtLang.addEventListener("change", () => {
          targetLang = selectTgtLang.value;
          if (targetLang === sourceLang) {
            sourceLang = targetLang === "en" ? "th" : "en";
            selectSrcLang.value = sourceLang;
          }
          updateConsoleUI();
          runTranslation();
        });

        // Swap Button
        btnSwapLang.addEventListener("click", () => {
          const temp = sourceLang;
          sourceLang = targetLang;
          targetLang = temp;
          const prevTarget = mainTargetDisplay.textContent?.trim() || "";
          if (prevTarget && prevTarget !== "...") {
            mainSourceInput.value = prevTarget;
          }
          updateConsoleUI();
          runTranslation();
        });

        // Run Translate Button
        btnRunTranslate.addEventListener("click", () => {
          runTranslation();
        });

        // 100% Clickable Global Wall Sentence Selection
        document.addEventListener("click", (e) => {
          const target = (e.target as HTMLElement).closest("[data-text]") as HTMLElement;
          if (target && !target.closest(".master-translate-card") && !target.closest(".info-dialog-box")) {
            const rawText = target.getAttribute("data-text");
            const src = target.getAttribute("data-src") || "th";
            const tgt = target.getAttribute("data-tgt") || "en";

            if (rawText) {
              sourceLang = src;
              targetLang = tgt;
              mainSourceInput.value = rawText;
              updateConsoleUI();
              runTranslation();
              showToast(`Selected: "${rawText.slice(0, 24)}..."`);
            }
          }
        });

        // Info Modal Open / Close
        btnOpenInfoModal.addEventListener("click", () => {
          infoModal.classList.add("is-open");
        });
        btnCloseInfoModal.addEventListener("click", () => {
          infoModal.classList.remove("is-open");
        });
        infoModal.addEventListener("click", (e) => {
          if (e.target === infoModal) infoModal.classList.remove("is-open");
        });

        // Actions
        document.getElementById("btnCopyResult")?.addEventListener("click", () => {
          navigator.clipboard.writeText(mainTargetDisplay.textContent || "");
          showToast("Translation copied to clipboard");
        });

        document.getElementById("btnClearInput")?.addEventListener("click", () => {
          mainSourceInput.value = "";
          updateConsoleUI();
          mainSourceInput.focus();
        });

        document.getElementById("btnPasteInput")?.addEventListener("click", async () => {
          try {
            const text = await navigator.clipboard.readText();
            mainSourceInput.value = text;
            updateConsoleUI();
            runTranslation();
          } catch (e) {
            showToast("Clipboard access denied");
          }
        });

        // TTS
        document.getElementById("btnSpeakSource")?.addEventListener("click", () => {
          speakTextAudio(mainSourceInput.value, sourceLang);
        });
        document.getElementById("btnSpeakTarget")?.addEventListener("click", () => {
          speakTextAudio(mainTargetDisplay.textContent || "", targetLang);
        });

        document.getElementById("btnFav")?.addEventListener("click", () => showToast("Saved to favorites"));
      });
    </script>
  </body>
</html>
