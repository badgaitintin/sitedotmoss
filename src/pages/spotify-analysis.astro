---
// spotify-analysis.astro — Spotify Sonic Atlas Page in Bold Abstract Geometric Graphic Style
import "@fontsource/google-sans-flex";
import Watermark from "../components/Watermark.astro";
import clusterSummary from "../../public/assets/spotify/cluster_summary.json";
import musicGalaxy from "../../public/assets/spotify/music_galaxy.json";
import personalRating from "../../public/assets/spotify/personal_rating.json";

const rawTracks = musicGalaxy.filter((t) => t.release_year <= 2020);
const uniqueNames = new Set(rawTracks.map((t) => t.name.toLowerCase().trim()));
const tracksCount = uniqueNames.size;
const clustersCount = clusterSummary.length;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Sonic Atlas — Geometric Data Analysis & Clustering Dashboard"
		/>
		<title>Sonic Atlas — site(.)moss</title>
		<script src="https://cdn.plot.ly/plotly-2.24.1.min.js" is:inline defer
		></script>

		<style is:global>
			/* ===========================
			   ABSTRACT GEOMETRIC DESIGN SYSTEM
			=========================== */
			:root {
				--geo-black: #0a0a0d;
				--geo-white: #ffffff;
				--geo-blue: #1642e8;   /* Bauhaus Royal Cobalt */
				--geo-red: #ef233c;    /* Crimson Coral */
				--geo-yellow: #fbbf24; /* Warm Gold Amber */
				--geo-cyan: #38bdf8;   /* Electric Aqua */
				--geo-purple: #31108d;
				--geo-surface: rgba(255, 255, 255, 0.90);
				--geo-surface-dark: #0f121d;
				--geo-border: #0a0a0d;
				--geo-text: #0a0a0d;
				--geo-muted: #475569;
				
				/* Solid crisp neo-brutalist / geometric graphic shadows */
				--geo-shadow: 4px 4px 0px #0a0a0d;
				--geo-shadow-lg: 6px 6px 0px #0a0a0d;
				--geo-shadow-sm: 2.5px 2.5px 0px #0a0a0d;

				/* Backwards compatible tokens */
				--bh-text: #0a0a0d;
				--bh-muted: #475569;
				--bh-accent: #1642e8;
			}

			/* ===========================
			   BASE
			=========================== */
			html,
			body {
				width: 100%;
				height: 100vh;
				overflow: hidden;
				background: transparent !important;
				font-family:
					"Google Sans Flex", "Google Sans", "Helvetica Neue",
					sans-serif;
				color: var(--geo-text);
				line-height: 1.5;
				margin: 0;
				padding: 0;
				position: relative;
			}
			
			button {
				color: inherit;
			}

			a {
				color: var(--geo-blue);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}

			.page-wrap {
				animation: geo-enter 0.45s cubic-bezier(0.1, 0.9, 0.2, 1) both;
				height: 100%;
				position: relative;
				z-index: 1;
			}
			@keyframes geo-enter {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			body.is-exiting .page-wrap {
				animation: geo-exit 0.28s cubic-bezier(0.4, 0, 1, 1) both;
				pointer-events: none;
			}
			@keyframes geo-exit {
				from {
					opacity: 1;
					transform: translateY(0);
				}
				to {
					opacity: 0;
					transform: translateY(14px);
				}
			}

			/* ===========================
			   LAYOUT CONTAINER
			=========================== */
			.bh-page {
				position: relative;
				z-index: 1;
				max-width: 1180px;
				margin: 0 auto;
				height: 100vh;
				padding: 16px 26px 26px 16px; /* Generous breathing room so 4px-6px shadows never clip */
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.bh-main-card {
				position: relative;
				display: flex;
				flex-direction: column;
				gap: 16px;
				height: calc(100vh - 42px);
				align-items: stretch;
				box-sizing: border-box;
				overflow: visible; /* Prevent any clipping on card shadows */
			}

			/* ===========================
			   BAUHAUS TOPBAR / SIDEBAR
			=========================== */
			.wbc-sidebar {
				width: 100%;
				height: auto;
				flex-shrink: 0;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 12px 20px;
				position: relative;
				background: var(--geo-surface);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 2px solid var(--geo-border);
				border-radius: 18px;
				box-shadow: var(--geo-shadow);
				box-sizing: border-box;
				z-index: 10;
				transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
			}

			.bh-header {
				display: flex;
				flex-direction: row;
				gap: 14px;
				margin: 0;
				width: auto;
				align-items: center;
				text-align: left;
			}

			/* Back Button */
			.wbc-back-btn {
				flex-shrink: 0;
				width: 38px;
				height: 38px;
				background: #ffffff;
				color: var(--geo-black);
				display: flex;
				align-items: center;
				justify-content: center;
				border: 2px solid var(--geo-border);
				border-radius: 50%;
				cursor: pointer;
				box-shadow: var(--geo-shadow-sm);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
			}
			.wbc-back-btn:hover {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
			}

			.title-tag-pill {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				font-size: 0.62rem;
				font-weight: 900;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--geo-blue);
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 99px;
				padding: 1px 8px;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
				width: fit-content;
				margin-bottom: 2px;
			}

			.bh-title {
				font-size: 1.6rem;
				font-weight: 900;
				line-height: 1;
				letter-spacing: -0.5px;
				margin: 0;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
				gap: 6px;
			}
			.title-sonic {
				color: var(--geo-blue);
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
			}
			.title-atlas {
				color: var(--geo-red);
				font-family: Georgia, serif;
				font-style: italic;
				font-weight: bold;
			}

			/* ── NAV MENU ── */
			.wbc-nav-menu {
				display: flex;
				flex-direction: row;
				gap: 8px;
				margin: 0;
				align-items: center;
			}
			.nav-item {
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 7px 15px;
				font-size: 0.74rem;
				font-weight: 800;
				color: var(--geo-black);
				background: #ffffff;
				border: 2px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				text-align: left;
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
				box-shadow: 2px 2px 0px var(--geo-border);
				letter-spacing: 0.02em;
			}
			.nav-item:hover {
				background: #f8fafc;
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.nav-item.active {
				color: #ffffff;
				transform: translate(-1.5px, -1.5px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
			}
			#nav-personas.active { background: var(--geo-red); }
			#nav-galaxy.active { background: var(--geo-blue); }
			#nav-rating.active { background: var(--geo-yellow); color: var(--geo-black); }
			#nav-pipeline.active { background: var(--geo-black); }

			.nav-geo-icon {
				font-size: 0.8rem;
				line-height: 1;
			}

			/* ── Right-side Resume Style Quadrant Wheel Widget & Canvas View Button ── */
			.geo-header-right {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			/* Canvas View Toggle Button */
			.geo-canvas-toggle-btn {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 6px 12px;
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 0.06em;
				color: var(--geo-black);
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				box-shadow: 2px 2px 0px var(--geo-border);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
			}
			.geo-canvas-toggle-btn:hover {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.geo-canvas-toggle-btn.active {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
				box-shadow: 3px 3px 0px var(--geo-border);
			}

			.geo-quadrant-badge {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				border: 2px solid var(--geo-black);
				position: relative;
				overflow: hidden;
				box-shadow: 2px 2px 0px var(--geo-black);
				background: #ffffff;
				flex-shrink: 0;
				animation: geo-spin-slow 20s linear infinite;
			}
			.geo-quadrant-slice {
				position: absolute;
				width: 50%;
				height: 50%;
			}
			.slice-tl { top: 0; left: 0; background: var(--geo-red); }
			.slice-tr { top: 0; right: 0; background: var(--geo-blue); }
			.slice-bl { bottom: 0; left: 0; background: var(--geo-yellow); }
			.slice-br { bottom: 0; right: 0; background: var(--geo-black); }
			.geo-quadrant-center {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: var(--geo-white);
				border: 1.5px solid var(--geo-black);
				z-index: 2;
			}
			@keyframes geo-spin-slow {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			.geo-dot-chip {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5px;
				padding: 5px;
				background: var(--geo-black);
				border: 1.5px solid var(--geo-black);
				border-radius: 6px;
				width: 22px;
				height: 22px;
				box-sizing: border-box;
				box-shadow: 2px 2px 0px rgba(0,0,0,0.2);
			}
			.geo-dot-chip span {
				width: 3.5px;
				height: 3.5px;
				border-radius: 50%;
				background: #ffffff;
			}
			.geo-dot-chip span.active {
				background: var(--geo-yellow);
			}

			/* ===========================
			   WORKSPACE / TABS
			=========================== */
			.wbc-workspace {
				flex: 1;
				display: flex;
				flex-direction: column;
				min-width: 0;
				height: 100%;
				overflow: visible;
				transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
				            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
			}

			/* Canvas Zen Mode Transitions */
			body.is-zen-canvas .wbc-workspace {
				opacity: 0;
				pointer-events: none;
				transform: translateY(32px) scale(0.97);
			}
			body.is-zen-canvas .wbc-sidebar {
				background: rgba(255, 255, 255, 0.72);
				box-shadow: 2.5px 2.5px 0px rgba(10, 10, 13, 0.4);
			}

			.geo-zen-exit-pill {
				position: fixed;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%) translateY(70px);
				opacity: 0;
				pointer-events: none;
				z-index: 9999;
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 8px 18px;
				font-size: 0.74rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: #ffffff;
				color: var(--geo-black);
				border: 2px solid var(--geo-border);
				border-radius: 99px;
				box-shadow: 4px 4px 0px var(--geo-border);
				cursor: pointer;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.geo-zen-exit-pill:hover {
				background: var(--geo-yellow);
				transform: translateX(-50%) translateY(-2px);
				box-shadow: 5px 5px 0px var(--geo-border);
			}
			body.is-zen-canvas .geo-zen-exit-pill {
				transform: translateX(-50%) translateY(0);
				opacity: 1;
				pointer-events: auto;
			}
			.zen-esc-kbd {
				background: var(--geo-black);
				color: #ffffff;
				font-size: 0.6rem;
				padding: 2px 6px;
				border-radius: 4px;
				font-family: monospace;
			}

			.tab-content {
				display: grid;
				grid-template-columns: 1fr;
				gap: 18px;
				height: 100%;
				min-height: 0;
				padding-right: 6px;
				padding-bottom: 6px;
				box-sizing: border-box;
			}
			@media (min-width: 768px) {
				.tab-content.wide-left {
					grid-template-columns: 1.45fr 1fr;
				}
				.tab-content.equal-split {
					grid-template-columns: 1fr 1fr;
				}
			}

			/* ── PANELS ── */
			.panel {
				background: var(--geo-surface);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 2px solid var(--geo-border);
				border-radius: 20px;
				padding: 20px;
				display: flex;
				flex-direction: column;
				height: 100%;
				min-height: 0;
				box-sizing: border-box;
				position: relative;
				box-shadow: var(--geo-shadow);
				transition: transform 0.18s cubic-bezier(0.1, 0.8, 0.2, 1), box-shadow 0.18s ease;
				overflow: hidden;
			}

			.panel:hover {
				transform: translate(-1px, -1px);
				box-shadow: 5px 5px 0px var(--geo-border);
			}

			/* Geometric Section Pill Badge */
			.section-title {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--geo-black);
				font-weight: 900;
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				padding: 3px 10px;
				box-shadow: 2px 2px 0px var(--geo-border);
				margin-bottom: 8px;
				width: fit-content;
			}

			.panel-header-title {
				font-size: 1.25rem;
				font-weight: 900;
				color: var(--geo-black);
				margin: 0 0 4px 0;
				letter-spacing: -0.3px;
			}

			/* Cluster detail card */
			.cluster-detail-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				justify-content: space-between;
				position: relative;
			}

			.cluster-detail-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 2px solid var(--geo-border);
				padding-bottom: 8px;
			}

			.cluster-badge {
				background: var(--geo-blue);
				color: #ffffff;
				border: 1.5px solid var(--geo-border);
				padding: 3px 10px;
				border-radius: 99px;
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 0.05em;
				box-shadow: 2px 2px 0px var(--geo-border);
			}

			.cluster-desc {
				font-size: 0.78rem;
				color: var(--geo-muted);
				font-weight: 600;
				margin: 8px 0 0 0;
			}

			/* Metrics grid */
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 8px;
				margin-top: 10px;
			}

			.metric-box {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				padding: 8px 12px;
				box-shadow: 2px 2px 0px var(--geo-border);
			}

			.metric-meta {
				display: flex;
				justify-content: space-between;
				font-size: 0.7rem;
				font-weight: 800;
				margin-bottom: 4px;
			}

			.metric-bar {
				height: 6px;
				background: #e2e8f0;
				border: 1.2px solid var(--geo-border);
				border-radius: 99px;
				overflow: hidden;
			}

			.metric-fill {
				height: 100%;
				border-radius: 99px;
				transition: width 0.6s cubic-bezier(0.1, 0.8, 0.2, 1);
			}

			.metric-chip-stat {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				padding: 8px 12px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.metric-chip-title {
				font-size: 0.62rem;
				color: var(--geo-muted);
				text-transform: uppercase;
				font-weight: 900;
				letter-spacing: 0.05em;
			}
			.metric-chip-val {
				font-size: 0.85rem;
				font-weight: 900;
				font-family: monospace;
			}

			/* Cluster rail buttons */
			.cluster-rail {
				display: flex;
				flex-direction: column;
				gap: 8px;
				margin-top: 8px;
			}

			.cluster-btn {
				position: relative;
				width: 100%;
				padding: 10px 14px;
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				text-align: left;
				cursor: pointer;
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
				box-shadow: 2.5px 2.5px 0px var(--geo-border);
			}
			.cluster-btn:hover {
				transform: translate(-1px, -1px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
				background: #f8fafc;
			}
			.cluster-btn.active {
				background: var(--geo-black);
				color: #ffffff;
				transform: translate(-1.5px, -1.5px);
				box-shadow: 3.5px 3.5px 0px var(--cluster-theme-color, var(--geo-red));
			}
			.cluster-btn.active .cluster-count-pill {
				background: #ffffff;
				color: var(--geo-black);
			}

			.cluster-title-wrap {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.78rem;
				font-weight: 800;
			}

			.cluster-count-pill {
				font-size: 0.65rem;
				font-weight: 800;
				padding: 2px 8px;
				border-radius: 99px;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				color: var(--geo-muted);
			}

			/* Track list items */
			.list-scroll {
				flex: 1;
				overflow-y: auto;
				margin-top: 6px;
				padding-right: 4px;
				display: flex;
				flex-direction: column;
				gap: 5px;
				min-height: 0;
			}
			.list-scroll::-webkit-scrollbar {
				width: 4px;
			}
			.list-scroll::-webkit-scrollbar-thumb {
				background: var(--geo-border);
				border-radius: 4px;
			}

			.track-list-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 7px 10px;
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 8px;
				font-size: 0.74rem;
				font-weight: 700;
				cursor: pointer;
				text-align: left;
				transition: all 0.15s ease;
				font-family: inherit;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.track-list-item:hover {
				background: #f8fafc;
				transform: translateX(3px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.track-list-item.selected {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
			}
			.track-list-item.selected .track-item-badge {
				background: #ffffff;
				color: var(--geo-blue);
			}

			.track-item-title {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 170px;
			}

			.track-item-badge {
				font-size: 0.62rem;
				font-weight: 900;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				padding: 2px 6px;
				border-radius: 4px;
				flex-shrink: 0;
			}

			/* ── GALAXY TAB STYLING ── */
			.galaxy-svg-container {
				width: 100%;
				height: 100%;
				min-height: 0;
				border: 2px solid var(--geo-border);
				border-radius: 16px;
				overflow: hidden;
				position: relative;
