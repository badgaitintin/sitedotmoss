				-webkit-backdrop-filter: blur(10px) saturate(130%);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-top: 1.5px solid rgba(255, 255, 255, 0.2);
				border-radius: 16px;
				padding: 10px 12px;
				font-size: 0.7rem;
				transition: all 0.2s;
				box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
