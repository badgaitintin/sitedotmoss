										<div
											class="list-scroll"
											id="cluster-tracks-list"
											style="flex: 1; min-height: 0; overflow-y: auto;"
										>
											<!-- Dynamic tracks in cluster -->
										</div>
									</div>
								</div>
							</div>

							<!-- RIGHT PANEL: ARCHETYPES & TRACK PASSPORT -->
							<div class="panel" style="display: flex; flex-direction: column; height: 100%; overflow: hidden; padding: 14px 16px; justify-content: space-between;">
								<div>
									<span class="section-title" style="margin-bottom: 4px;">Sonic Archetypes</span>
									<div
										class="cluster-rail"
										id="cluster-rail-list"
									>
										<!-- Rail buttons -->
									</div>
								</div>

								<!-- Live Track Inspector Passport HUD -->
								<div id="persona-track-inspector">
									<!-- Dynamic Selected Track Passport -->
								</div>

								<!-- Era Histogram Breakdown -->
								<div id="persona-era-breakdown">
									<!-- Dynamic Era Breakdown -->
								</div>
							</div>
						</div>

						<!-- ── TAB 2: MUSIC GALAXY ── -->
						<div
							id="tab-galaxy"
							class="tab-content wide-left hidden"
						>
							<div
								class="panel"
								style="padding: 0; position: relative;"
							>
								<div
									class="galaxy-svg-container"
									id="galaxy-container"
									style="width: 100%; height: 100%; border-radius: 16px; overflow: hidden; background: #0f121d;"
								>
									<div
										id="plotly-galaxy-3d"
										style="width: 100%; height: 100%;"
									>
									</div>
								</div>
							</div>

							<!-- DETAILS PANEL FOR SELECTED TRACK -->
							<div
								class="panel"
								style="display: flex; flex-direction: column; padding: 18px;"
							>
								<div
									class="selected-track-card"
									style="display: flex; flex-direction: column; height: 100%;"
								>
									<span class="section-title"
										>Selected Track HUD</span
									>
									<div style="margin-bottom: 10px; border-bottom: 2px solid var(--geo-border); padding-bottom: 8px;">
										<h4
											class="panel-header-title"
											id="galaxy-track-name"
											style="font-size: 1.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px;"
										>
											-
										</h4>
										<p
											style="font-size: 0.72rem; font-weight: 700; color: var(--geo-muted); margin: 0;"
											id="galaxy-track-year"
										>
											-
										</p>
									</div>

									<div
										style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px;"
										id="galaxy-track-metrics"
									>
										<!-- Track metrics progress bars -->
									</div>

									<div
										style="flex: 1; display: flex; flex-direction: column; min-height: 0; margin-bottom: 6px;"
									>
										<span class="section-title"
											>Closest Wormholes</span
										>
										<div
											class="list-scroll"
											id="galaxy-wormholes-list"
										>
											<!-- Wormhole similarities -->
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- ── TAB 3: PERSONAL RATING ── -->
						<div
							id="tab-rating"
							class="tab-content wide-left hidden"
						>
							<div
								class="panel"
								style="display: flex; flex-direction: column; height: 100%;"
							>
								<span class="section-title"
									>Personal Rating Space</span
								>
								<h3 class="panel-header-title">
									Album Track Clustering
								</h3>
								<p
									style="font-size: 0.72rem; font-weight: 600; color: var(--geo-muted); margin-bottom: 10px;"
								>
									Audio features and bias score clustering using GMM & PCA 3D projection.
								</p>
								<div
									id="plotly-3d-map"
									style="flex: 1; min-height: 0; width: 100%; border: 2px solid var(--geo-border); border-radius: 12px; overflow: hidden; background: #0f121d;"
								>
								</div>
							</div>
							<div
								class="panel"
								style="display: flex; flex-direction: column; gap: 12px; height: 100%; overflow: hidden;"
							>
								<span class="section-title"
									>Albums & Bias Breakdown</span
								>
								<div
									id="album-cards-container"
									style="display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex: 1; padding-right: 4px;"
								>
									<!-- Dynamic expandable album cards populated by script -->
								</div>
							</div>
						</div>

						<!-- ── TAB 4: ML PIPELINE GAME-STAGE ARENA ── -->
						<div
							id="tab-pipeline"
							class="tab-content full-width hidden"
						>
							<div
								class="panel"
								style="display: flex; flex-direction: column; height: 100%; overflow: hidden; padding: 14px 18px;"
							>
								<div class="pipeline-interactive-root" id="pipeline-interactive-root">
									<!-- Top Level / Stage Header Bar -->
									<div class="pipeline-top-header">
										<div style="display: flex; align-items: center; gap: 8px;">
											<span class="section-title" style="margin-bottom: 0;">ML PIPELINE FLOW</span>
											<h3 class="panel-header-title" style="font-size: 1.1rem; margin: 0;">
												Architecture Pipeline
											</h3>
										</div>
										<div class="pipeline-header-controls">
											<button type="button" id="pipeline-autoplay-btn" class="pipeline-hud-btn" title="Auto-advance through pipeline stages">
												<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
												<span>TOUR PIPELINE</span>
											</button>
											<button type="button" id="pipeline-view-mode-btn" class="pipeline-hud-btn" title="Toggle between Step Flow View and Architecture Grid Overview">
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
												<span>ARCHITECTURE GRID</span>
											</button>
										</div>
									</div>

									<!-- Stage Quest Track (Top Level Navigator) -->
									<div class="pipeline-quest-track" id="pipeline-quest-track">
										<!-- Populated dynamically by PipelineRenderer.renderQuestTrack -->
									</div>

									<!-- VIEW MODE 1: Interactive Stage Quest Arena -->
									<div class="pipeline-quest-view" id="pipeline-quest-view">
										<!-- Left: Visualization Simulation Graphic -->
										<div id="pipeline-stage-visualizer" style="height: 100%; min-height: 0;">
											<!-- Populated dynamically by PipelineRenderer.renderStageGraphic -->
										</div>

										<!-- Right: Quest Stage HUD Card -->
										<div id="pipeline-stage-hud" style="height: 100%; min-height: 0;">
											<!-- Populated dynamically by PipelineRenderer.renderStageHud -->
										</div>
									</div>

									<!-- VIEW MODE 2: Full Architecture Grid View (Hidden by default) -->
									<div class="pipeline-grid-view hidden" id="pipeline-grid-view">
										<!-- Populated dynamically by PipelineRenderer.renderGridOverview -->
									</div>
								</div>
							</div>
						</div>
					</main>
				</div>
			</div>
		</div>

		<Watermark />

		<!-- Page exit transition -->
		<script>
			const backBtn = document.getElementById("backBtn");
			if (backBtn) {
				backBtn.addEventListener("click", (e) => {
					e.preventDefault();
					document.body.classList.add("is-exiting");
					setTimeout(() => {
						window.location.href = backBtn.getAttribute("href") || "/";
					}, 280);
				});
			}
		</script>

		<!-- Pass server data variables to Client JavaScript -->
		<script define:vars={{ clusterSummary, musicGalaxy, personalRating }}>
			window.CLUSTER_SUMMARY = clusterSummary;
			window.MUSIC_GALAXY = musicGalaxy;
			window.PERSONAL_RATING = personalRating;
		</script>

		<!-- Client interactivity module -->
		<script>
			import {
				SpotifyDataStore,
				SpotifyState,
				PersonasRenderer,
				GalaxyRenderer,
				RatingRenderer,
				PipelineRenderer,
				DotMatrixEngine,
				SpotifyTab,
			} from "../lib/spotify";

			document.addEventListener("DOMContentLoaded", () => {
				const clusterSummary = (window as any).CLUSTER_SUMMARY;
				const musicGalaxy = (window as any).MUSIC_GALAXY;
				const personalRating = (window as any).PERSONAL_RATING;

				if (!clusterSummary || !musicGalaxy) return;

				const store = new SpotifyDataStore(musicGalaxy, clusterSummary);
				const state = new SpotifyState();

				const personas = new PersonasRenderer(store, state);
				const galaxy = new GalaxyRenderer(store, state);
				const rating = new RatingRenderer(personalRating || []);
				const pipeline = new PipelineRenderer(store);

				personas.init();
				galaxy.init();
				rating.init();
				pipeline.init(store);

				// ── Tab switching ──
				const navItems = document.querySelectorAll<HTMLButtonElement>(".nav-item");
				const tabs: Record<string, HTMLElement | null> = {
					personas: document.getElementById("tab-personas"),
					galaxy: document.getElementById("tab-galaxy"),
					rating: document.getElementById("tab-rating"),
					pipeline: document.getElementById("tab-pipeline"),
				};

				navItems.forEach((btn) => {
					btn.addEventListener("click", () => {
						const targetTab = btn.dataset.tab as SpotifyTab;
						if (!targetTab) return;

						navItems.forEach((n) => n.classList.remove("active"));
						btn.classList.add("active");

						Object.keys(tabs).forEach((k) => {
							if (k === targetTab) tabs[k]?.classList.remove("hidden");
							else tabs[k]?.classList.add("hidden");
						});

						state.setTab(targetTab);

						if (targetTab === SpotifyTab.Galaxy) {
							galaxy.render();
							const gd = document.getElementById("plotly-galaxy-3d");
							if (gd && (window as any).Plotly) {
								(window as any).Plotly.Plots.resize(gd);
							}
						}
						if (targetTab === SpotifyTab.Rating) {
							rating.render();
							const gd = document.getElementById("plotly-3d-map");
							if (gd && (window as any).Plotly) {
								(window as any).Plotly.Plots.resize(gd);
							}
						}
						if (targetTab === SpotifyTab.Pipeline) {
							pipeline.render();
						}
					});
				});

				// Delegate HUD next/prev button clicks in Tab 4
				document.getElementById("pipeline-stage-hud")?.addEventListener("click", (e) => {
					const btn = (e.target as Element).closest<HTMLButtonElement>(".stage-nav-btn");
					if (!btn) return;
					const action = btn.dataset.action;
					if (action === "next") pipeline.nextStage();
					else if (action === "prev") pipeline.prevStage();
				});

				// ── Canvas / Zen Mode Toggle ──
				const toggleCanvasBtn = document.getElementById("toggleCanvasBtn");
				const zenExitPill = document.getElementById("zenExitPill");

				function toggleZenCanvas() {
					const isZen = document.body.classList.toggle("is-zen-canvas");
					if (toggleCanvasBtn) {
						if (isZen) toggleCanvasBtn.classList.add("active");
						else toggleCanvasBtn.classList.remove("active");
					}
				}

				toggleCanvasBtn?.addEventListener("click", toggleZenCanvas);
				zenExitPill?.addEventListener("click", toggleZenCanvas);

				// Press Esc or H to toggle Zen Canvas mode
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && document.body.classList.contains("is-zen-canvas")) {
						toggleZenCanvas();
					} else if ((e.key === "h" || e.key === "H") && !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName)) {
						toggleZenCanvas();
					}
				});

				// Render initial view
				personas.render();
				rating.render();
				pipeline.render();

				// Dot matrix background engine
				const dotBgs = [
					"/m1.jpg", "/m2.jpg", "/m3.avif", "/m4.jpg", "/m5.jpg",
					"/m6.jpg", "/m7.webp", "/m8.jpg", "/m9.jpg", "/m10.jpg",
					"/m11.jpg", "/m12.webp", "/m13.webp", "/m14.webp", "/m15.jpg",
				];
				const dotCanvas = document.getElementById("dotMatrixCanvas") as HTMLCanvasElement | null;
				if (dotCanvas) {
					const dotEngine = new DotMatrixEngine(dotCanvas);
					dotEngine.start(dotBgs);
				}
			});
		</script>
	</body>
</html>
