---
// spotify-analysis.astro — Spotify Sonic Atlas Page in Bold Abstract Geometric Graphic Style
import "@fontsource/google-sans-flex";
import Watermark from "../components/Watermark.astro";
import clusterSummary from "../../public/assets/spotify/cluster_summary.json";
import musicGalaxy from "../../public/assets/spotify/music_galaxy.json";
import personalRating from "../../public/assets/spotify/personal_rating.json";

const rawTracks = musicGalaxy.filter((t) => t.release_year <= 2020);
const uniqueNames = new Set(rawTracks.map((t) => t.name.toLowerCase().trim()));
const tracksCount = uniqueNames.size;
const clustersCount = clusterSummary.length;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Sonic Atlas — Geometric Data Analysis & Clustering Dashboard"
		/>
		<title>Sonic Atlas — site(.)moss</title>
		<script src="https://cdn.plot.ly/plotly-2.24.1.min.js" is:inline defer></script>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
		<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" is:inline defer></script>

		<style is:global>
			/* ===========================
			   ABSTRACT GEOMETRIC DESIGN SYSTEM
			=========================== */
			:root {
				--geo-black: #0a0a0d;
				--geo-white: #ffffff;
				--geo-blue: #1642e8;   /* Bauhaus Royal Cobalt */
				--geo-red: #ef233c;    /* Crimson Coral */
				--geo-yellow: #fbbf24; /* Warm Gold Amber */
				--geo-cyan: #38bdf8;   /* Electric Aqua */
				--geo-purple: #31108d;
				--geo-surface: rgba(255, 255, 255, 0.90);
				--geo-surface-dark: #0f121d;
				--geo-border: #0a0a0d;
				--geo-text: #0a0a0d;
				--geo-muted: #475569;
				
				/* Solid crisp neo-brutalist / geometric graphic shadows */
				--geo-shadow: 4px 4px 0px #0a0a0d;
				--geo-shadow-lg: 6px 6px 0px #0a0a0d;
				--geo-shadow-sm: 2.5px 2.5px 0px #0a0a0d;

				/* Backwards compatible tokens */
				--bh-text: #0a0a0d;
				--bh-muted: #475569;
				--bh-accent: #1642e8;
			}

			/* ===========================
			   BASE
			=========================== */
			html,
			body {
				width: 100%;
				height: 100vh;
				overflow: hidden;
				background: transparent !important;
				font-family:
					"Google Sans Flex", "Google Sans", "Helvetica Neue",
					sans-serif;
				color: var(--geo-text);
				line-height: 1.5;
				margin: 0;
				padding: 0;
				position: relative;
			}
			
			button {
				color: inherit;
			}

			a {
				color: var(--geo-blue);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}

			.page-wrap {
				animation: geo-enter 0.45s cubic-bezier(0.1, 0.9, 0.2, 1) both;
				height: 100%;
				position: relative;
				z-index: 1;
			}
			@keyframes geo-enter {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			body.is-exiting .page-wrap {
				animation: geo-exit 0.28s cubic-bezier(0.4, 0, 1, 1) both;
				pointer-events: none;
			}
			@keyframes geo-exit {
				from {
					opacity: 1;
					transform: translateY(0);
				}
				to {
					opacity: 0;
					transform: translateY(14px);
				}
			}

			/* ===========================
			   LAYOUT CONTAINER
			=========================== */
			.bh-page {
				position: relative;
				z-index: 1;
				max-width: 1180px;
				margin: 0 auto;
				height: 100vh;
				padding: 14px 20px 20px 16px; /* Generous breathing room so 4px-6px shadows never clip and screen never overflows */
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: flex-start;
			}

			.bh-main-card {
				position: relative;
				display: flex;
				flex-direction: column;
				gap: 12px;
				height: 100%;
				min-height: 0;
				align-items: stretch;
				box-sizing: border-box;
				overflow: visible; /* Prevent any clipping on card shadows */
			}

			/* ===========================
			   BAUHAUS TOPBAR / SIDEBAR
			=========================== */
			.wbc-sidebar {
				width: 100%;
				height: auto;
				flex-shrink: 0;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 12px 20px;
				position: relative;
				background: var(--geo-surface);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 2px solid var(--geo-border);
				border-radius: 18px;
				box-shadow: var(--geo-shadow);
				box-sizing: border-box;
				z-index: 10;
				transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
			}

			.bh-header {
				display: flex;
				flex-direction: row;
				gap: 14px;
				margin: 0;
				width: auto;
				align-items: center;
				text-align: left;
			}

			/* Back Button */
			.wbc-back-btn {
				flex-shrink: 0;
				width: 38px;
				height: 38px;
				background: #ffffff;
				color: var(--geo-black);
				display: flex;
				align-items: center;
				justify-content: center;
				border: 2px solid var(--geo-border);
				border-radius: 50%;
				cursor: pointer;
				box-shadow: var(--geo-shadow-sm);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
			}
			.wbc-back-btn:hover {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
			}

			.title-tag-pill {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				font-size: 0.62rem;
				font-weight: 900;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--geo-blue);
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 99px;
				padding: 1px 8px;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
				width: fit-content;
				margin-bottom: 2px;
			}

			.bh-title {
				font-size: 1.6rem;
				font-weight: 900;
				line-height: 1;
				letter-spacing: -0.5px;
				margin: 0;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
				gap: 6px;
			}
			.title-sonic {
				color: var(--geo-blue);
				font-family: "Google Sans Flex", "Google Sans", sans-serif;
			}
			.title-atlas {
				color: var(--geo-red);
				font-family: Georgia, serif;
				font-style: italic;
				font-weight: bold;
			}

			/* ── NAV MENU ── */
			.wbc-nav-menu {
				display: flex;
				flex-direction: row;
				gap: 8px;
				margin: 0;
				align-items: center;
			}
			.nav-item {
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 7px 15px;
				font-size: 0.74rem;
				font-weight: 800;
				color: var(--geo-black);
				background: #ffffff;
				border: 2px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				text-align: left;
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
				box-shadow: 2px 2px 0px var(--geo-border);
				letter-spacing: 0.02em;
			}
			.nav-item:hover {
				background: #f8fafc;
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.nav-item.active {
				color: #ffffff;
				transform: translate(-1.5px, -1.5px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
			}
			#nav-personas.active { background: var(--geo-red); }
			#nav-galaxy.active { background: var(--geo-blue); }
			#nav-rating.active { background: var(--geo-yellow); color: var(--geo-black); }
			#nav-pipeline.active { background: var(--geo-black); }

			.nav-geo-icon {
				font-size: 0.8rem;
				line-height: 1;
			}

			/* ── Right-side Resume Style Quadrant Wheel Widget & Canvas View Button ── */
			.geo-header-right {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			/* Canvas View Toggle Button */
			.geo-canvas-toggle-btn {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 6px 12px;
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 0.06em;
				color: var(--geo-black);
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				box-shadow: 2px 2px 0px var(--geo-border);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
			}
			.geo-canvas-toggle-btn:hover {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.geo-canvas-toggle-btn.active {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
				box-shadow: 3px 3px 0px var(--geo-border);
			}

			.geo-quadrant-badge {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				border: 2px solid var(--geo-black);
				position: relative;
				overflow: hidden;
				box-shadow: 2px 2px 0px var(--geo-black);
				background: #ffffff;
				flex-shrink: 0;
				animation: geo-spin-slow 20s linear infinite;
			}
			.geo-quadrant-slice {
				position: absolute;
				width: 50%;
				height: 50%;
			}
			.slice-tl { top: 0; left: 0; background: var(--geo-red); }
			.slice-tr { top: 0; right: 0; background: var(--geo-blue); }
			.slice-bl { bottom: 0; left: 0; background: var(--geo-yellow); }
			.slice-br { bottom: 0; right: 0; background: var(--geo-black); }
			.geo-quadrant-center {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: var(--geo-white);
				border: 1.5px solid var(--geo-black);
				z-index: 2;
			}
			@keyframes geo-spin-slow {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			.geo-dot-chip {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5px;
				padding: 5px;
				background: var(--geo-black);
				border: 1.5px solid var(--geo-black);
				border-radius: 6px;
				width: 22px;
				height: 22px;
				box-sizing: border-box;
				box-shadow: 2px 2px 0px rgba(0,0,0,0.2);
			}
			.geo-dot-chip span {
				width: 3.5px;
				height: 3.5px;
				border-radius: 50%;
				background: #ffffff;
			}
			.geo-dot-chip span.active {
				background: var(--geo-yellow);
			}

			/* ===========================
			   WORKSPACE / TABS
			=========================== */
			.wbc-workspace {
				flex: 1;
				display: flex;
				flex-direction: column;
				min-width: 0;
				min-height: 0;
				height: auto;
				overflow: visible;
				transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
				            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
			}

			/* Canvas Zen Mode Transitions */
			body.is-zen-canvas .wbc-workspace {
				opacity: 0;
				pointer-events: none;
				transform: translateY(32px) scale(0.97);
			}
			body.is-zen-canvas .wbc-sidebar {
				background: rgba(255, 255, 255, 0.72);
				box-shadow: 2.5px 2.5px 0px rgba(10, 10, 13, 0.4);
			}

			.geo-zen-exit-pill {
				position: fixed;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%) translateY(70px);
				opacity: 0;
				pointer-events: none;
				z-index: 9999;
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 8px 18px;
				font-size: 0.74rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: #ffffff;
				color: var(--geo-black);
				border: 2px solid var(--geo-border);
				border-radius: 99px;
				box-shadow: 4px 4px 0px var(--geo-border);
				cursor: pointer;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.geo-zen-exit-pill:hover {
				background: var(--geo-yellow);
				transform: translateX(-50%) translateY(-2px);
				box-shadow: 5px 5px 0px var(--geo-border);
			}
			body.is-zen-canvas .geo-zen-exit-pill {
				transform: translateX(-50%) translateY(0);
				opacity: 1;
				pointer-events: auto;
			}
			.zen-esc-kbd {
				background: var(--geo-black);
				color: #ffffff;
				font-size: 0.6rem;
				padding: 2px 6px;
				border-radius: 4px;
				font-family: monospace;
			}

			.tab-content {
				display: grid;
				grid-template-columns: 1fr;
				gap: 14px;
				height: 100%;
				min-height: 0;
				padding-right: 4px;
				padding-bottom: 4px;
				box-sizing: border-box;
			}
			@media (min-width: 768px) {
				.tab-content.wide-left {
					grid-template-columns: 1.45fr 1fr;
				}
				.tab-content.equal-split {
					grid-template-columns: 1fr 1fr;
				}
			}

			/* ── PANELS ── */
			.panel {
				background: var(--geo-surface);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 2px solid var(--geo-border);
				border-radius: 18px;
				padding: 16px 18px;
				display: flex;
				flex-direction: column;
				height: 100%;
				min-height: 0;
				box-sizing: border-box;
				position: relative;
				box-shadow: var(--geo-shadow);
				transition: transform 0.18s cubic-bezier(0.1, 0.8, 0.2, 1), box-shadow 0.18s ease;
				overflow: hidden;
			}

			.panel:hover {
				transform: translate(-1px, -1px);
				box-shadow: 5px 5px 0px var(--geo-border);
			}

			/* Geometric Section Pill Badge */
			.section-title {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--geo-black);
				font-weight: 900;
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				padding: 3px 10px;
				box-shadow: 2px 2px 0px var(--geo-border);
				margin-bottom: 8px;
				width: fit-content;
			}

			.panel-header-title {
				font-size: 1.25rem;
				font-weight: 900;
				color: var(--geo-black);
				margin: 0 0 4px 0;
				letter-spacing: -0.3px;
			}

			/* Cluster detail card */
			.cluster-detail-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				justify-content: space-between;
				position: relative;
			}

			.cluster-detail-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 2px solid var(--geo-border);
				padding-bottom: 8px;
			}

			.cluster-badge {
				background: var(--geo-blue);
				color: #ffffff;
				border: 1.5px solid var(--geo-border);
				padding: 3px 10px;
				border-radius: 99px;
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 0.05em;
				box-shadow: 2px 2px 0px var(--geo-border);
			}

			.cluster-desc {
				font-size: 0.78rem;
				color: var(--geo-muted);
				font-weight: 600;
				margin: 8px 0 0 0;
			}

			/* Metrics grid */
			.metrics-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 6px;
				margin-top: 6px;
			}

			.metric-box {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px 10px;
				box-shadow: 2px 2px 0px var(--geo-border);
			}

			.metric-meta {
				display: flex;
				justify-content: space-between;
				font-size: 0.68rem;
				font-weight: 800;
				margin-bottom: 3px;
			}

			.metric-bar {
				height: 5px;
				background: #e2e8f0;
				border: 1.2px solid var(--geo-border);
				border-radius: 99px;
				overflow: hidden;
			}

			.metric-fill {
				height: 100%;
				border-radius: 99px;
				transition: width 0.6s cubic-bezier(0.1, 0.8, 0.2, 1);
			}

			.metric-chip-stat {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px 10px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.metric-chip-title {
				font-size: 0.58rem;
				color: var(--geo-muted);
				text-transform: uppercase;
				font-weight: 900;
				letter-spacing: 0.05em;
			}
			.metric-chip-val {
				font-size: 0.82rem;
				font-weight: 900;
				font-family: monospace;
			}

			/* ── PERSONAS INTERACTIVE GIMMICKS (RADAR, SOUNDWAVE, PASSPORT, ERA) ── */
			.personas-radar-wrap {
				display: grid;
				grid-template-columns: 1fr 1.15fr;
				gap: 8px;
				margin-top: 6px;
			}
			.persona-radar-card {
				background: #090c15;
				border: 1.8px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px 8px;
				box-shadow: 2px 2px 0px var(--geo-border);
				display: flex;
				flex-direction: column;
			}
			.radar-card-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2px;
			}
			.radar-title {
				font-size: 0.52rem;
				font-weight: 900;
				color: #94a3b8;
				letter-spacing: 0.05em;
			}
			.radar-live-badge {
				font-size: 0.5rem;
				font-weight: 900;
				padding: 1px 4px;
				border-radius: 99px;
			}
			.radar-svg-canvas {
				width: 100%;
				max-height: 95px;
			}

			.persona-soundwave-card {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px 8px;
				box-shadow: 2px 2px 0px var(--geo-border);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.soundwave-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 3px;
			}
			.soundwave-label {
				font-size: 0.52rem;
				font-weight: 900;
				color: var(--geo-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.soundwave-tempo {
				font-size: 0.62rem;
				font-weight: 900;
				font-family: monospace;
				color: var(--geo-black);
			}
			.soundwave-canvas-box {
				height: 68px;
				width: 100%;
				background: #090c15;
				border: 1.2px solid var(--geo-border);
				border-radius: 6px;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.soundwave-canvas {
				width: 100%;
				height: 100%;
				display: block;
			}

			.persona-vibe-tag {
				font-size: 0.56rem;
				font-weight: 900;
				padding: 1px 6px;
				border-radius: 99px;
				background: #ffffff;
				border: 1.2px solid var(--geo-border);
				display: inline-block;
				margin-right: 4px;
				margin-top: 4px;
			}

			/* Track Passport Card */
			.track-passport-card {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				padding: 10px 12px;
				box-shadow: 2.5px 2.5px 0px var(--geo-border);
				margin-top: 8px;
			}
			.passport-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2px;
			}
			.passport-tag {
				font-size: 0.55rem;
				font-weight: 900;
				color: var(--geo-muted);
				letter-spacing: 0.05em;
			}
			.passport-era-pill {
				font-size: 0.52rem;
				font-weight: 900;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				padding: 1px 5px;
				border-radius: 4px;
			}
			.passport-title {
				font-size: 0.85rem;
				font-weight: 900;
				color: var(--geo-black);
				margin: 2px 0 4px 0;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.passport-meta-row {
				display: flex;
				align-items: center;
				gap: 6px;
				font-size: 0.6rem;
				font-weight: 800;
			}
			.passport-cluster-badge {
				padding: 1px 6px;
				border-radius: 4px;
				font-size: 0.55rem;
				font-weight: 900;
			}
			.passport-year, .passport-pop {
				color: var(--geo-muted);
				font-family: monospace;
			}
			.passport-fingerprint-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 4px;
				margin-top: 6px;
				background: #f8fafc;
				border: 1.2px solid var(--geo-border);
				border-radius: 6px;
				padding: 4px;
			}
			.fp-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}
			.fp-lbl {
				font-size: 0.48rem;
				font-weight: 800;
				color: var(--geo-muted);
				text-transform: uppercase;
			}
			.fp-val {
				font-size: 0.62rem;
				font-weight: 900;
				font-family: monospace;
				color: var(--geo-black);
			}

			.passport-sister-section {
				margin-top: 6px;
				border-top: 1px solid #e2e8f0;
				padding-top: 4px;
			}
			.sister-section-lbl {
				font-size: 0.5rem;
				font-weight: 900;
				color: var(--geo-muted);
				letter-spacing: 0.05em;
				display: block;
				margin-bottom: 3px;
			}
			.sister-list {
				display: flex;
				flex-direction: column;
				gap: 3px;
			}
			.sister-jump-btn {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 3px 6px;
				background: #ffffff;
				border: 1px solid var(--geo-border);
				border-radius: 6px;
				cursor: pointer;
				font-family: inherit;
				font-size: 0.6rem;
				font-weight: 800;
				transition: all 0.12s ease;
			}
			.sister-jump-btn:hover {
				background: #f8fafc;
				transform: translateX(2px);
			}
			.sister-dot {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				margin-right: 4px;
			}
			.sister-name {
				flex: 1;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				text-align: left;
			}
			.sister-sim {
				font-family: monospace;
				color: var(--geo-blue);
				font-weight: 900;
			}

			/* Era Histogram Card */
			.persona-era-card {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				padding: 8px 10px;
				box-shadow: 2.5px 2.5px 0px var(--geo-border);
				margin-top: 8px;
			}
			.era-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 4px;
			}
			.era-title {
				font-size: 0.55rem;
				font-weight: 900;
				color: var(--geo-muted);
				letter-spacing: 0.05em;
			}
			.era-count {
				font-size: 0.58rem;
				font-weight: 900;
				font-family: monospace;
			}
			.era-histogram-box {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 8px;
				height: 48px;
				padding-top: 4px;
			}
			.era-bar-col {
				flex: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 2px;
				height: 100%;
			}
			.era-pct {
				font-size: 0.52rem;
				font-weight: 900;
				font-family: monospace;
				color: var(--geo-muted);
			}
			.era-bar-track {
				flex: 1;
				width: 100%;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				border-radius: 4px;
				overflow: hidden;
				display: flex;
				align-items: flex-end;
			}
			.era-bar-fill {
				width: 100%;
				border-radius: 2px;
				transition: height 0.5s ease;
			}
			.era-lbl {
				font-size: 0.55rem;
				font-weight: 900;
				color: var(--geo-black);
			}

			/* Cluster rail buttons */
			.cluster-rail {
				display: flex;
				flex-direction: column;
				gap: 5px;
				margin-top: 5px;
			}

			.cluster-btn {
				position: relative;
				width: 100%;
				padding: 7px 11px;
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 9px;
				text-align: left;
				cursor: pointer;
				transition: all 0.16s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.cluster-btn:hover {
				transform: translate(-0.8px, -0.8px);
				box-shadow: 2.8px 2.8px 0px var(--geo-border);
				background: #f8fafc;
			}
			.cluster-btn.active {
				background: var(--geo-black);
				color: #ffffff;
				transform: translate(-1px, -1px);
				box-shadow: 2.8px 2.8px 0px var(--cluster-theme-color, var(--geo-red));
			}
			.cluster-btn.active .cluster-count-pill {
				background: #ffffff;
				color: var(--geo-black);
			}

			.cluster-title-wrap {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.72rem;
				font-weight: 800;
			}

			.cluster-count-pill {
				font-size: 0.6rem;
				font-weight: 800;
				padding: 1.5px 7px;
				border-radius: 99px;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				color: var(--geo-muted);
			}

			/* Track list items */
			.list-scroll {
				flex: 1;
				overflow-y: auto;
				margin-top: 6px;
				padding-right: 4px;
				display: flex;
				flex-direction: column;
				gap: 5px;
				min-height: 0;
			}
			.list-scroll::-webkit-scrollbar {
				width: 4px;
			}
			.list-scroll::-webkit-scrollbar-thumb {
				background: var(--geo-border);
				border-radius: 4px;
			}

			.track-list-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 7px 10px;
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 8px;
				font-size: 0.74rem;
				font-weight: 700;
				cursor: pointer;
				text-align: left;
				transition: all 0.15s ease;
				font-family: inherit;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.track-list-item:hover {
				background: #f8fafc;
				transform: translateX(3px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.track-list-item.selected {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
			}
			.track-list-item.selected .track-item-badge {
				background: #ffffff;
				color: var(--geo-blue);
			}

			.track-item-title {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 170px;
			}

			.track-item-badge {
				font-size: 0.62rem;
				font-weight: 900;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				padding: 2px 6px;
				border-radius: 4px;
				flex-shrink: 0;
			}

			/* ── GALAXY TAB STYLING ── */
			.galaxy-svg-container {
				width: 100%;
				height: 100%;
				min-height: 0;
				border: 2px solid var(--geo-border);
				border-radius: 16px;
				overflow: hidden;
				position: relative;
				box-shadow: 3px 3px 0px var(--geo-border);
			}

			.geo-feature-row {
				margin-bottom: 6px;
			}
			.geo-feature-meta {
				display: flex;
				justify-content: space-between;
				font-size: 0.68rem;
				margin-bottom: 2px;
			}

			.geo-hud-stats-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 6px;
				margin-top: 10px;
				border-top: 2px solid var(--geo-border);
				padding-top: 8px;
			}
			.geo-hud-stat-chip {
				text-align: center;
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				padding: 4px;
				border-radius: 8px;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
			}
			.geo-hud-stat-label {
				font-size: 0.55rem;
				color: var(--geo-muted);
				text-transform: uppercase;
				font-weight: 900;
			}
			.geo-hud-stat-val {
				font-size: 0.75rem;
				font-weight: 900;
				font-family: monospace;
			}

			/* ── ALBUM EXPANDABLE CARDS (TAB 3) ── */
			.album-card {
				background: #ffffff;
				border: 2px solid var(--geo-border);
				border-radius: 14px;
				margin-bottom: 10px;
				overflow: hidden;
				box-shadow: 2.5px 2.5px 0px var(--geo-border);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
			}
			.album-card:hover {
				transform: translate(-1px, -1px);
				box-shadow: 3.5px 3.5px 0px var(--geo-border);
			}
			.album-card.active {
				border: 2.5px solid var(--geo-border);
				box-shadow: 4px 4px 0px var(--geo-blue);
			}
			.album-card-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 12px 16px;
				cursor: pointer;
				user-select: none;
				background: #ffffff;
			}
			.album-card-info {
				display: flex;
				flex-direction: column;
				gap: 1px;
			}
			.album-card-title {
				font-size: 0.88rem;
				font-weight: 900;
				color: var(--geo-black);
			}
			.album-card-subtitle {
				font-size: 0.65rem;
				color: var(--geo-muted);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.album-card-arrow {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background: #f1f5f9;
				border: 1.5px solid var(--geo-border);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: transform 0.25s ease, background 0.2s;
			}
			.album-card.active .album-card-arrow {
				transform: rotate(180deg);
				background: var(--geo-yellow);
			}
			.album-card-chevron {
				width: 14px;
				height: 14px;
				color: var(--geo-black);
			}
			.album-card-body {
				max-height: 0;
				overflow-y: hidden;
				transition:
					max-height 0.35s cubic-bezier(0.1, 0.8, 0.2, 1),
					padding 0.35s cubic-bezier(0.1, 0.8, 0.2, 1);
				padding: 0 16px;
				background: #fafafa;
			}
			.album-card.active .album-card-body {
				max-height: 240px;
				overflow-y: auto;
				padding-bottom: 14px;
				border-top: 1.5px solid var(--geo-border);
			}
			.album-card-body::-webkit-scrollbar {
				width: 3px;
			}
			.album-card-body::-webkit-scrollbar-thumb {
				background: var(--geo-border);
				border-radius: 4px;
			}

			.rating-group-sec {
				margin-top: 8px;
				padding-left: 8px;
			}
			.rating-group-title-sec {
				font-size: 0.65rem;
				font-weight: 900;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				margin-bottom: 4px;
				display: block;
			}
			.rating-group-tracks-sec {
				display: flex;
				flex-direction: column;
				gap: 2px;
			}

			.geo-track-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 4px 6px;
				border-bottom: 1px dashed rgba(10,10,13,0.12);
				transition: background-color 0.15s;
			}
			.geo-track-row:hover {
				background-color: #f1f5f9;
			}
			.geo-track-name {
				font-weight: 800;
				font-size: 0.72rem;
				color: var(--geo-black);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 175px;
			}
			.geo-bias-pill {
				font-size: 0.62rem;
				font-weight: 800;
				color: var(--geo-muted);
				background: #ffffff;
				border: 1px solid var(--geo-border);
				padding: 1px 6px;
				border-radius: 4px;
			}
			.geo-track-none {
				font-size: 0.68rem;
				color: var(--geo-muted);
				font-style: italic;
			}

			/* ── ML PIPELINE GAME-STAGE STYLES (TAB 4) ── */
			.pipeline-interactive-root {
				display: flex;
				flex-direction: column;
				height: 100%;
				min-height: 0;
				gap: 10px;
				overflow: hidden;
				box-sizing: border-box;
			}

			.pipeline-top-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-shrink: 0;
				gap: 12px;
			}

			.pipeline-header-controls {
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.pipeline-hud-btn {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 5px 12px;
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 0.05em;
				color: var(--geo-black);
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				box-shadow: 2px 2px 0px var(--geo-border);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
			}
			.pipeline-hud-btn:hover {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.pipeline-hud-btn.active {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
				box-shadow: 3px 3px 0px var(--geo-border);
			}

			/* ── TOP QUEST TRACK (OVERWORLD MAP) ── */
			.pipeline-quest-track {
				flex-shrink: 0;
				overflow-x: auto;
				padding: 2px 2px 6px 2px;
			}
			.pipeline-quest-track::-webkit-scrollbar {
				height: 3px;
			}
			.pipeline-quest-track::-webkit-scrollbar-thumb {
				background: var(--geo-border);
				border-radius: 3px;
			}

			.quest-track-wrapper {
				display: flex;
				align-items: center;
				gap: 6px;
				width: max-content;
				min-width: 100%;
			}

			.pipeline-node-btn {
				display: flex;
				flex-direction: column;
				gap: 2px;
				padding: 6px 10px;
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				cursor: pointer;
				box-shadow: 2px 2px 0px var(--geo-border);
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				font-family: inherit;
				min-width: 132px;
				max-width: 160px;
				text-align: left;
			}
			.pipeline-node-btn:hover {
				background: #f8fafc;
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.pipeline-node-btn.active {
				background: var(--geo-black);
				color: #ffffff;
				transform: translate(-1.5px, -1.5px);
				box-shadow: 3.5px 3.5px 0px var(--geo-yellow);
			}
			.pipeline-node-btn.active .node-category-pill {
				background: var(--geo-yellow);
				color: var(--geo-black);
				border-color: var(--geo-black);
			}
			.pipeline-node-btn.passed {
				border-color: #059669;
				background: #f0fdf4;
			}
			.pipeline-node-btn.passed .node-status-badge {
				color: #059669;
			}

			.node-pill-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.node-num {
				font-family: monospace;
				font-weight: 900;
				font-size: 0.72rem;
			}
			.node-category-pill {
				font-size: 0.58rem;
				font-weight: 900;
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				padding: 0px 5px;
				border-radius: 99px;
				color: var(--geo-text);
			}
			.node-title {
				font-size: 0.7rem;
				font-weight: 800;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.node-status-badge {
				font-size: 0.58rem;
				font-weight: 900;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--geo-muted);
			}
			.pipeline-node-btn.active .node-status-badge {
				color: var(--geo-yellow);
			}

			.node-connector-line {
				width: 14px;
				height: 2px;
				background: var(--geo-border);
				flex-shrink: 0;
				position: relative;
			}
			.connector-pulse {
				position: absolute;
				top: -2px;
				left: 0;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--geo-yellow);
				animation: geo-pulse-dot 1.8s infinite linear;
			}
			@keyframes geo-pulse-dot {
				0% { left: 0; opacity: 0; }
				50% { opacity: 1; }
				100% { left: 8px; opacity: 0; }
			}

			/* ── STAGE QUEST VIEW LAYOUT ── */
			.pipeline-quest-view {
				flex: 1;
				min-height: 0;
				display: grid;
				grid-template-columns: 1.25fr 1fr;
				gap: 12px;
				overflow: hidden;
			}
			@media (max-width: 860px) {
				.pipeline-quest-view {
					grid-template-columns: 1fr;
					overflow-y: auto;
				}
			}

			/* ── STAGE VISUALIZER GRAPHIC CARD ── */
			.stage-sim-box {
				background: #ffffff;
				border: 2px solid var(--geo-border);
				border-radius: 14px;
				padding: 12px 14px;
				box-shadow: 3px 3px 0px var(--geo-border);
				display: flex;
				flex-direction: column;
				height: 100%;
				min-height: 0;
				box-sizing: border-box;
				justify-content: space-between;
				position: relative;
				overflow: hidden;
			}

			.sim-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 1.5px solid var(--geo-border);
				padding-bottom: 6px;
				flex-shrink: 0;
			}
			.sim-tag {
				font-size: 0.62rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				color: var(--geo-blue);
			}
			.sim-metric-pill {
				font-size: 0.62rem;
				font-weight: 900;
				padding: 2px 8px;
				border-radius: 99px;
				border: 1.5px solid var(--geo-border);
				background: #f8fafc;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
			}

			.sim-toggle-group {
				display: flex;
				align-items: center;
				gap: 4px;
			}
			.curve-mode-toggle,
			.plot-toggle-btn {
				font-size: 0.58rem;
				font-weight: 900;
				font-family: inherit;
				background: #ffffff;
				color: var(--geo-text);
				border: 1.2px solid var(--geo-border);
				border-radius: 99px;
				padding: 2px 7px;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.curve-mode-toggle.active {
				background: var(--geo-blue);
				color: #ffffff;
				border-color: var(--geo-black);
			}
			.plot-toggle-btn {
				background: var(--geo-yellow);
				color: var(--geo-black);
				box-shadow: 1px 1px 0px var(--geo-border);
			}
			.plot-toggle-btn:hover {
				background: var(--geo-black);
				color: #ffffff;
			}
			.plot-toggle-btn.active {
				background: var(--geo-blue);
				color: #ffffff;
			}

			.notebook-plot-container {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				background: #ffffff;
				border: 1.5px solid var(--geo-border);
				border-radius: 8px;
				overflow: hidden;
				padding: 4px;
			}
			.notebook-plot-img {
				max-width: 100%;
				max-height: 165px;
				object-fit: contain;
				border-radius: 4px;
			}

			/* ── SIMULATION 1: DEDUPLICATION STREAM ── */
			.dedup-visualizer-canvas {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
				padding: 8px 0;
			}
			.dedup-stream {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 4px;
				min-height: 0;
			}
			.stream-label {
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 2px;
			}
			.stream-tokens, .clean-tokens-grid {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.stream-token {
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 4px 6px;
				border-radius: 6px;
				font-size: 0.65rem;
				font-weight: 700;
				border: 1.2px solid var(--geo-border);
			}
			.token-dup {
				background: #fee2e2;
				border-color: var(--geo-red);
				color: #991b1b;
				text-decoration: line-through;
				opacity: 0.75;
			}
			.token-orig {
				background: #f8fafc;
				color: var(--geo-black);
			}
			.token-sym {
				font-size: 0.7rem;
				font-weight: 900;
			}
			.token-name {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.dedup-filter-gate {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 4px;
				padding: 0 4px;
			}
			.gate-core {
				width: 50px;
				height: 50px;
				border-radius: 12px;
				background: var(--geo-black);
				color: var(--geo-yellow);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				border: 2px solid var(--geo-border);
				box-shadow: 2px 2px 0px var(--geo-border);
				position: relative;
				overflow: hidden;
			}
			.gate-icon {
				font-size: 1.2rem;
				z-index: 2;
			}
			.gate-label {
				display: none;
			}
			.gate-radar-sweep {
				position: absolute;
				width: 100%;
				height: 100%;
				background: conic-gradient(from 0deg, transparent 70%, rgba(251, 191, 36, 0.4) 100%);
				animation: geo-spin-slow 2s linear infinite;
			}
			.gate-arrow {
				font-size: 1rem;
				font-weight: 900;
				color: var(--geo-blue);
			}

			.clean-token-card {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 5px 8px;
				background: #f0fdf4;
				border: 1.5px solid #16a34a;
				border-radius: 6px;
				font-size: 0.65rem;
				font-weight: 800;
			}
			.clean-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				margin-right: 4px;
			}
			.clean-name {
				flex: 1;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.clean-status {
				font-size: 0.55rem;
				color: #15803d;
				font-weight: 900;
			}

			/* ── SIMULATION 2: CURVE VIEWPORT ── */
			.transform-curve-viewport {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 4px 0;
			}
			.curve-svg {
				width: 100%;
				max-height: 155px;
			}

			/* ── SIMULATION 3: GMM DENSITY ── */
			.gmm-density-canvas {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.gmm-svg {
				width: 100%;
				max-height: 155px;
			}
			.gmm-cluster-group {
				cursor: pointer;
				transition: transform 0.2s ease;
			}
			.gmm-cluster-group:hover {
				transform: scale(1.03);
			}

			/* ── SIMULATION 4: BOOTSTRAP RESILIENCE ── */
			.bootstrap-grid-layout {
				flex: 1;
				min-height: 0;
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 10px;
				align-items: center;
				padding: 4px 0;
			}
			.bars-label {
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-muted);
				margin-bottom: 3px;
			}
			.resample-bars-list {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3px 6px;
				max-height: 125px;
				overflow-y: auto;
			}
			.resample-bar-item {
				display: flex;
				align-items: center;
				gap: 4px;
				font-size: 0.6rem;
				font-family: monospace;
			}
			.bar-num {
				color: var(--geo-muted);
				width: 18px;
			}
			.bar-track {
				flex: 1;
				height: 5px;
				background: #e2e8f0;
				border-radius: 99px;
				overflow: hidden;
			}
			.bar-fill {
				height: 100%;
				background: #10b981;
				border-radius: 99px;
			}
			.bar-val {
				font-weight: 900;
				color: var(--geo-black);
			}

			.gauge-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 6px;
			}
			.radial-gauge-circle {
				width: 75px;
				height: 75px;
				position: relative;
			}
			.gauge-svg {
				width: 100%;
				height: 100%;
				transform: rotate(-90deg);
			}
			.gauge-center-text {
				position: absolute;
				inset: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}
			.gauge-score {
				font-size: 0.85rem;
				font-weight: 900;
				font-family: monospace;
			}
			.gauge-sub {
				font-size: 0.5rem;
				font-weight: 800;
				color: var(--geo-muted);
			}
			.gauge-badge {
				font-size: 0.58rem;
				font-weight: 900;
				background: #f0fdf4;
				color: #15803d;
				border: 1px solid #16a34a;
				border-radius: 99px;
				padding: 2px 8px;
			}

			/* ── SIMULATION 5: MANIFOLD PROJECTION ── */
			.manifold-projection-canvas {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
			}
			.hyper-feature-ring {
				flex: 1;
				background: #f8fafc;
				border: 1.5px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px;
			}
			.ring-title {
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-muted);
				margin-bottom: 4px;
				text-transform: uppercase;
			}
			.ring-features {
				display: flex;
				flex-wrap: wrap;
				gap: 2.5px;
			}
			.feat-tag {
				font-size: 0.55rem;
				font-weight: 800;
				background: #ffffff;
				border: 1px solid var(--geo-border);
				padding: 1px 4px;
				border-radius: 4px;
			}

			.projection-lens-unit {
				display: flex;
				align-items: center;
			}
			.lens-body {
				padding: 6px 8px;
				background: var(--geo-cyan);
				color: var(--geo-black);
				border: 1.8px solid var(--geo-border);
				border-radius: 8px;
				text-align: center;
				box-shadow: 2px 2px 0px var(--geo-border);
			}
			.lens-label {
				font-size: 0.65rem;
				font-weight: 900;
			}
			.lens-sub {
				font-size: 0.5rem;
				font-weight: 800;
			}

			.spatial-galaxy-box {
				flex: 1;
				height: 105px;
				background: #0f121d;
				border: 1.8px solid var(--geo-border);
				border-radius: 10px;
				padding: 6px;
				position: relative;
				overflow: hidden;
			}
			.galaxy-label {
				font-size: 0.55rem;
				font-weight: 900;
				color: #38bdf8;
				text-transform: uppercase;
			}
			.galaxy-star-cloud {
				position: relative;
				width: 100%;
				height: 75px;
			}
			.star {
				position: absolute;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				box-shadow: 0 0 8px currentColor;
				animation: geo-star-pulse 2s infinite alternate;
			}
			@keyframes geo-star-pulse {
				from { transform: scale(0.8); opacity: 0.6; }
				to { transform: scale(1.3); opacity: 1; }
			}
			.galaxy-axis {
				position: absolute;
				font-size: 0.48rem;
				font-family: monospace;
				color: #64748b;
			}
			.axis-x { bottom: 2px; right: 4px; }
			.axis-y { top: 12px; left: 4px; }
			.axis-z { bottom: 2px; left: 4px; }

			/* ── SIMULATION 6: WORMHOLE BRIDGE ── */
			.wormhole-visualizer-canvas {
				flex: 1;
				min-height: 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
			}
			.wormhole-node {
				background: #f8fafc;
				border: 1.5px solid var(--geo-border);
				border-radius: 8px;
				padding: 6px 8px;
				flex: 1;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
			}
			.node-badge {
				font-size: 0.58rem;
				font-weight: 900;
				padding: 1px 5px;
				border-radius: 4px;
				border: 1px solid var(--geo-border);
				display: inline-block;
				margin-bottom: 2px;
			}
			.node-name {
				font-size: 0.72rem;
				font-weight: 900;
			}
			.node-specs {
				font-size: 0.55rem;
				color: var(--geo-muted);
				font-family: monospace;
			}

			.wormhole-vortex-unit {
				width: 76px;
				height: 76px;
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.vortex-rings {
				position: absolute;
				border-radius: 50%;
				border: 2px dashed var(--geo-red);
			}
			.ring-1 {
				width: 100%;
				height: 100%;
				animation: geo-spin-slow 8s linear infinite;
			}
			.ring-2 {
				width: 70%;
				height: 70%;
				border-color: var(--geo-blue);
				animation: geo-spin-slow 5s linear infinite reverse;
			}
			.vortex-core {
				position: absolute;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				background: var(--geo-black);
				color: #ffffff;
				width: 52px;
				height: 52px;
				border-radius: 50%;
				border: 1.5px solid var(--geo-yellow);
				z-index: 2;
				text-align: center;
			}
			.vortex-sim-val {
				font-size: 0.52rem;
				font-family: monospace;
				font-weight: 900;
				color: var(--geo-yellow);
			}
			.vortex-lbl {
				font-size: 0.42rem;
				font-weight: 900;
				letter-spacing: 0.05em;
			}

			/* ── SIMULATION FOOTER HUD CHIPS ── */
			.sim-footer-hud {
				display: flex;
				gap: 6px;
				border-top: 1.5px solid var(--geo-border);
				padding-top: 6px;
				margin-top: 4px;
				flex-shrink: 0;
			}
			.hud-stat-chip {
				flex: 1;
				background: #f8fafc;
				border: 1.2px solid var(--geo-border);
				border-radius: 6px;
				padding: 3px 6px;
				text-align: center;
			}
			.hud-lbl {
				font-size: 0.52rem;
				font-weight: 800;
				color: var(--geo-muted);
				text-transform: uppercase;
				display: block;
			}
			.hud-val {
				font-size: 0.68rem;
				font-weight: 900;
				font-family: monospace;
				display: block;
			}

			/* ── RIGHT COLUMN: QUEST HUD CARD ── */
			.quest-hud-card {
				background: #ffffff;
				border: 2px solid var(--geo-border);
				border-radius: 14px;
				padding: 12px 14px;
				box-shadow: 3px 3px 0px var(--geo-border);
				display: flex;
				flex-direction: column;
				height: 100%;
				min-height: 0;
				box-sizing: border-box;
				justify-content: space-between;
				overflow: hidden;
			}

			.quest-hud-header {
				border-bottom: 1.5px solid var(--geo-border);
				padding-bottom: 6px;
				flex-shrink: 0;
			}
			.hud-badge-row {
				display: flex;
				align-items: center;
				gap: 6px;
				margin-bottom: 4px;
			}
			.hud-lvl-pill {
				font-size: 0.62rem;
				font-weight: 900;
				background: #ffffff;
				border: 2px solid var(--geo-black);
				border-radius: 99px;
				padding: 1px 8px;
				box-shadow: 1.5px 1.5px 0px var(--geo-border);
			}
			.hud-category-badge {
				font-size: 0.58rem;
				font-weight: 900;
				background: var(--geo-yellow);
				color: var(--geo-black);
				border: 1.2px solid var(--geo-border);
				border-radius: 99px;
				padding: 1px 7px;
			}

			.hud-stage-title {
				font-size: 0.95rem;
				font-weight: 900;
				color: var(--geo-black);
				margin: 0;
				line-height: 1.2;
			}
			.hud-quest-name {
				font-size: 0.68rem;
				font-weight: 700;
				color: var(--geo-muted);
				margin: 2px 0 0 0;
			}

			.quest-section-box {
				margin-top: 6px;
				flex-shrink: 0;
			}
			.quest-sub-label {
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-muted);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				display: block;
				margin-bottom: 2px;
			}
			.quest-objective-p {
				font-size: 0.72rem;
				font-weight: 600;
				color: var(--geo-black);
				margin: 0;
				line-height: 1.35;
			}

			.formula-chip {
				background: #0f121d;
				border: 1.5px solid var(--geo-border);
				border-radius: 6px;
				padding: 6px 10px;
				overflow-x: auto;
				display: flex;
				align-items: center;
				min-height: 28px;
			}
			.formula-chip .katex {
				color: #38bdf8;
				font-size: 0.82rem;
			}
			.formula-chip .katex-html {
				color: #38bdf8;
			}
			.formula-chip code {
				color: #38bdf8;
				font-size: 0.68rem;
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				word-break: break-all;
			}

			.quest-bullets-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 3px;
				max-height: 100px;
				overflow-y: auto;
			}
			.quest-bullet-item {
				display: flex;
				align-items: flex-start;
				gap: 6px;
				font-size: 0.68rem;
				line-height: 1.3;
				color: var(--geo-muted);
				font-weight: 600;
			}
			.bullet-dot {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				margin-top: 5px;
				flex-shrink: 0;
			}

			.quest-hud-actions {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1.5px solid var(--geo-border);
				padding-top: 8px;
				margin-top: 6px;
				flex-shrink: 0;
			}
			.stage-nav-btn {
				padding: 6px 12px;
				font-size: 0.68rem;
				font-weight: 900;
				border: 1.8px solid var(--geo-border);
				border-radius: 99px;
				cursor: pointer;
				background: #ffffff;
				box-shadow: 2px 2px 0px var(--geo-border);
				font-family: inherit;
				transition: all 0.15s ease;
			}
			.stage-nav-btn:hover:not(:disabled) {
				background: var(--geo-yellow);
				transform: translate(-1px, -1px);
				box-shadow: 3px 3px 0px var(--geo-border);
			}
			.stage-nav-btn:disabled {
				opacity: 0.4;
				cursor: not-allowed;
				box-shadow: none;
			}
			.stage-nav-btn.next-btn {
				background: var(--geo-blue);
				color: #ffffff;
			}
			.stage-nav-btn.next-btn:hover {
				background: var(--geo-black);
				color: #ffffff;
			}

			.stage-progress-indicator {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 2px;
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-muted);
			}
			.prog-dots {
				display: flex;
				gap: 3px;
			}
			.prog-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #cbd5e1;
				border: 1px solid var(--geo-border);
			}
			.prog-dot.done {
				background: #10b981;
			}
			.prog-dot.active {
				background: var(--geo-yellow);
				transform: scale(1.2);
			}

			/* ── GRID OVERVIEW (VIEW MODE 2) ── */
			.pipeline-grid-view {
				flex: 1;
				min-height: 0;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
			}
			.pipeline-grid-overview-wrapper {
				display: flex;
				flex-direction: column;
				gap: 10px;
				height: 100%;
			}
			.grid-overview-header {
				flex-shrink: 0;
			}
			.grid-overview-sub {
				font-size: 0.72rem;
				font-weight: 600;
				color: var(--geo-muted);
				margin: 0;
			}
			.pipeline-grid-6cards {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 8px;
				flex: 1;
			}
			@media (max-width: 768px) {
				.pipeline-grid-6cards {
					grid-template-columns: 1fr;
				}
			}
			.stage-grid-card {
				background: #ffffff;
				border: 1.8px solid var(--geo-border);
				border-radius: 12px;
				padding: 10px 12px;
				box-shadow: 2.5px 2.5px 0px var(--geo-border);
				cursor: pointer;
				transition: all 0.18s cubic-bezier(0.1, 0.8, 0.2, 1);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.stage-grid-card:hover {
				transform: translate(-1.5px, -1.5px);
				box-shadow: 3.5px 3.5px 0px var(--geo-blue);
				background: #f8fafc;
			}
			.stage-grid-card.current-stage {
				border-color: var(--geo-blue);
				box-shadow: 3.5px 3.5px 0px var(--geo-blue);
			}
			.grid-card-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 4px;
			}
			.grid-lvl-badge {
				font-size: 0.6rem;
				font-weight: 900;
				padding: 1px 6px;
				border-radius: 4px;
				border: 1.2px solid var(--geo-border);
			}
			.grid-xp-badge {
				font-size: 0.58rem;
				font-weight: 800;
				color: var(--geo-muted);
			}
			.grid-card-title {
				font-size: 0.78rem;
				font-weight: 900;
				margin: 0 0 2px 0;
			}
			.grid-card-desc {
				font-size: 0.65rem;
				color: var(--geo-muted);
				line-height: 1.3;
				margin: 0 0 6px 0;
			}
			.grid-card-metric {
				font-size: 0.6rem;
				font-weight: 900;
				color: var(--geo-blue);
				background: #f1f5f9;
				border: 1px solid var(--geo-border);
				border-radius: 4px;
				padding: 2px 6px;
				width: fit-content;
			}
			.grid-card-footer {
				margin-top: 6px;
				text-align: right;
			}
			.grid-jump-hint {
				font-size: 0.58rem;
				font-weight: 900;
				color: var(--geo-black);
			}

			.hidden {
				display: none !important;
			}
		</style>
	</head>

	<body>
		<!-- High-Contrast Multi-Shape Dot Matrix Canvas Engine -->
		<canvas id="dotMatrixCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none; background: #ffffff;"></canvas>

		<!-- Floating Exit Zen/Canvas Mode Pill -->
		<div id="zenExitPill" class="geo-zen-exit-pill" title="Click to show dashboard (or press Esc)">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
			<span>SHOW DASHBOARD</span>
			<span class="zen-esc-kbd">ESC</span>
		</div>

		<div class="page-wrap">
			<div class="bh-page">
				<div class="bh-main-card">
					<!-- TOP BAUHAUS HEADER & NAVIGATION -->
					<aside class="wbc-sidebar">
						<header class="bh-header">
							<a
								href="/"
								class="wbc-back-btn"
								id="backBtn"
								title="Back to Home"
							>
								<svg
									width="16"
									height="16"
									viewBox="0 0 14 14"
									fill="none"
									stroke="currentColor"
									stroke-width="2.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M9 12L4 7l5-5"></path>
								</svg>
							</a>
							<div style="display: flex; flex-direction: column;">
								<span class="title-tag-pill">
									SPOTIFY SONIC ATLAS
								</span>
								<h1 class="bh-title">
									<span class="title-sonic">Sonic</span>
									<span class="title-atlas">Atlas</span>
								</h1>
							</div>
						</header>

						<nav class="wbc-nav-menu">
							<button
								class="nav-item active"
								data-tab="personas"
								id="nav-personas"
							>
								<span class="nav-geo-icon" style="color: var(--geo-red);">●</span>
								Sonic Personas
							</button>
							<button
								class="nav-item"
								data-tab="galaxy"
								id="nav-galaxy"
							>
								<span class="nav-geo-icon" style="color: var(--geo-blue);">▲</span>
								Music Galaxy
							</button>
							<button
								class="nav-item"
								data-tab="rating"
								id="nav-rating"
							>
								<span class="nav-geo-icon" style="color: var(--geo-yellow);">■</span>
								Personal Rating
							</button>
							<button
								class="nav-item"
								data-tab="pipeline"
								id="nav-pipeline"
							>
								<span class="nav-geo-icon" style="color: var(--geo-black);">◫</span>
								ML Pipeline
							</button>
						</nav>

						<!-- Right Geometric Accents (Canvas Toggle + Resume 4-Quadrant Wheel + Dot Chip) -->
						<div class="geo-header-right">
							<button
								id="toggleCanvasBtn"
								class="geo-canvas-toggle-btn"
								title="Hide UI to view Full Background Canvas (Press H or Esc)"
								aria-label="Toggle canvas art view"
							>
								<svg class="canvas-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
									<circle cx="12" cy="12" r="3"></circle>
								</svg>
								<span>CANVAS</span>
							</button>
							<div class="geo-dot-chip" title="3x3 Matrix Unit" aria-hidden="true">
								<span></span><span></span><span></span>
								<span></span><span class="active"></span><span></span>
								<span></span><span></span><span></span>
							</div>
							<div class="geo-quadrant-badge" title="Audio Archetype Wheel" aria-hidden="true">
								<div class="geo-quadrant-slice slice-tl"></div>
								<div class="geo-quadrant-slice slice-tr"></div>
								<div class="geo-quadrant-slice slice-bl"></div>
								<div class="geo-quadrant-slice slice-br"></div>
								<div class="geo-quadrant-center"></div>
							</div>
						</div>
					</aside>

					<!-- WORKSPACE TABS -->
					<main class="wbc-workspace">
						<!-- ── TAB 1: SONIC PERSONAS ── -->
						<div
							id="tab-personas"
							class="tab-content wide-left"
						>
							<!-- LEFT PANEL: PERSONA ACOUSTIC PROFILE & DISCOGRAPHY -->
							<div class="panel" style="display: flex; flex-direction: column; height: 100%; overflow: hidden; padding: 14px 16px;">
								<div class="cluster-detail-card" style="display: flex; flex-direction: column; height: 100%; min-height: 0; gap: 8px;">
									<!-- Top Header + Vibe Tags + Share Badge -->
									<div class="cluster-hero-top" style="flex-shrink: 0;">
										<div class="cluster-detail-header">
											<div style="display: flex; align-items: center; gap: 8px;">
												<h3 class="panel-header-title" id="cluster-name" style="margin: 0;">
													Acoustic & Mellow
												</h3>
												<div id="persona-vibe-tags"></div>
											</div>
											<span class="cluster-badge" id="cluster-share">21% share</span>
										</div>

										<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
											<span class="section-title" style="margin-bottom: 0;">Acoustic Fingerprint</span>
											<button type="button" id="persona-submode-btn" class="plot-toggle-btn" style="padding: 1px 8px; font-size: 0.55rem;">
												<span>BARS</span>
											</button>
										</div>

										<div id="cluster-metrics">
											<!-- Dynamic radar / metrics populated by PersonasRenderer -->
										</div>
									</div>

									<!-- Tracks section expanding to fill all remaining vertical space -->
									<div class="cluster-tracks-section" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;">
										<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; flex-shrink: 0;">
											<span class="section-title" style="margin-bottom: 0;">Tracks</span>
											<input
												type="text"
												id="personas-search"
												placeholder="Search tracks..."
												style="width: 140px; padding: 3px 8px; font-size: 0.68rem; font-weight: 700; background: #ffffff; border: 1.5px solid var(--geo-border); border-radius: 6px; box-sizing: border-box; font-family: inherit; color: var(--geo-text); outline: none; box-shadow: 1.5px 1.5px 0px var(--geo-border);"
											/>
